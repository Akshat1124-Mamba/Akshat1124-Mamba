@* SuperAdmin PMS Dashboard - Premium Command Center *@
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>SuperAdmin — PMS Command Center</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0
        }

        :root {
            --navy: #07111f;
            --navy2: #0d1a2e;
            --navy3: #112238;
            --navy4: #162d47;
            --gold: #f5a623;
            --gold-dim: #c47f0c;
            --gold-glow: rgba(245,166,35,.18);
            --ink: #f0f4f8;
            --ink2: #cbd5e0;
            --ink3: #8899aa;
            --ink4: #4a5a6a;
            --bg: #060f1c;
            --surface: #0d1a2e;
            --surface2: #112238;
            --surface3: #162d47;
            --border: rgba(255,255,255,.06);
            --border2: rgba(255,255,255,.10);
            --border3: rgba(255,255,255,.16);
            --teal: #14b8a6;
            --teal-lt: rgba(20,184,166,.12);
            --teal-bd: rgba(20,184,166,.3);
            --emerald: #10b981;
            --emerald-lt: rgba(16,185,129,.12);
            --rose: #f43f5e;
            --rose-lt: rgba(244,63,94,.12);
            --cobalt: #3b82f6;
            --cobalt-lt: rgba(59,130,246,.12);
            --violet: #8b5cf6;
            --violet-lt: rgba(139,92,246,.12);
            --amber: #f59e0b;
            --amber-lt: rgba(245,158,11,.12);
            --slate: #64748b;
            --font: 'Inter',sans-serif;
            --mono: 'JetBrains Mono',monospace;
            --rad: 8px;
            --rad-lg: 12px;
            --rad-xl: 16px;
            --sh: 0 1px 3px rgba(0,0,0,.4),0 8px 24px rgba(0,0,0,.3);
            --sh-lg: 0 4px 32px rgba(0,0,0,.5);
            --transition: .18s cubic-bezier(.4,0,.2,1);
        }

        body {
            font-family: var(--font);
            background: var(--bg);
            color: var(--ink);
            font-size: 13px;
            min-height: 100vh;
            -webkit-font-smoothing: antialiased
        }

        /* ── SCROLLBAR ── */
        ::-webkit-scrollbar {
            width: 4px;
            height: 4px
        }

        ::-webkit-scrollbar-track {
            background: transparent
        }

        ::-webkit-scrollbar-thumb {
            background: var(--border3);
            border-radius: 4px
        }

        /* ══════════════════════════════════
           LAYOUT
        ══════════════════════════════════ */
        .layout {
            display: flex;
            min-height: 100vh
        }

        /* ── SIDEBAR ── */
        .sidebar {
            width: 232px;
            background: var(--navy);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 600;
            border-right: 1px solid var(--border);
            overflow: hidden
        }

        .sb-brand {
            height: 64px;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 16px;
            border-bottom: 1px solid var(--border);
            flex-shrink: 0
        }

        .sb-logo {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg,#f5a623,#e84545);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            font-weight: 800;
            color: #fff;
            font-family: Georgia,serif;
            font-style: italic;
            flex-shrink: 0;
            box-shadow: 0 2px 12px rgba(245,166,35,.35)
        }

        .sb-name {
            font-size: .78rem;
            font-weight: 700;
            color: #fff;
            letter-spacing: -.01em
        }

            .sb-name span {
                display: block;
                font-size: .55rem;
                color: var(--ink4);
                text-transform: uppercase;
                letter-spacing: .12em;
                font-weight: 500;
                margin-top: 1px
            }

        .sa-badge {
            margin: 12px 14px;
            padding: 7px 11px;
            background: linear-gradient(135deg,rgba(245,166,35,.15),rgba(232,69,69,.1));
            border: 1px solid rgba(245,166,35,.22);
            border-radius: 9px;
            display: flex;
            align-items: center;
            gap: 7px;
            flex-shrink: 0
        }

        .sa-badge-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--gold);
            box-shadow: 0 0 6px var(--gold);
            flex-shrink: 0
        }

        .sa-badge-label {
            font-size: .58rem;
            font-weight: 700;
            color: var(--gold);
            text-transform: uppercase;
            letter-spacing: .12em
        }

        .sb-section-label {
            padding: 10px 18px 4px;
            font-size: .50rem;
            font-weight: 700;
            letter-spacing: .14em;
            text-transform: uppercase;
            color: var(--ink4);
            flex-shrink: 0
        }

        .sb-nav {
            flex: 1;
            overflow-y: auto;
            padding-bottom: 12px
        }

        .sb-link {
            display: flex;
            align-items: center;
            gap: 8px;
            height: 36px;
            padding: 0 12px 0 14px;
            border-radius: 7px;
            margin: 1px 8px;
            color: var(--ink3);
            font-size: .73rem;
            font-weight: 500;
            cursor: pointer;
            text-decoration: none;
            border: 1px solid transparent;
            transition: var(--transition);
            white-space: nowrap;
            position: relative
        }

        .sb-icon {
            font-size: .82rem;
            flex-shrink: 0;
            opacity: .8
        }

        .sb-link:hover {
            background: rgba(255,255,255,.05);
            color: var(--ink2)
        }

        .sb-link.active {
            background: rgba(245,166,35,.1);
            border-color: rgba(245,166,35,.22);
            color: var(--gold)
        }

            .sb-link.active .sb-icon {
                opacity: 1
            }

        .sb-cnt {
            margin-left: auto;
            font-family: var(--mono);
            font-size: .56rem;
            background: rgba(255,255,255,.07);
            padding: 1px 6px;
            border-radius: 5px;
            color: var(--ink4);
            flex-shrink: 0
        }

        .sb-link.active .sb-cnt {
            background: rgba(245,166,35,.18);
            color: var(--gold)
        }

        .sb-divider {
            height: 1px;
            background: var(--border);
            margin: 8px 14px
        }

        .sb-footer {
            padding: 12px 14px;
            border-top: 1px solid var(--border);
            flex-shrink: 0
        }

        .sb-user {
            display: flex;
            align-items: center;
            gap: 9px
        }

        .sb-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: linear-gradient(135deg,#f5a623,#e84545);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .60rem;
            font-weight: 700;
            color: #fff;
            flex-shrink: 0
        }

        .sb-uname {
            font-size: .68rem;
            color: var(--ink4)
        }

            .sb-uname strong {
                display: block;
                color: var(--ink2);
                font-size: .70rem;
                font-weight: 600
            }

        /* ── MAIN ── */
        .main {
            margin-left: 232px;
            display: flex;
            flex-direction: column;
            min-height: 100vh
        }

        .topbar {
            height: 64px;
            background: rgba(7,17,31,.92);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 28px;
            position: sticky;
            top: 0;
            z-index: 400
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 14px
        }

        .page-heading {
            font-size: .92rem;
            font-weight: 700;
            color: var(--ink);
            letter-spacing: -.01em
        }

        .page-sub {
            font-size: .68rem;
            color: var(--ink4);
            margin-top: 2px
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 8px
        }

        .btn-sm {
            height: 32px;
            padding: 0 14px;
            border-radius: 7px;
            border: 1px solid var(--border2);
            background: rgba(255,255,255,.04);
            font-size: .71rem;
            font-weight: 600;
            font-family: var(--font);
            color: var(--ink2);
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: var(--transition)
        }

            .btn-sm:hover {
                border-color: var(--border3);
                color: var(--ink);
                background: rgba(255,255,255,.07)
            }

            .btn-sm.gold {
                background: var(--gold);
                color: #07111f;
                border-color: var(--gold);
                box-shadow: 0 2px 12px rgba(245,166,35,.3);
                font-weight: 700
            }

                .btn-sm.gold:hover {
                    filter: brightness(1.1)
                }

            .btn-sm.teal {
                background: var(--teal-lt);
                border-color: var(--teal-bd);
                color: var(--teal)
            }

        .year-sel {
            height: 32px;
            border: 1px solid var(--border2);
            border-radius: 7px;
            padding: 0 10px;
            font-size: .72rem;
            font-family: var(--font);
            background: rgba(255,255,255,.04);
            color: var(--ink2);
            outline: none;
            min-width: 110px
        }

            .year-sel:focus {
                border-color: rgba(245,166,35,.4)
            }

            .year-sel option {
                background: #0d1a2e
            }

        .chip-sa {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: .60rem;
            font-weight: 700;
            background: rgba(245,166,35,.12);
            color: var(--gold);
            border: 1px solid rgba(245,166,35,.25)
        }

        .content {
            padding: 24px 28px 80px
        }

        /* ── PANEL ── */
        .panel {
            display: none
        }

            .panel.active {
                display: block
            }

        /* ══════════════════════════════════
           OVERVIEW HERO
        ══════════════════════════════════ */
        .cmd-hero {
            background: var(--navy2);
            border: 1px solid var(--border);
            border-radius: var(--rad-xl);
            padding: 28px 32px;
            margin-bottom: 22px;
            position: relative;
            overflow: hidden
        }

            .cmd-hero::before {
                content: '';
                position: absolute;
                top: -60px;
                right: -60px;
                width: 280px;
                height: 280px;
                background: radial-gradient(circle,rgba(245,166,35,.1) 0%,transparent 70%);
                pointer-events: none
            }

            .cmd-hero::after {
                content: '';
                position: absolute;
                bottom: -40px;
                left: 40%;
                width: 180px;
                height: 180px;
                background: radial-gradient(circle,rgba(20,184,166,.07) 0%,transparent 70%);
                pointer-events: none
            }

        .hero-eyebrow {
            font-size: .57rem;
            font-weight: 700;
            letter-spacing: .16em;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 8px
        }

            .hero-eyebrow::before {
                content: '';
                width: 18px;
                height: 1px;
                background: var(--gold);
                opacity: .5
            }

        .hero-title {
            font-size: 1.6rem;
            font-weight: 700;
            color: #fff;
            line-height: 1.2;
            letter-spacing: -.02em
        }

        .hero-sub {
            font-size: .76rem;
            color: var(--ink3);
            margin-top: 7px;
            max-width: 480px;
            line-height: 1.6
        }

        .hero-actions {
            display: flex;
            gap: 8px;
            margin-top: 20px;
            flex-wrap: wrap
        }

        .btn-hero {
            height: 36px;
            padding: 0 18px;
            border-radius: 8px;
            font-size: .74rem;
            font-weight: 600;
            font-family: var(--font);
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: var(--transition);
            white-space: nowrap;
            border: 1px solid var(--border2);
            background: rgba(255,255,255,.06);
            color: rgba(255,255,255,.7)
        }

            .btn-hero:hover {
                background: rgba(255,255,255,.11);
                color: #fff;
                border-color: var(--border3)
            }

            .btn-hero.gold {
                background: var(--gold);
                color: #07111f;
                border-color: var(--gold);
                box-shadow: 0 2px 14px rgba(245,166,35,.35);
                font-weight: 700
            }

                .btn-hero.gold:hover {
                    filter: brightness(1.08)
                }

        /* ══════════════════════════════════
           STATS GRID
        ══════════════════════════════════ */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit,minmax(148px,1fr));
            gap: 10px;
            margin-bottom: 22px
        }

        .stat-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--rad-lg);
            padding: 16px 18px;
            position: relative;
            overflow: hidden;
            transition: var(--transition)
        }

            .stat-card:hover {
                border-color: var(--border2);
                transform: translateY(-1px)
            }

            .stat-card::after {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 2px;
                border-radius: var(--rad-lg) var(--rad-lg) 0 0
            }

        .c-gold::after {
            background: var(--gold)
        }

        .c-rose::after {
            background: var(--rose)
        }

        .c-amber::after {
            background: var(--amber)
        }

        .c-emerald::after {
            background: var(--emerald)
        }

        .c-cobalt::after {
            background: var(--cobalt)
        }

        .c-teal::after {
            background: var(--teal)
        }

        .c-violet::after {
            background: var(--violet)
        }

        .c-slate::after {
            background: var(--slate)
        }

        .stat-label {
            font-size: .54rem;
            font-weight: 700;
            letter-spacing: .11em;
            text-transform: uppercase;
            color: var(--ink4);
            margin-bottom: 8px
        }

        .stat-val {
            font-size: 1.7rem;
            font-weight: 700;
            font-family: var(--mono);
            line-height: 1
        }

        .stat-sub {
            font-size: .64rem;
            color: var(--ink4);
            margin-top: 5px;
            line-height: 1.4
        }

        .stat-icon {
            position: absolute;
            right: 14px;
            top: 14px;
            font-size: 1.1rem;
            opacity: .25
        }

        /* ══════════════════════════════════
           SECTION LABEL
        ══════════════════════════════════ */
        .section-lbl {
            font-size: .55rem;
            font-weight: 700;
            letter-spacing: .14em;
            text-transform: uppercase;
            color: var(--ink4);
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 10px
        }

            .section-lbl::after {
                content: '';
                flex: 1;
                height: 1px;
                background: var(--border)
            }

        /* ══════════════════════════════════
           CARD
        ══════════════════════════════════ */
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--rad-xl);
            padding: 20px 22px;
            margin-bottom: 18px;
            box-shadow: var(--sh)
        }

        .card-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
            gap: 12px;
            flex-wrap: wrap
        }

        .card-title {
            font-size: .83rem;
            font-weight: 700;
            color: var(--ink);
            letter-spacing: -.01em
        }

        .card-sub {
            font-size: .68rem;
            color: var(--ink4);
            margin-top: 3px
        }

        /* ══════════════════════════════════
           ROLE VIEW CARDS (Quick Launch)
        ══════════════════════════════════ */
        .role-views {
            display: grid;
            grid-template-columns: repeat(auto-fit,minmax(185px,1fr));
            gap: 12px;
            margin-bottom: 22px
        }

        .rv-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--rad-xl);
            padding: 18px 20px;
            cursor: pointer;
            transition: var(--transition);
            position: relative;
            overflow: hidden
        }

            .rv-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 2px
            }

            .rv-card:hover {
                border-color: var(--border2);
                transform: translateY(-2px);
                box-shadow: var(--sh)
            }

        .rv-emp::before {
            background: var(--cobalt)
        }

        .rv-rm::before {
            background: var(--amber)
        }

        .rv-hod::before {
            background: var(--teal)
        }

        .rv-uh::before {
            background: var(--violet)
        }

        .rv-mc::before {
            background: #b45309
        }

        .rv-jmd::before {
            background: var(--rose)
        }

        .rv-icon {
            font-size: 1.4rem;
            margin-bottom: 9px;
            opacity: .85
        }

        .rv-title {
            font-size: .78rem;
            font-weight: 700;
            color: var(--ink)
        }

        .rv-sub {
            font-size: .65rem;
            color: var(--ink4);
            margin-top: 2px
        }

        .rv-count {
            margin-top: 10px;
            font-size: 1.4rem;
            font-weight: 700;
            font-family: var(--mono);
            color: var(--ink)
        }

        .rv-pending {
            font-size: .62rem;
            font-weight: 600;
            color: var(--gold);
            margin-top: 3px
        }

        /* ══════════════════════════════════
           DUAL PANEL
        ══════════════════════════════════ */
        .dual {
            display: grid;
            grid-template-columns: 1fr 320px;
            gap: 14px
        }
        @@media(max - width:1100px) {
            .dual

        {
            grid-template-columns: 1fr
        }

        }

        /* ══════════════════════════════════
           FUNNEL
        ══════════════════════════════════ */
        .funnel {
            display: flex;
            flex-direction: column;
            gap: 7px;
            padding: 4px 0
        }

        .funnel-row {
            display: flex;
            align-items: center;
            gap: 10px
        }

        .funnel-lbl {
            font-size: .65rem;
            color: var(--ink3);
            width: 110px;
            flex-shrink: 0;
            text-align: right
        }

        .funnel-bar-wrap {
            flex: 1;
            height: 20px;
            background: rgba(255,255,255,.04);
            border-radius: 5px;
            overflow: hidden
        }

        .funnel-bar {
            height: 100%;
            border-radius: 5px;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding-right: 8px;
            font-size: .58rem;
            font-weight: 700;
            color: rgba(255,255,255,.9);
            font-family: var(--mono);
            transition: width .7s cubic-bezier(.4,0,.2,1)
        }

        .funnel-pct {
            font-size: .60rem;
            color: var(--ink4);
            width: 34px;
            text-align: right;
            font-family: var(--mono)
        }

        /* ══════════════════════════════════
           ALERTS
        ══════════════════════════════════ */
        .alert-item {
            border-radius: var(--rad);
            padding: 10px 14px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 7px;
            border: 1px solid transparent
        }

            .alert-item.warn {
                background: rgba(245,166,35,.08);
                border-color: rgba(245,166,35,.2)
            }

            .alert-item.info {
                background: rgba(59,130,246,.08);
                border-color: rgba(59,130,246,.2)
            }

            .alert-item.success {
                background: rgba(16,185,129,.08);
                border-color: rgba(16,185,129,.2)
            }

            .alert-item.danger {
                background: rgba(244,63,94,.08);
                border-color: rgba(244,63,94,.2)
            }

        .alert-icon {
            font-size: .9rem;
            flex-shrink: 0;
            margin-top: 1px
        }

        .alert-title {
            font-size: .72rem;
            font-weight: 600
        }

        .alert-sub {
            font-size: .63rem;
            color: var(--ink4);
            margin-top: 1px
        }

        .warn .alert-title {
            color: #f5a623
        }

        .info .alert-title {
            color: var(--cobalt)
        }

        .success .alert-title {
            color: var(--emerald)
        }

        .danger .alert-title {
            color: var(--rose)
        }

        /* ══════════════════════════════════
           PROGRESS RING
        ══════════════════════════════════ */
        .prog-wrap {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap
        }

        .prog-ring {
            position: relative;
            width: 76px;
            height: 76px;
            flex-shrink: 0
        }

            .prog-ring svg {
                transform: rotate(-90deg)
            }

        .prog-ring-inner {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center
        }

        .pr-val {
            font-size: .88rem;
            font-weight: 700;
            font-family: var(--mono);
            color: var(--ink)
        }

        .pr-lbl {
            font-size: .46rem;
            color: var(--ink4);
            text-transform: uppercase;
            letter-spacing: .1em
        }

        /* ══════════════════════════════════
           TIMELINE PROCESS VIEWER (NEW)
        ══════════════════════════════════ */
        .process-track {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--rad-xl);
            padding: 20px 22px;
            margin-bottom: 18px
        }

        .process-stages {
            display: flex;
            align-items: flex-start;
            gap: 0;
            position: relative;
            padding-top: 36px;
            overflow-x: auto;
            padding-bottom: 8px
        }

            .process-stages::before {
                content: '';
                position: absolute;
                top: 18px;
                left: 24px;
                right: 24px;
                height: 1.5px;
                background: linear-gradient(90deg,var(--cobalt) 0%,var(--teal) 30%,var(--violet) 60%,var(--emerald) 100%);
                opacity: .3
            }

        .ps-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            flex: 1;
            min-width: 96px;
            position: relative;
            cursor: pointer
        }

        .ps-dot-wrap {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
            position: relative;
            z-index: 2;
            flex-shrink: 0;
            transition: var(--transition)
        }

            .ps-dot-wrap.active {
                transform: scale(1.15)
            }

        .ps-dot {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .55rem;
            font-weight: 700;
            color: #fff;
            border: 2px solid transparent;
            transition: var(--transition)
        }

        .ps-label {
            font-size: .60rem;
            font-weight: 600;
            color: var(--ink3);
            text-align: center;
            line-height: 1.4
        }

        .ps-count {
            font-size: .80rem;
            font-weight: 700;
            font-family: var(--mono);
            color: var(--ink);
            margin-top: 4px
        }

        .ps-tag {
            font-size: .55rem;
            padding: 1px 6px;
            border-radius: 4px;
            margin-top: 3px;
            font-weight: 700;
            display: inline-block
        }

        /* ══════════════════════════════════
           TOOLBAR
        ══════════════════════════════════ */
        .toolbar {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
            margin-bottom: 14px
        }

        .role-tabs {
            display: flex;
            gap: 5px;
            flex-wrap: wrap
        }

        .rtab {
            height: 30px;
            padding: 0 12px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: transparent;
            font-size: .68rem;
            font-weight: 600;
            color: var(--ink4);
            cursor: pointer;
            font-family: var(--font);
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: var(--transition)
        }

            .rtab:hover {
                border-color: var(--border2);
                color: var(--ink2)
            }

            .rtab.active {
                border-color: rgba(245,166,35,.35);
                color: var(--gold);
                background: rgba(245,166,35,.08)
            }

        .rtab-cnt {
            font-family: var(--mono);
            font-size: .56rem;
            background: rgba(255,255,255,.07);
            padding: 1px 5px;
            border-radius: 4px
        }

        .rtab.active .rtab-cnt {
            background: rgba(245,166,35,.18);
            color: var(--gold)
        }

        .search-wrap {
            position: relative;
            flex: 1;
            max-width: 280px;
            margin-left: auto
        }

            .search-wrap input {
                width: 100%;
                height: 30px;
                border: 1px solid var(--border);
                border-radius: 7px;
                padding: 0 10px 0 28px;
                font-size: .73rem;
                font-family: var(--font);
                background: rgba(255,255,255,.04);
                color: var(--ink);
                outline: none
            }

                .search-wrap input:focus {
                    border-color: rgba(245,166,35,.35)
                }

                .search-wrap input::placeholder {
                    color: var(--ink4)
                }

        .search-icon {
            position: absolute;
            left: 8px;
            top: 50%;
            transform: translateY(-50%);
            font-size: .72rem;
            color: var(--ink4);
            pointer-events: none
        }

        /* ══════════════════════════════════
           TABLE
        ══════════════════════════════════ */
        .tbl-wrap {
            overflow-x: auto
        }

        .sa-tbl {
            width: 100%;
            border-collapse: collapse;
            font-size: .74rem
        }

            .sa-tbl thead th {
                background: rgba(255,255,255,.03);
                color: var(--ink4);
                padding: 8px 10px;
                text-align: left;
                font-size: .54rem;
                font-weight: 700;
                letter-spacing: .09em;
                text-transform: uppercase;
                border-bottom: 1px solid var(--border2);
                white-space: nowrap
            }

            .sa-tbl tbody tr {
                border-bottom: 1px solid rgba(255,255,255,.04);
                transition: background .1s
            }

                .sa-tbl tbody tr:hover {
                    background: rgba(255,255,255,.03)
                }

            .sa-tbl tbody td {
                padding: 9px 10px;
                color: var(--ink2);
                vertical-align: middle
            }

            .sa-tbl .mono {
                font-family: var(--mono);
                font-size: .70rem
            }

            .sa-tbl .dim {
                color: var(--ink4)
            }

        .tbl-empty {
            text-align: center;
            padding: 48px 20px;
            color: var(--ink4);
            font-size: .78rem
        }

        .tbl-loading {
            text-align: center;
            padding: 36px;
            color: var(--ink4)
        }

        /* ── PILLS ── */
        .pill {
            display: inline-flex;
            align-items: center;
            gap: 3px;
            padding: 2px 8px;
            border-radius: 8px;
            font-size: .58rem;
            font-weight: 700;
            font-family: var(--mono);
            white-space: nowrap;
            letter-spacing: .03em
        }

        .pill-draft {
            background: rgba(100,116,139,.15);
            color: var(--slate);
            border: 1px solid rgba(100,116,139,.25)
        }

        .pill-emp {
            background: var(--cobalt-lt);
            color: var(--cobalt);
            border: 1px solid rgba(59,130,246,.25)
        }

        .pill-rm {
            background: var(--amber-lt);
            color: var(--amber);
            border: 1px solid rgba(245,158,11,.25)
        }

        .pill-hod {
            background: var(--teal-lt);
            color: var(--teal);
            border: 1px solid rgba(20,184,166,.25)
        }

        .pill-uh {
            background: var(--violet-lt);
            color: var(--violet);
            border: 1px solid rgba(139,92,246,.25)
        }

        .pill-mc {
            background: rgba(180,83,9,.15);
            color: #f59e0b;
            border: 1px solid rgba(180,83,9,.3)
        }

        .pill-jmd {
            background: var(--rose-lt);
            color: var(--rose);
            border: 1px solid rgba(244,63,94,.25)
        }

        .pill-hr {
            background: var(--emerald-lt);
            color: var(--emerald);
            border: 1px solid rgba(16,185,129,.25)
        }

        /* ── CYCLE CHIP ── */
        .cycle-chip {
            display: inline-flex;
            align-items: center;
            padding: 2px 7px;
            border-radius: 6px;
            font-size: .58rem;
            font-weight: 600;
            font-family: var(--mono);
            background: var(--teal-lt);
            color: var(--teal);
            border: 1px solid var(--teal-bd);
            white-space: nowrap
        }

        /* ── LINK BTNS ── */
        .link-btns {
            display: flex;
            gap: 4px;
            flex-wrap: wrap
        }

        .lb {
            height: 26px;
            padding: 0 9px;
            border-radius: 5px;
            font-size: .64rem;
            font-weight: 600;
            font-family: var(--font);
            border: 1px solid transparent;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 3px;
            transition: var(--transition);
            white-space: nowrap
        }

        .lb-emp {
            background: var(--cobalt-lt);
            color: var(--cobalt);
            border-color: rgba(59,130,246,.3)
        }

        .lb-rm {
            background: var(--amber-lt);
            color: var(--amber);
            border-color: rgba(245,158,11,.3)
        }

        .lb-hod {
            background: var(--teal-lt);
            color: var(--teal);
            border-color: rgba(20,184,166,.3)
        }

        .lb-uh {
            background: var(--violet-lt);
            color: var(--violet);
            border-color: rgba(139,92,246,.3)
        }

        .lb-mc {
            background: rgba(180,83,9,.12);
            color: #f59e0b;
            border-color: rgba(180,83,9,.3)
        }

        .lb-jmd {
            background: var(--rose-lt);
            color: var(--rose);
            border-color: rgba(244,63,94,.3)
        }

        .lb-print {
            background: rgba(255,255,255,.06);
            color: var(--ink3);
            border-color: var(--border)
        }

        .lb:hover {
            filter: brightness(1.15)
        }

        /* ── PIPELINE DOTS ── */
        .pipeline {
            display: flex;
            align-items: center;
            gap: 1px
        }

        .pipe-dot {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .40rem;
            font-weight: 700;
            border: 1.5px solid transparent;
            flex-shrink: 0
        }

            .pipe-dot.done {
                background: var(--emerald);
                border-color: var(--emerald);
                color: #fff
            }

            .pipe-dot.now {
                background: var(--gold);
                border-color: var(--gold);
                color: #07111f;
                box-shadow: 0 0 0 3px rgba(245,166,35,.2)
            }

            .pipe-dot.wait {
                background: rgba(255,255,255,.06);
                border-color: var(--border);
                color: var(--ink4)
            }

        .pipe-line {
            width: 6px;
            height: 1.5px;
            background: var(--border);
            border-radius: 2px
        }

            .pipe-line.done {
                background: var(--emerald)
            }

        /* ══════════════════════════════════
           MASTERS TABLE extras
        ══════════════════════════════════ */
        .reviewer-chip {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: .62rem;
            color: var(--ink3);
            background: rgba(255,255,255,.05);
            padding: 2px 7px;
            border-radius: 5px;
            border: 1px solid var(--border)
        }

        /* ══════════════════════════════════
           AUDIT TRAIL PANEL (NEW)
        ══════════════════════════════════ */
        .audit-feed {
            display: flex;
            flex-direction: column;
            gap: 0
        }

        .audit-item {
            display: flex;
            gap: 14px;
            align-items: flex-start;
            padding: 10px 0;
            border-bottom: 1px solid var(--border)
        }

            .audit-item:last-child {
                border-bottom: none
            }

        .audit-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
            margin-top: 5px
        }

            .audit-dot.a {
                background: var(--cobalt)
            }

            .audit-dot.b {
                background: var(--teal)
            }

            .audit-dot.c {
                background: var(--gold)
            }

            .audit-dot.d {
                background: var(--emerald)
            }

            .audit-dot.e {
                background: var(--violet)
            }

            .audit-dot.f {
                background: var(--rose)
            }

        .audit-text {
            font-size: .72rem;
            color: var(--ink2);
            line-height: 1.5
        }

        .audit-time {
            font-size: .60rem;
            color: var(--ink4);
            font-family: var(--mono);
            margin-top: 2px
        }

        /* ══════════════════════════════════
           MINI PROGRESS BARS (stage insight)
        ══════════════════════════════════ */
        .stage-breakdown {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-top: 10px
        }

        .sbd-row {
            display: flex;
            align-items: center;
            gap: 8px
        }

        .sbd-label {
            font-size: .64rem;
            color: var(--ink3);
            width: 120px;
            flex-shrink: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis
        }

        .sbd-bar-wrap {
            flex: 1;
            height: 5px;
            background: rgba(255,255,255,.06);
            border-radius: 3px;
            overflow: hidden
        }

        .sbd-bar {
            height: 100%;
            border-radius: 3px;
            transition: width .6s cubic-bezier(.4,0,.2,1)
        }

        .sbd-val {
            font-size: .60rem;
            color: var(--ink4);
            font-family: var(--mono);
            width: 28px;
            text-align: right
        }

        /* ══════════════════════════════════
           ANNUAL REPORT PANEL
        ══════════════════════════════════ */
        .annual-cta {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 48px 20px;
            text-align: center
        }

        .annual-cta-icon {
            font-size: 2.4rem;
            margin-bottom: 14px;
            opacity: .7
        }

        .annual-cta-title {
            font-size: .92rem;
            font-weight: 700;
            color: var(--ink);
            margin-bottom: 6px
        }

        .annual-cta-sub {
            font-size: .74rem;
            color: var(--ink4);
            max-width: 360px;
            line-height: 1.6;
            margin-bottom: 20px
        }
    </style>
</head>
