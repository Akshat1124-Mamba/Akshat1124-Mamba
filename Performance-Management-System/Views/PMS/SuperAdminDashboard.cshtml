        function setRoleViewFilter(role, filter, btn) {
          _roleFilters[role] = filter;
          var panelId = role === 'emp' ? 'employee' : role;
          document.querySelectorAll('#panel-' + panelId + ' .rtab').forEach(function(b){ b.classList.remove('active'); });
          if (btn) btn.classList.add('active');
          renderRoleTable(role);
        }

        function renderRoleTable(role) {
          var cfg  = ROLE_CFG[role];
          var filt = _roleFilters[role] || 'all';
          var searchId = role === 'emp' ? 'emp-search' : role + '-search';
          var q = ((document.getElementById(searchId)||{}).value||'').toLowerCase();
          var all = filteredByYear(_allMappings);

          var pending = all.filter(function(m){ return m.status === cfg.pendingStatus; });
          var done    = all.filter(function(m){ return cfg.doneStatuses.indexOf(m.status) >= 0; });

          setText(role + '-cnt-all', all.length);
          setText(role + '-cnt-p',   pending.length);
          setText(role + '-cnt-d',   done.length);

          var rows = all.filter(function(m){
            if (filt === 'pending' && m.status !== cfg.pendingStatus) return false;
            if (filt === 'done' && cfg.doneStatuses.indexOf(m.status) < 0) return false;
            if (q && (m.empName||'').toLowerCase().indexOf(q)<0 && (m.empCode||'').toLowerCase().indexOf(q)<0) return false;
            return true;
          });

          var tbodyId = role === 'emp' ? 'emp-tbody' : role + '-tbody';
          var tbody = document.getElementById(tbodyId);
          if (!tbody) return;
          if (!rows.length) { tbody.innerHTML = '<tr><td colspan="10" class="tbl-empty">No records.</td></tr>'; return; }

          tbody.innerHTML = rows.map(function(m, i){
            var reviewerVal = cfg.reviewerCol ? (m[cfg.reviewerCol]||'—') : '';
            return '<tr>' +
              '<td class="dim mono">' + (i+1) + '</td>' +
              '<td style="font-weight:600;white-space:nowrap">' + esc(m.empName) + '</td>' +
              '<td class="mono">' + esc(m.empCode) + '</td>' +
              '<td style="font-size:.70rem">' + esc(m.department) + '</td>' +
              (cfg.reviewerCol ? '<td style="font-size:.68rem;color:var(--ink4)">' + esc(reviewerVal) + '</td>' : '') +
              '<td><span class="cycle-chip">' + esc(m.appraisalCycle||'—') + '</span></td>' +
              '<td class="mono">' + (m.appraisalYear||'—') + '</td>' +
              '<td class="mono" style="text-align:center">' + (m.kpiCount||0) + '</td>' +
              '<td>' + statusPill(m.status) + '</td>' +
              '<td><div class="link-btns">' +
                cfg.actionLink(m) +
                '<a href="/Pms/PrintAppraisal?mappingId=' + m.mappingId + '" class="lb lb-print" target="_blank">📄</a>' +
                '<a href="/Pms/RmAppraisal?mappingId=' + m.mappingId + '" class="lb lb-rm" target="_blank" title="SA: Open as RM">📋</a>' +
              '</div></td>' +
            '</tr>';
          }).join('');
        }

        /* ══════════════════════════════════
           MASTERS TABLE
        ══════════════════════════════════ */
        function renderMastersTable() {
          var q = (document.getElementById('masters-search').value||'').toLowerCase();
          var all = filteredByYear(_masterMappings);
          var rows = all.filter(function(m){
            return !q ||
              (m.empName||'').toLowerCase().indexOf(q)>=0 ||
              (m.empCode||'').toLowerCase().indexOf(q)>=0 ||
              (m.department||'').toLowerCase().indexOf(q)>=0 ||
              (m.designation||'').toLowerCase().indexOf(q)>=0;
          });
          setText('cnt-masters', all.length);
          var tbody = document.getElementById('masters-tbody');
          if (!tbody) return;
          if (!rows.length) { tbody.innerHTML = '<tr><td colspan="13" class="tbl-empty">No master mappings found.</td></tr>'; return; }
          tbody.innerHTML = rows.map(function(m, i){
            return '<tr>' +
              '<td class="dim mono">' + (i+1) + '</td>' +
              '<td style="font-weight:600;white-space:nowrap">' + esc(m.empName) + '</td>' +
              '<td class="mono">' + esc(m.empCode) + '</td>' +
              '<td style="font-size:.70rem">' + esc(m.department) + '</td>' +
              '<td style="font-size:.68rem;color:var(--ink3)">' + esc(m.designation) + '</td>' +
              '<td class="mono">' + (m.appraisalYear||'—') + '</td>' +
              '<td><span class="reviewer-chip">' + esc(m.rmName||'—') + '</span></td>' +
              '<td><span class="reviewer-chip">' + esc(m.hodName||'—') + '</span></td>' +
              '<td><span class="reviewer-chip">' + esc(m.unitHeadName||'—') + '</span></td>' +
              '<td><span class="reviewer-chip">' + esc(m.jmdName||'—') + '</span></td>' +
              '<td class="mono" style="text-align:center">' + (m.kpiCount||0) + '</td>' +
              '<td style="font-size:.62rem;color:var(--ink4);font-family:var(--mono)">' + esc(m.lastUpdatedAt||'—') + '</td>' +
              '<td><a href="/Pms/Index?tab=3" target="_blank" class="lb lb-hod">✏️ Edit</a></td>' +
            '</tr>';
          }).join('');
        }

        /* ══════════════════════════════════
           STATUS PILL
        ══════════════════════════════════ */
        function statusPill(status) {
          var MAP = {
            'Draft':                ['pill-draft','Draft'],
            'EmployeeFilled':       ['pill-emp','👤 Emp Filled'],
            'RMReview':             ['pill-rm','📋 RM Review'],
            'HODReview':            ['pill-hod','🏛 HOD Review'],
            'UnitHeadReview':       ['pill-uh','🏢 UH Review'],
            'ModCommitteeReview':   ['pill-mc','🏅 MC Review'],
            'JMDReview':            ['pill-jmd','⭐ JMD Review'],
            'HRFinalized':          ['pill-hr','✅ Finalized'],
            'Master':               ['pill-draft','🗄 Master']
          };
          var pair = MAP[status] || ['pill-draft', esc(status)];
          return '<span class="pill ' + pair[0] + '">' + pair[1] + '</span>';
        }

        /* ══════════════════════════════════
           HELPERS
        ══════════════════════════════════ */
        function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
        function setText(id,val){var el=document.getElementById(id);if(el)el.textContent=val;}
        function setSbCount(id,val){var el=document.getElementById(id);if(el)el.textContent=val;}
        function setRvCard(id,total,pending,label){
          var el=document.getElementById(id);if(el)el.textContent=total;
          var ep=document.getElementById(id+'-p');
          if(ep)ep.textContent=pending>0?'⏳ '+pending+' '+label:'✔ All up to date';
        }

        /* ══════════════════════════════════
           BOOT
        ══════════════════════════════════ */
        loadAllData();
    </script>
</body>
</html>
