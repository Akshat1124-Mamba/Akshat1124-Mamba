    <script>
        /* ══════════════════════════════════
           DATA STORE
        ══════════════════════════════════ */
        var _allMappings   = [];
        var _masterMappings = [];
        var _loadedOnce    = {};
        var _pipelineFilter = 'all';
        var _roleFilters   = { emp:'all', rm:'all', hod:'all', uh:'all', mc:'all', jmd:'all' };
        var _activePanel   = 'overview';
        var _globalYear    = 0;

        var PANEL_META = {
          overview: { title:'Command Center',              sub:'Full visibility · All appraisal workflows' },
          process:  { title:'Full Process View',           sub:'Lifecycle from initialization to HR sign-off' },
          pipeline: { title:'Live Appraisal Pipeline',     sub:'Every appraisal · All statuses · All employees' },
          employee: { title:'Employee Self-Appraisal View',sub:'View any employee\'s appraisal as SuperAdmin' },
          rm:       { title:'Reporting Manager View',      sub:'All RM-stage appraisals across the organisation' },
          hod:      { title:'Head of Department View',     sub:'All HOD-stage appraisals' },
          uh:       { title:'Unit Head View',              sub:'All UH-stage appraisals' },
          mc:       { title:'Moderation Committee View',   sub:'MC-stage appraisals' },
          jmd:      { title:'JMD Review View',             sub:'Final approval · All JMD-stage appraisals' },
          masters:  { title:'Master KPI Mappings',         sub:'Base employee–KPI configurations' },
          annual:   { title:'Annual Appraisal Report',     sub:'Scores, ratings and increment summary' }
        };

        /* ══════════════════════════════════
           NAVIGATION
        ══════════════════════════════════ */
        function showPanel(name, sidebarLink) {
          document.querySelectorAll('.panel').forEach(function(p){ p.classList.remove('active'); });
          var el = document.getElementById('panel-' + name);
          if (el) el.classList.add('active');

          document.querySelectorAll('.sb-link').forEach(function(l){ l.classList.remove('active'); });
          if (sidebarLink) sidebarLink.classList.add('active');

          var meta = PANEL_META[name] || {};
          document.getElementById('topbar-heading').textContent = meta.title || name;
          document.getElementById('topbar-sub').textContent = meta.sub || '';
          _activePanel = name;

          if (!_loadedOnce[name]) {
            _loadedOnce[name] = true;
            switch(name) {
              case 'process':  renderProcessView();       break;
              case 'pipeline': renderPipelineTable();     break;
              case 'employee': renderRoleTable('emp');    break;
              case 'rm':       renderRoleTable('rm');     break;
              case 'hod':      renderRoleTable('hod');    break;
              case 'uh':       renderRoleTable('uh');     break;
              case 'mc':       renderRoleTable('mc');     break;
              case 'jmd':      renderRoleTable('jmd');    break;
              case 'masters':  renderMastersTable();      break;
            }
          }
        }

        /* ══════════════════════════════════
           YEAR FILTER
        ══════════════════════════════════ */
        function globalYearChanged() {
          _globalYear = parseInt(document.getElementById('globalYearFilter').value) || 0;
          buildOverview();
          _loadedOnce = { overview: true };
          if (_activePanel !== 'overview') {
            _loadedOnce[_activePanel] = true;
            switch(_activePanel) {
              case 'process':  renderProcessView();       break;
              case 'pipeline': renderPipelineTable();     break;
              case 'employee': renderRoleTable('emp');    break;
              case 'rm':       renderRoleTable('rm');     break;
              case 'hod':      renderRoleTable('hod');    break;
              case 'uh':       renderRoleTable('uh');     break;
              case 'mc':       renderRoleTable('mc');     break;
              case 'jmd':      renderRoleTable('jmd');    break;
              case 'masters':  renderMastersTable();      break;
            }
          }
        }

        function filteredByYear(list) {
          if (!_globalYear) return list;
          return list.filter(function(m){
            return m.appraisalYear === _globalYear || m.AppraisalYear === _globalYear;
          });
        }

        /* ══════════════════════════════════
           LOAD ALL DATA
        ══════════════════════════════════ */
        function loadAllData() {
          Promise.all([
            fetch('/Pms/GetAppraisalMappingsJson').then(function(r){ return r.json(); }),
            fetch('/Pms/GetAllMappingsJson').then(function(r){ return r.json(); })
          ]).then(function(results) {
            _allMappings    = Array.isArray(results[0]) ? results[0] : [];
            _masterMappings = Array.isArray(results[1]) ? results[1] : [];

            // Populate year dropdown
            var years = [...new Set(_allMappings.map(function(m){ return m.appraisalYear || m.AppraisalYear; }).filter(Boolean))].sort().reverse();
            var sel = document.getElementById('globalYearFilter');
            years.forEach(function(y){
              var o = document.createElement('option');
              o.value = y; o.textContent = 'FY ' + y + '-' + String(y+1).slice(-2);
              sel.appendChild(o);
            });
            buildOverview();
          }).catch(function(e){ console.error('Load error', e); });
        }

        /* ══════════════════════════════════
           OVERVIEW
        ══════════════════════════════════ */
        function buildOverview() {
          var all = filteredByYear(_allMappings);
          var total   = all.length;
          var draft   = all.filter(function(m){ return m.status === 'Draft'; }).length;
          var efilled = all.filter(function(m){ return m.status === 'EmployeeFilled'; }).length;
          var rmrev   = all.filter(function(m){ return m.status === 'RMReview'; }).length;
          var hodrev  = all.filter(function(m){ return m.status === 'HODReview'; }).length;
          var uhrev   = all.filter(function(m){ return m.status === 'UnitHeadReview'; }).length;
          var mcrev   = all.filter(function(m){ return m.status === 'ModCommitteeReview'; }).length;
          var jmdrev  = all.filter(function(m){ return m.status === 'JMDReview'; }).length;
          var hrfin   = all.filter(function(m){ return m.status === 'HRFinalized'; }).length;
          var inprog  = total - draft - hrfin;
          var masters = filteredByYear(_masterMappings).length;

          setText('ov-total', total);
          setText('ov-draft', draft);
          setText('ov-inprogress', inprog);
          setText('ov-finalized', hrfin);
          setText('ov-rm',   efilled);
          setText('ov-hod',  rmrev);
          setText('ov-uh',   hodrev);
          setText('ov-masters', masters);

          // Sidebar counts
          setSbCount('cnt-process',  total);
          setSbCount('cnt-pipeline', total);
          setSbCount('cnt-emp',  total);
          setSbCount('cnt-rm',   efilled);
          setSbCount('cnt-hod',  rmrev);
          setSbCount('cnt-uh',   hodrev);
          setSbCount('cnt-mc',   mcrev);
          setSbCount('cnt-jmd',  jmdrev);
          setSbCount('cnt-masters', masters);

          setRvCard('rv-emp', total, draft,   'awaiting self-appraisal');
          setRvCard('rv-rm',  total, efilled, 'waiting RM review');
          setRvCard('rv-hod', total, rmrev,   'waiting HOD review');
          setRvCard('rv-uh',  total, hodrev,  'waiting UH review');
          setRvCard('rv-mc',  total, uhrev,   'at Mod. Committee');
          setRvCard('rv-jmd', total, mcrev,   'pending JMD sign-off');

          // Completion ring
          var pct = total > 0 ? Math.round(hrfin / total * 100) : 0;
          setText('pr-pct', pct + '%');
          setText('pr-detail', hrfin + ' / ' + total + ' complete');
          var circ = 188.5;
          var offset = circ - (pct / 100 * circ);
          var circle = document.getElementById('pr-circle');
          if (circle) { setTimeout(function(){ circle.style.strokeDashoffset = offset; circle.style.transition = 'stroke-dashoffset 1s cubic-bezier(.4,0,.2,1)'; }, 200); }

          // Mini stage breakdown bars
          buildStageBreakdown([
            { label:'Draft',          count:draft,   color:'#64748b', max:total },
            { label:'Emp Filled',     count:efilled, color:'#3b82f6', max:total },
            { label:'RM Review',      count:rmrev,   color:'#f59e0b', max:total },
            { label:'HOD Review',     count:hodrev,  color:'#14b8a6', max:total },
            { label:'UH Review',      count:uhrev,   color:'#8b5cf6', max:total },
            { label:'MC Review',      count:mcrev,   color:'#b45309', max:total },
            { label:'JMD Review',     count:jmdrev,  color:'#f43f5e', max:total },
            { label:'HR Finalized',   count:hrfin,   color:'#10b981', max:total }
          ], total);

          buildFunnel([
            { label:'Draft / Not Started', count:draft,   color:'#64748b' },
            { label:'Employee Filled',     count:efilled, color:'#3b82f6' },
            { label:'RM Review',           count:rmrev,   color:'#f59e0b' },
            { label:'HOD Review',          count:hodrev,  color:'#14b8a6' },
            { label:'UH Review',           count:uhrev,   color:'#8b5cf6' },
            { label:'Mod. Committee',      count:mcrev,   color:'#f59e0b' },
            { label:'JMD Review',          count:jmdrev,  color:'#f43f5e' },
            { label:'HR Finalized',        count:hrfin,   color:'#10b981' }
          ], total);

          buildAlerts(draft, efilled, rmrev, hodrev, uhrev, mcrev, jmdrev, hrfin, total);
        }

        function buildStageBreakdown(stages, total) {
          var el = document.getElementById('stage-breakdown');
          if (!el) return;
          if (!total) { el.innerHTML = ''; return; }
          el.innerHTML = stages.filter(function(s){ return s.count > 0; }).map(function(s){
            var w = Math.round(s.count / total * 100);
            return '<div class="sbd-row">' +
              '<div class="sbd-label">' + esc(s.label) + '</div>' +
              '<div class="sbd-bar-wrap"><div class="sbd-bar" style="width:' + w + '%;background:' + s.color + '"></div></div>' +
              '<div class="sbd-val">' + s.count + '</div>' +
            '</div>';
          }).join('');
        }

        function buildFunnel(stages, total) {
          var el = document.getElementById('funnel-chart');
          if (!el) return;
          if (!total) { el.innerHTML = '<div class="tbl-empty">No data yet</div>'; return; }
          el.innerHTML = stages.map(function(s){
            var pct = total > 0 ? Math.round(s.count / total * 100) : 0;
            var w = Math.max(s.count > 0 ? 5 : 0, pct);
            return '<div class="funnel-row">' +
              '<div class="funnel-lbl">' + esc(s.label) + '</div>' +
              '<div class="funnel-bar-wrap"><div class="funnel-bar" style="width:' + w + '%;background:' + s.color + '">' +
                (s.count > 0 ? s.count : '') + '</div></div>' +
              '<div class="funnel-pct">' + pct + '%</div>' +
            '</div>';
          }).join('');
        }

        function buildAlerts(draft, ef, rm, hod, uh, mc, jmd, fin, total) {
          var el = document.getElementById('alerts-section');
          if (!el) return;
          var alerts = [];
          if (draft > 0) alerts.push({ type:'danger', icon:'🔴', title: draft + ' employees haven\'t started', sub:'Self-appraisal still pending' });
          if (ef > 0)   alerts.push({ type:'warn',   icon:'🟡', title: ef + ' waiting for RM review', sub:'Employees submitted, RM not acted' });
          if (rm > 0)   alerts.push({ type:'info',   icon:'🔵', title: rm + ' waiting for HOD', sub:'RM done, HOD review pending' });
          if (hod > 0)  alerts.push({ type:'info',   icon:'🔵', title: hod + ' waiting for Unit Head', sub:'HOD done, UH review pending' });
          if (uh > 0)   alerts.push({ type:'info',   icon:'🔵', title: uh + ' waiting for MC', sub:'UH done, MC review pending' });
          if (mc > 0)   alerts.push({ type:'info',   icon:'🔵', title: mc + ' waiting for JMD', sub:'MC done, JMD approval pending' });
          if (fin > 0)  alerts.push({ type:'success',icon:'✅', title: fin + ' fully finalized', sub:'HR has closed these appraisals' });
          if (!alerts.length) alerts.push({ type:'success', icon:'🎉', title:'All appraisals on track', sub:'No critical blockers detected' });
          el.innerHTML = alerts.map(function(a){
            return '<div class="alert-item ' + a.type + '">' +
              '<span class="alert-icon">' + a.icon + '</span>' +
              '<div><div class="alert-title">' + esc(a.title) + '</div>' +
              '<div class="alert-sub">' + esc(a.sub) + '</div></div>' +
            '</div>';
          }).join('');
        }

        /* ══════════════════════════════════
           FULL PROCESS VIEW
        ══════════════════════════════════ */
        var STAGES_CFG = [
          { key:'Init',              label:'Cycle Init',      icon:'🚀', color:'#64748b', desc:'Cycle created, employee assigned' },
          { key:'Draft',             label:'Self-Appraisal',  icon:'👤', color:'#3b82f6', desc:'Employee filling KPIs & self-ratings' },
          { key:'EmployeeFilled',    label:'RM Review',       icon:'📋', color:'#f59e0b', desc:'RM reviewing submitted appraisal' },
          { key:'RMReview',          label:'HOD Review',      icon:'🏛', color:'#14b8a6', desc:'HOD provides department-level input' },
          { key:'HODReview',         label:'UH Review',       icon:'🏢', color:'#8b5cf6', desc:'Unit Head strategic review' },
          { key:'UnitHeadReview',    label:'MC Review',       icon:'🏅', color:'#f5a623', desc:'Moderation Committee calibration' },
          { key:'ModCommitteeReview',label:'JMD Approval',    icon:'⭐', color:'#f43f5e', desc:'JMD final sign-off' },
          { key:'JMDReview',         label:'HR Finalized',    icon:'✅', color:'#10b981', desc:'Appraisal closed by HR' },
          { key:'HRFinalized',       label:'Archived',        icon:'🗄', color:'#475569', desc:'Permanently recorded' }
        ];

        function renderProcessView() {
          var all = filteredByYear(_allMappings);
          var counts = {};
          all.forEach(function(m){ counts[m.status] = (counts[m.status]||0)+1; });

          var stagesCont = document.getElementById('process-stages');
          if (!stagesCont) return;

          var stageHTML = STAGES_CFG.map(function(s, i){
            var cnt = s.key === 'Init' ? all.length : (counts[s.key]||0);
            var isPast = s.key === 'HRFinalized';
            return '<div class="ps-item" onclick="filterProcessDetail(\'' + s.key + '\')">' +
              '<div class="ps-dot-wrap">' +
                '<div class="ps-dot" style="background:' + s.color + ';border-color:' + s.color + '">' + (i+1) + '</div>' +
              '</div>' +
              '<div class="ps-label">' + s.icon + ' ' + esc(s.label) + '</div>' +
              '<div class="ps-count" style="color:' + s.color + '">' + cnt + '</div>' +
            '</div>' +
            (i < STAGES_CFG.length - 1 ? '<div style="flex-shrink:0;height:2px;width:18px;background:rgba(255,255,255,.1);margin-top:17px"></div>' : '');
          }).join('');
          stagesCont.innerHTML = stageHTML;

          // Build per-stage detail cards
          buildProcessDetailCards(all, counts);
        }

        function buildProcessDetailCards(all, counts) {
          var cont = document.getElementById('process-detail-cards');
          if (!cont) return;

          var activeStatuses = ['Draft','EmployeeFilled','RMReview','HODReview','UnitHeadReview','ModCommitteeReview','JMDReview'];
          var html = '';

          activeStatuses.forEach(function(status){
            var items = all.filter(function(m){ return m.status === status; });
            if (!items.length) return;
            var cfg = STAGES_CFG.find(function(s){ return s.key === status; }) || {};
            html += '<div class="card" id="pdc-' + status + '">' +
              '<div class="card-head">' +
                '<div>' +
                  '<div class="card-title">' + (cfg.icon||'') + ' ' + esc(cfg.label||status) + ' — ' + items.length + ' appraisals</div>' +
                  '<div class="card-sub">' + esc(cfg.desc||'') + '</div>' +
                '</div>' +
                '<span class="pill" style="background:rgba(0,0,0,.2);border:1px solid rgba(255,255,255,.1);color:rgba(255,255,255,.5);font-size:.58rem">' + items.length + ' pending</span>' +
              '</div>' +
              '<div class="tbl-wrap"><table class="sa-tbl"><thead><tr>' +
                '<th>#</th><th>Employee</th><th>Code</th><th>Department</th>' +
                '<th>Cycle</th><th>Year</th><th>KPIs</th><th>Actions</th>' +
              '</tr></thead><tbody>' +
              items.slice(0,10).map(function(m, i){
                return '<tr>' +
                  '<td class="dim mono">' + (i+1) + '</td>' +
                  '<td style="font-weight:600">' + esc(m.empName) + '</td>' +
                  '<td class="mono">' + esc(m.empCode) + '</td>' +
                  '<td>' + esc(m.department) + '</td>' +
                  '<td><span class="cycle-chip">' + esc(m.appraisalCycle||'—') + '</span></td>' +
                  '<td class="mono">' + (m.appraisalYear||'—') + '</td>' +
                  '<td class="mono" style="text-align:center">' + (m.kpiCount||0) + '</td>' +
                  '<td>' + allRoleLinks(m) + '</td>' +
                '</tr>';
              }).join('') +
              (items.length > 10 ? '<tr><td colspan="8" style="text-align:center;padding:10px;font-size:.68rem;color:var(--ink4)">+ ' + (items.length-10) + ' more — use Live Pipeline for full list</td></tr>' : '') +
              '</tbody></table></div></div>';
          });

          // Finalized summary
          var fin = all.filter(function(m){ return m.status === 'HRFinalized'; });
          if (fin.length) {
            html += '<div class="card" style="border-color:rgba(16,185,129,.2)">' +
              '<div class="card-head">' +
                '<div><div class="card-title">✅ HR Finalized — ' + fin.length + ' appraisals complete</div>' +
                '<div class="card-sub">These appraisals have been closed and archived by HR</div></div>' +
                '<a href="/Pms/GetAnnualReport" target="_blank" class="btn-sm gold">View Annual Report ↗</a>' +
              '</div>' +
              '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:8px">' +
              fin.slice(0,12).map(function(m){
                return '<div style="background:rgba(16,185,129,.06);border:1px solid rgba(16,185,129,.15);border-radius:8px;padding:10px 12px">' +
                  '<div style="font-weight:600;font-size:.74rem;color:var(--ink)">' + esc(m.empName) + '</div>' +
                  '<div style="font-size:.62rem;color:var(--ink4);margin-top:2px">' + esc(m.department) + ' · ' + (m.appraisalYear||'—') + '</div>' +
                  '<div style="margin-top:6px"><a href="/Pms/PrintAppraisal?mappingId=' + m.mappingId + '" class="lb lb-print" target="_blank">📄 Print</a></div>' +
                '</div>';
              }).join('') +
              (fin.length > 12 ? '<div style="display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:8px;padding:10px;font-size:.68rem;color:var(--ink4)">+ ' + (fin.length-12) + ' more</div>' : '') +
              '</div></div>';
          }

          if (!html) html = '<div class="card"><div class="tbl-empty">No appraisals in active stages.</div></div>';
          cont.innerHTML = html;
        }

        /* ══════════════════════════════════
           PIPELINE TABLE
        ══════════════════════════════════ */
        function setPipelineFilter(f, btn) {
          _pipelineFilter = f;
          document.querySelectorAll('#pipeline-status-tabs .rtab').forEach(function(b){ b.classList.remove('active'); });
          btn.classList.add('active');
          renderPipelineTable();
        }

        function renderPipelineTable() {
          var q = (document.getElementById('pipeline-search').value || '').toLowerCase();
          var all = filteredByYear(_allMappings);
          var cnts = {};
          all.forEach(function(m){ cnts[m.status] = (cnts[m.status]||0)+1; });

          setText('pf-all',   all.length);
          setText('pf-draft', cnts['Draft']||0);
          setText('pf-ef',    cnts['EmployeeFilled']||0);
          setText('pf-rm',    cnts['RMReview']||0);
          setText('pf-hod',   cnts['HODReview']||0);
          setText('pf-uh',    cnts['UnitHeadReview']||0);
          setText('pf-mc',    cnts['ModCommitteeReview']||0);
          setText('pf-jmd2',  cnts['JMDReview']||0);
          setText('pf-fin',   cnts['HRFinalized']||0);

          var rows = all.filter(function(m){
            if (_pipelineFilter !== 'all' && m.status !== _pipelineFilter) return false;
            if (q && (m.empName||'').toLowerCase().indexOf(q) < 0 &&
                     (m.empCode||'').toLowerCase().indexOf(q) < 0 &&
                     (m.department||'').toLowerCase().indexOf(q) < 0) return false;
            return true;
          });

          var tbody = document.getElementById('pipeline-tbody');
          if (!rows.length) { tbody.innerHTML = '<tr><td colspan="10" class="tbl-empty">No records match this filter.</td></tr>'; return; }
          tbody.innerHTML = rows.map(function(m, i){
            return '<tr>' +
              '<td class="dim mono">' + (i+1) + '</td>' +
              '<td style="font-weight:600;white-space:nowrap">' + esc(m.empName) + '</td>' +
              '<td class="mono">' + esc(m.empCode) + '</td>' +
              '<td style="font-size:.70rem">' + esc(m.department) + '</td>' +
              '<td><span class="cycle-chip">' + esc(m.appraisalCycle||'—') + '</span></td>' +
              '<td class="mono">' + (m.appraisalYear||'—') + '</td>' +
              '<td class="mono" style="text-align:center">' + (m.kpiCount||0) + '</td>' +
              '<td>' + pipelineDots(m.status) + '</td>' +
              '<td>' + statusPill(m.status) + '</td>' +
              '<td>' + allRoleLinks(m) + '</td>' +
            '</tr>';
          }).join('');
        }

        function pipelineDots(status) {
          var STAGES = ['Draft','EmployeeFilled','RMReview','HODReview','UnitHeadReview','ModCommitteeReview','JMDReview','HRFinalized'];
          var LABELS = ['E','R','H','U','M','J','✓'];
          var idx = STAGES.indexOf(status);
          var out = '<div class="pipeline">';
          for (var i = 0; i < 7; i++) {
            var cls = i < idx ? 'done' : (i === idx ? 'now' : 'wait');
            out += '<div class="pipe-dot ' + cls + '" title="' + STAGES[i+1] + '">' + LABELS[i] + '</div>';
            if (i < 6) out += '<div class="pipe-line ' + (i < idx ? 'done' : '') + '"></div>';
          }
          return out + '</div>';
        }

        function allRoleLinks(m) {
          var mid = m.mappingId;
          return '<div class="link-btns">' +
            '<a href="/Pms/MyAppraisal?mappingId=' + mid + '" class="lb lb-emp" target="_blank">👤</a>' +
            '<a href="/Pms/RmAppraisal?mappingId=' + mid + '" class="lb lb-rm" target="_blank">📋</a>' +
            '<a href="/Pms/HodAppraisal?mappingId=' + mid + '" class="lb lb-hod" target="_blank">🏛</a>' +
            '<a href="/Pms/UnitHeadAppraisal?mappingId=' + mid + '" class="lb lb-uh" target="_blank">🏢</a>' +
            '<a href="/Pms/ModCommitteeAppraisal?mappingId=' + mid + '" class="lb lb-mc" target="_blank">🏅</a>' +
            '<a href="/Pms/JmdAppraisal?mappingId=' + mid + '" class="lb lb-jmd" target="_blank">⭐</a>' +
            '<a href="/Pms/PrintAppraisal?mappingId=' + mid + '" class="lb lb-print" target="_blank">📄</a>' +
          '</div>';
        }

