<script>
/* ═══════════════════════════════════════════════════════════════
   DATA — serialised from server
   ═══════════════════════════════════════════════════════════════ */
var _data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.Select(r => new {
        id           = r.MappingId,
        empId        = r.EmpId,
        empCode      = r.EmpCode,
        empName      = r.EmpName,
        department   = r.Department,
        designation  = r.Designation,
        unitHead     = r.UnitName       ?? "",
        unitHeadName = r.UnitHeadName   ?? "",
        doj          = r.DateOfJoining.HasValue
                           ? r.DateOfJoining.Value.ToString("dd-MMM-yyyy")
                           : "—",
        finalScore   = r.FinalScore,
        calcRating   = r.CalcRating,
        ratingLabel  = r.RatingLabel,
        basePercent  = r.BasePercent,
        hikeOverBase = r.HikeOverBase,
        finalIncrPct = r.FinalIncrPct,
        baCompleted  = r.BehaviouralCompleted,
        jmdRemark    = r.JmdRemark ?? "",
        mcRating     = (object)r.McRating,
        jmdRating    = (object)r.JmdRating
    })
));

/* Rating-version lookup table */
var _ratingVersionRows = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    activeVersion?.DetailRows?.Select(d => new {
        rating              = d.Rating,
        ratingLabel         = d.RatingLabel,
        hikeOverBasePercent = d.HikeOverBasePercent
    }) ?? Enumerable.Empty<object>()
));

var _fyLabel    = '@(Model.FirstOrDefault()?.AppraisalYear)-@((Model.FirstOrDefault()?.AppraisalYear+1)%100)';
var _effDate    = '01-Apr-@(Model.FirstOrDefault()?.AppraisalYear+1 ?? DateTime.Now.Year+1)';
var _totalCount = _data.length;

/* ═══════════════════════════════════════════════════════════════
   PER-ROW RUNTIME STATE
   ═══════════════════════════════════════════════════════════════ */
var _rowState = {};
_data.forEach(function (r) {
    var mcEl  = document.getElementById('mc_'  + r.id);
    var jmdEl = document.getElementById('jmd_' + r.id);

    var savedMc  = (mcEl  && mcEl.value  !== '') ? parseFloat(mcEl.value)  : null;
    var savedJmd = (jmdEl && jmdEl.value !== '') ? parseFloat(jmdEl.value) : null;

    r.mcRating  = savedMc;
    r.jmdRating = savedJmd;

    _rowState[r.id] = {
        pmsSelf : null, pmsRM : null, pmsHOD : null, pmsUH : null,
        pmsAvg  : r.finalScore,
        baRM    : null, baHOD : null, baAvg  : null,
        wtRating     : r.finalScore,
        mcRating     : savedMc,
        jmdRating    : savedJmd,
        finalRating  : null,
        finalIncrPct : 0,
        gross        : 0,
        incrAmt      : 0,
        revGross     : 0
    };
});

/* ═══════════════════════════════════════════════════════════════
   DEBOUNCED SAVE
   ═══════════════════════════════════════════════════════════════ */
var _saveTimers = {};
function scheduleSave(id) {
    clearTimeout(_saveTimers[id]);
    _saveTimers[id] = setTimeout(function () { persistMcJmd(id); }, 800);
}
function persistMcJmd(id) {
    var state = _rowState[id];
    if (!state) return;
    if (state.mcRating === null && state.jmdRating === null) return;
    var payload = { mappingId: id, mcRating: state.mcRating !== null ? state.mcRating : null, jmdRating: state.jmdRating !== null ? state.jmdRating : null };
    fetch('/Pms/SaveMcJmdRatings', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) })
        .then(function (r) { return r.json(); })
        .then(function (res) {
            if (!res.success) console.warn('[PMS Annual] SaveMcJmdRatings failed id=' + id, res.message);
        })
        .catch(function (err) { console.warn('[PMS Annual] SaveMcJmdRatings network error id=' + id, err); });
}

/* ═══════════════════════════════════════════════════════════════
   MATH HELPERS
   ═══════════════════════════════════════════════════════════════ */
function _clampRating(rawRating) {
    if (rawRating === null || rawRating === undefined || isNaN(rawRating)) return null;
    return Math.min(5, Math.max(1, Math.round(parseFloat(rawRating))));
}
function getHikeForRating(rawRating) {
    var r = _clampRating(rawRating);
    if (r === null || !_ratingVersionRows || !_ratingVersionRows.length) return 0;
    var match = _ratingVersionRows.find(function (d) { return d.rating === r; });
    return match ? match.hikeOverBasePercent : 0;
}
function computeIncrPct(rawRating, basePercent) {
    if (!basePercent || basePercent <= 0) return 0;
    var hike   = getHikeForRating(rawRating);
    var result = basePercent * (1 + hike / 100);
    return Math.round(result * 10000) / 10000;
}

/* ═══════════════════════════════════════════════════════════════
   SELECTION STATE
   ═══════════════════════════════════════════════════════════════ */
var _selectedIds = new Set();

function onRowChkChange() {
    _selectedIds.clear();
    document.querySelectorAll('.emp-chk').forEach(function (c) {
        var tr = c.closest('tr');
        if (c.checked) { _selectedIds.add(parseInt(c.dataset.id)); tr.classList.add('row-selected'); }
        else           { tr.classList.remove('row-selected'); }
    });
    updateSelectionUI();
}

function toggleSelectAll(checked) {
    document.getElementById('selectAllChk').checked = checked;
    _selectedIds.clear();
    document.querySelectorAll('.emp-chk').forEach(function (c) {
        var tr = c.closest('tr');
        if (!tr || tr.style.display === 'none') return;
        c.checked = checked;
        if (checked) { _selectedIds.add(parseInt(c.dataset.id)); tr.classList.add('row-selected'); }
        else          { tr.classList.remove('row-selected'); }
    });
    updateSelectionUI();
}

function clearSelection() { toggleSelectAll(false); }

function updateSelectionUI() {
    var count     = _selectedIds.size;
    var badge     = document.getElementById('selCountBadge');
    var exportBtn = document.getElementById('selExportBtn');
    var printSelBtn = document.getElementById('btnPrintSel');
    badge.textContent = count + ' selected';
    badge.classList.toggle('visible', count > 0);
    exportBtn.disabled = count === 0;
    if (printSelBtn) printSelBtn.classList.toggle('visible', count > 0);

    var visibleTotal = 0;
    document.querySelectorAll('.emp-chk').forEach(function (c) {
        if (c.closest('tr') && c.closest('tr').style.display !== 'none') visibleTotal++;
    });
    var selAllChk           = document.getElementById('selectAllChk');
    selAllChk.indeterminate = count > 0 && count < visibleTotal;
    selAllChk.checked       = count === visibleTotal && visibleTotal > 0;
}

/* ═══════════════════════════════════════════════════════════════
   PRINT — supports printing selected rows only
   ═══════════════════════════════════════════════════════════════ */
function printReport(selectedOnly) {
    if (selectedOnly && _selectedIds.size === 0) {
        alert('Please select at least one employee to print.');
        return;
    }

    // Collect which employee IDs to print
    var printIds = selectedOnly ? new Set(_selectedIds) : null;

    // Apply print-hidden class to rows that should NOT be printed
    var allDrRows = document.querySelectorAll('tr.dr');
    allDrRows.forEach(function (tr) {
        var id = parseInt(tr.dataset.id);
        if (printIds && !printIds.has(id)) {
            tr.classList.add('print-hidden');
        } else {
            tr.classList.remove('print-hidden');
        }
    });

    // Also hide dept group rows that have no visible employees
    var dgRows = document.querySelectorAll('tr.dg');
    dgRows.forEach(function (dg) {
        var dept = dg.dataset.dept;
        var hasVisible = false;
        allDrRows.forEach(function (tr) {
            if (tr.dataset.dept === dept && !tr.classList.contains('print-hidden')) {
                hasVisible = true;
            }
        });
        if (!hasVisible) {
            dg.classList.add('print-hidden');
        } else {
            dg.classList.remove('print-hidden');
        }
    });

    window.print();

    // Restore after print
    setTimeout(function () {
        document.querySelectorAll('.print-hidden').forEach(function (el) {
            el.classList.remove('print-hidden');
        });
    }, 1000);
}

/* ═══════════════════════════════════════════════════════════════
   CORE CALC: calcFinal(id, silent)
   ═══════════════════════════════════════════════════════════════ */
function calcFinal(id, silent) {
    var mcEl  = document.getElementById('mc_'  + id);
    var jmdEl = document.getElementById('jmd_' + id);
    if (!mcEl || !jmdEl) return;

    var mcVal  = mcEl.value  !== '' ? parseFloat(mcEl.value)  : null;
    var jmdVal = jmdEl.value !== '' ? parseFloat(jmdEl.value) : null;

    var state = _rowState[id];
    if (!state) return;

    state.mcRating  = mcVal;
    state.jmdRating = jmdVal;

    var rec = _data.find(function (r) { return r.id == id; });
    if (!rec) return;

    // ── JMD rating is mandatory. MC input alone must NEVER drive
    //    Final Rating / Incr % / increment amounts. ──
    if (jmdVal === null || isNaN(jmdVal)) {
        state.finalRating  = null;
        state.finalIncrPct = 0;

        var frateEl = document.getElementById('frate_' + id);
        if (frateEl) {
            frateEl.textContent    = mcVal !== null ? '⏳ Awaiting JMD' : '—';
            frateEl.style.fontSize = '.62rem';
            frateEl.style.color    = '#c2410c';
        }
        var fincrEl = document.getElementById('fincrpct_' + id);
        if (fincrEl) { fincrEl.textContent = '—'; fincrEl.style.color = ''; }

        calcIncrement(id);
        if (!silent) scheduleSave(id);
        return;
    }

    var effectiveRating = jmdVal;
    state.finalRating = effectiveRating;

    var basePercent = rec.basePercent || 0;
    var incrPct = 0;
    if (basePercent > 0 && effectiveRating > 0) {
        incrPct = computeIncrPct(effectiveRating, basePercent);
    }
    state.finalIncrPct = incrPct;

    var frateEl = document.getElementById('frate_' + id);
    if (frateEl) {
        var cr = _clampRating(effectiveRating);
        if (cr !== null) {
            var ratingRow = _ratingVersionRows.find(function (d) { return d.rating === cr; });
            var lbl = ratingRow ? ratingRow.ratingLabel : ('Rating ' + cr);
            frateEl.textContent    = cr + ' – ' + lbl;
            frateEl.style.fontSize = '.68rem';
            frateEl.style.color    = '';
        } else {
            frateEl.textContent = '—';
        }
    }

    var fincrEl = document.getElementById('fincrpct_' + id);
    if (fincrEl) {
        if (incrPct > 0) { fincrEl.textContent = incrPct.toFixed(4) + '%'; fincrEl.style.color = '#34d399'; }
        else              { fincrEl.textContent = '—'; }
    }

    calcIncrement(id);
    if (!silent) scheduleSave(id);
}
/* ═══════════════════════════════════════════════════════════════
   SALARY CALC
   ═══════════════════════════════════════════════════════════════ */
function calcIncrement(id) {
    var gValEl = document.getElementById('gross_' + id + '_val');
    var iEl = document.getElementById('incr_'  + id);
    var rEl = document.getElementById('rev_'   + id);
    if (!gValEl || !iEl || !rEl) return;
    var state = _rowState[id];
    if (!state) return;

    var gross = parseFloat(gValEl.value) || 0;
    state.gross = gross;

    // No increment can be finalised without a JMD rating.
    if (state.finalRating == null) {
        state.incrAmt  = 0;
        state.revGross = 0;
        iEl.textContent = '⏳ Awaiting JMD';
        rEl.textContent = '⏳ Awaiting JMD';
        updateTotals();
        return;
    }

    var pct = state.finalIncrPct || 0;
    var amt = (gross > 0 && pct > 0) ? Math.round(gross * pct / 100) : 0;
    state.incrAmt  = amt;
    state.revGross = gross + amt;
    iEl.textContent = gross > 0 && amt > 0 ? '₹' + amt.toLocaleString('en-IN') : gross > 0 ? '₹0' : '—';
    rEl.textContent = gross > 0 ? '₹' + (gross + amt).toLocaleString('en-IN') : '—';
    updateTotals();
}

function updateTotals() {
    var tg = 0, ti = 0, any = false;
    _data.forEach(function (r) {
        var s = _rowState[r.id];
        if (s && s.gross > 0) { any = true; tg += s.gross; ti += s.incrAmt; }
    });
    var totG = document.getElementById('totGross');
    var totI = document.getElementById('totIncr');
    if (totG) totG.textContent = any ? '₹' + Math.round(tg).toLocaleString('en-IN') : '₹—';
    if (totI) totI.textContent = any ? '₹' + Math.round(ti).toLocaleString('en-IN') : '₹—';
}

