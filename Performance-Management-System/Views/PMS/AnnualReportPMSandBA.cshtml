@using vgl.Models
@model List<AnnualReportRow>
@{
    Layout = null;
    var activeVersion = ViewBag.ActiveVersion as PasRatingVersionRow;

    string RatingBg(int r) => r switch {
        5 => "#fef3c7", 4 => "#eff4ff", 3 => "#f1f4f9", 2 => "#fff1f2", 1 => "#fff1f2", _ => "#f1f4f9"
    };
    string RatingTxt(int r) => r switch {
        5 => "#92400e", 4 => "#1e4ed8", 3 => "#334155", 2 => "#e11d48", 1 => "#be123c", _ => "#334155"
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Annual Increment Report — Vandana Global Limited</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet"/>
<script src="https://cdn.jsdelivr.net/npm/xlsx-js-style@1.2.0/dist/xlsx.bundle.js"></script>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
    --navy:#0f1c3f;--navy2:#1a2d5a;--navy3:#253d75;
    --cobalt:#1e4ed8;--cobalt-lt:#eff4ff;--cobalt-md:#c7d7fd;
    --gold:#d97706;--gold-lt:#fef3c7;
    --emerald:#059669;--emerald-lt:#d1fae5;
    --rose:#e11d48;--rose-lt:#fff1f2;--violet:#7c3aed;
    --bg:#f0f4fa;--bg2:#e8edf7;--white:#ffffff;
    --border:#d8e0ef;--border2:#e8edf7;
    --ink:#0f172a;--ink2:#334155;--ink3:#64748b;--ink4:#94a3b8;
    --font:'Plus Jakarta Sans','Segoe UI',system-ui,sans-serif;
    --mono:'JetBrains Mono','Courier New',monospace;
    --shadow:0 2px 12px rgba(15,28,63,.07);
    --shadow-md:0 4px 20px rgba(15,28,63,.10);
    --shadow-lg:0 8px 40px rgba(15,28,63,.14);
    --radius:10px;--radius-lg:14px;--radius-xl:18px;
    --sel-blue:#2563eb;

    --pms-bg:#f0fdf4;--pms-border:#a7f3d0;--pms-hdr:#065f46;--pms-avg:#d1fae5;
    --ba-bg:#eff6ff;--ba-border:#93c5fd;--ba-hdr:#1e40af;--ba-avg:#dbeafe;
    --wt-bg:#fef9c3;--wt-border:#fde047;--wt-hdr:#854d0e;
    --mc-bg:#fff7ed;--mc-border:#fdba74;--mc-hdr:#9a3412;
    --jmd-bg:#fdf2f8;--jmd-border:#f9a8d4;--jmd-hdr:#831843;
    --fin-bg:#1e3a6e;--fin-txt:#f8fafc;
}
body{font-family:var(--font);background:var(--bg);color:var(--ink);font-size:13px;min-height:100vh;-webkit-font-smoothing:antialiased}

/* ══ TOOLBAR ══ */
.toolbar{position:sticky;top:0;z-index:600;background:var(--navy);padding:0 24px;display:flex;align-items:center;gap:10px;height:58px;box-shadow:0 2px 20px rgba(15,28,63,.35);flex-wrap:wrap}
.toolbar-logo{display:flex;align-items:center;gap:10px;flex:1;min-width:0}
.logo-badge{width:34px;height:34px;border-radius:9px;background:linear-gradient(135deg,#3b82f6,#4f46e5);display:flex;align-items:center;justify-content:center;font-size:15px;color:#fff;font-weight:800;flex-shrink:0;letter-spacing:-.5px}
.toolbar-title{font-size:.80rem;font-weight:700;color:#fff;letter-spacing:.01em;white-space:nowrap}
.toolbar-sub{font-size:.60rem;color:rgba(255,255,255,.4);margin-top:1px;letter-spacing:.07em;text-transform:uppercase}
.toolbar-actions{display:flex;gap:7px;align-items:center;flex-shrink:0}
.btn{display:inline-flex;align-items:center;gap:6px;height:34px;padding:0 15px;border-radius:8px;font-family:var(--font);font-size:.74rem;font-weight:700;cursor:pointer;border:none;transition:all .15s;white-space:nowrap;text-decoration:none}
.btn-close{background:rgba(255,255,255,.1);color:rgba(255,255,255,.75);border:1px solid rgba(255,255,255,.14)}
.btn-close:hover{background:rgba(255,255,255,.18);color:#fff}
.btn-print{background:var(--cobalt);color:#fff;box-shadow:0 2px 8px rgba(30,78,216,.3)}
.btn-print:hover{background:#1740bf}
.btn-excel{background:linear-gradient(135deg,#15803d,#059669);color:#fff;box-shadow:0 2px 8px rgba(5,150,105,.3)}
.btn-excel:hover{background:linear-gradient(135deg,#166534,#047857)}
.search-wrap{display:flex;align-items:center;background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.15);border-radius:8px;overflow:hidden}
.search-wrap input{height:34px;background:none;border:none;outline:none;padding:0 12px;font-family:var(--font);font-size:.78rem;color:#fff;width:200px}
.search-wrap input::placeholder{color:rgba(255,255,255,.35)}

/* ══ SELECTION CONTROL BAR ══ */
.sel-bar{background:var(--white);border-bottom:1.5px solid var(--border);padding:0 24px;height:46px;display:flex;align-items:center;gap:14px;position:sticky;top:58px;z-index:500;box-shadow:0 2px 8px rgba(15,28,63,.06)}
.sel-chk-wrap{display:flex;align-items:center;gap:8px;cursor:pointer;user-select:none}
.sel-chk-wrap input[type=checkbox]{width:16px;height:16px;accent-color:var(--sel-blue);cursor:pointer;flex-shrink:0}
.sel-chk-label{font-size:.75rem;font-weight:700;color:var(--ink2)}
.sel-count-badge{background:var(--cobalt-lt);border:1.5px solid var(--cobalt-md);color:var(--cobalt);font-family:var(--mono);font-size:.62rem;font-weight:700;border-radius:20px;padding:2px 11px;display:none}
.sel-count-badge.visible{display:inline-flex}
.sel-divider{width:1px;height:22px;background:var(--border)}
.sel-action-btn{display:inline-flex;align-items:center;gap:5px;height:28px;padding:0 12px;border-radius:7px;font-size:.72rem;font-weight:700;cursor:pointer;border:none;font-family:var(--font);transition:all .15s}
.sel-act-export{background:var(--emerald-lt);color:var(--emerald);border:1.5px solid #a7f3d0}
.sel-act-export:hover{background:#a7f3d0}
.sel-act-export:disabled{opacity:.4;cursor:not-allowed}
.sel-act-clear{background:var(--bg2);color:var(--ink3);border:1.5px solid var(--border)}
.sel-act-clear:hover{background:var(--border);color:var(--ink2)}
.sel-bar-right{margin-left:auto;font-size:.70rem;color:var(--ink3)}
.sel-bar-right strong{font-family:var(--mono);color:var(--ink2)}

/* Print selected button */
.btn-print-sel{background:linear-gradient(135deg,#7c3aed,#6d28d9);color:#fff;box-shadow:0 2px 8px rgba(124,58,237,.3);display:none}
.btn-print-sel.visible{display:inline-flex}
.btn-print-sel:hover{background:linear-gradient(135deg,#6d28d9,#5b21b6)}

/* ══ PAGE ══ */
.page{max-width:1800px;margin:0 auto;padding:24px 24px 80px}

/* ══ LETTERHEAD ══ */
.letterhead{background:linear-gradient(135deg,var(--navy) 0%,#162550 60%,#1e3a6e 100%);border-radius:var(--radius-xl);padding:26px 32px;margin-bottom:20px;display:flex;align-items:center;gap:24px;flex-wrap:wrap;position:relative;overflow:hidden}
.letterhead::before{content:'';position:absolute;inset:0;background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.025'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E") repeat;pointer-events:none}
.lh-badge{width:62px;height:62px;border-radius:15px;flex-shrink:0;background:linear-gradient(135deg,#3b82f6,#4f46e5);display:flex;align-items:center;justify-content:center;font-size:28px;color:#fff;font-weight:800;box-shadow:0 6px 20px rgba(79,70,229,.45);letter-spacing:-1px;position:relative;z-index:1}
.lh-text{position:relative;z-index:1}
.lh-company{font-size:1.05rem;font-weight:800;color:#fff;letter-spacing:.05em;text-transform:uppercase}
.lh-sub{font-size:.62rem;color:rgba(255,255,255,.42);letter-spacing:.12em;text-transform:uppercase;margin-top:4px}
.lh-right{margin-left:auto;text-align:right;position:relative;z-index:1}
.lh-doc-type{font-size:.88rem;font-weight:800;color:#f59e0b;letter-spacing:.06em;text-transform:uppercase;margin-bottom:4px}
.lh-meta{font-size:.64rem;color:rgba(255,255,255,.48);font-family:var(--mono);line-height:1.8}

/* ══ STATS ══ */
.stats{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:20px}
.stat{background:var(--white);border:1.5px solid var(--border);border-radius:var(--radius-lg);padding:16px 20px;display:flex;align-items:center;gap:14px;box-shadow:var(--shadow);transition:border-color .15s,box-shadow .15s;position:relative;overflow:hidden}
.stat:hover{border-color:var(--cobalt-md);box-shadow:var(--shadow-md)}
.stat::after{content:'';position:absolute;top:0;left:0;right:0;height:3px;border-radius:var(--radius-lg) var(--radius-lg) 0 0}
.s-blue::after{background:var(--cobalt)}.s-green::after{background:var(--emerald)}.s-gold::after{background:var(--gold)}.s-navy::after{background:var(--navy)}.s-violet::after{background:var(--violet)}
.stat-icon{font-size:1.5rem;flex-shrink:0}
.stat-val{font-size:1.6rem;font-weight:800;color:var(--navy);font-family:var(--mono);line-height:1}
.stat-lbl{font-size:.65rem;color:var(--ink3);margin-top:4px;font-weight:600;text-transform:uppercase;letter-spacing:.04em}

/* ══ NOTICE / FORMULA ══ */
.notice{background:#fffbeb;border:1.5px solid #fde68a;border-left:3px solid var(--gold);border-radius:var(--radius);padding:10px 16px;margin-bottom:14px;font-size:.75rem;color:#92400e;display:flex;align-items:center;gap:9px}
.formula-box{background:var(--cobalt-lt);border:1.5px solid var(--cobalt-md);border-radius:var(--radius);padding:11px 18px;margin-bottom:18px;font-size:.74rem;color:#1e3a6e;line-height:1.8;display:flex;align-items:center;gap:14px;flex-wrap:wrap}

/* ══ FILTER BAR ══ */
.filter-bar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:16px}
.fpill{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 13px;border-radius:20px;border:1.5px solid var(--border);background:var(--white);font-size:.71rem;font-weight:700;color:var(--ink3);cursor:pointer;transition:all .15s;font-family:var(--font)}
.fpill:hover{border-color:var(--cobalt-md);color:var(--cobalt);background:var(--cobalt-lt)}
.fpill.active{border-color:var(--cobalt);color:var(--cobalt);background:var(--cobalt-lt)}

/* ══ TABLE CARD ══ */
.tbl-card{background:var(--white);border:1.5px solid var(--border);border-radius:var(--radius-xl);overflow:hidden;box-shadow:var(--shadow-lg);margin-bottom:20px}
.tbl-head{background:linear-gradient(90deg,var(--navy) 0%,var(--navy3) 100%);padding:13px 20px;display:flex;align-items:center;gap:10px}
.tbl-head-title{font-size:.74rem;font-weight:700;color:rgba(255,255,255,.9);font-family:var(--mono);text-transform:uppercase;letter-spacing:.06em}
.rec-badge{font-size:.62rem;font-weight:600;background:rgba(255,255,255,.1);color:rgba(255,255,255,.65);padding:3px 11px;border-radius:20px;font-family:var(--mono);border:1px solid rgba(255,255,255,.15)}
.tbl-scroll{overflow-x:auto}

/* ══ MAIN TABLE ══ */
table.rpt{width:100%;border-collapse:collapse;font-size:.74rem;white-space:nowrap}

table.rpt thead tr.hr1 th{background:#1e3162;color:rgba(255,255,255,.92);padding:9px 10px;font-size:.60rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase;border-right:1px solid rgba(255,255,255,.10);text-align:center;vertical-align:middle}
table.rpt thead tr.hr2 th{padding:7px 10px;font-size:.58rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase;border-right:1px solid rgba(255,255,255,.12);text-align:center;vertical-align:middle;color:#fff}

.hdr-info{background:#162550 !important}
.hdr-pms{background:#065f46 !important}
.hdr-ba{background:#1e3a8a !important}
.hdr-wt{background:#78350f !important}
.hdr-mc{background:#7c2d12 !important}
.hdr-jmd{background:#701a75 !important}
.hdr-fin{background:#1e3a6e !important}
.hdr-misc{background:#1e3162 !important}

table.rpt tbody tr{border-bottom:1px solid var(--border2);transition:background .12s}
table.rpt tbody tr:last-child{border-bottom:none}
table.rpt tbody tr:hover{background:#f5f8ff}
table.rpt tbody tr.row-selected{background:#eff6ff!important;border-left:3px solid var(--sel-blue)}
table.rpt tbody td{padding:9px 10px;color:var(--ink2);border-right:1px solid var(--border2);vertical-align:middle;text-align:center}
table.rpt tbody td.td-left{text-align:left}
table.rpt tbody td.mono{font-family:var(--mono);font-size:.70rem}
table.rpt tbody td.chk-td{text-align:center;padding:9px 6px}
.row-chk{width:15px;height:15px;accent-color:var(--sel-blue);cursor:pointer}

td.pms-cell{background:var(--pms-bg) !important;color:#065f46;font-family:var(--mono);font-weight:600}
td.pms-avg-cell{background:var(--pms-avg) !important;color:#065f46;font-family:var(--mono);font-weight:800;border:1.5px solid var(--pms-border) !important}
td.ba-cell{background:var(--ba-bg) !important;color:#1e40af;font-family:var(--mono);font-weight:600}
td.ba-avg-cell{background:var(--ba-avg) !important;color:#1e40af;font-family:var(--mono);font-weight:800;border:1.5px solid var(--ba-border) !important}
td.wt-cell{background:var(--wt-bg) !important;color:#854d0e;font-family:var(--mono);font-weight:800;font-size:.80rem;border:2px solid var(--wt-border) !important}

td.ic{padding:5px 7px;min-width:100px}
.sal-inp{height:32px;width:100%;background:var(--cobalt-lt);border:1.5px solid var(--cobalt-md);border-radius:7px;padding:0 8px;font-family:var(--mono);font-size:.76rem;color:var(--ink);outline:none;transition:all .15s}
.sal-inp:focus{border-color:var(--cobalt);background:var(--white);box-shadow:0 0 0 3px rgba(30,78,216,.1)}
.sal-inp.last-inp{background:#f0fdf4;border-color:#a7f3d0}
.sal-inp.last-inp:focus{border-color:var(--emerald);box-shadow:0 0 0 3px rgba(5,150,105,.1)}

.mc-inp{height:32px;width:72px;background:var(--mc-bg);border:1.5px solid var(--mc-border);border-radius:7px;padding:0 6px;font-family:var(--mono);font-size:.80rem;color:#9a3412;font-weight:700;outline:none;text-align:center;transition:all .15s}
.mc-inp:focus{border-color:#ea580c;background:#fff;box-shadow:0 0 0 3px rgba(234,88,12,.12)}
.jmd-inp{height:32px;width:72px;background:var(--jmd-bg);border:1.5px solid var(--jmd-border);border-radius:7px;padding:0 6px;font-family:var(--mono);font-size:.80rem;color:#831843;font-weight:700;outline:none;text-align:center;transition:all .15s}
.jmd-inp:focus{border-color:#db2777;background:#fff;box-shadow:0 0 0 3px rgba(219,39,119,.12)}

td.cc{font-family:var(--mono);font-weight:700;font-size:.78rem;text-align:right}
td.cc.incr{background:var(--cobalt-lt);color:var(--cobalt)}
td.cc.rev{background:#f0fdf4;color:var(--emerald)}

td.fin-rating{background:#1e3a6e !important;color:#f59e0b !important;font-family:var(--mono);font-weight:800;font-size:.84rem}
td.fin-incr{background:#1e3a6e !important;color:#34d399 !important;font-family:var(--mono);font-weight:700}

.rat-badge{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:7px;font-weight:700;font-family:var(--mono);font-size:.78rem}
.score-badge{display:inline-flex;align-items:center;justify-content:center;padding:3px 9px;border-radius:20px;font-family:var(--mono);font-weight:700;font-size:.72rem;background:var(--cobalt-lt);color:var(--cobalt);border:1px solid var(--cobalt-md)}
.ba-done{background:var(--emerald-lt);color:var(--emerald);border:1px solid #a7f3d0;border-radius:12px;padding:2px 9px;font-size:.60rem;font-weight:700;font-family:var(--mono)}
.ba-pend{background:#fff7ed;color:#c2410c;border:1px solid #fed7aa;border-radius:12px;padding:2px 9px;font-size:.60rem;font-weight:700;font-family:var(--mono)}

td.sig{min-width:100px;padding:7px 10px;vertical-align:bottom}
.sig-line{border-bottom:1.5px solid var(--ink3);height:26px;margin-bottom:3px;width:85px}
.sig-lbl{font-size:.58rem;color:var(--ink4)}

.empty td{padding:52px;text-align:center;color:var(--ink4)}
.empty-icon{font-size:2.5rem;display:block;margin-bottom:14px;opacity:.3}

tr.dg td{background:linear-gradient(90deg,var(--bg2),var(--white))!important;color:var(--navy)!important;font-weight:800!important;font-size:.68rem;letter-spacing:.07em;text-transform:uppercase;border-top:2px solid var(--cobalt-md)!important;padding:7px 12px!important;border-left:3px solid var(--cobalt)!important}

.rating-legend{background:var(--white);border:1.5px solid var(--border);border-radius:var(--radius-lg);padding:18px 22px;margin-bottom:18px;box-shadow:var(--shadow)}
.rating-legend-title{font-size:.62rem;font-weight:800;letter-spacing:.10em;text-transform:uppercase;color:var(--ink3);margin-bottom:14px;border-left:3px solid var(--cobalt);padding-left:10px}

.legend-bar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}
.legend-pill{display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:8px;font-size:.66rem;font-weight:700}

.sig-footer{display:flex;gap:20px;margin-top:24px;padding-top:20px;border-top:1.5px solid var(--border);flex-wrap:wrap}
.sig-block{flex:1;min-width:130px;text-align:center}
.sig-block-line{height:1px;background:var(--ink3);margin-bottom:8px}
.sig-block-name{font-size:.70rem;font-weight:700;color:var(--ink3);letter-spacing:.05em;text-transform:uppercase}
.sig-block-date{font-size:.60rem;color:var(--ink4);margin-top:3px}

.tbl-footer{background:var(--navy);padding:13px 20px;display:flex;align-items:center;gap:24px;flex-wrap:wrap}
.tfl{font-size:.60rem;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:.07em}
.tfv{font-family:var(--mono);font-size:.90rem;font-weight:700;color:#fff}

.avg-box{display:inline-flex;align-items:center;justify-content:center;padding:3px 10px;border-radius:8px;font-family:var(--mono);font-weight:800;font-size:.80rem}
.avg-box-pms{background:var(--pms-avg);color:#065f46;border:1.5px solid var(--pms-border)}
.avg-box-ba{background:var(--ba-avg);color:#1e40af;border:1.5px solid var(--ba-border)}
.avg-box-wt{background:var(--wt-bg);color:#854d0e;border:2px solid var(--wt-border)}

/* ══ PRINT STYLES ══ */
@@media print{
    body{background:#fff;font-size:10px}
    .toolbar,.notice,.filter-bar,.sel-bar{display:none!important}
    .page{padding:0;max-width:none}
    .tbl-card{box-shadow:none!important;border:1px solid #ccc!important;overflow:visible!important}
    .tbl-scroll{overflow:visible!important}
    table.rpt{width:100%!important;table-layout:fixed!important;font-size:6.5px!important;white-space:normal!important;word-break:break-word}
    table.rpt thead tr th{padding:4px!important;font-size:6px!important;white-space:normal!important}
    table.rpt tbody td{padding:4px!important;font-size:6.5px!important;white-space:normal!important}
    .mc-inp,.jmd-inp,.sal-inp{border:none!important;background:transparent!important;box-shadow:none!important;font-size:6px!important;padding:0!important}
    .no-print{display:none!important}
    .tbl-footer{display:none!important}
    .chk-td,.chk-th{display:none!important}
    /* Hide non-selected rows when printing selected */
    .print-hidden{display:none!important}
}
@@page{size:landscape;margin:6mm}

/* ── 2-row employee layout ── */
table.rpt tbody tr.pms-tr td { border-bottom: 0 !important; }
table.rpt tbody tr.ba-tr td  { border-bottom: 1px solid var(--border2); }
table.rpt tbody tr.ba-tr:hover, table.rpt tbody tr.pms-tr:hover { background: #f5f8ff; }
table.rpt tbody tr.ba-tr[style*="display: none"] { display: none !important; }
</style>
</head>
<body>

<!-- ══ TOOLBAR ══ -->
<div class="toolbar">
    <div class="toolbar-logo">
        <div class="logo-badge">VG</div>
        <div>
            <div class="toolbar-title">Vandana Global Limited — Annual Increment Report</div>
            <div class="toolbar-sub">PMS &amp; Behavioural Audit — Annual Appraisal Cycle</div>
        </div>
    </div>
    <div class="search-wrap no-print">
        <input type="text" id="rptSearch" placeholder="🔍 Search employee, dept…" oninput="filterTable()"/>
    </div>
    <div class="toolbar-actions">
        <button type="button" class="btn btn-close no-print" onclick="window.close()">✕ Close</button>
        <button type="button" class="btn btn-excel no-print" id="toolbarExcelBtn" onclick="exportExcel(false)">
