    sumWs[XLSX.utils.encode_cell({ r: SR, c: 2 })] = sumCell('', false, LTGREEN, INKTEXT, 10, 'left');
    sumWs[XLSX.utils.encode_cell({ r: SR, c: 3 })] = sumCell('', false, LTGREEN, INKTEXT, 10, 'left');
    sumWs[XLSX.utils.encode_cell({ r: SR, c: 1 })].z = '#,##0'; SR++;

    sumWs[XLSX.utils.encode_cell({ r: SR, c: 0 })] = sumCell('Total Revised Gross',   true,  BG2,    INKTEXT, 10, 'left');
    sumWs[XLSX.utils.encode_cell({ r: SR, c: 1 })] = sumCell((tg2+ti2)||0, true, 'FFFEF9C3', 'FF854D0E', 11, 'right');
    sumWs[XLSX.utils.encode_cell({ r: SR, c: 2 })] = sumCell('', false, 'FFFEF9C3', INKTEXT, 10, 'left');
    sumWs[XLSX.utils.encode_cell({ r: SR, c: 3 })] = sumCell('', false, 'FFFEF9C3', INKTEXT, 10, 'left');
    sumWs[XLSX.utils.encode_cell({ r: SR, c: 1 })].z = '#,##0'; SR++;

    sumWs['!ref']    = XLSX.utils.encode_range({ s: { r: 0, c: 0 }, e: { r: SR, c: SUM_COLS } });
    sumWs['!merges'] = sumMerges;
    sumWs['!cols']   = [{ wch: 30 }, { wch: 20 }, { wch: 12 }, { wch: 12 }];
    sumWs['!rows']   = [{ hpx: 36 }, { hpx: 22 }, { hpx: 18 }, { hpx: 8 }];

    XLSX.utils.book_append_sheet(wb, sumWs, 'Summary');

    /* ════════════════════════════════════
       SHEET 3: Dept Summary (fully styled)
       ════════════════════════════════════ */
    var deptWs = {};
    var DR = 0;
    var DEPT_COLS = 5;

    function deptCell(v, bold, bg, color, sz, hz, numFmt) {
        var t = (typeof v === 'number') ? 'n' : 's';
        if (v === '' || v === null || v === undefined) { v = ''; t = 's'; }
        return {
            v: v, t: t,
            s: {
                font      : { name: 'Verdana', sz: sz || 10, bold: !!bold, color: { rgb: color || INKTEXT } },
                fill      : { patternType: 'solid', fgColor: { rgb: bg || WHITE } },
                alignment : { horizontal: hz || 'left', vertical: 'center', wrapText: false },
                border    : thinBorder
            },
            z: numFmt || undefined
        };
    }

    var deptMerges = [];

    /* Title */
    for (var c = 0; c <= DEPT_COLS; c++) deptWs[XLSX.utils.encode_cell({ r: DR, c: c })] = deptCell(c===0 ? 'VANDANA GLOBAL LIMITED — DEPARTMENT WISE SUMMARY' : '', true, NAVY, WHITE, 14, 'center');
    deptMerges.push({ s: { r: DR, c: 0 }, e: { r: DR, c: DEPT_COLS } }); DR++;
    for (var c = 0; c <= DEPT_COLS; c++) deptWs[XLSX.utils.encode_cell({ r: DR, c: c })] = deptCell(c===0 ? 'Financial Year: ' + _fyLabel + '  |  Effective: ' + _effDate : '', false, NAVY2, 'FFB0C4DE', 9, 'center');
    deptMerges.push({ s: { r: DR, c: 0 }, e: { r: DR, c: DEPT_COLS } }); DR++;
    for (var c = 0; c <= DEPT_COLS; c++) deptWs[XLSX.utils.encode_cell({ r: DR, c: c })] = deptCell('', false, BG2, INKTEXT, 8, 'left');
    deptMerges.push({ s: { r: DR, c: 0 }, e: { r: DR, c: DEPT_COLS } }); DR++;

    /* Column headers */
    var deptHdrs = ['Department', 'Employees', 'Avg PMS Score', 'Avg Incr %', 'BA Done', 'BA Pending'];
    var deptHdrBgs = [NAVY2, COBALT, PMS_HDR, WT_HDR, 'FF065F46', 'FF9A3412'];
    deptHdrs.forEach(function(h, ci) {
        deptWs[XLSX.utils.encode_cell({ r: DR, c: ci })] = deptCell(h, true, deptHdrBgs[ci], WHITE, 10, 'center');
    });
    DR++;

    /* Data rows */
    deptOrder.forEach(function(dept, idx) {
        var dr2 = deptMap[dept];
        var ds = dr2.reduce(function(s,r){return s+r.finalScore;},0) / dr2.length;
        var da = dr2.filter(function(r){ return (_rowState[r.id]||{}).finalIncrPct > 0; });
        var dp = da.length ? da.reduce(function(s,r){return s+((_rowState[r.id]||{}).finalIncrPct||0);},0)/da.length : 0;
        var baDone    = dr2.filter(function(r){return  r.baCompleted;}).length;
        var baPending = dr2.filter(function(r){return !r.baCompleted;}).length;
        var rowBg = idx % 2 === 0 ? WHITE : BG2;

        deptWs[XLSX.utils.encode_cell({ r: DR, c: 0 })] = deptCell(dept,                          true,  rowBg,   NAVY,    10, 'left');
        deptWs[XLSX.utils.encode_cell({ r: DR, c: 1 })] = deptCell(dr2.length,                    true,  LTBLUE2, NAVY2,   11, 'center');
        deptWs[XLSX.utils.encode_cell({ r: DR, c: 2 })] = deptCell(parseFloat(ds.toFixed(2)),     true,  PMS_BG,  'FF065F46', 10, 'center');
        deptWs[XLSX.utils.encode_cell({ r: DR, c: 3 })] = deptCell(dp ? parseFloat(dp.toFixed(4)) : 0, true, WT_BG, 'FF854D0E', 10, 'center');
        deptWs[XLSX.utils.encode_cell({ r: DR, c: 4 })] = deptCell(baDone,                        true,  LTGREEN, 'FF065F46', 10, 'center');
        deptWs[XLSX.utils.encode_cell({ r: DR, c: 5 })] = deptCell(baPending,                     true,  baPending>0?'FFFFF7ED':LTGREEN, baPending>0?'FF9A3412':'FF065F46', 10, 'center');
        DR++;
    });

    /* Totals row */
    var totalEmps = rows.length;
    var totalBaDone = rows.filter(function(r){return r.baCompleted;}).length;
    deptWs[XLSX.utils.encode_cell({ r: DR, c: 0 })] = deptCell('GRAND TOTAL',          true, NAVY, WHITE,     10, 'left');
    deptWs[XLSX.utils.encode_cell({ r: DR, c: 1 })] = deptCell(totalEmps,              true, NAVY, AMBER,     11, 'center');
    deptWs[XLSX.utils.encode_cell({ r: DR, c: 2 })] = deptCell('',                     false,NAVY, WHITE,     10, 'center');
    deptWs[XLSX.utils.encode_cell({ r: DR, c: 3 })] = deptCell('',                     false,NAVY, WHITE,     10, 'center');
    deptWs[XLSX.utils.encode_cell({ r: DR, c: 4 })] = deptCell(totalBaDone,            true, NAVY, EMERALD2,  11, 'center');
    deptWs[XLSX.utils.encode_cell({ r: DR, c: 5 })] = deptCell(totalEmps-totalBaDone,  true, NAVY, 'FFFB923C', 11, 'center');

    deptWs['!ref']    = XLSX.utils.encode_range({ s: { r: 0, c: 0 }, e: { r: DR, c: DEPT_COLS } });
    deptWs['!merges'] = deptMerges;
    deptWs['!cols']   = [{ wch: 28 }, { wch: 12 }, { wch: 14 }, { wch: 14 }, { wch: 10 }, { wch: 12 }];
    deptWs['!rows']   = [{ hpx: 32 }, { hpx: 18 }, { hpx: 8 }];

    XLSX.utils.book_append_sheet(wb, deptWs, 'Dept Summary');

    /* ── Write file ── */
    var d   = new Date();
    var sfx = selectedOnly ? '_Selected' : '_All';
    var fn  = 'VGL_AnnualIncrement_FY' + _fyLabel.replace('-', '_') + sfx + '_'
            + d.getFullYear()
            + ('0' + (d.getMonth() + 1)).slice(-2)
            + ('0' + d.getDate()).slice(-2) + '.xlsx';
    XLSX.writeFile(wb, fn);
}

/* ═══════════════════════════════════════════════════════════════
   AUTO-FETCH GROSS SALARIES
   ═══════════════════════════════════════════════════════════════ */
function loadGrossSalaries() {
    _data.forEach(function (rec) {
        var grossEl    = document.getElementById('gross_' + rec.id);
        var grossValEl = document.getElementById('gross_' + rec.id + '_val');
        if (!grossEl || !grossValEl) return;

        fetch('/Pms/GetEmployeeGrossSalary?empId=' + rec.empId)
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.success && data.gross > 0) {
                    grossValEl.value     = data.gross;
                    grossEl.textContent  = '₹' + Math.round(data.gross).toLocaleString('en-IN');

                    // Show source label
                    var srcEl = document.getElementById('gross_src_' + rec.id);
                    if (srcEl) {
                        srcEl.textContent = data.source === 'increment'
                            ? '✓ From last increment'
                            : '✓ From salary record';
                        srcEl.style.color = data.source === 'increment' ? '#059669' : '#1e4ed8';
                    }

                    calcIncrement(rec.id);
                } else {
                    grossEl.textContent = '—';
                    grossEl.style.color = '#94a3b8';
                    grossEl.style.fontStyle = 'italic';
                }
            })
            .catch(function () {
                grossEl.textContent = '—';
                grossEl.style.color = '#94a3b8';
                grossEl.style.fontStyle = 'italic';
            });
    });
}
</script>
