    var SUM_COLS = 3;

    /* Helper for summary cells */
    function sumCell(v, bold, bg, color, sz, hz) {
        var t = (typeof v === 'number') ? 'n' : 's';
        if (v === '' || v === null || v === undefined) { v = ''; t = 's'; }
        return {
            v: v, t: t,
            s: {
                font      : { name: 'Verdana', sz: sz || 10, bold: !!bold, color: { rgb: color || INKTEXT } },
                fill      : { patternType: 'solid', fgColor: { rgb: bg || WHITE } },
                alignment : { horizontal: hz || 'left', vertical: 'center', wrapText: false },
                border    : thinBorder
            }
        };
    }
    function sumSpan(ws, rn, val, bg, color, sz, bold, cols) {
        ws[XLSX.utils.encode_cell({ r: rn, c: 0 })] = sumCell(val, bold !== false, bg, color, sz, 'center');
        for (var c = 1; c <= (cols || SUM_COLS); c++)
            ws[XLSX.utils.encode_cell({ r: rn, c: c })] = blankCell(bg);
    }
    function sumBlankRow(ws, rn) {
        for (var c = 0; c <= SUM_COLS; c++) ws[XLSX.utils.encode_cell({ r: rn, c: c })] = blankCell(WHITE);
    }
    function sumSectionHdr(ws, rn, label) {
        ws[XLSX.utils.encode_cell({ r: rn, c: 0 })] = sumCell(label, true, NAVY2, WHITE, 10, 'left');
        for (var c = 1; c <= SUM_COLS; c++) ws[XLSX.utils.encode_cell({ r: rn, c: c })] = blankCell(NAVY2);
    }
    function sumRow2(ws, rn, label, value, labelBg, valueBg, valueColor) {
        ws[XLSX.utils.encode_cell({ r: rn, c: 0 })] = sumCell(label, true,  labelBg  || BG2,   INKTEXT,          10, 'left');
        ws[XLSX.utils.encode_cell({ r: rn, c: 1 })] = sumCell(value, true,  valueBg  || WHITE, valueColor || GREEN, 10, 'center');
        ws[XLSX.utils.encode_cell({ r: rn, c: 2 })] = sumCell('',    false, valueBg  || WHITE, INKTEXT,          10, 'left');
        ws[XLSX.utils.encode_cell({ r: rn, c: 3 })] = sumCell('',    false, valueBg  || WHITE, INKTEXT,          10, 'left');
    }

    var sumMerges = [];

