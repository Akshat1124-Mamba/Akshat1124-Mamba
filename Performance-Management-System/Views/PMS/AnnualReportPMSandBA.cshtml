var _deptFilter = 'all';
var _search     = '';

function setFilter(dept, btn) {
    _deptFilter = dept;
    document.querySelectorAll('.fpill').forEach(function (b) { b.classList.remove('active'); });
    if (btn) btn.classList.add('active');
    applyFilters();
}

function filterTable() {
    _search = (document.getElementById('rptSearch').value || '').toLowerCase().trim();
    applyFilters();
}

function applyFilters() {
    var rows = document.querySelectorAll('.dr');
    var grps = document.querySelectorAll('.dg');
    var vis  = 0;
    rows.forEach(function (r) {
        var dm = _deptFilter === 'all' || r.dataset.dept === _deptFilter;
        var sm = !_search ||
            (r.dataset.name || '').indexOf(_search) >= 0 ||
            (r.dataset.code || '').indexOf(_search) >= 0 ||
            (r.dataset.dlc  || '').indexOf(_search) >= 0;
        r.style.display = (dm && sm) ? '' : 'none';
        if (dm && sm) vis++;
    });
    grps.forEach(function (gh) {
        var dept = gh.dataset.dept;
        var hv   = false;
        rows.forEach(function (r) {
            if (r.dataset.dept === dept && r.style.display !== 'none') hv = true;
        });
        gh.style.display = hv ? '' : 'none';
    });
    var vc = document.getElementById('visCount'); if (vc) vc.textContent = vis;
    var tb = document.getElementById('tblBadge'); if (tb) tb.textContent = vis + ' employee(s)';
    updateSelectionUI();
}

/* ═══════════════════════════════════════════════════════════════
   ASYNC LOADERS
   ═══════════════════════════════════════════════════════════════ */
function loadPmsScores() {
    _data.forEach(function (rec) {
        fetch('/Pms/GetPmsScoresForAnnualReport?mappingId=' + rec.id)
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.error) return;
                var id    = rec.id;
                var state = _rowState[id];
                if (!state) return;

                var pmsSelf = data.empScore != null ? Math.round(parseFloat(data.empScore) * 100) / 100 : null;
                var pmsRM   = data.rmScore  != null ? Math.round(parseFloat(data.rmScore)  * 100) / 100 : null;
                var pmsHOD  = data.hodScore != null ? Math.round(parseFloat(data.hodScore) * 100) / 100 : null;
                var pmsUH   = data.uhScore  != null ? Math.round(parseFloat(data.uhScore)  * 100) / 100 : null;

                var bscScore = data.bscScore != null
                    ? Math.round(parseFloat(data.bscScore) * 100) / 100
                    : rec.finalScore;

                state.pmsSelf  = pmsSelf;
                state.pmsRM    = pmsRM;
                state.pmsHOD   = pmsHOD;
                state.pmsUH    = pmsUH;
                state.pmsAvg   = bscScore;
                state.bscScore = bscScore;  // ← store authoritative BSC score

                function setCell(elId, val) {
                    var el = document.getElementById(elId);
                    if (el) el.textContent = val != null ? val.toFixed(2) : '—';
                }
                setCell('pms_self_' + id, pmsSelf);
                setCell('pms_rm_'   + id, pmsRM);
                setCell('pms_hod_'  + id, pmsHOD);
                setCell('pms_uh_'   + id, pmsUH);

                // AVG ▣ box = server bscScore (normalized weighted sum)
                var avgBox = document.getElementById('pms_avg_box_' + id);
                if (avgBox) avgBox.textContent = bscScore.toFixed(2);

                // Also update wt_box immediately with correct bscScore (before BA loads)
                var wtBox = document.getElementById('wt_box_' + id);
                if (wtBox) wtBox.textContent = bscScore.toFixed(2);

                // ── FIXED: pass NO extra args — updateWeighted(id, baAvg)
                //    baAvg comes from state (may be null if BA not loaded yet — that's correct)
                updateWeighted(id, state.baAvg != null ? state.baAvg : null);
            })
            .catch(function () {});
    });
}
function loadBaScores() {
    _data.forEach(function (rec) {
        fetch('/Pms/GetBaScoresForAnnualReport?mappingId=' + rec.id + '&empId=' + (rec.empId || 0))
            .then(function (r) { return r.json(); })
            .then(function (ba) {
                var baRM  = ba.rmScore  != null ? Math.round(ba.rmScore  * 100) / 100 : null;
                var baHOD = ba.hodScore != null ? Math.round(ba.hodScore * 100) / 100 : null;
                var baAvg = null;
                if      (baRM !== null && baHOD !== null) baAvg = Math.round((baRM + baHOD) / 2 * 100) / 100;
                else if (baRM !== null)                   baAvg = baRM;
                else if (baHOD !== null)                  baAvg = baHOD;

                var state = _rowState[rec.id];
                if (state) { state.baRM = baRM; state.baHOD = baHOD; state.baAvg = baAvg; }

                function setBA(elId, val) {
                    var el = document.getElementById(elId);
                    if (el) el.textContent = val != null ? val.toFixed(2) : '—';
                }
                setBA('ba_rm_'  + rec.id, baRM);
                setBA('ba_hod_' + rec.id, baHOD);
                var baAvgBox = document.getElementById('ba_avg_box_' + rec.id);
                if (baAvgBox) baAvgBox.textContent = baAvg != null ? baAvg.toFixed(2) : '—';

                // CRITICAL: always use state.bscScore (server value) — never pmsAvg from _data
                updateWeighted(rec.id, baAvg);
            })
            .catch(function () {});
    });
}
function updateWeighted(id, baAvg) {
    var state = _rowState[id];
    if (!state) return;

    var rec = _data.find(function (r) { return r.id == id; });
    var bsc = 0;
    if (state.bscScore != null && state.bscScore > 0) {
        bsc = state.bscScore;
    } else if (rec && rec.finalScore > 0 && rec.finalScore <= 5) {
        bsc = rec.finalScore;
    }

    if (baAvg != null) state.baAvg = baAvg;

    // ── CHANGE: wt = bscScore only, no BA mixing ──
 var wt;
if (state.baAvg != null && state.baAvg > 0) {
    wt = Math.round((0.8 * bsc + 0.2 * state.baAvg) * 100) / 100;
} else {
    wt = Math.round(bsc * 100) / 100;
}
    state.wtRating = wt;

    var wtBox = document.getElementById('wt_box_' + id);
    if (wtBox) wtBox.textContent = wt > 0 ? wt.toFixed(2) : '—';

    var avgBox = document.getElementById('pms_avg_box_' + id);
    if (avgBox && bsc > 0) avgBox.textContent = bsc.toFixed(2);

    calcFinal(id, true);
}
/* ═══════════════════════════════════════════════════════════════
   INIT
   ═══════════════════════════════════════════════════════════════ */
(function () {
    applyFilters();
    _data.forEach(function (r) { calcFinal(r.id, true); });
    loadPmsScores();
    loadBaScores();
    loadGrossSalaries();
})();

