@using vgl.Models
@model EmpKpiMappingModel
@{
    Layout = null;

    bool isAnnualCycle = (Model.AppraisalCycle ?? "").Trim().Equals("Annual", StringComparison.OrdinalIgnoreCase);

    decimal? GetFinalRating(EmpKpiRow r)
    {
        var vals = new List<decimal>();
        if (r.EmpRating.HasValue) vals.Add(r.EmpRating.Value);
        if (r.RmRating.HasValue) vals.Add(r.RmRating.Value);
        if (r.HodRating.HasValue) vals.Add(r.HodRating.Value);
        if (r.UnitHeadRating.HasValue) vals.Add(r.UnitHeadRating.Value);
        return vals.Any() ? (decimal?)Math.Round(vals.Average(), 2) : null;
    }

    decimal GetWeightedRating(EmpKpiRow r)
    {
        var rt = GetFinalRating(r);
        return rt.HasValue ? Math.Round(r.IndividualWeightage / 100m * rt.Value, 2) : 0m;
    }
    decimal CalcWeighted(EmpKpiRow r, decimal? rating) =>
        rating.HasValue ? Math.Round(r.IndividualWeightage / 100m * rating.Value, 2) : 0m;

    decimal? RowAvgRmHodUh(EmpKpiRow r)
    {
        var vals = new List<decimal>();
        if (r.EmpRating.HasValue) vals.Add(r.EmpRating.Value);
        if (r.RmRating.HasValue) vals.Add(r.RmRating.Value);
        if (r.HodRating.HasValue) vals.Add(r.HodRating.Value);
        if (r.UnitHeadRating.HasValue) vals.Add(r.UnitHeadRating.Value);
        return vals.Any() ? (decimal?)Math.Round(vals.Average(), 2) : null;
    }

    var pmpGroups = Model.KpiRows
        .GroupBy(k => k.PmpId)
        .Select(g => new
        {
            PmpName = g.First().PmpName,
            OvWt = g.First().OverallWeightage,
            Rows = g.ToList()
        }).ToList();

    var _empRows = Model.KpiRows.Where(x => x.EmpRating.HasValue).ToList();
    decimal empScore = _empRows.Any() ? Math.Round(_empRows.Average(x => x.EmpRating!.Value), 2) : 0m;

    var _rmRows = Model.KpiRows.Where(x => x.RmRating.HasValue).ToList();
    decimal rmScore = _rmRows.Any() ? Math.Round(_rmRows.Average(x => x.RmRating!.Value), 2) : 0m;

    var _hodRows = Model.KpiRows.Where(x => x.HodRating.HasValue).ToList();
    decimal hodScore = _hodRows.Any() ? Math.Round(_hodRows.Average(x => x.HodRating!.Value), 2) : 0m;

    var _uhRows = Model.KpiRows.Where(x => x.UnitHeadRating.HasValue).ToList();
    decimal uhScore = _uhRows.Any() ? Math.Round(_uhRows.Average(x => x.UnitHeadRating!.Value), 2) : 0m;

    var filledReviewerScores = new List<decimal>();
    bool empHasAny = Model.KpiRows.Any(r => r.EmpRating.HasValue);
    bool rmHasAny = Model.KpiRows.Any(r => r.RmRating.HasValue);
    bool hodHasAny = Model.KpiRows.Any(r => r.HodRating.HasValue);
    bool uhHasAny = Model.KpiRows.Any(r => r.UnitHeadRating.HasValue);
    if (empHasAny) filledReviewerScores.Add(empScore);
    if (rmHasAny) filledReviewerScores.Add(rmScore);
    if (hodHasAny) filledReviewerScores.Add(hodScore);
    if (uhHasAny) filledReviewerScores.Add(uhScore);

    decimal _totalKpiWt = Model.KpiRows.Sum(r => r.IndividualWeightage);
    decimal bscScore = (_totalKpiWt > 0)
        ? Math.Round(Model.KpiRows.Sum(r =>
        {
            var _rt = GetFinalRating(r);
            if (!_rt.HasValue) return 0m;
            return Math.Round((r.IndividualWeightage / _totalKpiWt) * _rt.Value, 4);
        }), 2)
        : 0m;

    decimal? GetPreMcRating(EmpKpiRow r) =>
        r.UnitHeadRating ?? r.HodRating ?? r.RmRating ?? r.EmpRating;
    decimal preModScore = Math.Round(Model.KpiRows.Sum(r => CalcWeighted(r, GetPreMcRating(r))), 2);

    decimal? mcOverallRating = ViewBag.McOverallRating as decimal?;
    decimal? jmdOverallRating = ViewBag.JmdOverallRating as decimal?;
    string mcOverallRemarks = ViewBag.McOverallRemarks as string ?? "";
    string jmdOverallRemarks = ViewBag.JmdOverallRemarks as string ?? "";

    bool behAuditExists = ViewBag.BehaviouralAuditExists != null && (bool)ViewBag.BehaviouralAuditExists;
    bool behAuditCompleted = ViewBag.BehaviouralAuditCompleted != null && (bool)ViewBag.BehaviouralAuditCompleted;
    decimal behScore = ViewBag.BehaviouralScore != null ? (decimal)ViewBag.BehaviouralScore : 0m;

    // ── TRUE weighted rating using the formula ──
    decimal weightedRating = behAuditCompleted && behScore > 0
        ? Math.Round(0.8m * bscScore + 0.2m * behScore, 2)
        : Math.Round(bscScore, 2);

    decimal pmsWeightedComponent = Math.Round(bscScore * 0.8m, 2);
    decimal baWeightedComponent = behAuditCompleted ? Math.Round(behScore * 0.2m, 2) : 0m;

    decimal finalScore = weightedRating;

    var yearlyPAT = ViewBag.YearlyPAT as PasYearlyPATEntryRow;
    var activeVersion = ViewBag.ActiveRatingVersion as PasRatingVersionRow;

    decimal? printMcRating = ViewBag.McOverallRating as decimal?;
    decimal? printJmdRating = ViewBag.JmdOverallRating as decimal?;

    decimal basePercent = yearlyPAT?.BasePercentage ?? 0m;
    decimal patPercent = yearlyPAT?.PATRevenuePercentDirect ?? yearlyPAT?.PATRevenuePercent ?? 0m;

    string fyRaw = yearlyPAT?.FinancialYear ?? $"{Model.AppraisalYear}-{((Model.AppraisalYear + 1) % 100):D2}";
    string fyLabel = $"FY {fyRaw}";
    int nextYear = Model.AppraisalYear + 1;

    DateTime? defaultIncrDate = Model.CycleToDate;
    string incrDateStr = defaultIncrDate.HasValue
        ? defaultIncrDate.Value.ToString("dd-MMM-yyyy")
        : $"01-Apr-{nextYear}";
    string incrDateIso = defaultIncrDate.HasValue
        ? defaultIncrDate.Value.ToString("yyyy-MM-dd")
        : $"{nextYear}-04-01";

    decimal effectiveRatingForHike = printJmdRating.HasValue ? printJmdRating.Value
                                   : printMcRating.HasValue ? printMcRating.Value
                                   : finalScore;

    int calcRating = (int)Math.Min(5, Math.Max(1, Math.Round(effectiveRatingForHike)));
    decimal hikeOverBase = 0m;
    string ratingLabel = $"Rating {calcRating}";

    if (activeVersion?.DetailRows != null)
    {
        var dr2 = activeVersion.DetailRows.FirstOrDefault(d => d.Rating == calcRating);
        if (dr2 != null) { hikeOverBase = dr2.HikeOverBasePercent; ratingLabel = dr2.RatingLabel; }
    }

    decimal finalIncrPct = basePercent > 0
        ? Math.Round(basePercent * (1m + hikeOverBase / 100m), 4)
        : 0m;

    string cycleInfo = "";
    if (!string.IsNullOrWhiteSpace(Model.AppraisalCycle))
    {
        cycleInfo = Model.AppraisalCycle;
        if (Model.CycleFromDate.HasValue)
            cycleInfo += $" ({Model.CycleFromDate.Value:dd-MMM-yyyy} – {(Model.CycleToDate.HasValue ? Model.CycleToDate.Value.ToString("dd-MMM-yyyy") : "—")})";
    }

    string Fmt(decimal? v, string def = "—") => v.HasValue ? v.Value.ToString("0.##") : def;
    string FmtW(decimal v) => v == 0m ? "—" : v.ToString("0.##");

    string finalAuthority = jmdOverallRating.HasValue ? "JMD Overall"
                              : mcOverallRating.HasValue ? "MC Overall"
                              : "BSC Cascade";
    decimal finalDisplayValue = jmdOverallRating.HasValue ? jmdOverallRating.Value
                              : mcOverallRating.HasValue ? mcOverallRating.Value
                              : finalScore;

    string subDeptDisplay = string.IsNullOrWhiteSpace(Model.SubDepartment) ? "—" : Model.SubDepartment;

    // Total KPI row count for BA rowspan
    int totalKpiRowCount = Model.KpiRows.Count;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Appraisal – @Model.EmpName</title>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Verdana, Helvetica, sans-serif;
            background: #f8f9fc;
            color: #1a1a2e;
            font-size: 12px;
        }

        .page {
