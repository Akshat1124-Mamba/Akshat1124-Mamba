            </div>

            <div class="sig-section">
                <div class="sig-box"><div class="sig-line"></div><div class="sig-label">HR Manager</div><div style="font-size:9px;color:#94a3b8;margin-top:2px">Date: ____________</div></div>
                <div class="sig-box"><div class="sig-line"></div><div class="sig-label">Reporting Manager</div><div style="font-size:9px;color:#94a3b8;margin-top:2px">@(string.IsNullOrWhiteSpace(Model.RmName) ? "Name: ____________" : Model.RmName)</div></div>
                <div class="sig-box"><div class="sig-line"></div><div class="sig-label">HOD / Unit Head</div><div style="font-size:9px;color:#94a3b8;margin-top:2px">@(string.IsNullOrWhiteSpace(Model.HodName) ? "Name: ____________" : Model.HodName)</div></div>
                <div class="sig-box"><div class="sig-line"></div><div class="sig-label">JMD Approval</div><div style="font-size:9px;color:#94a3b8;margin-top:2px">@(string.IsNullOrWhiteSpace(Model.JmdName) ? "Name: ____________" : Model.JmdName)</div></div>
                <div class="sig-box"><div class="sig-line"></div><div class="sig-label">Employee Acknowledgement</div><div style="font-size:9px;color:#94a3b8;margin-top:2px">Date: ____________</div></div>
            </div>

        </div><!-- /view1 -->
        <!-- ══════════════════════════════════════════════════
             VIEW 2 — FINAL APPRAISAL SUMMARY
        ══════════════════════════════════════════════════ -->
        <div class="view-panel" id="view2">

            <div style="font-size:18px;font-weight:700;color:#0f1c3f;margin-bottom:4px">Final Appraisal — @Model.EmpName</div>
            @if (!string.IsNullOrWhiteSpace(cycleInfo))
            {
                <div style="font-size:11px;color:#64748b;margin-bottom:12px">@cycleInfo | @fyLabel</div>
            }

            @if (!behAuditCompleted)
            {
                <div class="ba-banner-warn" style="margin-bottom:14px">
                    <span class="ba-banner-icon">⚠️</span>
                    <div>
                        <div class="ba-banner-title-warn">Behavioural Audit Not Completed</div>
                        <div class="ba-banner-sub">Final score reflects PMS (BSC) only. Behavioural component will be added once the audit is finalized.</div>
                    </div>
                </div>
            }

            @if (mcOverallRating.HasValue || jmdOverallRating.HasValue)
            {
                <div class="overall-strip" style="margin-bottom:16px">
                    @if (mcOverallRating.HasValue)
                    {
                        <div class="os-item">
                            <span class="os-label">⚖️ MC Overall Rating</span>
                            <span class="os-val" style="color:#c2410c">@mcOverallRating.Value.ToString("0.##") <span style="font-size:11px;color:#94a3b8">/ 5</span></span>
                            @if (!string.IsNullOrWhiteSpace(mcOverallRemarks))
                            {
                                <span class="os-rem">"@mcOverallRemarks"</span>
                            }
                        </div>
                    }
                    @if (jmdOverallRating.HasValue)
                    {
                        <div class="os-item">
                            <span class="os-label">👑 JMD Overall Rating</span>
                            <span class="os-val" style="color:#9d174d">@jmdOverallRating.Value.ToString("0.##") <span style="font-size:11px;color:#94a3b8">/ 5</span></span>
                            @if (!string.IsNullOrWhiteSpace(jmdOverallRemarks))
                            {
                                <span class="os-rem">"@jmdOverallRemarks"</span>
                            }
                        </div>
                    }
                    <div style="font-size:10px;color:#64748b;align-self:center">MC &amp; JMD ratings are single overall scores, not per-KPI.</div>
                </div>
            }

            <div class="v-card">
                <div class="v-card-head">
                    <span style="font-size:1rem">📊</span>
                    <span class="v-card-head-title">KPI Performance — Final Cascade Ratings with Weighted Breakdown</span>
                    <span style="margin-left:auto;font-size:10px;color:rgba(255,255,255,.5);font-family:'Courier New',monospace">
                        BSC: @bscScore.ToString("0.##") &nbsp;|&nbsp; PMS×0.8: @pmsWeightedComponent.ToString("0.##") &nbsp;|&nbsp;
                        BA Score: @(behAuditCompleted? behScore.ToString("0.##") : "—") &nbsp;|&nbsp;
                        BA×0.2: @(behAuditCompleted? baWeightedComponent.ToString("0.##") : "—") &nbsp;|&nbsp;
                        Weighted: @weightedRating.ToString("0.##")
                    </span>
                </div>
                <div class="v-scroll">
                    <table class="main-tbl">
                        <colgroup>
                            <col style="width:12%" />
                            <col style="width:13%" />
                            <col style="width:20%" />
                            <col style="width:5%" />
                            <col style="width:6%" />
                            <col style="width:5%" />
                            <col style="width:5%" />
                            <col style="width:5%" />
                            <col style="width:6%" />
                            <col style="width:7%" />
                            <col style="width:7%" />
                            <col style="width:9%" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Performance Management<br />Perspectives (PMP)</th>
                                <th>Key Result Areas (KRAs)</th>
                                <th>Key Performance Indicators (KPIs)</th>
                                <th>Unit</th>
                                <th>Indiv. Wt%</th>
                                <th>Ovr Wt%</th>
                                <th>Target</th>
                                <th>Actual</th>
                                <th>Rating</th>
                                <th style="background:#047857 !important">KPI Wt. Rating<br /><span style="font-size:8px;opacity:.8;font-weight:400">(Wt% × Rating)</span></th>
                                <th class="th-pms-wt">PMS Wt.<br /><span style="font-size:8px;opacity:.8;font-weight:400">(× 0.8)</span></th>
                                <th class="th-ba">BA Score<br /><span style="font-size:8px;opacity:.8;font-weight:400">(single avg /5)</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.KpiRows.Any())
                            {
                                <tr><td colspan="12" style="text-align:center;padding:28px;color:#94a3b8">No KPI data found.</td></tr>
                            }
                            else
                            {
                                bool baRowspanRendered = false;
                                int totalRows2 = Model.KpiRows.Count;

                                foreach (var grp in pmpGroups)
                                {
                                    int span = grp.Rows.Count;
                                    bool first = true;
                                    foreach (var row in grp.Rows)
                                    {
                                        decimal? fr = GetFinalRating(row);
                                        decimal wr = GetWeightedRating(row);
                                        decimal pmsWt = Math.Round(wr * 0.8m, 3);
                                        decimal? actual = row.EmpActual ?? row.RmActual ?? row.HodActual ?? row.UnitHeadActual;
                                        <tr>
                                            @if (first)
                                            {
                                                <td class="pmp-cell" rowspan="@span">@grp.PmpName</td>
                                            }
                                            <td style="font-weight:600">@row.KraName</td>
                                            <td>@row.KpiName</td>
                                            <td class="tc">@row.UnitOfMeasure</td>
                                            <td class="tc">@row.IndividualWeightage.ToString("0.##")%</td>
                                            @if (first)
                                            {
                                                <td class="ow-cell" rowspan="@span">@grp.OvWt.ToString("0.##")%</td>
                                            }
                                            <td class="tc">@row.Target.ToString("0.##")</td>
                                            <td class="tc">@(actual.HasValue? actual.Value.ToString("0.##") : "—")</td>
                                            <td class="tc fw">@(fr.HasValue? fr.Value.ToString("0.##") : "—")</td>
                                            <td class="tc fw c-blue">@(fr.HasValue? wr.ToString("0.###") : "—")</td>
                                            <td class="tc td-pms-wt">@(fr.HasValue? pmsWt.ToString("0.###") : "—")</td>

                                            @* BA column — rowspan across ALL KPI rows, shown only once *@
                                            @if (!baRowspanRendered)
                                            {
                                                baRowspanRendered = true;
                                                <td class="td-ba-single" rowspan="@totalRows2">
                                                    @if (behAuditCompleted && behScore > 0)
                                                    {
                                                        <div style="font-size:18px;font-weight:700;color:#1e40af;font-family:'Courier New',monospace">@behScore.ToString("0.##")</div>
                                                        <div style="font-size:9px;color:#1e40af;margin-top:3px">avg /5</div>
                                                        <div style="font-size:9px;color:#475569;margin-top:4px;border-top:1px solid #bfdbfe;padding-top:4px">
                                                            ×0.2 = <strong style="color:#1e40af">@baWeightedComponent.ToString("0.##")</strong>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div style="font-size:12px;color:#94a3b8;font-style:italic">—</div>
                                                        <div style="font-size:9px;color:#94a3b8;margin-top:3px">Not completed</div>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                        first = false;
                                    }
                                }

                                <!-- Totals row -->
                                <tr>
                                    <td colspan="9" style="text-align:right;font-weight:700;background:#0f1c3f;color:#fff;padding:10px 14px">Total Weighted Rating</td>
                                    <td class="tc fw" style="background:#0f1c3f;color:#f59e0b;font-size:14px;padding:10px 12px">
                                        @bscScore.ToString("0.##")
                                        <div style="font-size:9px;color:#94a3b8;font-weight:400">BSC total</div>
                                    </td>
                                    <td class="tc fw" style="background:#d1fae5;color:#065f46;font-size:14px;padding:10px 12px">
                                        @pmsWeightedComponent.ToString("0.##")
                                        <div style="font-size:9px;color:#047857;font-weight:400">PMS × 0.8</div>
                                    </td>
                                    <td class="tc fw" style="background:#dbeafe;color:#1e40af;font-size:14px;padding:10px 12px">
                                        @(behAuditCompleted? behScore.ToString("0.##") : "—")
                                        <div style="font-size:9px;color:#1e40af;font-weight:400">BA avg score</div>
                                        @if (behAuditCompleted)
                                        {
                                            <div style="font-size:9px;color:#1e40af;font-weight:400">×0.2 = @baWeightedComponent.ToString("0.##")</div>
                                        }
                                    </td>
                                </tr>
                                <!-- Weighted Rating summary row -->
                                <tr>
                                    <td colspan="10" style="text-align:right;font-weight:700;background:#ca8a04;color:#fff;padding:8px 14px">
                                        ⚖️ Final Weighted Rating = PMS×0.8 + BA×0.2
                                    </td>
                                    <td colspan="2" style="text-align:center;font-weight:700;background:#fefce8;color:#92400e;font-size:16px;padding:10px 12px;border:2px solid #fde047">
                                        @pmsWeightedComponent.ToString("0.##") + @(behAuditCompleted? baWeightedComponent.ToString("0.##") : "0")
                                        = <span style="font-size:18px;color:#ca8a04">@weightedRating.ToString("0.##")</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Score Summary -->
            <div class="scores-row">
                <div class="score-mini-tbl">
                    <table>
                        <thead>
                            <tr>
                                <th class="col-label"></th>
                                <th class="col-pms">PMS</th>
                                <th class="col-ba">B A</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="row-bsc">
                                <td class="lbl-cell" style="color:#0369a1;font-weight:600;">
                                    Appraisal Score (BSC / PMS)
                                    <span class="score-sub-lbl">Weighted avg of KPI ratings = @bscScore.ToString("0.##")</span>
                                </td>
                                <td class="score-cell" style="color:#0369a1;">@bscScore.ToString("0.##")</td>
                                <td class="score-cell ba-val" style="color:@(behAuditCompleted ? "#059669" : "#e11d48");">
                                    @(behAuditCompleted? behScore.ToString("0.##") : "—")
                                </td>
                            </tr>
                            <tr style="background:#fefce8">
                                <td class="lbl-cell" style="color:#92400e;font-weight:600;">
                                    ⚖️ Weighted Components
                                    <span class="score-sub-lbl">PMS×0.8 = @pmsWeightedComponent.ToString("0.##") &nbsp;|&nbsp; BA×0.2 = @(behAuditCompleted? baWeightedComponent.ToString("0.##") : "—")</span>
                                </td>
                                <td class="score-cell" style="background:#d1fae5;color:#065f46;">@pmsWeightedComponent.ToString("0.##")</td>
                                <td class="score-cell" style="background:#dbeafe;color:#1e40af;">@(behAuditCompleted? baWeightedComponent.ToString("0.##") : "—")</td>
                            </tr>
                            <tr style="background:#fefce8;border:2px solid #fde047">
                                <td class="lbl-cell" style="color:#ca8a04;font-weight:700;">
                                    ⚖️ Weighted Rating
                                    <span class="score-sub-lbl" style="color:#ca8a04">PMS×0.8 + BA×0.2 = @weightedRating.ToString("0.##")</span>
                                </td>
                                <td colspan="2" class="score-cell" style="color:#ca8a04;font-size:18px;background:#fefce8;">
                                    @weightedRating.ToString("0.##")
                                </td>
                            </tr>
                            @if (mcOverallRating.HasValue)
                            {
                                <tr class="row-mc">
                                    <td class="lbl-cell" style="color:#c2410c;font-weight:600;">
                                        ⚖️ Appraisal Score (MC)
                                        <span class="score-sub-lbl mc-color">Moderation Committee — single overall rating@(!string.IsNullOrWhiteSpace(mcOverallRemarks) ? $" · \"{mcOverallRemarks}\"" : "")</span>
                                    </td>
                                    <td class="score-cell" style="color:#c2410c;">@mcOverallRating.Value.ToString("0.##")</td>
                                    <td class="score-cell" style="color:#94a3b8;">—</td>
                                </tr>
                            }
                            @if (jmdOverallRating.HasValue)
                            {
                                <tr class="row-jmd">
                                    <td class="lbl-cell" style="color:#9d174d;font-weight:600;">
                                        👑 Appraisal Score (JMD)
                                        <span class="score-sub-lbl jmd-color">JMD — single overall rating (highest authority)@(!string.IsNullOrWhiteSpace(jmdOverallRemarks) ? $" · \"{jmdOverallRemarks}\"" : "")</span>
                                    </td>
                                    <td class="score-cell" style="color:#9d174d;">@jmdOverallRating.Value.ToString("0.##")</td>
                                    <td class="score-cell" style="color:#94a3b8;">—</td>
                                </tr>
                            }
                            <tr class="row-final">
                                <td class="lbl-cell">
                                    <strong>Appraisal Score (Final)</strong>
                                    <span class="score-sub-lbl final-color">
                                        @if (jmdOverallRating.HasValue)
                                        {
                                            <text>Based on JMD Overall Rating → Rating @calcRating — @ratingLabel</text>
                                        }
                                        else if (mcOverallRating.HasValue)
                                        {
                                            <text>Based on MC Overall Rating → Rating @calcRating — @ratingLabel</text>
                                        }
                                        else
                                        {
                                            <text>Based on Weighted Rating (@weightedRating.ToString("0.##")) → Rating @calcRating — @ratingLabel</text>
                                        }
                                    </span>
                                </td>
                                <td class="score-cell" style="font-size:15px;">@finalDisplayValue.ToString("0.##")</td>
                                <td class="score-cell" style="color:#94a3b8;">—</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;padding:8px 0">
                <div style="background:#fefce8;border:2px solid #fde047;border-radius:8px;padding:10px 18px;text-align:center">
                    <div style="font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#92400e;margin-bottom:4px">⚖️ Weighted Rating</div>
                    <div style="font-size:22px;font-weight:700;color:#ca8a04;font-family:'Courier New',monospace">@weightedRating.ToString("0.##")</div>
                    <div style="font-size:9.5px;color:#92400e;margin-top:2px">@pmsWeightedComponent.ToString("0.##") + @(behAuditCompleted? baWeightedComponent.ToString("0.##") : "0")</div>
                </div>
                <div style="background:#eff4ff;border:1.5px solid #c7d7fd;border-radius:8px;padding:10px 18px;text-align:center">
                    <div style="font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#64748b;margin-bottom:4px">Final Increment %</div>
                    <div style="font-size:22px;font-weight:700;color:#1e4ed8;font-family:'Courier New',monospace">@finalIncrPct.ToString("0.####")%</div>
                    <div style="font-size:9.5px;color:#64748b;margin-top:2px">Rating @calcRating — @ratingLabel</div>
                </div>
                @if (mcOverallRating.HasValue)
                {
                    <div style="background:#fff7ed;border:1.5px solid #fdba74;border-radius:8px;padding:10px 18px;text-align:center">
                        <div style="font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#9a3412;margin-bottom:4px">⚖️ MC Overall</div>
                        <div style="font-size:22px;font-weight:700;color:#c2410c;font-family:'Courier New',monospace">@mcOverallRating.Value.ToString("0.##")</div>
                        <div style="font-size:9px;color:#64748b;margin-top:2px">/ 5.00</div>
                    </div>
                }
                @if (jmdOverallRating.HasValue)
                {
                    <div style="background:#fdf2f8;border:1.5px solid #f9a8d4;border-radius:8px;padding:10px 18px;text-align:center">
                        <div style="font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#9d174d;margin-bottom:4px">👑 JMD Overall</div>
                        <div style="font-size:22px;font-weight:700;color:#9d174d;font-family:'Courier New',monospace">@jmdOverallRating.Value.ToString("0.##")</div>
                        <div style="font-size:9px;color:#64748b;margin-top:2px">/ 5.00</div>
                    </div>
                }
            </div>

            @if (!behAuditCompleted)
            {
                <div class="ba-not-done-note">⚠️ Behavioural Audit Not Completed — Final score reflects PMS (BSC) only.</div>
            }
            <div class="formula-line">Individual Appraisal = ((0.8 × BSC Score) + (0.2 × Behavioural Score))</div>
            <div class="note-line">Note: Function &amp; Department Appraisal for @Model.EmpName would be same as Individual BSC Score (100% Weightage)</div>

        </div><!-- /view2 -->
        <!-- ══════════════════════════════════════════════════
             VIEW 3 — ALL REVIEWER SCORES
        ══════════════════════════════════════════════════ -->
        <div class="view-panel" id="view3">

            <div style="font-size:18px;font-weight:700;color:#0f1c3f;margin-bottom:4px">All Reviewer Scores — @Model.EmpName</div>
