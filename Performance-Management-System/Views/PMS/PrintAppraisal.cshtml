            <div class="v-card">
                <div class="v-card-head">
                    <span style="font-size:1rem">🔍</span>
                    <span class="v-card-head-title">All Reviewer Scores — Stage-by-Stage with Weighted Breakdown</span>
                    <span style="margin-left:auto;font-size:10px;color:rgba(255,255,255,.5);font-family:'Courier New',monospace">
                        Weighted: @weightedRating.ToString("0.##") (PMS @pmsWeightedComponent.ToString("0.##") + BA×0.2 @(behAuditCompleted? baWeightedComponent.ToString("0.##") : "—"))
                    </span>
                </div>
                <div class="v-scroll">
                    <table class="rev-tbl">
                        <thead>
                            <tr>
                                <th rowspan="2" style="width:7%">PMP</th>
                                <th rowspan="2" style="width:8%">KRA</th>
                                <th rowspan="2" style="width:14%">KPI</th>
                                <th rowspan="2" style="width:4%">Unit</th>
                                <th rowspan="2" style="width:4%">Wt%</th>
                                <th rowspan="2" style="width:4%">Ovr Wt%</th>
                                <th rowspan="2" style="width:5%">Target</th>
                                <th colspan="2" class="th-emp">Employee</th>
                                <th colspan="2" class="th-rm">Reporting Manager</th>
                                <th colspan="2" class="th-hod">HOD</th>
                                <th colspan="2" class="th-uh">Unit Head</th>
                                <th class="th-avg">Avg</th>
                                <th class="th-fin">Rating</th>
                                <th class="th-fin">Wt.Rating</th>
                                <th class="th-pms-wt">PMS Wt.<br /><span style="font-size:8px;font-weight:400;opacity:.8">×0.8</span></th>
                                <th class="th-ba" rowspan="2" style="min-width:90px">
                                    BA Score<br />
                                    <span style="font-size:8px;font-weight:400;opacity:.8">(single avg /5)</span>
                                </th>
                            </tr>
                            <tr>
                                <th class="th-emp">Actual</th>
                                <th class="th-emp">Rating</th>
                                <th class="th-rm">Actual</th>
                                <th class="th-rm">Rating</th>
                                <th class="th-hod">Actual</th>
                                <th class="th-hod">Rating</th>
                                <th class="th-uh">Actual</th>
                                <th class="th-uh">Rating</th>
                                <th class="th-avg">/5</th>
                                <th class="th-fin">/5</th>
                                <th class="th-fin">score</th>
                                <th class="th-pms-wt">score</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.KpiRows.Any())
                            {
                                <tr><td colspan="20" style="text-align:center;padding:24px;color:#94a3b8">No KPI data found.</td></tr>
                            }
                            else
                            {
                                bool baRendered3 = false;
                                int totalRows3 = Model.KpiRows.Count;

                                foreach (var grp in pmpGroups)
                                {
                                    int span2 = grp.Rows.Count;
                                    bool first2 = true;
                                    foreach (var row in grp.Rows)
                                    {
                                        decimal? fr2 = GetFinalRating(row);
                                        decimal wr2 = GetWeightedRating(row);
                                        decimal pmsWt2 = Math.Round(wr2 * 0.8m, 3);
                                        decimal? ravg = RowAvgRmHodUh(row);
                                        <tr>
                                            @if (first2)
                                            {
                                                <td class="pmp-cell" rowspan="@span2">@grp.PmpName</td>
                                            }
                                            <td style="font-weight:600;font-size:10px">@row.KraName</td>
                                            <td style="font-size:10px">@row.KpiName</td>
                                            <td class="tc">@row.UnitOfMeasure</td>
                                            <td class="tc">@row.IndividualWeightage.ToString("0.##")%</td>
                                            @if (first2)
                                            {
                                                <td class="ow-cell" rowspan="@span2">@grp.OvWt.ToString("0.##")%</td>
                                            }
                                            <td class="tc">@row.Target.ToString("0.##")</td>
                                            <td class="tc td-emp">@Fmt(row.EmpActual)</td>
                                            <td class="tc td-emp fw">@Fmt(row.EmpRating)</td>
                                            <td class="tc td-rm">@Fmt(row.RmActual)</td>
                                            <td class="tc td-rm fw">@Fmt(row.RmRating)</td>
                                            <td class="tc td-hod">@Fmt(row.HodActual)</td>
                                            <td class="tc td-hod fw">@Fmt(row.HodRating)</td>
                                            <td class="tc td-uh">@Fmt(row.UnitHeadActual)</td>
                                            <td class="tc td-uh fw">@Fmt(row.UnitHeadRating)</td>
                                            <td class="tc td-avg">@(ravg.HasValue? ravg.Value.ToString("0.00") : "—")</td>
                                            <td class="tc td-fin fw">@(fr2.HasValue? fr2.Value.ToString("0.##") : "—")</td>
                                            <td class="tc td-fin fw c-blue">@(fr2.HasValue? wr2.ToString("0.###") : "—")</td>
                                            <td class="tc td-pms-wt">@(fr2.HasValue? pmsWt2.ToString("0.###") : "—")</td>

                                            @* BA — single rowspan cell across all KPI rows *@
                                            @if (!baRendered3)
                                            {
                                                baRendered3 = true;
                                                <td class="td-ba-single" rowspan="@totalRows3">
                                                    @if (behAuditCompleted && behScore > 0)
                                                    {
                                                        <div style="font-size:16px;font-weight:700;color:#1e40af;font-family:'Courier New',monospace">@behScore.ToString("0.##")</div>
                                                        <div style="font-size:9px;color:#1e40af;margin-top:2px">avg /5</div>
                                                        <div style="font-size:9px;color:#475569;margin-top:4px;border-top:1px solid #bfdbfe;padding-top:4px">
                                                            ×0.2 = <strong style="color:#1e40af">@baWeightedComponent.ToString("0.##")</strong>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div style="font-size:12px;color:#94a3b8;font-style:italic">—</div>
                                                        <div style="font-size:9px;color:#94a3b8;margin-top:2px">Not completed</div>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                        first2 = false;
                                    }
                                }

                                <tr>
                                    <td colspan="7" style="text-align:right;font-weight:700;background:#0f1c3f;color:#fff;padding:9px 12px">Totals</td>
                                    <td style="background:#0f1c3f"></td>
                                    <td class="tc fw" style="background:#065f46;color:#6ee7b7">@FmtW(empScore)</td>
                                    <td style="background:#0f1c3f"></td>
                                    <td class="tc fw" style="background:#1e40af;color:#bfdbfe">@FmtW(rmScore)</td>
                                    <td style="background:#0f1c3f"></td>
                                    <td class="tc fw" style="background:#5b21b6;color:#ddd6fe">@FmtW(hodScore)</td>
                                    <td style="background:#0f1c3f"></td>
                                    <td class="tc fw" style="background:#0f766e;color:#99f6e4">@FmtW(uhScore)</td>
                                    <td style="background:#0f1c3f"></td>
                                    <td style="background:#0f1c3f"></td>
                                    <td class="tc fw" style="background:#f59e0b;color:#fff;font-size:13px">@bscScore.ToString("0.##")</td>
                                    <td class="tc fw" style="background:#d1fae5;color:#065f46;font-size:13px">@pmsWeightedComponent.ToString("0.##")</td>
                                    <td class="tc fw" style="background:#dbeafe;color:#1e40af;font-size:13px">
                                        @(behAuditCompleted? behScore.ToString("0.##") : "—")
                                        @if (behAuditCompleted)
                                        {
                                            <div style="font-size:9px;font-weight:400">×0.2=@baWeightedComponent.ToString("0.##")</div>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="18" style="text-align:right;font-weight:700;background:#ca8a04;color:#fff;padding:8px 14px">
                                        ⚖️ Weighted Rating = PMS×0.8 + BA×0.2
                                    </td>
                                    <td colspan="2" style="text-align:center;font-weight:700;background:#fefce8;color:#92400e;font-size:15px;padding:10px 12px;border:2px solid #fde047">
                                        @pmsWeightedComponent.ToString("0.##") + @(behAuditCompleted? baWeightedComponent.ToString("0.##") : "0")
                                        = <span style="font-size:17px;color:#ca8a04">@weightedRating.ToString("0.##")</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="scores-row">
                <div class="score-mini-tbl">
                    <table>
                        <tr>
                            <td>Appraisal Score (BSC — Final)</td>
                            <td style="text-align:right;font-weight:700">@bscScore.ToString("0.##")</td>
                        </tr>
                        <tr style="background:#d1fae5">
                            <td style="color:#065f46;font-weight:600">PMS Component (BSC × 0.8)</td>
                            <td style="text-align:right;font-weight:700;color:#065f46">@pmsWeightedComponent.ToString("0.##")</td>
                        </tr>
                        <tr>
                            <td>
                                Appraisal Score (Behavioural — single avg)
                                @if (!behAuditCompleted)
                                {
                                    <span class="score-not-done">NOT DONE</span>
                                }
                            </td>
                            <td style="text-align:right;font-weight:700;color:@(behAuditCompleted ? "#059669" : "#e11d48")">
                                @(behAuditCompleted? behScore.ToString("0.##") : "—")
                            </td>
                        </tr>
                        @if (behAuditCompleted)
                        {
                            <tr style="background:#dbeafe">
                                <td style="color:#1e40af;font-weight:600">BA Component (BA avg × 0.2)</td>
                                <td style="text-align:right;font-weight:700;color:#1e40af">@baWeightedComponent.ToString("0.##")</td>
                            </tr>
                        }
                        <tr style="background:#fefce8;border:2px solid #fde047">
                            <td style="color:#92400e;font-weight:700">⚖️ Weighted Rating (PMS×0.8 + BA×0.2)</td>
                            <td style="text-align:right;font-weight:700;color:#ca8a04;font-size:15px">@weightedRating.ToString("0.##")</td>
                        </tr>
                        <tr>
                            <td>
                                Appraisal Score (Final)
                                <span class="score-sub-lbl final-color">
                                    @if (jmdOverallRating.HasValue)
                                    {
                                        <text>Based on JMD Overall Rating</text>
                                    }
                                    else if (mcOverallRating.HasValue)
                                    {
                                        <text>Based on MC Overall Rating</text>
                                    }
                                    else
                                    {
                                        <text>Based on Weighted Rating</text>
                                    }
                                </span>
                            </td>
                            <td style="text-align:right;font-weight:700;color:#0f1c3f;font-size:14px">@finalDisplayValue.ToString("0.##")</td>
                        </tr>
                    </table>
                </div>

                <div class="rev-score-wrap">
                    <div class="s-head" style="margin-top:0">Reviewer Score Comparison</div>
                    <table class="rev-sum-tbl">
                        <thead>
                            <tr>
                                <th style="text-align:left;width:22%">Reviewer</th>
                                <th style="width:22%">Name</th>
                                <th style="width:18%">Score / Rating</th>
                                <th>Note</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="font-weight:700;background:#f0fdf4;color:#065f46">Employee</td>
                                <td style="background:#f0fdf4">@Model.EmpName</td>
                                <td style="text-align:center;font-weight:700;background:#f0fdf4">@FmtW(empScore)</td>
                                <td style="background:#f0fdf4;font-size:10px">Self-assessment → Draft</td>
                            </tr>
                            <tr>
                                <td style="font-weight:700;background:#eff4ff;color:#1e40af">Reporting Manager</td>
                                <td style="background:#eff4ff">@(string.IsNullOrWhiteSpace(Model.RmName) ? "—" : Model.RmName)</td>
                                <td style="text-align:center;font-weight:700;background:#eff4ff">@FmtW(rmScore)</td>
                                <td style="background:#eff4ff;font-size:10px">EmployeeFilled → RMReview</td>
                            </tr>
                            <tr>
                                <td style="font-weight:700;background:#ede9fe;color:#5b21b6">Head of Department</td>
                                <td style="background:#ede9fe">@(string.IsNullOrWhiteSpace(Model.HodName) ? "—" : Model.HodName)</td>
                                <td style="text-align:center;font-weight:700;background:#ede9fe">@FmtW(hodScore)</td>
                                <td style="background:#ede9fe;font-size:10px">RMReview → HODReview</td>
                            </tr>
                            <tr>
                                <td style="font-weight:700;background:#f0fdfa;color:#0f766e">Unit Head</td>
                                <td style="background:#f0fdfa">@(string.IsNullOrWhiteSpace(Model.UnitHeadName) ? "—" : Model.UnitHeadName)</td>
                                <td style="text-align:center;font-weight:700;background:#f0fdfa">@FmtW(uhScore)</td>
                                <td style="background:#f0fdfa;font-size:10px">HODReview → UnitHeadReview</td>
                            </tr>
                            <tr>
                                <td style="font-weight:700;background:#fff7ed;color:#9a3412">Mod. Committee</td>
                                <td style="background:#fff7ed">@(string.IsNullOrWhiteSpace(Model.ModCommitteeNames) ? "—" : Model.ModCommitteeNames)</td>
                                <td style="text-align:center;font-weight:700;background:#fff7ed">
                                    @if (mcOverallRating.HasValue)
                                    {
                                        <span class="overall-badge overall-badge-mc">@mcOverallRating.Value.ToString("0.##")</span>
                                    }
                                    else
                                    {
                                        <text>—</text>
                                    }
                                </td>
                                <td style="background:#fff7ed;font-size:10px">Single overall rating / 5.00</td>
                            </tr>
                            <tr>
                                <td style="font-weight:700;background:#fdf2f8;color:#831843">JMD</td>
                                <td style="background:#fdf2f8">@(string.IsNullOrWhiteSpace(Model.JmdName) ? "—" : Model.JmdName)</td>
                                <td style="text-align:center;font-weight:700;background:#fdf2f8">
                                    @if (jmdOverallRating.HasValue)
                                    {
                                        <span class="overall-badge overall-badge-jmd">@jmdOverallRating.Value.ToString("0.##")</span>
                                    }
                                    else
                                    {
                                        <text>—</text>
                                    }
                                </td>
                                <td style="background:#fdf2f8;font-size:10px">Single overall rating / 5.00</td>
                            </tr>
                            <tr style="background:#f0fdf4">
                                <td style="font-weight:700;color:#065f46">🔵 BA Score</td>
                                <td style="color:#64748b;font-size:10px">Behavioural Audit (RM + HOD avg)</td>
                                <td style="text-align:center;font-weight:700;font-size:15px;color:@(behAuditCompleted ? "#1e40af" : "#94a3b8")">
                                    @(behAuditCompleted? behScore.ToString("0.##") : "—")
                                    @if (behAuditCompleted)
                                    {
                                        <div style="font-size:9px;font-weight:400;color:#64748b">×0.2 = @baWeightedComponent.ToString("0.##")</div>
                                    }
                                </td>
                                <td style="font-size:10px;color:#64748b">Single score applied across all KPIs proportionally</td>
                            </tr>
                            <tr style="background:#fefce8;border:2px solid #fde047">
                                <td style="font-weight:700;color:#92400e">⚖️ Weighted Rating</td>
                                <td style="color:#64748b;font-size:10px">PMS×0.8 + BA×0.2</td>
                                <td style="text-align:center;font-weight:700;font-size:15px;color:#ca8a04">@weightedRating.ToString("0.##")</td>
                                <td style="font-size:10px;color:#92400e">@pmsWeightedComponent.ToString("0.##") + @(behAuditCompleted? baWeightedComponent.ToString("0.##") : "0") = @weightedRating.ToString("0.##")</td>
                            </tr>
                            <tr>
                                <td style="font-weight:700;color:#1e3a6e">Final (Cascade)</td>
                                <td>
                                    @if (jmdOverallRating.HasValue)
                                    {
                                        <span style="font-size:10px;color:#831843;font-weight:600">JMD Overall</span>
                                    }
                                    else if (mcOverallRating.HasValue)
                                    {
                                        <span style="font-size:10px;color:#9a3412;font-weight:600">MC Overall</span>
                                    }
                                    else
                                    {
                                        <text>HR Finalized</text>
                                    }
                                </td>
                                <td style="text-align:center;font-weight:700;font-size:14px;color:#1e3a6e">@finalDisplayValue.ToString("0.##")</td>
                                <td style="font-size:10px;color:#64748b">
                                    @if (jmdOverallRating.HasValue)
                                    {
                                        <text>JMD overall rating is final authority</text>
                                    }
                                    else if (mcOverallRating.HasValue)
                                    {
                                        <text>MC overall rating used (no JMD)</text>
                                    }
                                    else
                                    {
                                        <text>Based on weighted rating cascade</text>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            @if (!behAuditCompleted)
            {
                <div class="ba-not-done-note">⚠️ Behavioural Audit Not Completed — Final score reflects PMS (BSC) only.</div>
            }
            <div class="formula-line" style="margin-top:14px">Individual Appraisal = ((0.8 × BSC Score) + (0.2 × Behavioural Score))</div>
            <div class="note-line">Note: Function &amp; Department Appraisal for @Model.EmpName would be same as Individual BSC Score (100% Weightage)</div>

        </div><!-- /view3 -->

    </div><!-- /.page -->

    <script>
        var _view         = 1;
        var _finalIncrPct = parseFloat('@(finalIncrPct.ToString("0.0000", System.Globalization.CultureInfo.InvariantCulture))') || 0;
        var _isAnnual     = @(isAnnualCycle ? "true" : "false");
        var _monthNames   = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

        function formatDateDisplay(isoValue) {
            if (!isoValue) return '';
            var parts = isoValue.split('-');
            if (parts.length !== 3) return isoValue;
            return parseInt(parts[2]) + '-' + _monthNames[parseInt(parts[1]) - 1] + '-' + parts[0];
        }

        function onIncrDateChange() {
            var el   = document.getElementById('incrDateInput');
            var disp = document.getElementById('incrDateDisplay');
            if (el && disp) disp.textContent = el.value ? formatDateDisplay(el.value) : '';
        }

        function switchView(n) {
            _view = n;
            for (var i = 1; i <= 3; i++) {
                var p = document.getElementById('view' + i);
                var b = document.getElementById('vbtn-' + i);
                if (p) p.classList.toggle('active', i === n);
                if (b) b.classList.toggle('active', i === n);
            }
        }

        var _currentGross = 0;

        function calcIncrement() {
            if (!_isAnnual) return;
            var incrCell = document.getElementById('incrAmtCell');
            var newGCell = document.getElementById('newGrossCell');
            if (!incrCell || !newGCell) return;
            var gross = _currentGross;
            if (gross <= 0 || _finalIncrPct <= 0) {
                incrCell.textContent = (gross > 0 && _finalIncrPct <= 0) ? 'No Base% — set PAT entry' : '—';
                incrCell.style.color = (_finalIncrPct <= 0 && gross > 0) ? '#e11d48' : '';
                newGCell.textContent = '—';
                return;
            }
            var incrAmt  = parseFloat((gross * _finalIncrPct / 100).toFixed(2));
            var newGross = parseFloat((gross + incrAmt).toFixed(2));
            incrCell.style.color = '';
            incrCell.textContent = 'Rs ' + incrAmt.toLocaleString('en-IN', { minimumFractionDigits:2, maximumFractionDigits:2 });
            newGCell.textContent = 'Rs ' + newGross.toLocaleString('en-IN', { minimumFractionDigits:2, maximumFractionDigits:2 });
        }

        function loadGrossSalary() {
            var empId   = @Model.EmpId;
            var grossEl = document.getElementById('grossInput');
            if (!empId || empId <= 0) { if (grossEl) grossEl.textContent = '—'; return; }
            fetch('/Pms/GetEmployeeGrossSalary?empId=' + empId)
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    var srcLabel = document.getElementById('grossSrcLabel');
                    if (!grossEl) return;
                    if (data.success && data.gross > 0) {
                        _currentGross = data.gross;
                        grossEl.textContent = 'Rs ' + data.gross.toLocaleString('en-IN', { minimumFractionDigits:2, maximumFractionDigits:2 });
                        if (srcLabel) {
                            srcLabel.textContent = data.source === 'increment' ? '✓ From last increment' : '✓ From salary record';
                            srcLabel.style.color = data.source === 'increment' ? '#059669' : '#1e4ed8';
                        }
                        calcIncrement();
                    } else {
                        grossEl.textContent = '—';
                        if (srcLabel) srcLabel.textContent = '';
                    }
                })
                .catch(function() { if (grossEl) grossEl.textContent = '—'; });
        }

        function triggerPrint() {
            for (var i = 1; i <= 3; i++) {
                var p = document.getElementById('view' + i);
                if (p) p.classList.remove('print-active');
            }
            var active = document.getElementById('view' + _view);
            if (active) active.classList.add('print-active');
            window.print();
        }

        onIncrDateChange();
        switchView(1);
        loadGrossSalary();
    </script>
</body>
</html>
