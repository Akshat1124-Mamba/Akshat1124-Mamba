                table.main-tbl thead th:last-child, table.rev-tbl thead th:last-child {
                    border-right: none;
                }

            table.main-tbl tbody tr, table.rev-tbl tbody tr {
                border-bottom: 1px solid #eaeef7;
            }

                table.main-tbl tbody tr:hover, table.rev-tbl tbody tr:hover {
                    background: #f8faff;
                }

            table.main-tbl tbody td, table.rev-tbl tbody td {
                padding: 10px 12px;
                color: #334155;
                border-right: 1px solid #eaeef7;
                vertical-align: middle;
            }

                table.main-tbl tbody td:last-child, table.rev-tbl tbody td:last-child {
                    border-right: none;
                }

            table.rev-tbl th, table.rev-tbl td {
                white-space: nowrap;
            }

        table.rev-tbl {
            font-size: 10px;
            min-width: max-content;
        }

        td.pmp-cell {
            background: #dce4f0 !important;
            text-align: center !important;
            font-weight: 700 !important;
        }

        td.ow-cell {
            background: #efefef !important;
            text-align: center !important;
            font-weight: 700 !important;
        }

        .tc {
            text-align: center;
        }

        .fw {
            font-weight: 700;
        }

        /* ── REVIEWER HEADER COLOURS ── */
        .th-emp {
            background: #065f46 !important;
        }

        .th-rm {
            background: #1e40af !important;
        }

        .th-hod {
            background: #5b21b6 !important;
        }

        .th-uh {
            background: #0f766e !important;
        }

        .th-mc {
            background: #9a3412 !important;
        }

        .th-jmd {
            background: #831843 !important;
        }

        .th-fin {
            background: #1e3a6e !important;
        }

        .th-avg {
            background: #0369a1 !important;
        }

        .th-pms-wt {
            background: #047857 !important;
        }

        .th-ba {
            background: #1d4ed8 !important;
        }

        td.td-emp {
            background: #f0fdf4;
        }

        td.td-rm {
            background: #eff4ff;
        }

        td.td-hod {
            background: #ede9fe;
        }

        td.td-uh {
            background: #f0fdfa;
        }

        td.td-mc {
            background: #fff7ed;
        }

        td.td-jmd {
            background: #fdf2f8;
        }

        td.td-fin {
            background: #e8eef8;
            font-weight: 700;
        }

        td.td-avg {
            background: #f0f9ff;
            font-weight: 700;
            color: #0369a1;
        }

        td.td-pms-wt {
            background: #d1fae5;
            font-weight: 700;
            color: #065f46;
        }

        /* ── BA SINGLE-SCORE CELL ── */
        td.td-ba-single {
            background: #dbeafe;
            font-weight: 700;
            color: #1e40af;
            text-align: center;
            vertical-align: middle;
            border-left: 2px solid #93c5fd;
        }

        .overall-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 4px 10px;
            border-radius: 7px;
            font-family: 'Courier New',monospace;
            font-size: 13px;
            font-weight: 700;
        }

        .overall-badge-mc {
            background: #fff7ed;
            color: #c2410c;
            border: 1.5px solid #fdba74;
        }

        .overall-badge-jmd {
            background: #fdf2f8;
            color: #9d174d;
            border: 1.5px solid #f9a8d4;
        }

        .scores-row {
            display: flex;
            gap: 12px;
            margin-top: 14px;
            flex-wrap: wrap;
        }

        .score-mini-tbl {
            min-width: 300px;
        }

            .score-mini-tbl table {
                border-collapse: collapse;
                width: 100%;
            }

                .score-mini-tbl table td {
                    border: 1px solid #dde2ed;
                    padding: 7px 12px;
                    font-size: 11.5px;
                }

                .score-mini-tbl table tr.row-bsc td {
                    background: #f0f9ff;
                }

                .score-mini-tbl table tr.row-mc td {
                    background: #fff7ed;
                }

                .score-mini-tbl table tr.row-jmd td {
                    background: #fdf2f8;
                }

                .score-mini-tbl table tr.row-beh td {
                    background: #f0fdf4;
                }

                .score-mini-tbl table tr.row-final td {
                    background: #0f1c3f;
                    color: #fff;
                    font-weight: 700;
                }

        .score-sub-lbl {
            display: block;
            font-size: 9px;
            font-weight: 400;
            color: #94a3b8;
            margin-top: 2px;
            letter-spacing: .04em;
        }

            .score-sub-lbl.mc-color {
                color: #c2410c;
            }

            .score-sub-lbl.jmd-color {
                color: #9d174d;
            }

            .score-sub-lbl.final-color {
                color: #f59e0b;
            }

        .score-not-done {
            background: #fff1f2;
            color: #e11d48;
            font-size: 9px;
            font-weight: 700;
            padding: 1px 6px;
            border-radius: 4px;
            margin-left: 4px;
        }

        .rev-score-wrap {
            flex: 1;
            min-width: 360px;
            overflow-x: auto;
        }

        table.rev-sum-tbl {
            border-collapse: collapse;
            width: 100%;
            font-size: 11px;
        }

            table.rev-sum-tbl thead th {
                background: #253d75;
                color: #fff;
                padding: 7px 10px;
                font-size: 9.5px;
                font-weight: 700;
                letter-spacing: .07em;
                text-transform: uppercase;
            }

            table.rev-sum-tbl tbody td {
                border: 1px solid #eaeef7;
                padding: 7px 10px;
                vertical-align: middle;
            }

            table.rev-sum-tbl tbody tr:last-child td {
                background: #e8eef8;
                font-weight: 700;
            }

        .formula-line {
            margin-top: 14px;
            font-size: 13px;
            font-weight: 700;
            color: #0f1c3f;
        }

        .note-line {
            margin-top: 5px;
            font-size: 11px;
            color: #64748b;
        }

        .ba-not-done-note {
            background: #fff1f2;
            border: 1.5px solid #fecdd3;
            border-left: 3px solid #e11d48;
            border-radius: 7px;
            padding: 9px 14px;
            margin-top: 8px;
            font-size: 11.5px;
            color: #e11d48;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .score-mini-tbl table thead tr {
            background: #1e293b;
            color: #fff;
        }

        .score-mini-tbl table thead th {
            padding: 9px 16px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: .08em;
            text-align: right;
            border: 1px solid #dde2ed;
        }

            .score-mini-tbl table thead th.col-label {
                text-align: left;
                width: 60%;
            }

            .score-mini-tbl table thead th.col-pms {
                color: #93c5fd;
            }

            .score-mini-tbl table thead th.col-ba {
                color: #6ee7b7;
            }

        .lbl-cell {
            padding: 12px 16px;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
        }

        .score-cell {
            padding: 12px 16px;
            text-align: right;
            font-weight: 700;
            font-family: 'Courier New',monospace;
            font-size: 14px;
            white-space: nowrap;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
            border-left: 1px solid #e2e8f0;
        }

        .ba-val {
            font-size: 14px;
            background: #f0fdf4;
        }

        /* ── PRINT ── */
        @@media print {
            body {
                background: #fff;
                margin: 0;
                font-size: 10px;
            }

            #grossSrcLabel {
                display: none !important;
            }

            .toolbar {
                display: none !important;
            }

            .page {
                padding: 0;
                max-width: none;
            }

            .view-panel {
                display: none !important;
            }

                .view-panel.print-active {
                    display: block !important;
                }

            .incr-wrap {
                overflow: visible !important;
                box-shadow: none !important;
                border: 1px solid #ccc !important;
            }

            .incr-scrl {
                overflow: visible !important;
            }

            table.incr-tbl {
                width: 100% !important;
                table-layout: fixed !important;
                font-size: 7.5px !important;
            }

                table.incr-tbl thead th {
                    padding: 5px 4px !important;
                    font-size: 7px !important;
                    white-space: normal !important;
                    word-break: break-word !important;
                }

                table.incr-tbl tbody td {
                    padding: 5px 4px !important;
                    font-size: 8px !important;
                    white-space: normal !important;
                    word-break: break-word !important;
                }

            .date-input {
                border: none !important;
                background: transparent !important;
                box-shadow: none !important;
                font-size: 8px !important;
                width: 100% !important;
                padding: 0 !important;
            }

            .v-card {
                overflow: visible !important;
                box-shadow: none !important;
                border: 1px solid #ccc !important;
            }

            .v-scroll {
                overflow: visible !important;
                border: none !important;
            }

            table.rev-tbl {
                width: 100% !important;
                table-layout: fixed !important;
                font-size: 6.5px !important;
                min-width: 0 !important;
            }

                table.rev-tbl thead th {
                    padding: 3px 2px !important;
                    font-size: 6px !important;
                    white-space: normal !important;
                    word-break: break-word !important;
                    line-height: 1.2 !important;
                }

                table.rev-tbl tbody td {
                    padding: 3px 2px !important;
                    font-size: 6.5px !important;
                    white-space: normal !important;
                    word-break: break-word !important;
                }

                table.rev-tbl th, table.rev-tbl td {
                    white-space: normal !important;
                }

            table.main-tbl {
                width: 100% !important;
                table-layout: fixed !important;
                font-size: 7.5px !important;
                min-width: 0 !important;
            }

                table.main-tbl thead th {
                    padding: 4px 3px !important;
                    font-size: 7px !important;
                    white-space: normal !important;
                    word-break: break-word !important;
                }

                table.main-tbl tbody td {
                    padding: 4px 3px !important;
                    font-size: 7.5px !important;
                    white-space: normal !important;
                    word-break: break-word !important;
                }

            .scores-row {
                flex-wrap: wrap !important;
                gap: 8px !important;
            }

            .rev-score-wrap {
                min-width: 0 !important;
                overflow: visible !important;
            }

            table.rev-sum-tbl {
                font-size: 8px !important;
                width: 100% !important;
            }

                table.rev-sum-tbl thead th, table.rev-sum-tbl tbody td {
                    padding: 4px 6px !important;
                    font-size: 8px !important;
                }

            .print-input {
                border: none !important;
                background: transparent !important;
                box-shadow: none !important;
                font-size: 8px !important;
                width: 100% !important;
                padding: 0 !important;
            }

            .perf-cards {
                flex-wrap: nowrap !important;
                gap: 5px !important;
            }

            .perf-card {
                padding: 6px 8px !important;
                min-width: 0 !important;
                flex: 1 !important;
            }

            .pc-val {
                font-size: 14px !important;
            }

            .pc-lbl {
                font-size: 7px !important;
            }

            .pc-sub {
                font-size: 8px !important;
            }

            .emp-strip {
                padding: 8px 12px !important;
                gap: 14px !important;
            }

            .esp-val {
                font-size: 10px !important;
            }

            .vgl-letterhead {
                padding: 12px 16px !important;
                margin-bottom: 10px !important;
            }

            .vgl-lh-name {
                font-size: 13px !important;
            }

            .sig-section {
                margin-top: 16px !important;
            }

            .ba-banner-warn, .ba-banner-ok {
                padding: 8px 10px !important;
                margin-bottom: 8px !important;
            }

            .ba-banner-icon {
                font-size: 1rem !important;
            }

            .overall-strip {
                padding: 8px 12px !important;
                gap: 10px !important;
            }

            .score-mini-tbl {
                min-width: 0 !important;
            }

                .score-mini-tbl table td {
                    padding: 4px 8px !important;
                    font-size: 9px !important;
                }

            .score-sub-lbl {
                font-size: 7px !important;
            }

            td.td-ba-single {
                font-size: 7px !important;
            }
        }

        @@page {
            size: landscape;
            margin: 8mm;
        }
    </style>
</head>
<body>
    <div class="page">

        <!-- ══ TOOLBAR ══ -->
        <div class="toolbar">
            <div class="toolbar-title">📋 Appraisal Print — @Model.EmpName (@Model.EmpCode)</div>
            <div class="view-badge-bar">
                <button class="vb vb-1 active" id="vbtn-1" onclick="switchView(1)">💰 Increment Sheet</button>
                <button class="vb vb-2" id="vbtn-2" onclick="switchView(2)">📊 Final Summary</button>
                <button class="vb vb-3" id="vbtn-3" onclick="switchView(3)">🔍 All Reviewer Scores</button>
            </div>
            <button class="btn-t btn-close-t" onclick="window.close()">✕ Close</button>
            <button class="btn-t btn-print-t" onclick="triggerPrint()">🖨 Print / PDF</button>
        </div>

        <!-- ══════════════════════════════════════════════════
             VIEW 1 — INCREMENT SHEET
        ══════════════════════════════════════════════════ -->
        <div class="view-panel active" id="view1">

            <div class="vgl-letterhead">
                <div class="vgl-lh-badge">V</div>
                <div>
                    <div class="vgl-lh-name">Vandana Global Limited</div>
                    <div class="vgl-lh-sub">Performance Appraisal &amp; Salary Increment</div>
                </div>
                <div class="vgl-lh-right">
                    <div class="vgl-doc-type">💰 Increment Sheet</div>
                    <div class="vgl-fy-info">@fyLabel &nbsp;|&nbsp; Default Increment Date: @incrDateStr</div>
                    @if (!string.IsNullOrWhiteSpace(cycleInfo))
                    {
                        <div class="vgl-fy-info">Cycle: @cycleInfo</div>
                    }
                    <div class="vgl-fy-info" style="margin-top:4px;opacity:.6">Printed: @DateTime.Now.ToString("dd-MMM-yyyy HH:mm")</div>
                </div>
            </div>

            <div class="emp-strip">
                <div class="emp-strip-item"><span class="esp-lbl">EMP Code</span><span class="esp-val">@Model.EmpCode</span></div>
                <div class="emp-strip-item"><span class="esp-lbl">Employee Name</span><span class="esp-val">@Model.EmpName</span></div>
                <div class="emp-strip-item"><span class="esp-lbl">Designation</span><span class="esp-val">@(string.IsNullOrWhiteSpace(Model.Designation) ? "—" : Model.Designation)</span></div>
                <div class="emp-strip-item"><span class="esp-lbl">Department</span><span class="esp-val">@(string.IsNullOrWhiteSpace(Model.Department) ? "—" : Model.Department)</span></div>
                <div class="emp-strip-item"><span class="esp-lbl">Sub Department</span><span class="esp-val">@subDeptDisplay</span></div>
                <div class="emp-strip-item"><span class="esp-lbl">Appraisal Year</span><span class="esp-val">@fyLabel</span></div>
                <div class="emp-strip-item"><span class="esp-lbl">Increment Date</span><span class="esp-val" style="color:#059669">@incrDateStr</span></div>
                @if (!string.IsNullOrWhiteSpace(Model.RmName))
                {
                    <div class="emp-strip-item"><span class="esp-lbl">Reporting Manager</span><span class="esp-val" style="font-size:12px">@Model.RmName</span></div>
                }
            </div>

            <!-- ── BA Status Banner ── -->
            @if (!behAuditCompleted)
            {
                <div class="ba-banner-warn">
                    <span class="ba-banner-icon">⚠️</span>
                    <div>
                        <div class="ba-banner-title-warn">Behavioural Audit Not Completed</div>
                        <div class="ba-banner-sub">
                            @if (!behAuditExists)
                            {
                                <text>No Behavioural Audit initiated. Final score is based on PMS (BSC) only.</text>
                            }
                            else
                            {
                                <text>Behavioural Audit in progress but not finalized. Final score is based on PMS (BSC) only.</text>
                            }
                            @if (jmdOverallRating.HasValue)
                            {
                                <text> &nbsp;→&nbsp; <strong style="color:#e11d48">JMD Override: @jmdOverallRating.Value.ToString("0.##")</strong> (Final Authority)</text>
                            }
                            else if (mcOverallRating.HasValue)
                            {
                                <text> &nbsp;→&nbsp; <strong style="color:#e11d48">MC Override: @mcOverallRating.Value.ToString("0.##")</strong></text>
                            }
                        </div>
                    </div>
                    <div class="ba-banner-chip ba-banner-chip-warn">
                        <div class="ba-chip-lbl">Weighted Rating</div>
                        <div class="ba-chip-val-warn">@weightedRating.ToString("0.##")</div>
                    </div>
                </div>
            }
            else
            {
                <div class="ba-banner-ok">
                    <span class="ba-banner-icon">✅</span>
                    <div>
                        <div class="ba-banner-title-ok">Both Assessments Completed</div>
                        <div class="ba-banner-sub">
                            BSC @bscScore.ToString("0.##") × 80% (@pmsWeightedComponent.ToString("0.##")) + Behavioural @behScore.ToString("0.##") × 20% (@baWeightedComponent.ToString("0.##"))
                            = <strong style="color:#059669">@weightedRating.ToString("0.##")</strong>
                            @if (jmdOverallRating.HasValue)
                            {
                                <text>&nbsp;→&nbsp;<strong style="color:#9d174d">👑 JMD Override: @jmdOverallRating.Value.ToString("0.##")</strong> <span style="color:#64748b;font-size:10px">(Final Authority)</span></text>
                            }
                            else if (mcOverallRating.HasValue)
                            {
                                <text>&nbsp;→&nbsp;<strong style="color:#c2410c">⚖️ MC Override: @mcOverallRating.Value.ToString("0.##")</strong></text>
                            }
                        </div>
                    </div>
                    <div class="ba-banner-chip ba-banner-chip-ok">
                        <div class="ba-chip-lbl">Weighted Rating</div>
                        <div class="ba-chip-val-ok">@weightedRating.ToString("0.##")</div>
                    </div>
                </div>
            }

            <!-- ── Performance Analysis Cards ── -->
            <div class="s-head">📊 Performance Analysis</div>
            <div class="perf-cards">
                <div class="perf-card pc-blue">
                    <div class="pc-lbl">BSC Score (PMS)</div>
                    <div class="pc-val">@bscScore.ToString("0.##")</div>
                    <div class="pc-sub">Raw PMS score</div>
                </div>
                @if (behAuditCompleted)
                {
                    <div class="perf-card" style="border-top:3px solid #1d4ed8;background:#eff6ff">
                        <div class="pc-lbl">BA Score</div>
                        <div class="pc-val" style="color:#1d4ed8">@behScore.ToString("0.##")</div>
                        <div class="pc-sub">Behavioural Audit avg</div>
                    </div>
                }
                <div class="perf-card" style="border-top:3px solid #ca8a04;background:#fefce8">
                    <div class="pc-lbl">Weighted Rating<br /><span style="font-size:9px;color:#94a3b8">(PMS×0.8 + BA×0.2)</span></div>
                    <div class="pc-val" style="color:#ca8a04">@weightedRating.ToString("0.##")</div>
                    <div class="pc-sub">@(behAuditCompleted ? $"{pmsWeightedComponent.ToString("0.##")} + {baWeightedComponent.ToString("0.##")}" : "BSC only (BA pending)")</div>
                </div>
                @if (mcOverallRating.HasValue)
                {
                    <div class="perf-card" style="border-top:3px solid #c2410c">
                        <div class="pc-lbl">MC Overall Rating</div>
                        <div class="pc-val" style="color:#c2410c">@mcOverallRating.Value.ToString("0.##")</div>
                        <div class="pc-sub">Single overall / 5.00</div>
                    </div>
                }
                @if (jmdOverallRating.HasValue)
                {
                    <div class="perf-card" style="border-top:3px solid #9d174d">
                        <div class="pc-lbl">JMD Overall Rating</div>
                        <div class="pc-val" style="color:#9d174d">@jmdOverallRating.Value.ToString("0.##")</div>
                        <div class="pc-sub">Single overall / 5.00</div>
                    </div>
                }
                @if (patPercent > 0)
                {
                    <div class="perf-card pc-navy">
                        <div class="pc-lbl">PAT / Revenue %</div>
                        <div class="pc-val">@patPercent.ToString("0.####")%</div>
                        <div class="pc-sub">@fyLabel</div>
                    </div>
                }
                <div class="perf-card pc-green">
                    <div class="pc-lbl">Base Percentage</div>
                    <div class="pc-val" style="color:#059669">@basePercent.ToString("0.##")%</div>
                    <div class="pc-sub">From PAT Range Master</div>
                </div>
                <div class="perf-card" style="border-top:3px solid #7c3aed">
                    <div class="pc-lbl">Hike over Base %</div>
                    <div class="pc-val" style="color:#7c3aed">@(hikeOverBase >= 0 ? "+" : "")@hikeOverBase.ToString("0.##")%</div>
                    <div class="pc-sub">Rating @calcRating adjustment</div>
                </div>
                <div class="perf-card" style="border-top:3px solid #1e4ed8;background:#eff4ff">
                    <div class="pc-lbl">Final Increment %</div>
                    <div class="pc-val" style="color:#1e4ed8;font-size:24px">@finalIncrPct.ToString("0.####")%</div>
                    <div class="pc-sub">Base × (1 + Hike/100)</div>
                </div>
            </div>

            <!-- ── Increment Summary Table ── -->
            <div class="incr-wrap">
                <div class="incr-tbl-head">
                    <span style="font-size:1rem">💰</span>
                    <span class="incr-tbl-head-title">Salary Increment Summary — @fyLabel</span>
                    <span style="margin-left:auto;font-size:10px;color:rgba(255,255,255,.5);font-family:'Courier New',monospace">
                        Weighted Rating: @weightedRating.ToString("0.##") &nbsp;|&nbsp; Final Increment: @(finalIncrPct > 0 ? finalIncrPct.ToString("0.####") + "%" : "—")
                    </span>
                </div>
                <div class="incr-notice">
                    @if (isAnnualCycle)
                    {
                        <text>✏️ <strong>Current Gross Salary</strong> is fetched from system records. Enter <strong>Last Year Increment</strong> and select the <strong>Increment Date</strong> to complete the calculation before printing.</text>
                    }
                    else
                    {
                        <text>ℹ️ Salary increment details are only available for <strong>Annual</strong> appraisal cycles. Current cycle: <strong>@Model.AppraisalCycle</strong></text>
                    }
                </div>
                <div class="incr-scrl">
                    <table class="incr-tbl">
                        <thead>
                            <tr>
                                <th>EMP Code</th>
                                <th>Employee Name</th>
                                <th>Designation</th>
                                <th>Department</th>
                                <th>Sub Department</th>
                                <th>Increment Date</th>
                                @if (isAnnualCycle)
                                {
                                    <th>Current Gross<br />Salary (₹)</th>
                                    <th>Increment<br />Amount (₹)</th>
