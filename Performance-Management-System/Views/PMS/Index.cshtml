function editKpi(pmpId, kraId, pmpName, kraName) {
    // Clean up any previous edit banner
    document.querySelectorAll('.kpi-edit-mode-notice').forEach(function(el) { el.remove(); });

    // Switch to KPI tab
    switchTab(3);
    window.scrollTo({ top: 0, behavior: 'smooth' });

    var pmpSel = document.getElementById('kpiPmpSel');
    var kraSel = document.getElementById('kpiKraSel');
    var card   = document.getElementById('kpiEntryCard');

    // Step 1: Set PMP and rebuild KRA dropdown WITHOUT hiding the card
    if (pmpSel) {
        pmpSel.value = String(pmpId);
        onKpiPmpChange(true);   // ← true = suppressCardHide
    }

    // Step 2: Set KRA value
    if (kraSel) {
        kraSel.value = String(kraId);
    }

    // Step 3: Show card with loading state immediately
    if (card) {
        card.style.display = 'block';
        document.getElementById('kpiRowsContainer').innerHTML =
            '<div style="text-align:center;padding:24px;color:var(--ink4)">' +
            '<span style="font-size:1.3rem;display:block;margin-bottom:8px">⏳</span>' +
            'Loading KPIs for <strong>' + esc(kraName) + '</strong>…</div>';
        card.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // Step 4: Fetch existing KPI rows for this PMP+KRA
    fetch(GET_MAPPING_URL + '?pmpId=' + pmpId + '&kraId=' + kraId)
        .then(function(r) { return r.json(); })
        .then(function(data) {
            clearKpiRows(true);

            if (data && data.length > 0) {
                data.forEach(function(k) {
                    addKpiRow({
                        kpiId:               k.kpiId,
                        kpiName:             k.kpiName,
                        unitOfMeasure:       k.unitOfMeasure || '%',
                        individualWeightage: parseFloat(k.individualWeightage) || 0,
                        target:              parseFloat(k.target) || 0
                    });
                });
            } else {
                addKpiRow();
            }

            recalcWeight();

            // Show edit mode notice at top of card
            var cardEl = document.getElementById('kpiEntryCard');
            if (cardEl) {
                var notice = document.createElement('div');
                notice.className = 'kpi-edit-mode-notice';
                notice.style.cssText =
                    'background:#eff6ff;border:1.5px solid #93c5fd;color:#1e40af;' +
                    'border-radius:8px;padding:10px 14px;margin-bottom:14px;' +
                    'font-size:.78rem;font-weight:600;display:flex;gap:8px;align-items:center';
                notice.innerHTML =
                    '✏️ Editing: <strong>' + esc(pmpName) + ' › ' + esc(kraName) + '</strong>' +
                    ' &nbsp;—&nbsp; ' + (data ? data.length : 0) + ' KPI(s) loaded. ' +
                    'Changes will sync to all active employee mappings on save.';
                cardEl.insertBefore(notice, cardEl.firstChild);
            }

            showToast(
                (data && data.length ? data.length : 0) +
                ' KPI(s) loaded for "' + esc(kraName) + '" — edit and save.',
                'ok'
            );
        })
        .catch(function(e) {
            clearKpiRows(true);
            addKpiRow();
            recalcWeight();
            showToast('Could not load KPIs: ' + e.message, 'err');
        });
}
function refreshKpiTable() {
    fetch(GET_ALL_KPIS_URL)
        .then(function(r) { return r.json(); })
        .then(function(data) {
            var tb = document.getElementById('kpiTbody');

            if (!data || !data.length) {
                tb.innerHTML =
                    '<tr class="ge-empty" id="kpiEmptyRow"><td colspan="8">' +
                    '<span class="ge-empty-icon">&#128202;</span>No KPIs saved yet.</td></tr>';
                document.getElementById('kpiCount').textContent = '0 record(s)';
                var statVals = document.querySelectorAll('#section-3 .stat-val');
                if (statVals[0]) statVals[0].textContent = '0';
                return;
            }

            // First pass — build PMP groups
            var pmpGroups = {};
            var pmpOrder  = [];
            data.forEach(function(k) {
                if (!pmpGroups[k.pmpId]) {
                    pmpGroups[k.pmpId] = {
                        firstKpiId:       k.kpiId,
                        count:            0,
                        overallWeightage: k.overallWeightage
                    };
                    pmpOrder.push(k.pmpId);
                }
                pmpGroups[k.pmpId].count++;
                pmpGroups[k.pmpId].overallWeightage = k.overallWeightage;
            });

            // Second pass — build HTML
            var srNo       = 1;
            var seenPmpIds = [];
            var html = data.map(function(k) {
                var grp         = pmpGroups[k.pmpId];
                var isFirst     = grp.firstKpiId === k.kpiId;
                var isSeparator = isFirst && seenPmpIds.length > 0;
                if (isFirst) seenPmpIds.push(k.pmpId);

                var span        = grp.count;
                var pmpCell     = isFirst
                    ? '<td class="pmp-group-cell" rowspan="' + span + '">' + esc(k.pmpName) + '</td>'
                    : '';
                var overallCell = isFirst
                    ? '<td class="overall-wt-cell" rowspan="' + span + '">' + grp.overallWeightage + '%</td>'
                    : '';

                return '<tr id="kpi-row-' + k.kpiId + '"' +
                    (isSeparator ? ' class="pmp-group-start"' : '') + '>' +
                    '<td style="color:var(--ink4);font-family:var(--mono)">' + srNo++ + '</td>' +
                    pmpCell +
                    '<td class="plain-cell">'                         + esc(k.kraName)        + '</td>' +
                    '<td class="plain-cell" style="font-weight:600">' + esc(k.kpiName)        + '</td>' +
                    '<td class="td-center plain-cell">'               + esc(k.unitOfMeasure)  + '</td>' +
                    '<td class="num-cell">'                           + k.individualWeightage + '%</td>' +
                    overallCell +
                    '<td class="num-cell" style="color:var(--teal)">' + k.target             + '%</td>' +
                    '<td><div class="row-acts">' +
                        '<button class="btn btn-warn btn-xs" onclick="editKpi(' +
                            k.pmpId + ',' + k.kraId + ',\'' +
                            esc(k.pmpName) + '\',\'' + esc(k.kraName) +
                        '\')">\u270F Edit</button>' +
                        '<button class="btn btn-danger btn-xs" onclick="deleteKpi(' +
                            k.kpiId +
                        ')">\uD83D\uDDD1</button>' +
                    '</div></td>' +
                '</tr>';
            }).join('');

            tb.innerHTML = html;

            // Update badge + stat cards
            document.getElementById('kpiCount').textContent = data.length + ' record(s)';
            var statVals = document.querySelectorAll('#section-3 .stat-val');
            if (statVals[0]) statVals[0].textContent = data.length;
            if (statVals[1]) statVals[1].textContent = pmpOrder.length;
        })
        .catch(function() { showToast('Could not refresh KPI list.', 'err'); });
}
/* ══════════════════════════════════════════════════════
   TAB 4 — EMPLOYEE MAPPING
══════════════════════════════════════════════════════ */
var _mappedKpiEntries = [];
var _mapUidSeq = 0;
var _editMappingId = 0;
var _changeLog = [];

function logChange(fieldName, oldVal, newVal) {
    if (String(oldVal) === String(newVal)) return;
    _changeLog.push({ FieldName: String(fieldName), OldValue: String(oldVal), NewValue: String(newVal) });
    renderChangeLogBanner();
}

function renderChangeLogBanner() {
    var banner = document.getElementById('changeLogBanner');
    var list   = document.getElementById('changeLogList');
    if (!banner || !list) return;
    if (_editMappingId > 0 && _changeLog.length > 0) {
        banner.style.display = 'flex';
        var recent = _changeLog.slice(-6);
        list.innerHTML = recent.map(function(c){
            return '<li>' + esc(c.FieldName) + ': <span style="color:#b45309">' + esc(c.OldValue) + '</span> → <span style="color:#059669">' + esc(c.NewValue) + '</span></li>';
        }).join('');
    } else {
        banner.style.display = 'none';
    }
}

function persistChangeLog(mappingId, actionType) {
    if (!_changeLog.length) return;
    var payload = {
        MappingId: mappingId,
        ActionType: actionType || (_editMappingId > 0 ? 'EDIT' : 'CREATE'),
        Changes: _changeLog.map(function(c){ return { FieldName: c.FieldName, OldValue: c.OldValue, NewValue: c.NewValue }; }),
        SessionJson: null
    };
    fetch(SAVE_CHANGELOG_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
    }).catch(function(){});
}

