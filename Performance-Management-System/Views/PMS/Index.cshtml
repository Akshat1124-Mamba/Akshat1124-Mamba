function editSentCycle(mappingId) {
    _isEditCycleMode    = true;
    _editCycleMappingId = mappingId;

    var m = ALL_MAPPED_EMPLOYEES.find(function(e) { return e.mappingId === mappingId; });
    if (!m) { showToast('Mapping data not found. Refresh and try again.', 'err'); return; }

    switchS5Tab('assign');

    /* show edit mode banner */
    var banner = document.getElementById('editModeBanner');
    if (banner) {
        banner.style.display = 'flex';
        var bt = document.getElementById('editModeBannerText');
        if (bt) bt.textContent =
            'Employee: ' + esc(m.empName || '') +
            '  |  Cycle: '  + esc(m.appraisalCycle || '—') +
            '  |  Status: ' + esc(m.status || 'Draft');
    }

    /* swap send button to Update Cycle */
    var lbl  = document.getElementById('assignSendBtnLabel');
    var icon = document.getElementById('assignSendBtnIcon');
    var btn  = document.getElementById('assignSendBtn');
    if (lbl)  lbl.textContent  = 'Update Cycle';
    if (icon) icon.textContent = '✏️';
    if (btn)  { btn.classList.remove('btn-success'); btn.classList.add('btn-warn'); }

    /* pre-fill employee search field */
    document.getElementById('assignEmpSearch').value = esc(m.empName || '') + ' (' + esc(m.empCode || '') + ')';
    document.getElementById('assignEmpSel').value    = mappingId;

    /* load full detail */
    fetch(GET_MAPPING_DETAIL + '?mappingId=' + mappingId)
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.error) { showToast(data.error, 'err'); return; }

            _assignSelectedMappingId = mappingId;
            _assignSelectedEmpData   = data;

            /* employee info strip */
            var strip = document.getElementById('assignEmpInfoStrip');
            if (strip) strip.style.display = 'block';
            document.getElementById('assignEmpStripName').textContent  = data.empName    || '';
            document.getElementById('assignEmpStripCode').textContent  = data.empCode    || '';
            document.getElementById('assignEmpStripDesig').textContent = data.designation || '';
            document.getElementById('assignEmpStripDept').textContent  = data.department  || '';

            /* show steps + clear button */
            document.getElementById('assignStepsWrap').style.display  = 'block';
            document.getElementById('assignEmpClearBtn').style.display = 'flex';

            /* year */
            document.getElementById('assignYear').value = m.appraisalYear || new Date().getFullYear();

            /* cycle pill */
            var cycle = data.appraisalCycle || m.appraisalCycle || '';
            document.getElementById('assignCycleName').value = cycle;
            document.querySelectorAll('#assignCyclePills .kpi-ftab').forEach(function(b) {
                b.classList.remove('active', 'disabled-cycle'); b.title = '';
            });
            if (cycle) {
                var pill = document.getElementById('assignPill-' + cycle);
                if (pill) pill.classList.add('active');
            }

            /* dates — GET_MAPPING_DETAIL returns yyyy-MM-dd */
            var fromISO = data.cycleFromDate || '';
            var toISO   = data.cycleToDate   || '';
            document.getElementById('assignFromDate').value = fromISO;
            document.getElementById('assignToDate').value   = toISO;
            if (fromISO || toISO) updateAssignDateDisplay(cycle || 'Custom', fromISO, toISO);

            /* reviewers */
            setSelVal('assignRmName',   data.rmName            || '');
            setSelVal('assignHodName',  data.hodName           || '');
            setSelVal('assignUhName',   data.unitHeadName      || '');
            setSelVal('assignModNames', data.modCommitteeNames || '');
            setSelVal('assignJmdName',  data.jmdName           || '');

            /* KPI readonly panel */
            renderAssignKpiReadonly(data.kpiRows || []);

            /* used cycles — exclude the one being edited so it stays selectable */
            var usedCycles = getUsedCyclesForEmp(data.empCode, m.appraisalYear)
                .filter(function(c) { return c !== cycle; });
            applyDisabledCyclePills(usedCycles);

            document.getElementById('assignStepsWrap').scrollIntoView({ behavior: 'smooth', block: 'start' });
        })
        .catch(function(e) { showToast('Could not load mapping: ' + e.message, 'err'); });
}

