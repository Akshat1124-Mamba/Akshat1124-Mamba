        return;
    }

    var html = cycleData.map(function(m, i) {
   var airStore     = _airDetailStore[m.mappingId] || {};
var hasMcRating  = airStore._mcRating  != null && airStore._mcRating  > 0;
var hasJmdRating = airStore._jmdRating != null && airStore._jmdRating > 0;
