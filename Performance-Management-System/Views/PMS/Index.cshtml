function openAssignEmpDropdown(){ filterAssignEmpDropdown(); document.getElementById('assignEmpDropdownList').style.display = 'block'; _assignEmpDropOpen = true; }

function filterAssignEmpDropdown(){
    var query = (document.getElementById('assignEmpSearch').value || '').toLowerCase().trim();
    var inner = document.getElementById('assignEmpDropdownInner');
    var noRes = document.getElementById('assignEmpNoResults');
    var filtered = query
        ? ALL_MAPPED_EMPLOYEES.filter(function(e){ return (e.empName || '').toLowerCase().indexOf(query) >= 0 || (e.empCode || '').toLowerCase().indexOf(query) >= 0; })
        : ALL_MAPPED_EMPLOYEES;
    if (!filtered.length) { inner.innerHTML = ''; noRes.style.display = 'block'; return; }
    noRes.style.display = 'none';
    inner.innerHTML = filtered.slice(0, 80).map(function(e){
        var displayText = esc(e.empName) + ' (' + esc(e.empCode) + ')';
        var hi = query ? displayText.replace(new RegExp('(' + escRegex(query) + ')', 'gi'), '<strong style="color:var(--cobalt)">$1</strong>') : displayText;
        return '<div class="emp-drop-item" data-value="' + e.mappingId + '" data-text="' + esc(e.empName) + ' (' + esc(e.empCode) + ')" onclick="selectAssignEmpItem(this)" onmouseenter="this.style.background=\'var(--cobalt-lt)\'" onmouseleave="this.style.background=\'\'" style="padding:10px 16px;cursor:pointer;font-size:.80rem;color:var(--ink2);border-bottom:1px solid var(--border2)">' + hi + '<div style="font-size:.65rem;color:var(--ink4)">' + esc(e.designation || '') + ' · ' + esc(e.department || '') + '</div></div>';
    }).join('');
    document.getElementById('assignEmpDropdownList').style.display = 'block';
}

function selectAssignEmpItem(el){
    document.getElementById('assignEmpSel').value = el.dataset.value;
    document.getElementById('assignEmpSearch').value = el.dataset.text;
    document.getElementById('assignEmpDropdownList').style.display = 'none';
