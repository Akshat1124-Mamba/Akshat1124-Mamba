function addMappedKpiEntry(){
    var pmpId   = document.getElementById('mapPmpSel').value;
    var kraId   = document.getElementById('mapKraSel').value;
    var kpiId   = document.getElementById('mapKpiSel').value;
    var kpiName = (document.getElementById('mapKpiNameInput').value || '').trim();
    var unit    = document.getElementById('mapKpiUnitInput').value;
    var wt      = parseFloat(document.getElementById('mapKpiWeightInput').value) || 0;
    var target  = parseFloat(document.getElementById('mapKpiTargetInput').value) || 0;
    if (!pmpId || !kraId || !kpiId) { showToast('Please select PMP, KRA and KPI.', 'err'); return; }
    if (!kpiName) { showToast('KPI Name cannot be empty.', 'err'); return; }
   // ── REPLACE WITH THIS ──
    if (_mappedKpiEntries.find(function(e){ return String(e.kpiId) === String(kpiId); })) { showToast('This KPI is already added.', 'err'); return; }

    var currentTotal = Math.round(
        _mappedKpiEntries.reduce(function(sum, e){ return sum + (parseFloat(e.individualWeightage) || 0); }, 0) * 100
    ) / 100;
    var projectedTotal = Math.round((currentTotal + wt) * 100) / 100;
    if (projectedTotal > 100) {
        showBlockedModal(
            'Cannot Add KPI — Weightage Exceeds 100%',
            'Adding "' + esc(kpiName) + '" at ' + wt + '% would bring the total individual weightage to ' +
            projectedTotal + '%, which exceeds the maximum of 100%. Current total: ' + currentTotal + '%.',
            [
                'Lower the weightage entered for "' + esc(kpiName) + '" so the total stays at or under 100%, or',
                'Reduce the weightage of one or more already-added KPIs first, then add this one.'
            ]
        );
        return;
    }

    var pmpSel = document.getElementById('mapPmpSel');
    var kraSel = document.getElementById('mapKraSel');
    var pmpName = pmpSel.options[pmpSel.selectedIndex].text.replace(/^\d+ – /, '').trim();
    var kraName = kraSel.options[kraSel.selectedIndex].text.replace(/^[A-Z0-9]+ – /, '').trim();
    _mapUidSeq++;
    _mappedKpiEntries.push({
        _uid: _mapUidSeq,
        pmpId: parseInt(pmpId), pmpName: pmpName,
        kraId: parseInt(kraId), kraName: kraName,
        kpiId: parseInt(kpiId), kpiName: kpiName,
        unitOfMeasure: unit, individualWeightage: wt, target: target,
        _origWeight: wt, _origTarget: target, _origName: kpiName
    });
    logChange('KPI Added: ' + kpiName, '', 'Wt=' + wt + '% Target=' + target);
// ── REPLACE WITH ──
    document.getElementById('mapKpiSel').value = '';
    document.getElementById('mapKpiEntryCard').style.display = 'none';
    var addBtn = document.getElementById('addMappedKpiBtn');
    if (addBtn) { addBtn.disabled = false; addBtn.style.opacity = ''; addBtn.style.cursor = ''; }
    var warnEl = document.getElementById('mapKpiWtWarning');
    if (warnEl) warnEl.style.display = 'none';
    renderMappedKpiGroups();
    showToast('KPI "' + kpiName + '" added.', 'ok');
}

function removeMappedKpiEntry(uid){
    var entry = _mappedKpiEntries.find(function(e){ return e._uid === uid; });
    if (entry) logChange('KPI Removed: ' + entry.kpiName, 'Wt=' + entry.individualWeightage + '%', '');
    _mappedKpiEntries = _mappedKpiEntries.filter(function(e){ return e._uid !== uid; });
    renderMappedKpiGroups();
}

function syncEntryField(uid, field, value, origValue) {
    var entry = _mappedKpiEntries.find(function(e){ return e._uid === uid; });
    if (!entry) return;
    entry[field] = (field === 'individualWeightage' || field === 'target') ? (parseFloat(value) || 0) : value;
    if (origValue !== null && String(origValue) !== String(entry[field])) {
        logChange(esc(entry.kpiName || field) + ' → ' + field, origValue, entry[field]);
    }
    recalcMappingWeight();
}

function syncAllEntriesFromDOM() {
    _mappedKpiEntries.forEach(function(e){
        var nameEl = document.getElementById('map-name-' + e._uid);
        var unitEl = document.getElementById('map-unit-' + e._uid);
        var wtEl   = document.getElementById('map-wt-'   + e._uid);
        var tgtEl  = document.getElementById('map-tgt-'  + e._uid);
        if (nameEl) e.kpiName            = nameEl.value;
        if (unitEl) e.unitOfMeasure       = unitEl.value;
        if (wtEl)   e.individualWeightage = parseFloat(wtEl.value)  || 0;
        if (tgtEl)  e.target              = parseFloat(tgtEl.value) || 0;
    });
}

function renderMappedKpiGroups(){
    var container = document.getElementById('mappedKpiGroupsContainer');
    if (!_mappedKpiEntries.length) {
        container.innerHTML = '<div style="text-align:center;padding:32px 0;color:var(--ink4)"><span style="font-size:1.8rem;display:block;margin-bottom:8px;opacity:.3">&#128193;&#65039;</span>No KPIs added yet. Use the cascade above to add KPI entries.</div>';
        recalcMappingWeight();
        return;
    }
    var pmpOrder = [], pmpMap = {};
    _mappedKpiEntries.forEach(function(e){
        if (!pmpMap[e.pmpId]) { pmpMap[e.pmpId] = { pmpId: e.pmpId, pmpName: e.pmpName, kras: {}, kraOrder: [] }; pmpOrder.push(e.pmpId); }
        var pm = pmpMap[e.pmpId];
        if (!pm.kras[e.kraId]) { pm.kras[e.kraId] = { kraId: e.kraId, kraName: e.kraName, entries: [] }; pm.kraOrder.push(e.kraId); }
        pm.kras[e.kraId].entries.push(e);
    });
    var html = '';
    pmpOrder.forEach(function(pmpId){
        var pm = pmpMap[pmpId]; var totalKpis = 0;
        pm.kraOrder.forEach(function(kid){ totalKpis += pm.kras[kid].entries.length; });
        html += '<div class="pmp-section-block"><div class="pmp-section-head"><span style="font-size:1rem">&#127919;</span><div class="pmp-section-head-title">' + esc(pm.pmpName) + '</div><span class="rec-badge" style="margin-left:auto">' + totalKpis + ' KPI(s)</span></div><div class="pmp-section-body">';
        pm.kraOrder.forEach(function(kraId){
            var kr = pm.kras[kraId];
            html += '<div class="kra-sub-group"><div class="kra-sub-head"><span style="font-size:.80rem">&#128204;</span><div class="kra-sub-head-title">' + esc(kr.kraName) + '</div><span style="font-size:.62rem;font-family:var(--mono);color:var(--ink4);margin-left:auto">' + kr.entries.length + ' KPI(s)</span></div><div class="kra-sub-body">';
            kr.entries.forEach(function(e, idx){
                html += '<div class="map-kpi-row"><span class="map-kpi-row-num">KPI ' + (idx + 1) + '</span>' +
                    '<div class="fg" style="margin-top:6px"><label>KPI Name</label>' +
                    '<input type="text" class="ge-input" id="map-name-' + e._uid + '" value="' + esc(e.kpiName) + '" oninput="syncEntryField(' + e._uid + ',\'kpiName\',this.value,' + JSON.stringify(e._origName || e.kpiName) + ')" /></div>' +
                    '<div class="fg" style="margin-top:6px"><label>Unit</label><select class="ge-input" id="map-unit-' + e._uid + '" onchange="syncEntryField(' + e._uid + ',\'unitOfMeasure\',this.value,null)">' +
                    ['%','Number','Days','Score'].map(function(u){ return '<option value="' + u + '"' + (e.unitOfMeasure === u ? ' selected' : '') + '>' + u + '</option>'; }).join('') + '</select></div>' +
                    '<div class="fg" style="margin-top:6px"><label>Indiv. Wt %</label>' +
                    '<input type="number" class="ge-input" id="map-wt-' + e._uid + '" min="0" max="100" step="0.01" value="' + e.individualWeightage + '" oninput="syncEntryField(' + e._uid + ',\'individualWeightage\',this.value,' + e._origWeight + ')" /></div>' +
                    '<div class="fg" style="margin-top:6px"><label>Target</label>' +
                    '<input type="number" class="ge-input" id="map-tgt-' + e._uid + '" min="0" step="0.01" value="' + e.target + '" oninput="syncEntryField(' + e._uid + ',\'target\',this.value,' + e._origTarget + ')" /></div>' +
                    '<div class="fg kpi-del-wrap" style="margin-top:6px"><label>&nbsp;</label><button type="button" class="kpi-del-btn" onclick="removeMappedKpiEntry(' + e._uid + ')" title="Remove">&#10005;</button></div></div>';
            });
            html += '</div></div>';
        });
        html += '</div></div>';
    });
    container.innerHTML = html;
    recalcMappingWeight();
}

function recalcMappingWeight(){
    _mappedKpiEntries.forEach(function(e){
        var wtEl = document.getElementById('map-wt-' + e._uid);
        if (wtEl) e.individualWeightage = parseFloat(wtEl.value) || 0;
    });
    var total = _mappedKpiEntries.reduce(function(sum, e){ return sum + (parseFloat(e.individualWeightage) || 0); }, 0);
    total = Math.round(total * 100) / 100;
    var wtEl   = document.getElementById('mappingTotalWt');
    var fillEl = document.getElementById('mappingWtFill');
    var barEl  = document.getElementById('mappingWtBarEl');
    var msgEl  = document.getElementById('mappingWtMsg');
    var notice = document.getElementById('wtExactNotice');
    var curr   = document.getElementById('wtExactCurrent');
    if (wtEl)   wtEl.textContent = total + '%';
    if (fillEl) fillEl.style.width = Math.min(total, 100) + '%';
    var isOk = (Math.abs(total - 100) < 0.01);
    if (barEl)  barEl.classList.toggle('ok', isOk);
    if (msgEl)  msgEl.textContent = isOk ? '✔ Weightage is exactly 100% — ready to save' : '⚠ Must be exactly 100% to save (currently ' + total + '%)';
    if (notice) notice.style.display = (!isOk && _mappedKpiEntries.length > 0) ? 'flex' : 'none';
    if (curr)   curr.textContent = total + '%';
}
function updateWeightageBar() { recalcMappingWeight(); }
