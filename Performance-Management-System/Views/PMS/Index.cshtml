/* ─ CSV fallback (when xlsx not available) ─ */
function _exportAnnualExcelCSV(visibleRows) {
    var headers = [
        'S.No','EMP Code','Employee Name','Designation','Department',
        'Unit','Date of Joining',                                     // ← NEW
        'Year',
        'PMS Self','PMS RM','PMS HOD','PMS UH','PMS Avg',
        'BA RM','BA HOD','BA Avg',
        'Weighted Rating',
        'MC Rating','JMD Rating',
        'Final Rating','Final Incr %',
        'JMD Signature'                                               // ← NEW
    ];

    var csvRows = [headers.map(function(h){ return '"'+h+'"'; }).join(',')];

    visibleRows.forEach(function(row, idx) {
        var mid = parseInt(row.getAttribute('data-mappingid'));
        var d   = _airDetailStore[mid] || {};
        var cols = row.querySelectorAll('td');
        var mcInput  = row.querySelector('.air-mc-input');
        var jmdInput = row.querySelector('.air-jmd-input');

        var unitName = row.getAttribute('data-unit') || '';
        var dojRaw   = row.getAttribute('data-doj')  || '';
        var dojDisplay = '';
        if (dojRaw) {
            try {
                var dojDate = new Date(dojRaw + (dojRaw.indexOf('T') < 0 ? 'T00:00:00' : ''));
                dojDisplay  = dojDate.toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'2-digit'});
            } catch(e) { dojDisplay = dojRaw; }
        }

        var line = [
            idx+1,
            cols[1] ? cols[1].textContent.trim() : '',
            cols[2] ? cols[2].textContent.trim() : '',
            cols[3] ? cols[3].textContent.trim() : '',
            cols[4] ? cols[4].textContent.trim() : '',
            unitName,                                                  // ← NEW
            dojDisplay,                                                // ← NEW
            row.getAttribute('data-year') || '',
            d._pmsWeightedSelf != null ? d._pmsWeightedSelf : '',
            d._pmsWeightedRM   != null ? d._pmsWeightedRM   : '',
            d._pmsWeightedHOD  != null ? d._pmsWeightedHOD  : '',
            d._pmsWeightedUH   != null ? d._pmsWeightedUH   : '',
            d._pmsFinalScore   != null ? d._pmsFinalScore   : '',
            d._baRmScore       != null ? d._baRmScore       : '',
            d._baHodScore      != null ? d._baHodScore      : '',
            d._baAvg           != null ? d._baAvg           : '',
            d._wtRating        != null ? d._wtRating        : '',
            mcInput  ? (mcInput.value  || '') : (d._mcRating  != null ? d._mcRating  : ''),
            jmdInput ? (jmdInput.value || '') : (d._jmdRating != null ? d._jmdRating : ''),
            d._finalRating  != null ? d._finalRating  : '',
            d._finalIncrPct != null ? d._finalIncrPct.toFixed(4)+'%' : '',
            ''                                                         // ← NEW JMD Signature (blank)
        ].map(function(v) { return '"' + String(v===null||v===undefined?'':v).replace(/"/g,'""') + '"'; }).join(',');
        csvRows.push(line);
    });

    var csv  = csvRows.join('\r\n');
    var blob = new Blob(['\uFEFF'+csv], {type:'text/csv;charset=utf-8;'});
    var url  = URL.createObjectURL(blob);
    var a    = document.createElement('a');
    a.href = url;
    a.download = 'VGL_AnnualReport_' + new Date().toISOString().slice(0,10) + '.csv';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    showToast('Annual Increment Report exported to CSV.', 'ok');
}
