function onKpiPmpChange(suppressCardHide) {
    document.querySelectorAll('.kpi-edit-mode-notice').forEach(function(el){ el.remove(); });

    var pmpId  = document.getElementById('kpiPmpSel').value;
    var kraSel = document.getElementById('kpiKraSel');
    kraSel.innerHTML = '';

    if (!pmpId) {
        kraSel.innerHTML = '<option value="">— Select a PMP first —</option>';
        kraSel.disabled = true;
        if (!suppressCardHide)
            document.getElementById('kpiEntryCard').style.display = 'none';
        return;
    }

    var filtered = ALL_KRA_DATA.filter(function(k) {
        return String(k.pmpId) === String(pmpId);
    });

    var ph = document.createElement('option');
    ph.value = '';
    ph.textContent = filtered.length
        ? '— Select KRA (' + filtered.length + ' available) —'
        : '— No KRAs linked to this PMP —';
    kraSel.appendChild(ph);

    filtered.forEach(function(k) {
        var opt = document.createElement('option');
        opt.value = k.kraId;
        opt.textContent = k.kraCode + ' – ' + k.kraName;
        kraSel.appendChild(opt);
    });

    kraSel.disabled = filtered.length === 0;

    // Only hide the card if NOT called from editKpi()
    if (!suppressCardHide) {
        document.getElementById('kpiEntryCard').style.display = 'none';
    }
}

function onMappingChange(suppressCardHide) {
    var pmpId = document.getElementById('kpiPmpSel').value;
    var kraId = document.getElementById('kpiKraSel').value;
    var card  = document.getElementById('kpiEntryCard');
    var banner = document.getElementById('pmpOverallBanner');

    if (!pmpId || !kraId) {
        if (!suppressCardHide) card.style.display = 'none';
        return;
    }

    // Show card immediately
    card.style.display = 'block';
    if (banner) banner.style.display = 'flex';

    fetch(GET_MAPPING_URL + '?pmpId=' + pmpId + '&kraId=' + kraId)
        .then(function(r) { return r.json(); })
        .then(function(data) {
            clearKpiRows(true);
            if (data && data.length > 0) {
                data.forEach(function(k) { addKpiRow(k); });
            } else {
                addKpiRow();
            }
            recalcWeight();
        })
        .catch(function() {
            clearKpiRows(true);
            addKpiRow();
        });
}

