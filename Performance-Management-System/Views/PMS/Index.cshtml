function showKpiSuggestions(val, suggestId, inputId) {
    var q = (val || '').trim().toLowerCase();
    var el = document.getElementById(suggestId); if (!el) return;
    if (!q || q.length < 2) { el.style.display = 'none'; return; }
    var matches = ALL_KPI_MASTER.filter(function(k){ return k.kpiName.toLowerCase().indexOf(q) >= 0; });
    if (!matches.length) { el.style.display = 'none'; return; }
    el.innerHTML = matches.slice(0,6).map(function(k){
        var isExact = k.kpiName.toLowerCase() === q;
        var dupClass = isExact ? ' is-duplicate' : '';
        var labelHtml = isExact
            ? '<span class="suggest-label" style="background:#fff1f2;color:#e11d48;border-color:#fecdd3;border:1px solid #fecdd3">⚠ duplicate</span>'
            : '<span class="suggest-label">' + esc(k.kraName) + '</span>';
        return '<div class="ge-suggest-item' + dupClass + '" onmousedown="document.getElementById(\'' + inputId + '\').value=' + JSON.stringify(k.kpiName) + ';hideSuggest(\'' + suggestId + '\')">'
            + labelHtml + buildHighlight(k.kpiName, val.trim()) + '</div>';
    }).join('');
    el.style.display = 'block';
}
