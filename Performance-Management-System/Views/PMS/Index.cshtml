function _removePmpRow(id) {
    console.log('[_removePmpRow] removing row for id=', id);

    var removed = false;

    // Strategy 1: find by button's onclick attribute
    document.querySelectorAll('#section-1 tbody tr').forEach(function(row) {
        var btn = row.querySelector('button.btn-danger');
        if (btn && btn.getAttribute('onclick') === 'deletePmp(' + id + ')') {
            row.remove();
            removed = true;
            console.log('[_removePmpRow] removed via strategy 1');
        }
    });

    // Strategy 2: find by data-id on edit button
    if (!removed) {
        document.querySelectorAll('#section-1 tbody tr').forEach(function(row) {
            var editBtn = row.querySelector('button[data-id="' + id + '"]');
            if (editBtn) {
                row.remove();
                removed = true;
                console.log('[_removePmpRow] removed via strategy 2');
            }
        });
    }

    // Strategy 3: search all text
    if (!removed) {
        document.querySelectorAll('#section-1 tbody tr').forEach(function(row) {
            if (row.innerHTML.indexOf('deletePmp(' + id + ')') !== -1) {
                row.remove();
                removed = true;
                console.log('[_removePmpRow] removed via strategy 3');
            }
        });
    }

    if (!removed) {
        console.warn('[_removePmpRow] row not found in DOM — reloading page');
        location.reload();
        return;
    }

    // Update badge and empty state
    var remaining = document.querySelectorAll('#section-1 tbody tr:not(.ge-empty)').length;
    var badge = document.getElementById('pmpCount');
    if (badge) badge.textContent = remaining + ' record(s)';

    if (remaining === 0) {
        var tb = document.querySelector('#section-1 tbody');
        if (tb) tb.innerHTML =
            '<tr class="ge-empty"><td colspan="4">' +
            '<span class="ge-empty-icon">&#128203;</span>No perspectives yet.</td></tr>';
    }

    // Update stat cards
    var cards = document.querySelectorAll('#section-1 .stat-val');
    if (cards[0]) cards[0].textContent = remaining;
    if (cards[1]) cards[1].textContent = remaining;
}

