/* ══ KEYWORD SUGGESTIONS ══ */
function buildHighlight(text, query) {
    if (!query) return esc(text);
    var re = new RegExp('(' + escRegex(query) + ')', 'gi');
    return esc(text).replace(re, '<span class="suggest-match">$1</span>');
}
function hideSuggest(id) {
    var el = document.getElementById(id); if (el) el.style.display = 'none';
}
function showPmpSuggestions(val) {
    var q = (val || '').trim().toLowerCase();
    var el = document.getElementById('pmpSuggest'); if (!el) return;
    if (!q || q.length < 2) { el.style.display = 'none'; return; }
    var allNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Pmps.Select(p => p.PmpName)));
    var matches = allNames.filter(function(name) { return name.toLowerCase().indexOf(q) >= 0; });
    if (!matches.length) { el.style.display = 'none'; return; }
    el.innerHTML = matches.slice(0,6).map(function(name){
        var isExact = name.toLowerCase() === q;
        var dupClass = isExact ? ' is-duplicate' : '';
        var labelHtml = isExact
            ? '<span class="suggest-label" style="background:#fff1f2;color:#e11d48;border-color:#fecdd3;border:1px solid #fecdd3">⚠ duplicate</span>'
            : '<span class="suggest-label">existing</span>';
        return '<div class="ge-suggest-item' + dupClass + '" onmousedown="document.getElementById(\'pmpName\').value=' + JSON.stringify(name) + ';hideSuggest(\'pmpSuggest\')">'
            + labelHtml + buildHighlight(name, val.trim()) + '</div>';
    }).join('');
    el.style.display = 'block';
}

