});

function getUsedCyclesForEmp(empCode, year) {
    var used = [];
    var normCode = (empCode || '').toLowerCase().trim();
    var normYear = parseInt(year);
    Object.keys(_cycleStore).forEach(function(mappingIdStr) {
        var stored = _cycleStore[mappingIdStr];
        if (!stored || !stored.appraisalCycle) return;
        var rec = ALL_MAPPED_EMPLOYEES.find(function(m) { return m.mappingId === parseInt(mappingIdStr); });
        if (!rec) return;
        var recCode = (rec.empCode || '').toLowerCase().trim();
        var recYear = parseInt(rec.appraisalYear);
        if (recCode === normCode && recYear === normYear) {
            var cycle = stored.appraisalCycle.trim();
            if (cycle && cycle !== '—' && used.indexOf(cycle) < 0) { used.push(cycle); }
        }
    });
    return used;
}

function applyDisabledCyclePills(usedCycles) {
    _assignUsedCycles = usedCycles || [];
    ALL_CYCLE_NAMES.forEach(function(name) {
        var pill = document.getElementById('assignPill-' + name);
        if (!pill) return;
        var isUsed = _assignUsedCycles.indexOf(name) >= 0;
        pill.classList.toggle('disabled-cycle', isUsed);
        pill.title = isUsed ? 'Already assigned for this year' : '';
    });
    var banner     = document.getElementById('lastCycleBanner');
    var bannerText = document.getElementById('lastCycleBannerText');
    if (_assignUsedCycles.length > 0) {
        banner.style.display = 'flex';
        bannerText.innerHTML = 'Already assigned for <strong>' + (parseInt(document.getElementById('assignYear').value) || '') + '</strong>: '
            + _assignUsedCycles.map(function(c){
                return '<span style="display:inline-flex;align-items:center;gap:4px;background:#fde68a;color:#92400e;font-family:var(--mono);font-size:.70rem;font-weight:700;padding:2px 10px;border-radius:12px;margin-right:4px">' + esc(c) + ' &#10003;</span>';
            }).join('');
    } else {
        banner.style.display = 'none';
    }
}

function loadAssignEmpDetails(){
    var mappingId = parseInt(document.getElementById('assignEmpSel').value) || 0;
    if (!mappingId) { showToast('Please select a mapped employee first.', 'err'); return; }
    fetch(GET_MAPPING_DETAIL + '?mappingId=' + mappingId).then(function(r){ return r.json(); }).then(function(data){
