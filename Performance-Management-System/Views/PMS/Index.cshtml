function onEmpSelectedInForm(empUserId, empText) {
    if (!empUserId) return;

    var nb = document.getElementById('nextCycleNoticeBanner');
    if (nb) nb.style.display = 'none';

    // empUserId is actually the EmpId from the search dropdown —
    // match on the reliable numeric empId field, not the legacy userId field.
    function matchesSelectedEmp(m) {
        var empIdMatch  = m.empId && String(m.empId).trim() === String(empUserId).trim();
        var userIdMatch = String(m.userId || '').trim().toLowerCase() ===
                           String(empUserId).trim().toLowerCase();
        return empIdMatch || userIdMatch;
    }

    var existing = ALL_MAPPED_EMPLOYEES.find(matchesSelectedEmp);

    if (existing) {
        // ── INSTANT pre-population from memory — no fetch needed for header data ──
        document.getElementById('existingMappingNotice').style.display = 'block';
        document.getElementById('existingMappingText').textContent =
            'Existing mapping found (' + existing.empCode + ', ' + existing.appraisalYear +
            '). Loading KPIs…';
        document.getElementById('empMappingFormTitle').textContent =
            'Edit Employee KPI Mapping — ' + existing.empName;

        // Pre-fill year instantly from memory
        document.getElementById('appraisalYear').value = existing.appraisalYear || new Date().getFullYear();

        // Pre-fill reviewers instantly from memory
        setSelVal('mapRmSel',  existing.rmName            || '');
        setSelVal('mapHodSel', existing.hodName           || '');
        setSelVal('mapUhSel',  existing.unitHeadName      || '');
        setSelVal('mapModSel', existing.modCommitteeNames || '');
        setSelVal('mapJmdSel', existing.jmdName            || '');

        // Show skeleton loader for KPIs while fetching
        document.getElementById('mappedKpiGroupsContainer').innerHTML =
            '<div style="text-align:center;padding:24px;color:var(--ink4)">' +
            '<span style="font-size:1.2rem;display:block;margin-bottom:8px">⏳</span>' +
            'Loading KPIs for <strong>' + esc(existing.empName) + '</strong>…</div>';

        // Check active cycles from memory instantly
        // (uses the same robust empId/userId match as above — was userId-only before)
        var assignedCycles = [];
        Object.keys(_cycleStore).forEach(function(midStr) {
            var stored = _cycleStore[midStr];
            if (!stored || !stored.appraisalCycle) return;
            var rec = ALL_MAPPED_EMPLOYEES.find(function(m) {
                return m.mappingId === parseInt(midStr);
            });
            if (rec && matchesSelectedEmp(rec)) {
                if (assignedCycles.indexOf(stored.appraisalCycle) < 0)
                    assignedCycles.push(stored.appraisalCycle);
            }
        });
        if (existing.appraisalCycle && existing.appraisalCycle.trim() &&
            existing.appraisalCycle !== '—' &&
            assignedCycles.indexOf(existing.appraisalCycle) < 0) {
            assignedCycles.push(existing.appraisalCycle);
        }
        if (assignedCycles.length > 0 && nb) {
            nb.style.display = 'flex';
            document.getElementById('nextCycleNoticeText').innerHTML =
                'This employee has active cycle(s): <strong>' +
                assignedCycles.map(esc).join(', ') +
                '</strong>. KPI changes apply to the <strong>master template only</strong>. ' +
                'The current cycle is not affected — changes take effect from the next assigned cycle.';
        }

        // Now fetch ONLY the KPI rows in background (lightweight call)
        loadMappingIntoForm(existing.mappingId);

    } else {
        document.getElementById('existingMappingNotice').style.display = 'none';
        document.getElementById('empMappingFormTitle').textContent =
            'Map New Employee — ' + empText;
        _editMappingId = 0; _changeLog = [];
        _mappedKpiEntries = []; _mapUidSeq = 0;
        renderMappedKpiGroups();
        renderChangeLogBanner();
        setSelVal('mapRmSel',  '');
        setSelVal('mapHodSel', '');
        setSelVal('mapUhSel',  '');
        setSelVal('mapModSel', '');
        setSelVal('mapJmdSel', '');

        // ── NEW: auto-fill RM straight from HRMS Emp_Superior ──
        autoFillReportingManager(empUserId);
    }
}

function autoFillReportingManager(empId) {
    fetch('/Pms/GetEmployeeReportingManager?empId=' + empId)
        .then(function (r) { return r.json(); })
        .then(function (res) {
            if (!res || !res.found || !res.rmName) return;

            var rmSel = document.getElementById('mapRmSel');
            if (!rmSel) return;

            // Only auto-select if that name exists as an option in the dropdown
            // (i.e. the manager is an active employee in the reviewer list)
            var hasOption = Array.prototype.some.call(rmSel.options, function (o) {
                return o.value === res.rmName;
            });

            if (hasOption) {
                setSelVal('mapRmSel', res.rmName);
                onReviewerChange('mapRmSel');
                showToast('Reporting Manager auto-filled from HRMS: ' + res.rmName, 'ok');
            } else {
                showToast('HRMS reporting manager "' + res.rmName + '" not found in active reviewer list — please select manually.', 'err');
            }
        })
        .catch(function () { /* best-effort — silently let HR pick manually */ });
}
function loadMappingIntoForm(mappingId) {
    // Use the master endpoint — reads EmpMappingMasterKpi directly,
    // much faster than GetMappingDetail which joins appraisal tables
    fetch('/Pms/GetMasterMappingDetail?masterMappingId=' + mappingId)
    .then(function(r){ return r.json(); })
    .then(function(data){
        if (data.error) {
            // Fallback to appraisal mapping endpoint if master not found
            return fetch(GET_MAPPING_DETAIL + '?mappingId=' + mappingId)
                   .then(function(r2){ return r2.json(); });
        }
        return data;
    })
    .then(function(data){
        if (!data || data.error) {
            showToast('Could not load mapping KPIs.', 'err');
            renderMappedKpiGroups();
            return;
        }

        _editMappingId = data.mappingId;
        _changeLog = [];

        // Re-fill from server (authoritative over memory cache)
        setSelVal('mapRmSel',  data.rmName            || '');
        setSelVal('mapHodSel', data.hodName           || '');
        setSelVal('mapUhSel',  data.unitHeadName      || '');
        setSelVal('mapModSel', data.modCommitteeNames || '');
        setSelVal('mapJmdSel', data.jmdName           || '');
        document.getElementById('appraisalYear').value =
            data.appraisalYear || new Date().getFullYear();

        // Build KPI entries
        _mappedKpiEntries = []; _mapUidSeq = 0;
        var rows = data.kpiRows || [];
        rows.forEach(function(r){
            _mapUidSeq++;
            _mappedKpiEntries.push({
                _uid:                _mapUidSeq,
                pmpId:               r.pmpId   || 0,
                pmpName:             r.pmpName || ('PMP ' + r.pmpId),
                kraId:               r.kraId   || 0,
                kraName:             r.kraName || ('KRA ' + r.kraId),
                kpiId:               r.kpiId   || 0,
                kpiName:             r.kpiName || '',
                unitOfMeasure:       r.unitOfMeasure || '%',
                individualWeightage: parseFloat(r.individualWeightage) || 0,
                target:              parseFloat(r.target) || 0,
                _origWeight:         parseFloat(r.individualWeightage) || 0,
                _origTarget:         parseFloat(r.target) || 0,
                _origName:           r.kpiName || ''
            });
        });

        // Last updated strip
        if (data.lastUpdatedAt && data.lastUpdatedAt !== '') {
            var lu = document.getElementById('mappingLastUpdatedStrip');
            var lt = document.getElementById('mappingLastUpdatedText');
            if (lu && lt) {
               lt.textContent = data.lastUpdatedAt;
                lu.style.display = 'flex';
            }
        }

        // Update notice
        var noticeText = document.getElementById('existingMappingText');
        if (noticeText) noticeText.textContent =
            'Editing existing mapping (' + (data.empCode || '') +
            ', ' + data.appraisalYear + ')' +
            (rows.length ? ' — ' + rows.length + ' KPI(s) loaded.' : ' — No KPIs yet.');

        renderMappedKpiGroups();
        renderChangeLogBanner();
    })
    .catch(function(e){
        showToast('Could not load KPIs: ' + e.message, 'err');
        renderMappedKpiGroups();
    });
}
