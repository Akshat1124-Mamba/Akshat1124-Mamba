function previewRatingHike() {
    var baseVal = parseFloat(document.getElementById('previewBaseInput') ?
        document.getElementById('previewBaseInput').value : 4.5) || 0;
    var container = document.getElementById('ratingPreviewTable');
    if (!container) return;
    var rows = _pasRatingMaster.map(function(r){
        var hikeEl  = document.getElementById('pasRatingHike-'  + r.id);
        var labelEl = document.getElementById('pasRatingLabel-' + r.id);
        return { rating: r.rating, label: labelEl ? labelEl.value : r.ratingLabel, hike: hikeEl ? (parseFloat(hikeEl.value) || 0) : r.hikeOverBasePercent };
    }).sort(function(a,b){ return b.rating - a.rating; });
    var html = '<div class="pas-increment-preview"><div class="pas-increment-preview-header"><span style="font-size:1rem">🔢</span><div class="pas-increment-preview-title">Preview at Base = ' + baseVal + '%</div></div><table class="pas-preview-tbl"><thead><tr><th>Rating</th><th>Label</th><th class="th-r">% Over Base</th><th class="th-r">Final Hike %</th><th class="th-r">On ₹9L Gross</th></tr></thead><tbody>';
    rows.forEach(function(r){
        var finalHike = Math.max(0, baseVal * (1 + r.hike / 100));
        finalHike = Math.round(finalHike * 100) / 100;
        var grossIncrement = Math.round((900000 * finalHike / 100));
        var chipCls = finalHike > baseVal ? 'hike-positive' : finalHike === 0 ? 'hike-zero' : 'hike-negative';
        var ratingColors = { 5:'#fef3c7', 4:'var(--cobalt-lt)', 3:'var(--bg2)', 2:'#fff1f2', 1:'#fff1f2' };
        var ratingTxtColors = { 5:'#92400e', 4:'var(--cobalt)', 3:'var(--ink2)', 2:'var(--rose)', 1:'#be123c' };
        html += '<tr><td><span style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:7px;font-weight:700;font-family:var(--mono);background:'+ratingColors[r.rating]+';color:'+ratingTxtColors[r.rating]+'">' + r.rating + '</span></td><td>' + esc(r.label) + '</td><td class="td-r" style="font-family:var(--mono)">' + (r.hike >= 0 ? '+' : '') + r.hike + '%</td><td class="td-r"><span class="pas-preview-hike-chip ' + chipCls + '">' + finalHike + '%</span></td><td class="td-r" style="font-family:var(--mono);color:rgba(255,255,255,.6)">₹' + grossIncrement.toLocaleString('en-IN') + '</td></tr>';
    });
    html += '</tbody></table></div>';
    container.innerHTML = html;
}
