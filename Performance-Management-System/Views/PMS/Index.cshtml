    <script>
    /* ── CONFIG ── */
var ACTIVE_TAB          = @Model.ActiveTab;
var SAVE_KPIS_URL       = '@Url.Action("SaveKpis","Pms")';
var DELETE_KPI_URL      = '@Url.Action("DeleteKpi","Pms")';
var GET_MAPPING_URL     = '@Url.Action("GetKpisByMapping","Pms")';
var GET_ALL_KPIS_URL    = '@Url.Action("GetAllKpisJson","Pms")';
var SAVE_EMP_MAP_URL    = '@Url.Action("SaveEmpMapping","Pms")';
var DELETE_EMP_MAP_URL  = '@Url.Action("DeleteEmpMapping","Pms")';
var GET_MAPPING_DETAIL  = '@Url.Action("GetMappingDetail","Pms")';
var GET_ALL_MAPS_URL    = '@Url.Action("GetAllMappingsJson","Pms")';
var ASSIGN_CYCLE_URL    = '@Url.Action("AssignCycleToEmployees","Pms")';
var SAVE_CHANGELOG_URL  = '@Url.Action("SaveChangeLog","Pms")';
var PRINT_APPRAISAL_URL = '@Url.Action("PrintAppraisal","Pms")';
var SAVE_PAS_BASE_URL    = '@Url.Action("SavePasBaseRow","Pms")';
var DELETE_PAS_BASE_URL  = '@Url.Action("DeletePasBaseRow","Pms")';
var SAVE_RATING_MAT_URL  = '@Url.Action("SaveRatingMatrix","Pms")';
var SAVE_PAS_YEARLY_URL  = '@Url.Action("SavePasYearlyEntry","Pms")';
var DELETE_PAS_YEAR_URL  = '@Url.Action("DeletePasYearly","Pms")';
var SAVE_RMV_URL         = '@Url.Action("SaveRmvVersion","Pms")';
var ACTIVATE_RMV_URL     = '@Url.Action("ActivateRmvVersion","Pms")';
var DELETE_RMV_URL       = '@Url.Action("DeleteRmvVersion","Pms")';
var SAVE_MC_JMD_URL = '@Url.Action("SaveMcJmdRatings","Pms")';
var GET_APPRAISAL_MAPS_URL = '@Url.Action("GetAppraisalMappingsJson","Pms")';
var DELETE_MASTER_MAP_URL = '@Url.Action("DeleteMasterMapping","Pms")';
var _appraisalCycleData = {};  // empCode.toLowerCase() → [{cycle,year,status,mappingId}]


var ALL_KRA_DATA = @Html.Raw(kraJson);

var ALL_KPI_MASTER = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.Kpis.Select(k => new {
        kpiId = k.KpiId, kpiName = k.KpiName, pmpId = k.PmpId, pmpName = k.PmpName,
        kraId = k.KraId, kraName = k.KraName, unitOfMeasure = k.UnitOfMeasure,
        individualWeightage = k.IndividualWeightage, target = k.Target
    })
));

var ALL_MAPPED_EMPLOYEES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.EmpMappings.Select(m => new {
        mappingId = m.MappingId,
        userId = m.UserId,
        empId = m.EmpId,
        empName = m.EmpName,
        empCode = m.EmpCode,
        designation = m.Designation,
        department = m.Department,
        email = m.Email,
        appraisalYear = m.AppraisalYear,
        rmName = m.RmName,
        hodName = m.HodName,
        unitHeadName = m.UnitHeadName,
        modCommitteeNames = m.ModCommitteeNames,
        jmdName = m.JmdName,
        status = m.Status,
        kpiCount = m.KpiRows.Count,
        cycleFromDate = m.CycleFromDate.HasValue ? m.CycleFromDate.Value.ToString("dd-MMM-yy") : "",
        cycleToDate = m.CycleToDate.HasValue ? m.CycleToDate.Value.ToString("dd-MMM-yy") : "",
        appraisalCycle = m.AppraisalCycle ?? "",
        createdAt = m.CreatedAt.HasValue ? m.CreatedAt.Value.ToString("dd-MMM-yy") : "—"
    })
));

var _pasBaseMaster = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.PasBaseMaster.OrderBy(x => x.SortOrder).Select(r => new {
        id = r.Id, rangeLabel = r.RangeLabel,
        pATRevenueMin = r.PATRevenueMin, pATRevenueMax = r.PATRevenueMax,
        basePercentage = r.BasePercentage, sortOrder = r.SortOrder
    })
));

var _pasRatingMaster = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.PasRatingMaster.OrderByDescending(x => x.Rating).Select(r => new {
        id = r.Id, rating = r.Rating, ratingLabel = r.RatingLabel,
        hikeOverBasePercent = r.HikeOverBasePercent
    })
));

// ← ADD HERE:
window._pasYearlyPATData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.PasYearlyPAT.Select(y => new {
        financialYear  = y.FinancialYear,
        basePercentage = y.BasePercentage ?? 0
    })
));
var _rmvVersions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.PasRatingVersions.Select(v => new {
        id = v.Id,
        versionName = v.VersionName,
        effectiveDate = v.EffectiveDate.ToString("yyyy-MM-dd"),
        isActive = v.IsActive,
        remarks = v.Remarks,
        detailRows = v.DetailRows.Select(d => new {
            id = d.Id,
            rating = d.Rating,
            ratingLabel = d.RatingLabel,
            ratingRangeMin = d.RatingRangeMin,
            ratingRangeMax = d.RatingRangeMax,
            distributionPercent = d.DistributionPercent,
            hikeOverBasePercent = d.HikeOverBasePercent
        })
    })
));


var _cycleStore = {};

/* ── Edit-cycle mode flags ── */
var _isEditCycleMode    = false;
var _editCycleMappingId = 0;

(function seedCycleStore() {
    ALL_MAPPED_EMPLOYEES.forEach(function(m) {
        if (m.appraisalCycle && m.appraisalCycle.trim() && m.appraisalCycle !== '—') {
            _cycleStore[m.mappingId] = {
                appraisalCycle:    m.appraisalCycle,
                cycleFromDate:     m.cycleFromDate  || '',
                cycleToDate:       m.cycleToDate    || '',
                status:            m.status         || 'Draft',
                rmName:            m.rmName            || '',
                hodName:           m.hodName           || '',
                unitHeadName:      m.unitHeadName      || '',
                modCommitteeNames: m.modCommitteeNames || '',
                jmdName:           m.jmdName           || ''
            };
        }
    });
})();

function _mergeCycleData(m) {
    var stored   = _cycleStore[m.mappingId] || {};
    var hasCycle = m.appraisalCycle && m.appraisalCycle.trim() && m.appraisalCycle !== '—';
    if (hasCycle) {
        _cycleStore[m.mappingId] = {
            appraisalCycle:    m.appraisalCycle,
            cycleFromDate:     m.cycleFromDate  || stored.cycleFromDate  || '',
            cycleToDate:       m.cycleToDate    || stored.cycleToDate    || '',
            status:            m.status         || stored.status         || 'Draft',
            rmName:            m.rmName            || stored.rmName            || '',
            hodName:           m.hodName           || stored.hodName           || '',
            unitHeadName:      m.unitHeadName      || stored.unitHeadName      || '',
            modCommitteeNames: m.modCommitteeNames || stored.modCommitteeNames || '',
            jmdName:           m.jmdName           || stored.jmdName           || ''
        };
        stored = _cycleStore[m.mappingId];
    }
    return {
        mappingId:         m.mappingId,
        userId:            m.userId,
        empId:             m.empId,
        empName:           m.empName,
        empCode:           m.empCode,
        designation:       m.designation,
        department:        m.department,
        email:             m.email,
        appraisalYear:     m.appraisalYear,
        rmName:            stored.rmName            || m.rmName            || '',
        hodName:           stored.hodName           || m.hodName           || '',
        unitHeadName:      stored.unitHeadName      || m.unitHeadName      || '',
        modCommitteeNames: stored.modCommitteeNames || m.modCommitteeNames || '',
        jmdName:           stored.jmdName           || m.jmdName           || '',
        status:            stored.status            || m.status            || 'Draft',
        kpiCount:          m.kpiCount || 0,
        appraisalCycle:    stored.appraisalCycle    || m.appraisalCycle    || '',
        cycleFromDate:     stored.cycleFromDate     || m.cycleFromDate     || '',
        cycleToDate:       stored.cycleToDate       || m.cycleToDate       || '',
        createdAt:         m.createdAt || '—',
        // ── ADD THESE TWO ──
        lastUpdatedAt:     m.lastUpdatedAt || '',
        lastUpdatedBy:     m.lastUpdatedBy || ''
    };
}

/* ── ALERT AUTO-DISMISS ── */
['alertOk','alertErr'].forEach(function(id){
    var el=document.getElementById(id); if(!el) return;
    setTimeout(function(){el.style.transition='opacity .5s';el.style.opacity='0';setTimeout(function(){el&&el.remove();},550);},4500);
});

/* ── TAB SWITCHING ── */
function switchTab(n){
    [0,1,2,3,4,5].forEach(function(i){
        var btn=document.getElementById('tab-btn-'+i);
        var sec=document.getElementById('section-'+i);
        if(btn) btn.classList.toggle('active',i===n);
        if(sec) sec.classList.toggle('active',i===n);
    });
   // NEW
if(n===5){ initAssignTab(); }
}
switchTab(ACTIVE_TAB);

/* ── SCREEN 4 SUB-TABS ── */
function switchS4Tab(tab) {
    var wasOnForm = document.getElementById('s4-form').classList.contains('active');

    if (tab === 'list' && wasOnForm) {
        var card = document.getElementById('empMappingFormCard');
        if (card) {
            card.style.transition = 'opacity .15s';
            card.style.opacity = '0';
            setTimeout(function () {
                resetEmpMappingForm();
                card.style.opacity = '1';
            }, 160);
        } else {
            resetEmpMappingForm();
        }
    }

    ['list','form'].forEach(function(t){
        document.getElementById('s4-'+t).classList.toggle('active', t===tab);
        document.getElementById('s4-tab-'+t).classList.toggle('active', t===tab);
    });
}
function startNewMapping() {
    resetEmpMappingForm();
    switchS4Tab('form');
    window.scrollTo({top:0,behavior:'smooth'});
}
function switchS5Tab(tab) {
    ['sent','assign','annual'].forEach(function(t){
        var el  = document.getElementById('s5-'+t);
        var btn = document.getElementById('s5-tab-'+t);
        if (el)  el.classList.toggle('active', t===tab);
        if (btn) btn.classList.toggle('active', t===tab);
    });
    if (tab === 'sent')   loadSentListFromServer();
    if (tab === 'annual') loadAnnualReportData();
    if (tab === 'assign') initAssignTab();          // ← ADD THIS LINE
}
/* ══ PMP ══ */
function editPmp(btn){document.getElementById('pmpId').value=btn.dataset.id;document.getElementById('pmpName').value=btn.dataset.name;document.getElementById('pmpName').focus();switchTab(1);window.scrollTo({top:0,behavior:'smooth'});}
function resetPmpForm(){document.getElementById('pmpId').value='0';document.getElementById('pmpName').value='';}
// ── Shared delete modal helper ──────────────────────────────────────────────
let _pendingDeleteFn = null;

// ── Shared delete modal helper ──────────────────────────────────────────────
function showDeleteModal(title, body, onConfirm) {
  // Reuse the existing custom confirm modal already on the page
  document.getElementById('cmIcon').className    = 'cm-icon danger';
  document.getElementById('cmEmoji').textContent = '🗑️';
  document.getElementById('cmTitle').textContent = title;
  document.getElementById('cmMsg').textContent   = body;
  document.getElementById('cmOkBtn').textContent = 'Yes, Delete';
  document.getElementById('cmOkBtn').className   = 'cm-btn cm-ok-red';
  var overlay = document.getElementById('cmOverlay');
  overlay.classList.add('open');
  overlay.onclick = function(e){ if(e.target===overlay) closeConfirm(); };
  document._cmKey = function(e){ if(e.key==='Escape') closeConfirm(); };
  document.addEventListener('keydown', document._cmKey);
  document.getElementById('cmOkBtn').onclick = function(){
    closeConfirm();
    if (onConfirm) onConfirm();
  };
  setTimeout(function(){ document.getElementById('cmOkBtn').focus(); }, 80);
}

// ── Helper: get antiforgery token from anywhere on the page ──────────────
function _getToken() {
    var el = document.querySelector('input[name="__RequestVerificationToken"]');
    return el ? el.value : '';
}
// ── Delete PMP ──
function deletePmp(id) {
    if (!confirm('Delete this Perspective? This cannot be undone.')) return;

    var token = document.querySelector('input[name="__RequestVerificationToken"]');

    fetch('/Pms/DeletePmp?id=' + id, {
        method: 'POST',
        headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'RequestVerificationToken': token ? token.value : ''
        }
    })
    .then(function(r) { return r.text(); })
    .then(function(text) {
        var res;
        try { res = JSON.parse(text); }
        catch(e) {
            showToast('Server error — check console.', 'err');
            return;
        }

        if (res.success) {
            showToast(res.message || 'Perspective deleted.', 'ok');

            // Remove row from DOM
            var removed = false;
            document.querySelectorAll('#section-1 tbody tr').forEach(function(row) {
                if (!removed && row.innerHTML.indexOf('deletePmp(' + id + ')') !== -1) {
                    row.remove();
                    removed = true;
                }
            });

            if (!removed) { setTimeout(function(){ location.reload(); }, 800); return; }

            var remaining = document.querySelectorAll('#section-1 tbody tr:not(.ge-empty)').length;
            var badge = document.getElementById('pmpCount');
            if (badge) badge.textContent = remaining + ' record(s)';

            if (remaining === 0) {
                var tb = document.querySelector('#section-1 tbody');
                if (tb) tb.innerHTML =
                    '<tr class="ge-empty"><td colspan="4">' +
                    '<span class="ge-empty-icon">&#128203;</span>' +
                    'No perspectives yet.</td></tr>';
            }

            var vals = document.querySelectorAll('#section-1 .stat-val');
            if (vals[0]) vals[0].textContent = remaining;
            if (vals[1]) vals[1].textContent = remaining;

        } else {
            // ── Show hierarchy-aware blocking message ──────────────────────
            var isLinked = res.message && (
                res.message.indexOf('KRA') !== -1 ||
                res.message.indexOf('active') !== -1 ||
                res.message.indexOf('linked') !== -1
            );

            if (isLinked) {
                showBlockedModal(
                    'Cannot Delete Perspective',
                    res.message,
                    [
                        '1. Go to <strong>Key Performance Indicators (KPIs)</strong> tab',
                        '2. Delete all KPIs under each KRA linked to this Perspective',
                        '3. Go to <strong>Key Result Areas (KRAs)</strong> tab',
                        '4. Delete all KRAs linked to this Perspective',
                        '5. Return here and delete the Perspective'
                    ]
                );
            } else {
                showToast(res.message || 'Delete failed.', 'err');
            }
        }
    })
    .catch(function(e) {
        showToast('Network error: ' + e.message, 'err');
    });
}

function showBlockedModal(title, serverMessage, steps) {
    // Reuse existing cmOverlay if available, else build inline
    var overlay = document.getElementById('cmOverlay');
    if (overlay) {
        document.getElementById('cmIcon').className    = 'cm-icon danger';
        document.getElementById('cmEmoji').textContent = '⛔';
        document.getElementById('cmTitle').textContent = title;

        // Build rich body
        var stepsHtml = steps.map(function(s) {
            return '<li style="margin-bottom:6px">' + s + '</li>';
        }).join('');

        document.getElementById('cmMsg').innerHTML =
            '<div style="color:#dc2626;font-weight:600;margin-bottom:10px">' +
                serverMessage +
            '</div>' +
            '<div style="font-size:.78rem;color:var(--ink2);font-weight:600;margin-bottom:6px">' +
                '📋 To delete this Perspective, follow these steps:' +
            '</div>' +
            '<ol style="font-size:.77rem;color:var(--ink3);padding-left:18px;margin:0">' +
                stepsHtml +
            '</ol>';

        // Hide OK button — this is info only
        var okBtn = document.getElementById('cmOkBtn');
        if (okBtn) okBtn.style.display = 'none';

        // Re-label cancel as Close
        var cancelBtn = document.querySelector('#cmOverlay .cm-btn:not(.cm-ok-red):not(.cm-ok-sky)');
        if (cancelBtn) cancelBtn.textContent = 'Close';

        overlay.classList.add('open');
        overlay.onclick = function(e) {
            if (e.target === overlay) {
                closeConfirm();
                // Restore OK button for next use
                if (okBtn) okBtn.style.display = '';
            }
        };

        document._cmKey = function(e) {
            if (e.key === 'Escape') {
                closeConfirm();
                if (okBtn) okBtn.style.display = '';
            }
        };
        document.addEventListener('keydown', document._cmKey);

    } else {
        // Fallback if modal not available
        alert(title + '\n\n' + serverMessage + '\n\nSteps:\n' +
            steps.map(function(s, i) {
                return (i + 1) + '. ' + s.replace(/<[^>]+>/g, '');
            }).join('\n')
        );
    }
}
