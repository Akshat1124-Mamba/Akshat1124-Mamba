function applyAssignCyclePreset(name){
    if (!_isEditCycleMode && _assignUsedCycles.indexOf(name) >= 0) {
        showToast(name + ' cycle has already been assigned to this employee for this year.', 'err');
        return;
    }
    _assignCycleName = name;
    document.querySelectorAll('#assignCyclePills .kpi-ftab').forEach(function(b){ b.classList.remove('active'); });
    var pill = document.getElementById('assignPill-' + name); if (pill) pill.classList.add('active');
    document.getElementById('assignCycleName').value = name;

    var year = parseInt(document.getElementById('assignYear').value) || new Date().getFullYear();
    var from = '', to = '';
    // Financial Year: April 1 (year) → March 31 (year+1)
    if      (name === 'Annual')   { from = year + '-04-01'; to = (year + 1) + '-03-31'; }
    else if (name === 'Mid-Year') { from = year + '-04-01'; to = year + '-09-30'; }
    else if (name === 'Q1')       { from = year + '-04-01'; to = year + '-06-30'; }
    else if (name === 'Q2')       { from = year + '-07-01'; to = year + '-09-30'; }
    else if (name === 'Q3')       { from = year + '-10-01'; to = year + '-12-31'; }
    else if (name === 'Q4')       { from = (year + 1) + '-01-01'; to = (year + 1) + '-03-31'; }
    document.getElementById('assignFromDate').value = from;
    document.getElementById('assignToDate').value   = to;
    updateAssignDateDisplay(name, from, to);
}

function onAssignYearChange(){
    if (_assignSelectedEmpData) {
        var year = parseInt(document.getElementById('assignYear').value) || new Date().getFullYear();
        var usedCycles = getUsedCyclesForEmp(_assignSelectedEmpData.empCode, year);
        if (_isEditCycleMode) {
            usedCycles = usedCycles.filter(function(c){ return c !== _assignCycleName; });
        }
        applyDisabledCyclePills(usedCycles);
        if (_assignCycleName && !_isEditCycleMode && _assignUsedCycles.indexOf(_assignCycleName) >= 0) {
            _assignCycleName = '';
            document.getElementById('assignCycleName').value = '';
            document.querySelectorAll('#assignCyclePills .kpi-ftab').forEach(function(b){ b.classList.remove('active'); });
            var dd = document.getElementById('assignDateDisplay'); if (dd) { dd.textContent = 'No range selected'; dd.classList.add('empty'); }
        }
    }
    if (_assignCycleName && _assignCycleName !== 'Custom') applyAssignCyclePreset(_assignCycleName);
}

function onAssignDateChange(){
    var from = document.getElementById('assignFromDate').value;
    var to   = document.getElementById('assignToDate').value;
    _assignCycleName = 'Custom';
    document.getElementById('assignCycleName').value = 'Custom';
    document.querySelectorAll('#assignCyclePills .kpi-ftab').forEach(function(b){ b.classList.remove('active'); });
    var cp = document.getElementById('assignPill-Custom'); if (cp) cp.classList.add('active');
    updateAssignDateDisplay('Custom', from, to);
}

function updateAssignDateDisplay(name, from, to){
    var el = document.getElementById('assignDateDisplay');
    if (!from && !to) { el.textContent = 'No range selected'; el.classList.add('empty'); return; }
    el.innerHTML = '&#128197; <strong>' + esc(name) + '</strong>&nbsp;&nbsp;' + (from ? formatDateDisplay(from) : '—') + ' → ' + (to ? formatDateDisplay(to) : '—');
    el.classList.remove('empty');
}

function formatDateDisplay(dateStr){
    if (!dateStr) return '—';
    var d = new Date(dateStr + 'T00:00:00');
    return d.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
}

function sendSingleToEmployee() {
    var cycle = document.getElementById('assignCycleName').value;
    var from  = document.getElementById('assignFromDate').value;
    var to    = document.getElementById('assignToDate').value;
    var year  = parseInt(document.getElementById('assignYear').value) || 0;
    if (!_assignSelectedMappingId) { showToast('Please load an employee first.', 'err'); return; }
    if (!cycle) { showToast('Please select an appraisal cycle.', 'err'); return; }
    if (!from)  { showToast('Please set a From date.', 'err'); return; }
    if (!to)    { showToast('Please set a To date.', 'err'); return; }
    if (from > to) { showToast('From date cannot be after To date.', 'err'); return; }

    /* skip duplicate check when editing (same cycle being updated) */
    if (!_isEditCycleMode && _assignUsedCycles.indexOf(cycle) >= 0) {
        showToast(cycle + ' has already been assigned this year.', 'err');
        return;
    }

    var modNames = (document.getElementById('assignModNames').value || '').trim();
    var jmdName  = (document.getElementById('assignJmdName').value  || '').trim();
    var rmName   = (document.getElementById('assignRmName').value   || '').trim();
    var hodName  = (document.getElementById('assignHodName').value  || '').trim();
    var uhName   = (document.getElementById('assignUhName').value   || '').trim();
    var empName  = _assignSelectedEmpData ? _assignSelectedEmpData.empName : 'the selected employee';

    document.getElementById('cmTitle').textContent = _isEditCycleMode ? 'Update Appraisal Cycle' : 'Send Appraisal Cycle';
    document.getElementById('cmMsg').textContent   = _isEditCycleMode
        ? 'Update "' + cycle + '" cycle for ' + empName + '? Reviewer change notifications will be triggered automatically.'
        : 'Send "' + cycle + '" cycle (' + formatDateDisplay(from) + ' \u2192 ' + formatDateDisplay(to) + ') to ' + empName + '?';
    document.getElementById('cmEmoji').textContent = _isEditCycleMode ? '\u270F\uFE0F' : '\u2709\uFE0F';
    document.getElementById('cmOkBtn').textContent = _isEditCycleMode ? 'Yes, Update' : 'Yes, Send';
    document.getElementById('cmOkBtn').className   = 'cm-btn cm-ok-sky';
    document.getElementById('cmIcon').className    = 'cm-icon warning';

    /* snapshot for closure */
    var isEditSnapshot    = _isEditCycleMode;
    var sentMappingIdSnap = _assignSelectedMappingId;

    _cmCb = function() {
        fetch(ASSIGN_CYCLE_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                mappingIds:        [sentMappingIdSnap],
                appraisalCycle:    cycle,
                cycleFromDate:     from,
                cycleToDate:       to,
                appraisalYear:     year,
                modCommitteeNames: modNames,
                jmdName:           jmdName,
                rmName:            rmName,
                hodName:           hodName,
                unitHeadName:      uhName,
                notifyEmail:       'developer2@vandanaglobal.com',
                isEdit:            isEditSnapshot
            })
        }).then(function(r){ return r.json(); }).then(function(res){
            if (res.success) {
                var fromDisp = from ? new Date(from+'T00:00:00').toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) : '';
                var toDisp   = to   ? new Date(to  +'T00:00:00').toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) : '';

                /* preserve existing status when editing; reset to Draft on fresh send */
                var prevStatus = (_cycleStore[sentMappingIdSnap] || {}).status || 'Draft';
                _cycleStore[sentMappingIdSnap] = {
                    appraisalCycle:    cycle,
                    cycleFromDate:     fromDisp,
                    cycleToDate:       toDisp,
                    status:            isEditSnapshot ? prevStatus : 'Draft',
                    rmName:            rmName,
                    hodName:           hodName,
                    unitHeadName:      uhName,
                    modCommitteeNames: modNames,
                    jmdName:           jmdName
                };

                var found = false;
                ALL_MAPPED_EMPLOYEES.forEach(function(m) {
                    if (m.mappingId === sentMappingIdSnap) {
                        m.appraisalCycle    = cycle;
                        m.cycleFromDate     = fromDisp;
                        m.cycleToDate       = toDisp;
                        if (rmName)   m.rmName            = rmName;
                        if (hodName)  m.hodName            = hodName;
                        if (uhName)   m.unitHeadName       = uhName;
                        if (modNames) m.modCommitteeNames  = modNames;
                        if (jmdName)  m.jmdName            = jmdName;
                        found = true;
                    }
                });
                if (!found && _assignSelectedEmpData) {
                    ALL_MAPPED_EMPLOYEES.push({
                        mappingId:         sentMappingIdSnap,
                        userId:            _assignSelectedEmpData.userId || '',
                        empId:             _assignSelectedEmpData.empId  || '',
                        empName:           _assignSelectedEmpData.empName || empName,
                        empCode:           _assignSelectedEmpData.empCode || '',
                        designation:       _assignSelectedEmpData.designation || '',
                        department:        _assignSelectedEmpData.department  || '',
                        email:             _assignSelectedEmpData.email       || '',
                        appraisalYear:     year,
                        rmName:            rmName, hodName: hodName, unitHeadName: uhName,
                        modCommitteeNames: modNames, jmdName: jmdName,
                        status:            'Draft',
                        kpiCount:          (_assignSelectedEmpData.kpiRows || []).length,
                        appraisalCycle:    cycle, cycleFromDate: fromDisp, cycleToDate: toDisp,
                        createdAt:         '\u2014'
                    });
                }
                _sentAllData = ALL_MAPPED_EMPLOYEES;

                showToast(
                    isEditSnapshot
                        ? 'Cycle updated. Reviewer notifications dispatched as needed.'
                        : 'Appraisal cycle sent to ' + empName + '.',
                    'ok'
                );
                clearAssignFlow();
                renderSentListTable(ALL_MAPPED_EMPLOYEES);
                setTimeout(function() { switchS5Tab('sent'); }, 700);
            } else {
                showToast(res.message || 'Failed to send.', 'err');
            }
        }).catch(function(e){ showToast('Network error: ' + e.message, 'err'); });
    };

    document.getElementById('cmOkBtn').onclick = function() { var c = _cmCb; closeConfirm(); if (c) c(); };
    document.getElementById('cmOverlay').classList.add('open');
    setTimeout(function() { document.getElementById('cmOkBtn').focus(); }, 80);
}
// Cache for BA statuses keyed by mappingId
var _baStatusCache = {};
function loadBaStatusForSentList(mappings) {
    // Only fetch BA for visible/active mappings, not all at once
    // Batch: fetch one at a time with a small delay to avoid hammering the server
    var queue = mappings.filter(function(m) {
        return m.mappingId && m.empId && !_baStatusCache[m.mappingId];
    });

    if (!queue.length) return;

    var idx = 0;
    function fetchNext() {
        if (idx >= queue.length) return;
        var m = queue[idx++];

        fetch('/Pms/GetBaScoresForAnnualReport?mappingId=' + m.mappingId + '&empId=' + m.empId)
            .then(function(r) { return r.json(); })
            .then(function(ba) {
                _baStatusCache[m.mappingId] = ba;
                // Only patch the single cell — never re-render the whole table
                var cell = document.querySelector(
                    '.sent-emp-row[data-mappingid="' + m.mappingId + '"] .stage-progress-wrap');
                if (cell) {
                    var sentM = (_sentAllData || []).find(function(x) { return x.mappingId === m.mappingId; });
                    cell.innerHTML = buildStageProgressJS(m.status, ba, m.mappingId, sentM || m);
                }
            })
            .catch(function() {})
            .finally(function() {
                // Small delay between requests to avoid overwhelming the server
                setTimeout(fetchNext, 80);
            });
    }

    // Start fetching — stagger slightly so first render is instant
    setTimeout(fetchNext, 300);
}
function buildStageProgressJS(status, ba, mappingId, m) {
    // m = full mapping object (empName, rmName, hodName, unitHeadName,
    //      modCommitteeNames, jmdName, appraisalCycle)
    // Falls back gracefully if m is missing

    var rm  = (m && m.rmName)            || 'RM';
    var hod = (m && m.hodName)           || 'HOD';
    var uh  = (m && m.unitHeadName)      || 'Unit Head';
    var mc  = (m && m.modCommitteeNames) || 'MC';
    var jmd = (m && m.jmdName)           || 'JMD';
    var emp = (m && m.empName)           || 'Employee';
    var cycle = (m && m.appraisalCycle)  || '';

    /* ── Stage index helper ── */
    var SI = { Draft:0, EmployeeFilled:1, RMReview:2, HODReview:3,
               UnitHeadReview:4, ModCommitteeReview:5, JMDReview:6, HRFinalized:7 };
    var si = SI[status] || 0;

    /* ── AIR store for MC/JMD ── */
    var airStore  = (mappingId && _airDetailStore[mappingId]) ? _airDetailStore[mappingId] : {};
    var mcRating  = airStore._mcRating  != null ? airStore._mcRating  : null;
    var jmdRating = airStore._jmdRating != null ? airStore._jmdRating : null;
    var mcDone    = (mcRating  != null && mcRating  > 0)
                 || si >= SI.ModCommitteeReview;
    var jmdDone   = (jmdRating != null && jmdRating > 0)
                 || si >= SI.JMDReview;
    var mcActive  = !mcDone  && si === SI.UnitHeadReview;
    var jmdActive = !jmdDone && (si === SI.ModCommitteeReview || mcDone);

    /* ── Dot builder ── */
    function dot(label, tooltip, isDone, isActive, color, isBlocked) {
        if (isBlocked) {
            return '<div style="display:flex;flex-direction:column;align-items:center;gap:2px">' +
                '<div title="' + tooltip + '" ' +
                'style="width:20px;height:20px;border-radius:50%;background:transparent;' +
                'border:2px solid #d1d0c8;display:flex;align-items:center;justify-content:center;' +
                'font-size:9px;font-weight:700;color:#bbb;cursor:default">—</div>' +
                '<span style="font-size:9px;color:#888">' + label + '</span></div>';
        }
        var bg        = isDone ? '#1D9E75' : isActive ? color : 'transparent';
        var border    = isDone ? '#1D9E75' : isActive ? color : '#c8c6bf';
        var textColor = (isDone || isActive) ? '#fff' : '#888';
        var icon      = isDone ? '&#10003;' : label.charAt(0);
        return '<div style="display:flex;flex-direction:column;align-items:center;gap:2px">' +
            '<div title="' + tooltip + '" ' +
            'style="width:20px;height:20px;border-radius:50%;background:' + bg + ';' +
            'border:2px solid ' + border + ';display:flex;align-items:center;' +
            'justify-content:center;font-size:9px;font-weight:700;color:' + textColor + ';cursor:default">' +
            icon + '</div>' +
            '<span style="font-size:9px;color:#888">' + label + '</span></div>';
    }

    function line(done) {
        return '<div style="height:2px;width:14px;background:' + (done ? '#1D9E75' : '#e0ddd4') +
            ';margin-bottom:14px;align-self:flex-start;margin-top:9px"></div>';
    }

    function tip(name, stateLabel) {
        return name + ' \u2014 ' + stateLabel;
    }

    /* ── PMS row ── */
    var empDone  = si >= SI.EmployeeFilled;
    var empAct   = si === SI.Draft;
    var rmDone   = si >= SI.RMReview;
    var rmAct    = si === SI.EmployeeFilled;
    var hodDone  = si >= SI.HODReview;
    var hodAct   = si === SI.RMReview;
    var uhDone   = si >= SI.UnitHeadReview;
    var uhAct    = si === SI.HODReview;

    var pmsHtml =
        '<div style="display:flex;align-items:flex-start;gap:0">' +
        dot('Emp', tip(emp,  empDone ? 'done' : empAct  ? 'in progress' : 'pending'),  empDone,  empAct,  '#378ADD') +
        line(empDone) +
        dot('RM',  tip(rm,   rmDone  ? 'done' : rmAct   ? 'in progress' : 'pending'),  rmDone,   rmAct,   '#378ADD') +
        line(rmDone) +
        dot('HOD', tip(hod,  hodDone ? 'done' : hodAct  ? 'in progress' : 'pending'),  hodDone,  hodAct,  '#378ADD') +
        line(hodDone) +
        dot('UH',  tip(uh,   uhDone  ? 'done' : uhAct   ? 'in progress' : 'pending'),  uhDone,   uhAct,   '#378ADD') +
        line(uhDone) +
        dot('MC',  tip(mc,   mcDone  ? 'done' : mcActive ? 'in progress' : 'pending'),  mcDone,   mcActive, '#EF9F27') +
        line(mcDone) +
        dot('JMD', tip(jmd,  jmdDone ? 'done' : jmdActive ? 'in progress' : 'pending'), jmdDone, jmdActive,'#9333ea') +
        '</div>';

    /* ── BA row — always 6 dots; only RM and HOD are active ── */
    var baHtml = '';
    if (ba) {
        var baRmDone  = ba.rmScore  != null && ba.rmScore  > 0;
        var baHodDone = ba.hodScore != null && ba.hodScore > 0;
        var baRmAct   = !baRmDone  && (si === SI.EmployeeFilled || si === SI.RMReview);
        var baHodAct  = !baHodDone && (si === SI.RMReview || si === SI.HODReview);

        var baRmTip  = baRmDone
            ? 'BA-RM: ' + rm + ' \u2014 done (' + ba.rmScore + ')'
            : 'BA-RM: ' + rm + ' \u2014 ' + (baRmAct ? 'in progress' : 'pending');
        var baHodTip = baHodDone
            ? 'BA-HOD: ' + hod + ' \u2014 done (' + ba.hodScore + ')'
            : 'BA-HOD: ' + hod + ' \u2014 ' + (baHodAct ? 'in progress' : 'pending');
        var naMsg = 'N/A \u2014 BA not required for this role';

        baHtml =
            '<div style="display:flex;align-items:flex-start;gap:0;margin-top:4px">' +
            dot('Emp', naMsg, false, false, '', true) +
            line(false) +
            dot('RM',  baRmTip,  baRmDone,  baRmAct,  '#EF9F27') +
            line(baRmDone) +
            dot('HOD', baHodTip, baHodDone, baHodAct, '#EF9F27') +
            line(false) +
            dot('UH',  naMsg, false, false, '', true) +
            line(false) +
            dot('MC',  naMsg, false, false, '', true) +
            line(false) +
            dot('JMD', naMsg, false, false, '', true) +
            '</div>';
    }

/* ── Row labels ── */
    var labelCol = ba
        ? '<div style="display:flex;flex-direction:column;gap:3px;padding-top:2px">' +
          '<div style="font-size:9px;font-weight:700;color:#4b7c61;min-height:32px;display:flex;align-items:center">PMS</div>' +
          '<div style="font-size:9px;font-weight:700;color:#1e40af;min-height:32px;display:flex;align-items:center;margin-top:4px">BA</div>' +
          '</div>'
        : '';

    return '<div style="display:flex;align-items:flex-start;gap:4px">' +
               labelCol +
               '<div>' +
                   '<div>' + pmsHtml + '</div>' +
                   (ba ? '<div>' + baHtml + '</div>' : '') +
               '</div>' +
           '</div>';
}

function isPrintUnlocked(m) {
    var SI = { Draft:0, EmployeeFilled:1, RMReview:2, HODReview:3,
               UnitHeadReview:4, ModCommitteeReview:5, JMDReview:6, HRFinalized:7 };
    var si = SI[m.status] || 0;
    var cycleNorm = (m.appraisalCycle || '').trim().toLowerCase();
    var isAnnual  = (cycleNorm === 'annual');

    if (isAnnual) {
        var airStore  = (_airDetailStore[m.mappingId] || {});
        var jmdRating = airStore._jmdRating != null ? airStore._jmdRating : null;
        return jmdRating != null && jmdRating > 0;
    } else {
        return si >= SI.UnitHeadReview;
    }
}
/* ══ SEARCHABLE EMPLOYEE DROPDOWN (TAB 4 form) ══ */
var _empData         = [];   // populated on first open / search
var _empDropdownOpen = false;
var _empSearchTimer  = null;

function openEmpDropdown() {
    _empDropdownOpen = true;
    var q = (document.getElementById('empSearch').value || '').trim();
    if (q.length >= 2) {
        _fetchEmployees(q);
    } else {
        // Show cached list or prompt
        _renderEmpDropdown(_empData);
        document.getElementById('empDropdownList').style.display =
            _empData.length ? 'block' : 'none';
    }
}

function filterEmpDropdown() {
    var q = (document.getElementById('empSearch').value || '').trim();
    clearTimeout(_empSearchTimer);

    // Clear selection if user is typing a new name
    if (document.getElementById('empSel').value) {
        document.getElementById('empSel').value = '';
    }

    if (q.length < 2) {
        document.getElementById('empDropdownList').style.display = 'none';
        return;
    }

    // Debounce 280ms so we don't hammer the server on every keystroke
    _empSearchTimer = setTimeout(function () {
        _fetchEmployees(q);
    }, 280);
}

function _fetchEmployees(term) {
    fetch('/Pms/SearchEmployees?term=' + encodeURIComponent(term))
        .then(function (r) { return r.json(); })
        .then(function (data) {
            _empData = data || [];
            _renderEmpDropdown(_empData);
            document.getElementById('empDropdownList').style.display =
                _empData.length ? 'block' : 'none';
        })
        .catch(function () {
            document.getElementById('empNoResults').style.display = 'block';
        });
}

function _renderEmpDropdown(list) {
    var inner = document.getElementById('empDropdownInner');
    var noRes = document.getElementById('empNoResults');
    var q     = (document.getElementById('empSearch').value || '').trim().toLowerCase();

    if (!list || !list.length) {
        inner.innerHTML        = '';
        noRes.style.display    = 'block';
        return;
    }

    noRes.style.display = 'none';
    inner.innerHTML = list.map(function (emp) {
        var display = esc(emp.display || (emp.empCode + ' – ' + emp.fullName));
        var hi      = q
            ? display.replace(
                new RegExp('(' + escRegex(q) + ')', 'gi'),
                '<strong style="color:var(--cobalt)">$1</strong>')
            : display;
        return '<div class="emp-drop-item"' +
            ' data-value="' + emp.empId + '"' +
            ' data-text="'  + esc(emp.display || emp.empCode + ' – ' + emp.fullName) + '"' +
            ' onclick="selectEmpItem(this)"' +
            ' onmouseenter="this.style.background=\'var(--cobalt-lt)\'"' +
            ' onmouseleave="this.style.background=\'\'"' +
            ' style="padding:10px 16px;cursor:pointer;font-size:.80rem;' +
                    'color:var(--ink2);border-bottom:1px solid var(--border2)">' +
            hi +
            '<div style="font-size:.65rem;color:var(--ink4)">' +
                esc(emp.designation || '') + ' · ' + esc(emp.department || '') +
            '</div>' +
        '</div>';
    }).join('');
}

function selectEmpItem(el) {
    // el.dataset.value = empId (integer as string)
    document.getElementById('empSel').value    = el.dataset.value;   // → sent as UserId → resolvedEmpId
    document.getElementById('empSearch').value = el.dataset.text;
    document.getElementById('empDropdownList').style.display = 'none';
    _empDropdownOpen = false;
    onEmpSelectedInForm(el.dataset.value, el.dataset.text);
}

document.addEventListener('click', function (e) {
    if (!_empDropdownOpen) return;
    var wrap = document.getElementById('empSearch');
    var list = document.getElementById('empDropdownList');
    if (wrap && !wrap.contains(e.target) && list && !list.contains(e.target)) {
        list.style.display = 'none';
        _empDropdownOpen   = false;
        // If nothing was selected, clear the typed text
        if (!document.getElementById('empSel').value)
            document.getElementById('empSearch').value = '';
    }
});

function escRegex(s){ return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

/* ══ CONFIRM MODAL ══ */
var _cmCb = null;
function showConfirm(type, entityName, cb){
    var overlay = document.getElementById('cmOverlay');
    var okBtn   = document.getElementById('cmOkBtn');
    var isLogout = (type === 'logout');
    document.getElementById('cmIcon').className    = 'cm-icon danger';
    document.getElementById('cmEmoji').textContent = isLogout ? '⏻' : '🗑️';
    document.getElementById('cmTitle').textContent = isLogout ? 'Confirm Logout' : 'Delete ' + (entityName || 'Record');
    document.getElementById('cmMsg').textContent   = isLogout ? 'You will be signed out. Any unsaved changes will be lost.' : 'This ' + (entityName || 'record') + ' will be permanently deleted. Continue?';
    okBtn.textContent = isLogout ? 'Yes, Logout' : 'Yes, Delete';
    okBtn.className   = 'cm-btn cm-ok-red';
    _cmCb = cb || (isLogout ? function(){ document.getElementById('logoutForm').submit(); } : null);
    okBtn.onclick = function(){ var c = _cmCb; closeConfirm(); if (c) c(); };
    overlay.classList.add('open');
    overlay.onclick = function(e){ if (e.target === overlay) closeConfirm(); };
    document._cmKey = function(e){ if (e.key === 'Escape') closeConfirm(); };
    document.addEventListener('keydown', document._cmKey);
    setTimeout(function(){ okBtn.focus(); }, 80);
}
function closeConfirm(){ document.getElementById('cmOverlay').classList.remove('open'); if (document._cmKey) document.removeEventListener('keydown', document._cmKey); _cmCb = null; }

function showToast(msg, type){
    var wrap = document.getElementById('toastWrap');
    var el   = document.createElement('div');
    el.className = 'toast ' + (type || 'ok');
    el.innerHTML = (type === 'err' ? '✖ ' : '✔ ') + esc(msg);
    wrap.appendChild(el);
    setTimeout(function(){ el.style.transition = 'opacity .4s'; el.style.opacity = '0'; setTimeout(function(){ el.remove(); }, 420); }, 3800);
}

function esc(s){ return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

