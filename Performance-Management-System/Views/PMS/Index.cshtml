                if (strip && stripText) {
                  stripText.textContent = data.lastUpdatedAt;
                    strip.style.display = 'flex';
                }
            }
 
            // Check if active cycles exist → show warning
            var assignedCycles = _getAllCyclesForEmp(data.empCode, data.appraisalYear);
            if (assignedCycles.length > 0) {
                var nb = document.getElementById('nextCycleNoticeBanner');
                if (nb) {
                    nb.style.display = 'flex';
                    document.getElementById('nextCycleNoticeText').innerHTML =
                        '⚠️ This employee has active cycle(s): <strong>' +
                        assignedCycles.map(function(c){ return esc(c); }).join(', ') +
                        '</strong>. KPI changes saved here apply to the <strong>master template only</strong> ' +
                        '— the current running cycle is NOT affected. Changes take effect from the next assigned cycle.';
                }
            }
 
            // ── Build _mappedKpiEntries from kpiRows ──
            _mappedKpiEntries = [];
            _mapUidSeq = 0;
 
            console.log('[editEmpMapping] kpiRows count:', data.kpiRows ? data.kpiRows.length : 0);
 
            if (data.kpiRows && data.kpiRows.length > 0) {
                data.kpiRows.forEach(function(r) {
                    _mapUidSeq++;
                    _mappedKpiEntries.push({
                        _uid:                _mapUidSeq,
                        pmpId:               r.pmpId   || 0,
                        pmpName:             r.pmpName || ('PMP ' + r.pmpId),
                        kraId:               r.kraId   || 0,
                        kraName:             r.kraName || ('KRA ' + r.kraId),
                        kpiId:               r.kpiId   || 0,
                        kpiName:             r.kpiName || '',
                        unitOfMeasure:       r.unitOfMeasure || '%',
                        individualWeightage: parseFloat(r.individualWeightage) || 0,
                        target:              parseFloat(r.target) || 0,
                        _origWeight:         parseFloat(r.individualWeightage) || 0,
                        _origTarget:         parseFloat(r.target) || 0,
                        _origName:           r.kpiName || ''
                    });
                });
                console.log('[editEmpMapping] entries built:', _mappedKpiEntries.length);
            } else {
                // No KPIs in master — show empty state with instructions
                document.getElementById('mappedKpiGroupsContainer').innerHTML =
                    '<div style="text-align:center;padding:32px;color:var(--ink4);">' +
                    '<span style="font-size:1.5rem;display:block;margin-bottom:8px;opacity:.4">📂</span>' +
                    'No KPIs in master mapping. Use the cascade above to add KPIs.</div>';
                recalcMappingWeight();
                // Still render the form — don't return early
            }
 
            // Render KPI groups
            renderMappedKpiGroups();
            renderChangeLogBanner();
 
            // Scroll form into view
            setTimeout(function() {
                var formCard = document.getElementById('empMappingFormCard');
                if (formCard)
                    formCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 100);
        })
        .catch(function(err) {
            console.error('[editEmpMapping] fetch error:', err);
            showToast('Failed to load: ' + err.message, 'err');
            document.getElementById('empMappingFormTitle').textContent =
                'Create / Edit Employee KPI Mapping';
            document.getElementById('mappedKpiGroupsContainer').innerHTML =
                '<div style="text-align:center;padding:32px;color:var(--rose);">' +
                '❌ Network error: ' + esc(err.message) + '</div>';
        });
}
 
