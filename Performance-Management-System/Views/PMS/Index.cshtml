// STEP 3: Replace _getAllCyclesForEmp() with this version
function _getAllCyclesForEmp(empCode, year) {
    var normCode = (empCode || '').toLowerCase().trim();
    var normYear = parseInt(year) || 0;
    var cycles   = [];

    // Primary: server-loaded data, STRICTLY year-scoped
    var empHistory = _appraisalCycleData[normCode] || [];
    empHistory.forEach(function(c) {
        // Only include entries for the exact selected year
        if (normYear > 0 && c.year !== normYear) return;
        if (cycles.indexOf(c.cycle) < 0) cycles.push(c.cycle);
    });

    // Secondary: freshly assigned this session via _cycleStore, year-scoped
    Object.keys(_cycleStore).forEach(function(midStr) {
        var stored = _cycleStore[midStr];
        if (!stored || !stored.appraisalCycle || !stored.appraisalCycle.trim()) return;
        var rec = ALL_MAPPED_EMPLOYEES.find(function(m) {
            return m.mappingId === parseInt(midStr);
        });
        if (!rec) return;
        if ((rec.empCode || '').toLowerCase().trim() !== normCode) return;
        // Year-scope: parse the stored cycleFromDate
        if (normYear > 0) {
            var storedFY = 0;
            var fromRaw = (stored.cycleFromDate || '').trim();
            if (fromRaw) {
                var m1 = fromRaw.match(/^(\d{1,2})-([A-Za-z]{3})-(\d{2,4})$/);
                if (m1) {
                    var months = {jan:1,feb:2,mar:3,apr:4,may:5,jun:6,
                                  jul:7,aug:8,sep:9,oct:10,nov:11,dec:12};
                    var mon = months[(m1[2]||'').toLowerCase()]||0;
                    var yr  = parseInt(m1[3]); if (yr < 100) yr += 2000;
                    storedFY = (mon >= 4) ? yr : yr - 1;
                } else {
                    var m2 = fromRaw.match(/^(\d{4})-(\d{2})-(\d{2})$/);
                    if (m2) {
                        var cal2 = parseInt(m2[1]), mon2 = parseInt(m2[2]);
                        storedFY = (mon2 >= 4) ? cal2 : cal2 - 1;
                    }
                }
            }
            // Fallback to rec.appraisalYear if no date
            if (!storedFY) storedFY = parseInt(rec.appraisalYear) || 0;
            if (storedFY !== normYear) return;
        }
        var c = stored.appraisalCycle.trim();
        if (c && c !== '—' && cycles.indexOf(c) < 0) cycles.push(c);
    });

    return cycles;
}
