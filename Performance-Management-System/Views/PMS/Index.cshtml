function _parseCycleDateFY(dateStr) {
    // Returns the Indian Financial Year start (e.g. 2025 for FY 2025-26)
    // Handles:  "01-Apr-25"  "01-Apr-2025"  "2025-04-01"  ""
    if (!dateStr || !dateStr.trim()) return 0;
    var s = dateStr.trim();
 
    var fyYear = 0;
    var mon = 0, cal = 0;
 
    // Format: "dd-MMM-yy" or "dd-MMM-yyyy"
    var m1 = s.match(/^(\d{1,2})-([A-Za-z]{3})-(\d{2,4})$/);
    if (m1) {
        var months = {jan:1,feb:2,mar:3,apr:4,may:5,jun:6,
                      jul:7,aug:8,sep:9,oct:10,nov:11,dec:12};
        mon = months[(m1[2] || '').toLowerCase()] || 0;
        cal = parseInt(m1[3]);
        if (cal < 100) cal += 2000;   // 25 → 2025
    }
 
    // Format: "yyyy-MM-dd"
    var m2 = s.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (m2) {
        cal = parseInt(m2[1]);
        mon = parseInt(m2[2]);
    }
 
    if (cal && mon) {
        // Apr-Dec → FY starts this calendar year
        // Jan-Mar → FY started the previous calendar year
        fyYear = (mon >= 4) ? cal : cal - 1;
    }
    return fyYear;
}
 
function _buildAppraisalCycleData(appraisalData) {
    _appraisalCycleData = {};

    appraisalData.forEach(function(m) {
        var key = (m.empCode || '').toLowerCase().trim();
        if (!key || key === '—') return;
        if (!_appraisalCycleData[key]) _appraisalCycleData[key] = [];

        var cycle = (m.appraisalCycle || '').trim();
        if (!cycle || cycle === '—') return;

        // Parse FY year from cycleFromDate (handles "01-Apr-25", "01-Apr-2025", "2025-04-01")
        var fyYear = parseInt(m.appraisalYear) || 0;
        var fromRaw = (m.cycleFromDate || '').trim();
        if (fromRaw) {
            var parsedDate = null;
            // "dd-MMM-yy" or "dd-MMM-yyyy" — e.g. "01-Apr-25"
            var m1 = fromRaw.match(/^(\d{1,2})-([A-Za-z]{3})-(\d{2,4})$/);
            if (m1) {
                var months = {jan:1,feb:2,mar:3,apr:4,may:5,jun:6,
                              jul:7,aug:8,sep:9,oct:10,nov:11,dec:12};
                var mon = months[(m1[2] || '').toLowerCase()] || 0;
                var yr  = parseInt(m1[3]);
                if (yr < 100) yr += 2000;
                if (mon && yr) parsedDate = new Date(yr, mon - 1, parseInt(m1[1]));
            }
            // "yyyy-MM-dd"
            if (!parsedDate) {
                var m2 = fromRaw.match(/^(\d{4})-(\d{2})-(\d{2})$/);
                if (m2) parsedDate = new Date(parseInt(m2[1]), parseInt(m2[2]) - 1, parseInt(m2[3]));
            }
            if (parsedDate && !isNaN(parsedDate.getTime())) {
                var cal = parsedDate.getFullYear();
                var mon2 = parsedDate.getMonth() + 1;
                // Apr–Dec → FY starts this calendar year; Jan–Mar → previous year
                fyYear = (mon2 >= 4) ? cal : cal - 1;
            }
        }

        _appraisalCycleData[key].push({
            cycle:     cycle,
            year:      fyYear,
            status:    m.status || 'Draft',
            mappingId: m.mappingId,
            fromDate:  m.cycleFromDate || '',
            toDate:    m.cycleToDate   || ''
        });
    });

    Object.keys(_appraisalCycleData).forEach(function(key) {
        _appraisalCycleData[key].sort(function(a, b) { return b.mappingId - a.mappingId; });
    });
}
// ============================================================
// PATCH 2 — renderAssignTable (full replacement)
// Key change: employees who already have the selected cycle
// are COMPLETELY REMOVED from the list rather than shown as
// greyed-out/blocked rows.  If no cycle is selected all
// employees show normally.
