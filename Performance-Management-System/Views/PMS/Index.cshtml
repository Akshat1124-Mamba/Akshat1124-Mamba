function deleteEmpMapping(id) {
    if (!confirm('Delete this Employee Mapping permanently?')) return;

    fetch(DELETE_MASTER_MAP_URL + '?id=' + id, { method: 'POST' })
    .then(function(r) { return r.text(); })
    .then(function(text) {
        var res; try { res = JSON.parse(text); } catch(e) { showToast('Server error.', 'err'); return; }
        if (res.success) {
            showToast('Mapping deleted.', 'ok');
            ALL_MAPPED_EMPLOYEES = ALL_MAPPED_EMPLOYEES.filter(function(m) { return m.mappingId !== id; });
            var tbody = document.getElementById('mappingListBody');
            if (tbody) {
                tbody.querySelectorAll('tr').forEach(function(row) {
                    if (row.innerHTML.indexOf('deleteEmpMapping(' + id + ')') !== -1) row.remove();
                });
                var remaining = tbody.querySelectorAll('tr:not(.ge-empty)').length;
                var badge = document.getElementById('mappingListCount');
                if (badge) badge.textContent = remaining + ' record(s)';
                if (remaining === 0) {
                    tbody.innerHTML = '<tr class="ge-empty"><td colspan="10"><span class="ge-empty-icon">&#128101;</span>No employee mappings yet.</td></tr>';
                }
            }
            setTimeout(function() { refreshAllMappingData(); }, 500);
        } else {
            // Safety net only — the button should already be disabled for this case.
            // If it somehow fires anyway (e.g. cycle assigned moments ago in another tab),
            // fall back to a toast instead of a popup, and re-lock the row.
            showToast(res.message || 'Delete failed — a cycle may already be assigned to this employee.', 'err');
            refreshMappingDeleteLocks();
        }
    })
    .catch(function() { showToast('Network error.', 'err'); });
}
function refreshAllMappingData(callback) {
    fetch(GET_ALL_MAPS_URL)
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (!data || data.error) { if (callback) callback(); return; }
        
        // Merge cycle data and update global
        var merged = data.map(function(m) { return _mergeCycleData(m); });
        ALL_MAPPED_EMPLOYEES = merged;
        
        // Update stat counts
        var total   = merged.length;
        var pending = merged.filter(function(m) { 
            return m.status === 'Draft' || m.status === 'EmployeeFilled'; 
        }).length;
        var done = merged.filter(function(m) { 
            return m.status === 'HRFinalized'; 
        }).length;
        
        var t = document.getElementById('empMappingStatTotal');   
        if (t) t.textContent = total;
        var p = document.getElementById('empMappingStatPending'); 
        if (p) p.textContent = pending;
        var d = document.getElementById('empMappingStatDone');    
        if (d) d.textContent = done;
        
        // THIS is the critical call — render with merged data
        refreshMappingListTable(merged);
        
        _sentAllData = merged;
        renderSentListTable(merged);
        refreshMappingDeleteLocks(); 
        
        if (callback) callback();
    })
    .catch(function() { if (callback) callback(); });
}

function refreshMappingDeleteLocks() {
    var tbody = document.getElementById('mappingListBody');
    if (!tbody) return;

    // Authoritative cycle data comes from _sentAllData (real EmpAppraisalMapping rows),
    // NOT from the master mapping list — matched by empCode.
    var cycleByEmpCode = {};
    (_sentAllData || []).forEach(function(m) {
        var cyc = (m.appraisalCycle || '').trim();
        if (cyc && cyc !== '—') {
            var code = (m.empCode || '').toLowerCase().trim();
            if (code) cycleByEmpCode[code] = cyc;
        }
    });

    tbody.querySelectorAll('.js-del-mapping-btn').forEach(function(btn) {
        var code = (btn.getAttribute('data-code') || '').toLowerCase().trim();
        var wrap = btn.closest('.row-acts');
        var existingLabel = wrap ? wrap.querySelector('.js-del-lock-label') : null;
        var cyc = cycleByEmpCode[code];

        if (cyc) {
            btn.disabled = true;
            btn.style.opacity = '.45';
            btn.style.cursor = 'not-allowed';
            btn.title = 'Cycle "' + cyc + '" is assigned — remove it first';
            if (!existingLabel && wrap) {
                var lbl = document.createElement('div');
                lbl.className = 'js-del-lock-label';
                lbl.style.cssText = 'font-size:.62rem;color:#b45309;font-weight:600;line-height:1.3';
                lbl.textContent = 'Remove from Sent Cycles, then delete';
                wrap.appendChild(lbl);
            }
        } else {
            btn.disabled = false;
            btn.style.opacity = '';
            btn.style.cursor = '';
            btn.title = '';
            if (existingLabel) existingLabel.remove();
        }
    });
}
