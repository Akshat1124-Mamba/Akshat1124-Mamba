var siLock       = SI_LOCK[m.status] || 0;
var isAnnualCyc  = (cycleNorm.toLowerCase() === 'annual');
var reviewersLocked = isAnnualCyc
    ? isCompleted                       /* JMD rating given (or HR finalized) */
    : (siLock > SI_LOCK.UnitHeadReview); /* UH has finished reviewing */

        var printBtn = isPrintUnlocked(m)
