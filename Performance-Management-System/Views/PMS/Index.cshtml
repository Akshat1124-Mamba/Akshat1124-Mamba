/* ── used-cycles helper ── */
function _usedCyclesForMapping(mappingId) {
    var base = ALL_MAPPED_EMPLOYEES.find(function(m){
        return m.mappingId === mappingId;
    });
    if (!base) return [];
    var used = [];
    ALL_MAPPED_EMPLOYEES.forEach(function(m) {
        if ((m.empCode || '').toLowerCase() === (base.empCode || '').toLowerCase()
            && m.appraisalYear === base.appraisalYear
            && m.appraisalCycle
            && m.appraisalCycle.trim() !== ''
            && m.appraisalCycle !== '—') {
            if (used.indexOf(m.appraisalCycle) < 0) used.push(m.appraisalCycle);
        }
    });
    return used;
}
 
/* ── Helper: get the "best" mapping for an employee for the target year ── */
function _getBestMappingForEmp(empMappings, targetYear) {
    /* prefer mapping whose appraisalYear matches target year */
    var yearMatch = empMappings.filter(function(m) {
        return parseInt(m.appraisalYear) === parseInt(targetYear);
    });
    if (yearMatch.length > 0) {
        /* among year matches, pick highest mappingId (most recent master) */
        return yearMatch.reduce(function(best, m) {
            return m.mappingId > best.mappingId ? m : best;
        });
    }
    /* fallback: highest mappingId overall */
    return empMappings.reduce(function(best, m) {
        return m.mappingId > best.mappingId ? m : best;
    });
}
 
