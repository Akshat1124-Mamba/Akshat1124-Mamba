                    _cycleChipStyle(cycleName, isLatest);
                var prefixHtml = isLatest
                    ? '<span style="font-size:.65rem;font-weight:900;color:#059669">&#10003;</span>'
                    : isActive
                        ? '<span style="width:5px;height:5px;border-radius:50%;' +
                          'background:currentColor;display:inline-block;' +
                          'flex-shrink:0;opacity:.6"></span>'
                        : '';
                return '<span style="' + chipStyle + '">' + prefixHtml +
                    _aEsc(cycleName) + '</span>';
            }).join(' ');
        } else {
            chipHtml = '<span style="font-size:.68rem;color:var(--ink4);' +
                'font-style:italic">No cycles yet</span>';
        }
 
        html +=
            '<tr style="border-bottom:1px solid var(--border2);' + rowBg +
            'cursor:pointer;transition:background .12s" ' +
            'onclick="toggleAssignRow(' + m.mappingId + ',event)">';
 
        /* Checkbox */
        html += '<td style="padding:8px 10px;text-align:center;width:38px"' +
            ' onclick="event.stopPropagation()">' +
            '<input type="checkbox" class="assign-chk" data-id="' + m.mappingId + '" ' +
            (checked ? 'checked ' : '') +
            'onchange="onAssignChkChange(' + m.mappingId + ',this)" ' +
            'style="width:15px;height:15px;cursor:pointer;" /></td>';
 
        /* EMP Code */
        html += '<td style="padding:8px 10px;white-space:nowrap;font-family:var(--mono);' +
            'font-size:.73rem;font-weight:700;color:var(--cobalt);width:90px">' +
            _aEsc(m.empCode || '—') + '</td>';
 
        /* Name + email */
        html += '<td style="padding:8px 10px;">' +
            '<div style="font-weight:600;color:var(--navy);font-size:.78rem">' +
            _aEsc(m.empName || '—') + '</div>' +
            '<div style="font-size:.64rem;color:var(--ink4)">' +
            _aEsc(m.email || '') + '</div>' +
            '</td>';
 
        /* Designation */
        html += '<td style="padding:8px 10px;color:var(--ink3);font-size:.75rem;width:130px">' +
            _aEsc(m.designation || '—') + '</td>';
 
        /* Department */
        html += '<td style="padding:8px 10px;color:var(--ink3);font-size:.75rem;width:120px">' +
            _aEsc(m.department || '—') + '</td>';
 
        /* Current Cycle + eligible note */
        html += '<td style="padding:8px 10px;">' +
            '<div style="display:flex;flex-wrap:wrap;gap:4px;align-items:center">' +
            chipHtml + '</div>' +
            eligibleNote + '</td>';
 
        /* KPI count */
        html += '<td style="padding:8px 10px;text-align:center;width:50px">' +
            '<span style="background:var(--cobalt-lt);color:var(--cobalt);' +
            'border-radius:20px;padding:1px 8px;font-size:.68rem;font-weight:700">' +
            kpiCount + '</span></td>';
 
        html += '</tr>';
    });
 
    tbody.innerHTML = html;
 
    /* Master checkbox state */
    var allChk = deduped.length > 0 && deduped.every(function(m) {
        return _assignSelected.has(m.mappingId);
    });
    var anyChk = deduped.some(function(m) { return _assignSelected.has(m.mappingId); });
    var chkAll = document.getElementById('assignChkAll');
    if (chkAll) {
        chkAll.checked       = allChk;
        chkAll.indeterminate = !allChk && anyChk;
        chkAll.disabled      = deduped.length === 0;
    }
 
    syncAssignSelCount();
}
 
/* ── selection ── */
function toggleAssignRow(mappingId, e) {
    if (e && (e.target.tagName === 'INPUT' || e.target.tagName === 'BUTTON')) return;
    var m = _assignAllMappings.find(function(x) { return x.mappingId === mappingId; });
    if (!m) return;
    var selYear  = parseInt(document.getElementById('assignBarYear').value) || 0;
    var assigned = _getAllCyclesForEmp(m.empCode, selYear || m.appraisalYear);
    if (_assignBarCycle && assigned.indexOf(_assignBarCycle) >= 0) return; /* blocked */
    if (_assignSelected.has(mappingId)) _assignSelected.delete(mappingId);
    else _assignSelected.add(mappingId);
    renderAssignTable();
    syncAssignSelCount();
}

function onAssignChkChange(mappingId, chk) {
    if (chk.checked) _assignSelected.add(mappingId);
    else             _assignSelected.delete(mappingId);
    renderAssignTable();
    syncAssignSelCount();
}
function toggleAssignAll(masterChk) {
    var selYear  = parseInt(document.getElementById('assignBarYear').value) || 0;
    var selCycle = _assignBarCycle;
 
    var empMap = {};
    _assignFiltered.forEach(function(m) {
        var key = (m.empCode || ('_mid_' + m.mappingId)).toLowerCase().trim();
        if (!empMap[key]) {
            empMap[key] = m;
        } else {
            var prev = empMap[key];
            if ((parseInt(m.appraisalYear) === selYear &&
                 parseInt(prev.appraisalYear) !== selYear) ||
                (parseInt(m.appraisalYear) === parseInt(prev.appraisalYear) &&
                 m.mappingId > prev.mappingId)) {
                empMap[key] = m;
            }
        }
    });
 
    /* Only consider employees who don't have the cycle for THIS year */
    var eligible = Object.values(empMap).filter(function(m) {
        if (!selCycle) return true;
        return _getAllCyclesForEmp(m.empCode, selYear).indexOf(selCycle) < 0;
    });
 
    if (masterChk.checked) {
        eligible.forEach(function(m) { _assignSelected.add(m.mappingId); });
    } else {
        eligible.forEach(function(m) { _assignSelected.delete(m.mappingId); });
    }
    renderAssignTable();
    syncAssignSelCount();
}
 
function syncAssignSelCount() {
    var n   = _assignSelected.size;
    var el  = document.getElementById('assignSelCount');
    var btn = document.getElementById('assignBulkBtn');
    if (el) el.textContent = n + ' selected';
    if (btn) {
        var hasCycle = !!_assignBarCycle;
        var hasFrom  = !!(document.getElementById('assignBarFrom') &&
                          document.getElementById('assignBarFrom').value);
        var hasTo    = !!(document.getElementById('assignBarTo') &&
                          document.getElementById('assignBarTo').value);

        // ── PAT/Base% existence check for selected year ──
        var selYear = parseInt(document.getElementById('assignBarYear').value) || 0;
        var hasPAT  = true;
        if (selYear > 0 && window._pasYearlyPATData && window._pasYearlyPATData.length) {
            var pe = window._pasYearlyPATData.find(function(y) {
                var parts = (y.financialYear || '').split(/[-\/]/);
                return parts.length > 0 && parseInt(parts[0]) === selYear;
            });
            hasPAT = !!(pe && pe.basePercentage > 0);
        }

        var isAnnualSel = (_assignBarCycle || '').trim().toLowerCase() === 'annual';
        var canSend = n > 0 && hasCycle && hasFrom && hasTo &&
                      (!isAnnualSel || hasPAT);
        btn.disabled      = !canSend;
        btn.style.opacity = canSend ? '1' : '.45';

        // ── Inline warning below year input ──
// ── Inline warning below year input (Annual cycle only) ──
        var isAnnualSel = (_assignBarCycle || '').trim().toLowerCase() === 'annual';
        var warnEl = document.getElementById('assignPatWarning');
        if (!warnEl) {
            warnEl = document.createElement('div');
            warnEl.id = 'assignPatWarning';
            warnEl.style.cssText =
                'font-size:.72rem;color:#b45309;font-weight:600;' +
                'margin-top:4px;display:none;';
            var yi = document.getElementById('assignBarYear');
            if (yi && yi.parentNode) yi.parentNode.appendChild(warnEl);
        }
        if (isAnnualSel && !hasPAT && selYear > 0) {
            warnEl.textContent =
                '⚠ No PAT/Base% configured for FY ' + selYear +
                ' — Annual increment cannot be calculated. Add it in PAT Configuration first.';
            warnEl.style.display = 'block';
        } else {
            warnEl.style.display = 'none';
        }
    }
}

/* ── submit ── */
function submitBulkAssign() {
    var cycle = (document.getElementById('assignBarCycleName').value || '').trim();
    var from  =  document.getElementById('assignBarFrom').value;
    var to    =  document.getElementById('assignBarTo').value;
    var year  =  parseInt(document.getElementById('assignBarYear').value) || 0;

    if (!cycle)                     { showToast('Please select an appraisal cycle first.', 'err'); return; }
    if (!from || !to)               { showToast('Please set the date range for the cycle.', 'err'); return; }
    if (from > to)                  { showToast('From date cannot be after To date.', 'err'); return; }
    if (!year)                      { showToast('Please enter a valid year.', 'err'); return; }
    if (_assignSelected.size === 0) { showToast('No employees selected.', 'err'); return; }

// ── Hard block: PAT/Base% must exist for Annual cycle only ──
    var isAnnualAssign = (cycle.trim().toLowerCase() === 'annual');
    if (isAnnualAssign && window._pasYearlyPATData && window._pasYearlyPATData.length) {
        var patEntry = window._pasYearlyPATData.find(function(y) {
            var parts = (y.financialYear || '').split(/[-\/]/);
            return parts.length > 0 && parseInt(parts[0]) === year;
        });
        if (!patEntry || !patEntry.basePercentage || patEntry.basePercentage <= 0) {
            var available = window._pasYearlyPATData
                .map(function(y) { return 'FY ' + y.financialYear; }).join(', ');
            showToast(
                'No PAT/Base% configured for FY ' + year +
                '. Please add it in PAT Configuration before assigning Annual cycle. ' +
                'Available: ' + (available || 'none') + '.',
                'err'
            );
            return;
        }
    }

    // ── DEDUP: for each unique empId, keep only the mapping that matches
    //    the target year; fall back to the most recent if no year match ──
    var rawIds     = Array.from(_assignSelected);
    var seenEmpIds = {};
    var uniqueIds  = [];

    rawIds.forEach(function(mid) {
        var m = _assignAllMappings.find(function(x) { return x.mappingId === mid; });
        if (!m) return;

        var eid = m.empId;
        if (!eid) { uniqueIds.push(mid); return; }

        if (!seenEmpIds[eid]) {
            seenEmpIds[eid] = mid;
        } else {
            var existing     = _assignAllMappings.find(function(x) { return x.mappingId === seenEmpIds[eid]; });
            var existingYear = existing ? existing.appraisalYear : 0;
            var newYear      = m.appraisalYear || 0;
            if (newYear === year && existingYear !== year) {
                seenEmpIds[eid] = mid;
            }
        }
    });

    Object.keys(seenEmpIds).forEach(function(eid) {
        uniqueIds.push(seenEmpIds[eid]);
    });

    var dupCount = rawIds.length - uniqueIds.length;

    document.getElementById('cmTitle').textContent = 'Assign ' + cycle + ' Cycle';
    document.getElementById('cmMsg').textContent   =
        'Send "' + cycle + '" (' + _aFmtD(from) + ' \u2192 ' + _aFmtD(to) +
        ') to ' + uniqueIds.length + ' employee(s)?' +
        (dupCount > 0 ? ' (' + dupCount + ' duplicate selection(s) ignored.)' : '') +
        ' Reviewer data will be pulled from each employee\'s existing mapping.';
    document.getElementById('cmEmoji').textContent = '\uD83D\uDCC5';
    document.getElementById('cmOkBtn').textContent = 'Yes, Assign';
    document.getElementById('cmOkBtn').className   = 'cm-btn cm-ok-sky';
    document.getElementById('cmIcon').className    = 'cm-icon warning';

    _cmCb = function() {
        var tok     = document.querySelector('input[name="__RequestVerificationToken"]');
        var headers = { 'Content-Type': 'application/json' };
        if (tok) headers['RequestVerificationToken'] = tok.value;

        var promises = uniqueIds.map(function(mid) {
            var m = _assignAllMappings.find(function(x) { return x.mappingId === mid; }) || {};
            return fetch(ASSIGN_CYCLE_URL, {
                method:  'POST',
                headers: headers,
                body: JSON.stringify({
                    mappingIds:        [mid],
                    appraisalCycle:    cycle,
                    cycleFromDate:     from,
                    cycleToDate:       to,
                    appraisalYear:     year,
                    rmName:            m.rmName            || '',
                    hodName:           m.hodName           || '',
                    unitHeadName:      m.unitHeadName      || '',
                    modCommitteeNames: m.modCommitteeNames || '',
                    jmdName:           m.jmdName           || '',
                    isEdit:            false
                })
            }).then(function(r) { return r.json(); });
        });

        showToast('Assigning cycle to ' + uniqueIds.length + ' employee(s)\u2026', 'ok');

        Promise.all(promises).then(function(results) {
            var ok   = results.filter(function(r) { return r && r.success; }).length;
            var fail = results.length - ok;

            var fromDisp = _aFmtD(from);
            var toDisp   = _aFmtD(to);
            uniqueIds.forEach(function(mid) {
                var m = ALL_MAPPED_EMPLOYEES.find(function(x) { return x.mappingId === mid; });
                if (m) {
                    m.appraisalCycle = cycle;
                    m.cycleFromDate  = fromDisp;
                    m.cycleToDate    = toDisp;
                    m.appraisalYear  = year;
                }
                var rev = _assignAllMappings.find(function(x) { return x.mappingId === mid; }) || {};
                _cycleStore[mid] = {
                    appraisalCycle:    cycle,
                    cycleFromDate:     fromDisp,
                    cycleToDate:       toDisp,
                    status:            'Draft',
                    rmName:            rev.rmName            || '',
                    hodName:           rev.hodName           || '',
                    unitHeadName:      rev.unitHeadName      || '',
                    modCommitteeNames: rev.modCommitteeNames || '',
                    jmdName:           rev.jmdName           || ''
                };
            });

            if (fail === 0) {
                showToast('\u2714 ' + ok + ' employee(s) assigned to ' + cycle + ' cycle successfully.', 'ok');
            } else {
                showToast('\u26A0 ' + ok + ' assigned, ' + fail + ' failed.', 'err');
            }

            _assignSelected.clear();
            syncAssignSelCount();
            loadAssignMappings();

            setTimeout(function() {
                renderSentListTable(ALL_MAPPED_EMPLOYEES);
                switchS5Tab('sent');
            }, 900);
        }).catch(function(e) {
            showToast('Network error: ' + e.message, 'err');
        });
    };

    document.getElementById('cmOkBtn').onclick =
        function() { var c = _cmCb; closeConfirm(); if (c) c(); };
    document.getElementById('cmOverlay').classList.add('open');
    setTimeout(function() { document.getElementById('cmOkBtn').focus(); }, 80);
}

// ── NEW: instant, keystroke-level validation — no click needed ──
function checkKpiWeightageLive() {
    var wtInput = document.getElementById('mapKpiWeightInput');
    var warnEl  = document.getElementById('mapKpiWtWarning');
    var addBtn  = document.getElementById('addMappedKpiBtn');
    if (!wtInput || !warnEl || !addBtn) return;

    var wt = parseFloat(wtInput.value) || 0;
    var currentTotal = Math.round(
        _mappedKpiEntries.reduce(function(sum, e){ return sum + (parseFloat(e.individualWeightage) || 0); }, 0) * 100
    ) / 100;
    var projectedTotal = Math.round((currentTotal + wt) * 100) / 100;

    if (wt > 0 && projectedTotal > 100) {
        wtInput.style.borderColor = 'var(--rose)';
        warnEl.style.display = 'block';
        warnEl.textContent = '⚠ Total would be ' + projectedTotal + '% — max is 100% (currently ' + currentTotal + '%)';
        addBtn.disabled = true;
        addBtn.style.opacity = '.45';
        addBtn.style.cursor = 'not-allowed';
    } else {
        wtInput.style.borderColor = '';
        warnEl.style.display = 'none';
        addBtn.disabled = false;
        addBtn.style.opacity = '';
        addBtn.style.cursor = '';
    }
}
/* ── tab switcher (replaces existing switchS5Tab) ── */
function switchS5Tab(tab) {
    ['sent','assign','annual'].forEach(function(t){
        var el  = document.getElementById('s5-'+t);
        var btn = document.getElementById('s5-tab-'+t);
        if (el)  el.classList.toggle('active', t===tab);
        if (btn) btn.classList.toggle('active', t===tab);
    });
    if (tab === 'sent')   loadSentListFromServer();
    if (tab === 'annual') loadAnnualReportData();
    if (tab === 'assign') initAssignTab();
}
/* ══ ANNUAL REPORT FULLSCREEN ══ */
/* ══ ANNUAL REPORT FULLSCREEN TOGGLE ══ */
function toggleAnnualFullscreen() {
    var section  = document.getElementById('s5-annual');
    var btn      = document.getElementById('annualFsBtn');
    var tblCard  = section ? section.querySelector('.tbl-card') : null;
    var isFs     = section.classList.toggle('fullscreen-mode');

    if (btn) {
        btn.innerHTML = isFs ? '⊡ Exit Full Screen' : '⛶ Full Screen';
        btn.classList.toggle('btn-warn',  isFs);
        btn.classList.toggle('btn-ghost', !isFs);
    }

    if (isFs) {
        document.body.style.overflow = 'hidden';
        section.scrollTop = 0;

        /* ← REMOVE the tblCard overflow:visible line entirely */
        /* tblCard must keep overflow:hidden so sticky thead works */

        if (typeof loadAnnualReportData === 'function') {
            setTimeout(loadAnnualReportData, 80);
        }

        function _escHandler(e) {
            if (e.key === 'Escape') {
                section.classList.remove('fullscreen-mode');
                document.body.style.overflow = '';
                if (btn) {
                    btn.innerHTML = '⛶ Full Screen';
                    btn.classList.remove('btn-warn');
                    btn.classList.add('btn-ghost');
                }
                document.removeEventListener('keydown', _escHandler);
            }
        }
        document.addEventListener('keydown', _escHandler);

    } else {
        document.body.style.overflow = '';
        setTimeout(function() {
            section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 50);
    }
}
</script>
</body>
</html>
