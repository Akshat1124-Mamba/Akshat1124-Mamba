/* ── RMV — RATING MATRIX VERSIONING ── */
var _rmvRows = [];
function _initRmvDefaultRows() {
    _rmvRows = [
        { rating:5, ratingLabel:'Outstanding',         ratingRangeMin:4.5,  ratingRangeMax:5.0,  distributionPercent:10, hikeOverBasePercent:30  },
        { rating:4, ratingLabel:'Exceeds Expectation', ratingRangeMin:3.5,  ratingRangeMax:4.49, distributionPercent:20, hikeOverBasePercent:15  },
        { rating:3, ratingLabel:'Meets Expectation',   ratingRangeMin:2.5,  ratingRangeMax:3.49, distributionPercent:50, hikeOverBasePercent:0   },
        { rating:2, ratingLabel:'Below Expectation',   ratingRangeMin:1.5,  ratingRangeMax:2.49, distributionPercent:15, hikeOverBasePercent:-10 },
        { rating:1, ratingLabel:'Unsatisfactory',      ratingRangeMin:0,    ratingRangeMax:1.49, distributionPercent:5,  hikeOverBasePercent:-20 }
    ];
}
function _getActiveVersionRows() {
    if (!_rmvVersions || !_rmvVersions.length) return _rmvRows;
    var active = _rmvVersions.find(function(v){ return v.isActive; }) || _rmvVersions[0];
    if (active && active.detailRows && active.detailRows.length) {
        return active.detailRows.slice().sort(function(a,b){ return b.rating - a.rating; });
    }
    return _rmvRows;
}
function syncRmvRow(idx) {
    var r = _rmvRows[idx]; if (!r) return;
    var labelEl = document.querySelector('.rmv-label[data-idx="' + idx + '"]');
    var minEl   = document.querySelector('.rmv-min[data-idx="'   + idx + '"]');
    var maxEl   = document.querySelector('.rmv-max[data-idx="'   + idx + '"]');
    var distEl  = document.querySelector('.rmv-dist[data-idx="'  + idx + '"]');
    var hikeEl  = document.querySelector('.rmv-hike[data-idx="'  + idx + '"]');
    if (labelEl) r.ratingLabel         = labelEl.value;
    if (minEl)   r.ratingRangeMin      = parseFloat(minEl.value)  || 0;
    if (maxEl)   r.ratingRangeMax      = parseFloat(maxEl.value)  || 0;
    if (distEl)  r.distributionPercent = parseFloat(distEl.value) || 0;
    if (hikeEl)  r.hikeOverBasePercent = parseFloat(hikeEl.value) || 0;
    recalcRmvDistTotal();
}
function recalcRmvDistTotal() {
    var total = _rmvRows.reduce(function(sum, r){ return sum + (parseFloat(r.distributionPercent) || 0); }, 0);
    total = Math.round(total * 100) / 100;
    var el   = document.getElementById('rmvDistTotal');
    var fill = document.getElementById('rmvDistFill');
    var msg  = document.getElementById('rmvDistMsg');
    var isOk = (Math.abs(total - 100) < 0.01);
    if (el)   el.textContent = total + '%';
    if (fill) { fill.style.width = Math.min(total, 100) + '%'; fill.style.background = total > 100 ? 'var(--rose)' : isOk ? 'var(--emerald)' : 'var(--cobalt)'; }
    if (msg)  msg.innerHTML = isOk
        ? '<span style="color:var(--emerald)">&#10004; Distribution is exactly 100% — ready to save</span>'
        : '<span style="color:var(--rose)">&#9888; Must total 100% to save (currently ' + total + '%)</span>';
}
function renderRmvRows() {
    var container = document.getElementById('rmvRowsContainer'); if (!container) return;
    if (!_rmvRows.length) _initRmvDefaultRows();
    var ratingColors = {5:'#fef3c7',4:'var(--cobalt-lt)',3:'var(--bg2)',2:'#fff1f2',1:'#fff1f2'};
    var ratingTxt    = {5:'#92400e',4:'var(--cobalt)',3:'var(--ink2)',2:'var(--rose)',1:'#be123c'};
    var html = _rmvRows.map(function(r, i){
        return '<div style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr 1fr 1fr 28px;gap:8px;align-items:end;background:var(--bg);border:1.5px solid var(--border2);border-radius:10px;padding:16px 14px 14px;position:relative;margin-bottom:8px">' +
            '<span style="position:absolute;top:-10px;left:14px;font-size:.58rem;font-weight:700;letter-spacing:.08em;color:#fff;background:var(--teal);padding:2px 10px;border-radius:20px;font-family:var(--mono)">Rating ' + r.rating + '</span>' +
            '<div class="fg" style="margin-top:6px"><label>Label</label><input type="text" class="ge-input rmv-label" data-idx="' + i + '" value="' + esc(r.ratingLabel) + '" oninput="syncRmvRow(' + i + ')" /></div>' +
            '<div class="fg" style="margin-top:6px"><label>Rating</label><input type="number" class="ge-input" value="' + r.rating + '" readonly style="background:var(--bg2);border-style:dashed;cursor:default" /></div>' +
            '<div class="fg" style="margin-top:6px"><label>Range Min</label><input type="number" class="ge-input rmv-min" data-idx="' + i + '" value="' + r.ratingRangeMin + '" step="0.1" oninput="syncRmvRow(' + i + ')" /></div>' +
            '<div class="fg" style="margin-top:6px"><label>Range Max</label><input type="number" class="ge-input rmv-max" data-idx="' + i + '" value="' + r.ratingRangeMax + '" step="0.1" oninput="syncRmvRow(' + i + ')" /></div>' +
            '<div class="fg" style="margin-top:6px"><label>Dist %</label><input type="number" class="ge-input rmv-dist" data-idx="' + i + '" value="' + r.distributionPercent + '" step="0.01" oninput="syncRmvRow(' + i + ')" /></div>' +
            '<div class="fg" style="margin-top:6px"><label>Hike over Base %</label><input type="number" class="ge-input rmv-hike" data-idx="' + i + '" value="' + r.hikeOverBasePercent + '" step="0.01" oninput="syncRmvRow(' + i + ')" /></div>' +
            '<div style="margin-top:22px;display:flex;align-items:center;justify-content:center"><span style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:7px;font-weight:700;font-family:var(--mono);font-size:.80rem;background:' + (ratingColors[r.rating]||'var(--bg2)') + ';color:' + (ratingTxt[r.rating]||'var(--ink2)') + '">' + r.rating + '</span></div>' +
        '</div>';
    }).join('');
    container.innerHTML = html;
    recalcRmvDistTotal();
}
