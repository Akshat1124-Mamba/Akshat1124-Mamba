function deleteCycleAssignment(mappingId) {
    showConfirm('delete', 'Cycle Assignment', function() {
        fetch('/Pms/DeleteCycleAssignment?mappingId=' + mappingId, {
            method: 'POST',
            headers: { 'RequestVerificationToken': _getToken() }
        })
        .then(function(r) { return r.text(); })
        .then(function(text) {
            var res;
            try { res = JSON.parse(text); }
            catch(e) { showToast('Server error.', 'err'); return; }

            if (res.success) {
                // Update in-memory stores immediately
                delete _cycleStore[mappingId];

                var found = ALL_MAPPED_EMPLOYEES.find(function(e) { return e.mappingId === mappingId; });
                if (found) {
                    found.appraisalCycle = '';
                    found.cycleFromDate  = '';
                    found.cycleToDate    = '';
                    found.status         = 'Draft';
                }

                // Remove row from sent list table immediately (no flicker)
                var rows = document.querySelectorAll('.sent-emp-row');
                rows.forEach(function(row) {
                    if (row.innerHTML.indexOf('deleteCycleAssignment(' + mappingId + ')') !== -1) {
                        row.style.transition = 'opacity .2s';
                        row.style.opacity = '0';
                        setTimeout(function() { row.remove(); refreshSentListCounts(); }, 200);
                    }
                });

                showToast('Cycle assignment removed.', 'ok');

                // Refresh from server in background to sync counts
                setTimeout(function() { loadSentListFromServer(); }, 400);

            } else {
                showToast(res.message || 'Failed.', 'err');
            }
        })
        .catch(function() { showToast('Network error.', 'err'); });
    });
}
