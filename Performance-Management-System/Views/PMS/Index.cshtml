/* ── MC input handler ── */
function onAirMcInput(input) {
    var mid = parseInt(input.getAttribute('data-mid'));
    var mcVal = parseFloat(input.value);

    if (!isNaN(mcVal) && mcVal >= 1 && mcVal <= 5) {
        input.style.borderColor = '#059669';
        // No auto-save — just remember the value locally so
        // "Save MC & JMD Ratings" can pick it up when clicked.
        if (!_airDetailStore[mid]) _airDetailStore[mid] = {};
        _airDetailStore[mid]._mcRating = mcVal;
    } else {
        input.style.borderColor = input.value ? '#e11d48' : '';
        if (_airDetailStore[mid]) _airDetailStore[mid]._mcRating = null;
    }

    var wtRating = (_airDetailStore[mid] && _airDetailStore[mid]._wtRating) || 0;
    var jmdVal   = (_airDetailStore[mid] && _airDetailStore[mid]._jmdRating) || null;
    _airUpdateFinal(mid, wtRating,
        isNaN(mcVal) ? null : Math.min(5, Math.max(1, mcVal)),
        jmdVal);

    refreshAnnualStatusCounts();
}

function onAirJmdInput(input) {
    var mid    = parseInt(input.getAttribute('data-mid'));
    var jmdVal = parseFloat(input.value);

    if (!isNaN(jmdVal) && jmdVal >= 1 && jmdVal <= 5) {
        input.style.borderColor = '#c026d3';
        // No auto-save — just remember the value locally so
        // "Save MC & JMD Ratings" can pick it up when clicked.
        if (!_airDetailStore[mid]) _airDetailStore[mid] = {};
        _airDetailStore[mid]._jmdRating = jmdVal;
    } else {
        input.style.borderColor = input.value ? '#e11d48' : '';
        if (_airDetailStore[mid]) _airDetailStore[mid]._jmdRating = null;
    }

    var wtRating = (_airDetailStore[mid] && _airDetailStore[mid]._wtRating) || 0;

    var mcInput = null;
    document.querySelectorAll('.annual-report-row[data-mappingid="' + mid + '"]')
        .forEach(function(r) {
            var el = r.querySelector('.air-mc-input');
            if (el) mcInput = el;
        });
    var mcVal = mcInput ? parseFloat(mcInput.value) : NaN;

    _airUpdateFinal(
        mid,
        wtRating,
        isNaN(mcVal)  ? null : Math.min(5, Math.max(1, mcVal)),
        isNaN(jmdVal) ? null : Math.min(5, Math.max(1, jmdVal))
    );

    // Status badge is now only upgraded to JMDReview once the rating
    // is actually SAVED (see saveAllMcJmdRatings), not just typed.

    refreshAnnualStatusCounts();
}

function saveMcJmdRatings(mappingId) {
    var state = _airDetailStore[mappingId] || {};
    var mc  = state._mcRating  != null ? state._mcRating  : null;
    var jmd = state._jmdRating != null ? state._jmdRating : null;
    if (mc == null && jmd == null) { showToast('Enter at least one rating before saving.', 'err'); return; }
    fetch(SAVE_MC_JMD_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mappingId: mappingId, mcRating: mc, jmdRating: jmd })
    }).then(function(r){ return r.json(); }).then(function(res){
        if (res.success) {
            showToast('Ratings saved for mapping #' + mappingId, 'ok');
            if (mc  != null) _lockMcJmdRow(mappingId, 'mc');
            if (jmd != null) { _lockMcJmdRow(mappingId, 'jmd'); _airUpdateStatusBadge(mappingId, 'JMDReview'); }
            refreshAnnualStatusCounts();
        } else {
            showToast(res.message || 'Save failed.', 'err');
        }
    }).catch(function(e){ showToast('Network error: ' + e.message, 'err'); });
}

function saveAllMcJmdRatings() {
    var rows = document.querySelectorAll('.annual-report-row');
    var mids = new Set();
    rows.forEach(function(r) { var m = r.getAttribute('data-mappingid'); if (m) mids.add(parseInt(m)); });
    var payload = [];
    mids.forEach(function(mid) {
        var state = _airDetailStore[mid] || {};
        // Only send a field if it hasn't already been locked/saved
        var mcInp  = document.querySelector('.annual-report-row[data-mappingid="' + mid + '"] .air-mc-input');
        var jmdInp = document.querySelector('.annual-report-row[data-mappingid="' + mid + '"] .air-jmd-input');
        var mcAlreadyLocked  = mcInp  && mcInp.disabled;
        var jmdAlreadyLocked = jmdInp && jmdInp.disabled;

        var mcToSave  = (!mcAlreadyLocked  && state._mcRating  != null) ? state._mcRating  : null;
        var jmdToSave = (!jmdAlreadyLocked && state._jmdRating != null) ? state._jmdRating : null;

        if (mcToSave != null || jmdToSave != null) {
            payload.push({ mappingId: mid, mcRating: mcToSave, jmdRating: jmdToSave });
        }
    });
    if (!payload.length) { showToast('No new MC/JMD ratings to save.', 'err'); return; }
    var saved = 0;
    var promises = payload.map(function(p) {
        return fetch(SAVE_MC_JMD_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(p)
        }).then(function(r){ return r.json(); }).then(function(res){
            if (res.success) {
                saved++;
                // Lock ONLY the field(s) that were actually saved in this call,
                // and only now — on confirmed save — upgrade the status badge.
                if (p.mcRating  != null) _lockMcJmdRow(p.mappingId, 'mc');
                if (p.jmdRating != null) {
                    _lockMcJmdRow(p.mappingId, 'jmd');
                    _airUpdateStatusBadge(p.mappingId, 'JMDReview');
                }
                refreshAnnualStatusCounts();
            }
        });
    });
    Promise.all(promises).then(function() {
        showToast(saved + ' rating(s) saved and locked successfully.', 'ok');
        loadSentListFromServer();
        refreshAnnualStatusCounts();
    });
}

function _lockMcJmdRow(mid, field) {
    // field: 'mc' | 'jmd' | 'both' (default 'both' for backward compatibility)
    field = field || 'both';

    document.querySelectorAll('.annual-report-row[data-mappingid="' + mid + '"]').forEach(function(tr) {
        var mcInp  = tr.querySelector('.air-mc-input');
        var jmdInp = tr.querySelector('.air-jmd-input');

        if ((field === 'mc' || field === 'both') && mcInp) {
            mcInp.readOnly  = true;
            mcInp.disabled  = true;
            mcInp.style.background   = '#f0fdf4';
            mcInp.style.borderColor  = '#059669';
            mcInp.style.cursor       = 'not-allowed';
            mcInp.style.color        = '#065f46';
            mcInp.title = 'MC Rating saved & locked';

            var mcBadge = tr.querySelector('.air-lock-badge-mc');
            if (!mcBadge && mcInp.parentNode) {
                var bMc = document.createElement('span');
                bMc.className = 'air-lock-badge-mc';
                bMc.innerHTML = '🔒';
                bMc.title = 'MC Rating saved & locked';
                bMc.style.cssText = 'font-size:.75rem;margin-left:4px;vertical-align:middle;opacity:.7';
                mcInp.parentNode.appendChild(bMc);
            }
        }

        if ((field === 'jmd' || field === 'both') && jmdInp) {
            jmdInp.readOnly = true;
            jmdInp.disabled = true;
            jmdInp.style.background  = '#fdf2f8';
            jmdInp.style.borderColor = '#c026d3';
            jmdInp.style.cursor      = 'not-allowed';
            jmdInp.style.color       = '#701a75';
            jmdInp.title = 'JMD Rating saved & locked';

            var jmdBadge = tr.querySelector('.air-lock-badge-jmd');
            if (!jmdBadge && jmdInp.parentNode) {
                var bJmd = document.createElement('span');
                bJmd.className = 'air-lock-badge-jmd';
                bJmd.innerHTML = '🔒';
                bJmd.title = 'JMD Rating saved & locked';
                bJmd.style.cssText = 'font-size:.75rem;margin-left:4px;vertical-align:middle;opacity:.7';
                jmdInp.parentNode.appendChild(bJmd);
            }
        }
    });
}

function _airUpdateStatusBadge(mappingId, newStatus) {
    /* Update the status badge in the annual report table in real time */
    var scope = document.getElementById('s5-annual') || document;
    var rows = scope.querySelectorAll('.annual-report-row[data-mappingid="' + mappingId + '"]');
    rows.forEach(function(r) {
        var badge = r.querySelector('.status-badge');
        if (badge) {
            /* Only upgrade status — don't downgrade */
            var currentStatus = badge.textContent.trim();
            var statusRank = {
                'Draft': 0, 'EmployeeFilled': 1, 'RMReview': 2,
                'HODReview': 3, 'UnitHeadReview': 4,
                'ModCommitteeReview': 5, 'JMDReview': 6, 'HRFinalized': 7
            };
            if ((statusRank[newStatus] || 0) > (statusRank[currentStatus] || 0)) {
                badge.textContent = newStatus;
                badge.className = 'status-badge sb-jmd';
            }
        }
    });
}

/* Auto-save with debounce — fires 600ms after last keystroke */
var _airSaveTimers = {};
function _airAutoSave(mid, mcVal, jmdVal) {
    clearTimeout(_airSaveTimers[mid]);
    _airSaveTimers[mid] = setTimeout(function() {
        _airPersistMcJmd(mid, mcVal, jmdVal);
    }, 600);
}

function _airPersistMcJmd(mid, mcVal, jmdVal) {
    if (mcVal === null && jmdVal === null) return;
    var state = _airDetailStore[mid] || {};
    state._mcRating  = mcVal;
    state._jmdRating = jmdVal;
    _airDetailStore[mid] = state;

    fetch(SAVE_MC_JMD_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            mappingId: mid,
            mcRating:  mcVal  !== null ? mcVal  : null,
            jmdRating: jmdVal !== null ? jmdVal : null
        })
    })
    .then(function(r) { return r.json(); })
    .then(function(res) {
        if (res.success) {
            showToast('Rating saved for #' + mid, 'ok');

            // Refresh sent cycles list so status shows Completed
            loadSentListFromServer();

            // Re-render stage progress for this mapping in sent list immediately
            var sentRow = document.querySelector('.sent-emp-row[data-mappingid="' + mid + '"]');
            if (sentRow) {
                var progressWrap = sentRow.querySelector('.stage-progress-wrap');
                if (progressWrap) {
                    var statusBadge = sentRow.querySelector('.status-badge');
                    var curStatus = statusBadge
                        ? statusBadge.textContent.trim()
                        : (sentRow.dataset.filterstatus === 'completed' ? 'JMDReview' : 'Draft');
             var sentM = (_sentAllData || []).find(function(x){ return x.mappingId === mid; });
progressWrap.innerHTML = buildStageProgressJS(
    curStatus,
    _baStatusCache[mid] || null,
    mid,
    sentM || null
);
                }
            }

            /* Flash green on both pms-tr and ba-tr inputs */
            document.querySelectorAll(
                '.annual-report-row[data-mappingid="' + mid + '"]')
            .forEach(function(tr) {
                var mc  = tr.querySelector('.air-mc-input');
                var jmd = tr.querySelector('.air-jmd-input');
                if (mc  && mcVal  !== null) {
                    mc.style.borderColor = '#059669';
                    setTimeout(function(){ mc.style.borderColor = ''; }, 2500);
                }
                if (jmd && jmdVal !== null) {
                    jmd.style.borderColor = '#059669';
                    setTimeout(function(){ jmd.style.borderColor = ''; }, 2500);
                }
            });

        } else {
            showToast('Save failed: ' + (res.message || 'unknown error'), 'err');
        }
    })
    .catch(function(e) {
        showToast('Network error saving rating', 'err');
        console.error('[AIR] _airPersistMcJmd failed', e);
    });
}
