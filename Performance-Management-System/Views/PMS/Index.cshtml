                var isActive    = (cycleStatus !== 'Draft' && cycleStatus !== 'HRFinalized');
                var chipStyle   = 'display:inline-flex;align-items:center;gap:3px;' +
                    'padding:2px 9px;border-radius:20px;font-size:.67rem;' +
