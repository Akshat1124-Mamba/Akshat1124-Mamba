    var m = (_sentAllData || []).find(function(e){ return e.mappingId === mappingId; })
          || ALL_MAPPED_EMPLOYEES.find(function(e){ return e.mappingId === mappingId; });
    
    if (!m) { 
        // Try fetching directly from server
        fetch('/Pms/GetMappingDetail?mappingId=' + mappingId)
            .then(function(r){ return r.json(); })
            .then(function(data){
                if (data.error) { showToast('Record not found.', 'err'); return; }
                _editCycleMappingId = mappingId;
                setSelVal('rev-rmName',       data.rmName            || '');
