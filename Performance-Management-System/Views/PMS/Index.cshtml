function deleteRmvVersion(id) {
    if (!confirm('Delete this Rating Matrix Version? This cannot be undone.')) return;
    fetch(DELETE_RMV_URL + '?id=' + id, { method: 'POST' })
    .then(function(r) { return r.text(); })
    .then(function(text) {
        var res; try { res = JSON.parse(text); } catch(e) { showToast('Server error.', 'err'); return; }
        if (res.success) { showToast('Deleted.', 'ok'); location.reload(); }
        else showToast(res.message || 'Delete failed.', 'err');
    })
    .catch(function() { showToast('Network error.', 'err'); });
}

function lookupScoreHike() {
    var score = parseFloat((document.getElementById('lookupScore')||{}).value) || 0;
    var base  = parseFloat((document.getElementById('lookupBase') ||{}).value) || 0;
    var gross = parseFloat((document.getElementById('lookupGross')||{}).value) || 900000;
    var boxEl = document.getElementById('lookupResultBox');
    if (!score || !base) { if (boxEl) boxEl.style.display = 'none'; return; }
    var roundedRating = Math.min(5, Math.max(1, Math.round(score)));
    var rows  = _getActiveVersionRows();
    var match = rows.find(function(r){ return r.rating === roundedRating; });
    if (!match) { if (boxEl) boxEl.style.display = 'none'; return; }
    var finalHike = Math.max(0, base * (1 + match.hikeOverBasePercent / 100));
    finalHike = Math.round(finalHike * 100) / 100;
    var amount = Math.round(gross * finalHike / 100);
    boxEl.style.display = 'block';
    document.getElementById('lr-score').textContent    = score.toFixed(2);
    document.getElementById('lr-rating').textContent   = roundedRating;
    document.getElementById('lr-label').textContent    = match.ratingLabel;
    document.getElementById('lr-hikeover').textContent = (match.hikeOverBasePercent >= 0 ? '+' : '') + match.hikeOverBasePercent + '%';
    document.getElementById('lr-finalhike').textContent= finalHike + '%';
    document.getElementById('lr-gross-label').textContent = gross.toLocaleString('en-IN');
    document.getElementById('lr-amount').textContent   = '₹' + amount.toLocaleString('en-IN');
}

