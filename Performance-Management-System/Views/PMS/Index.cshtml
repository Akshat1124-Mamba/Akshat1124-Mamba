var cycleNorm    = (m.appraisalCycle || '').trim();
var yearStr      = String(m.appraisalYear || '');

/* ── Reviewer-edit lock check ──
   Annual: locked once JMD rating has been given (isCompleted above).
   Q1/Q2/Q3/Q4/Mid-Year: locked once Unit Head has completed
   their review (status has moved past UnitHeadReview). */
