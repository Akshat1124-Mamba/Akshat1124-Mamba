function renderAssignKpiReadonly(kpiRows){
    var container = document.getElementById('assignKpiReadonlyContainer');
    if (!kpiRows || !kpiRows.length) {
        container.innerHTML = '<div style="text-align:center;padding:20px;color:var(--ink4);font-size:.78rem">No KPIs found for this employee mapping.</div>';
        return;
    }
    var pmpGroups = {}, pmpOrder = [];
    kpiRows.forEach(function(r){
        if (!pmpGroups[r.pmpName]) { pmpGroups[r.pmpName] = { kras: {}, kraOrder: [] }; pmpOrder.push(r.pmpName); }
        var pg = pmpGroups[r.pmpName];
        if (!pg.kras[r.kraName]) { pg.kras[r.kraName] = []; pg.kraOrder.push(r.kraName); }
        pg.kras[r.kraName].push(r);
    });
    var html = '<div class="assign-kpi-readonly-panel">';
    var globalIdx = 0;
    pmpOrder.forEach(function(pmpName){
        var pg = pmpGroups[pmpName];
        html += '<div class="assign-kpi-pmp-block">';
        html += '<div class="assign-kpi-pmp-label">&#127919; ' + esc(pmpName) + '</div>';
        pg.kraOrder.forEach(function(kraName){
            html += '<div class="assign-kpi-kra-block">';
            html += '<div class="assign-kpi-kra-label">&#128204; ' + esc(kraName) + '</div>';
            pg.kras[kraName].forEach(function(r){
                globalIdx++;
                html += '<div class="assign-kpi-readonly-row">' +
                    '<span class="assign-kpi-readonly-num">KPI ' + globalIdx + '</span>' +
                    '<span class="assign-kpi-readonly-name">' + esc(r.kpiName) + '</span>' +
                    '<div class="assign-kpi-readonly-meta">' +
                        '<div class="assign-kpi-meta-chip chip-unit"><span class="chip-label">Unit</span>' + esc(r.unitOfMeasure) + '</div>' +
                        '<div class="assign-kpi-meta-chip chip-wt"><span class="chip-label">Weight</span>' + r.individualWeightage + '%</div>' +
                        '<div class="assign-kpi-meta-chip chip-target"><span class="chip-label">Target</span>' + r.target + '</div>' +
                    '</div>' +
                '</div>';
            });
            html += '</div>';
        });
        html += '</div>';
    });
    html += '</div>';
    container.innerHTML = html;
}

