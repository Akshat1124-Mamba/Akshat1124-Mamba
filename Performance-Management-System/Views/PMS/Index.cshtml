            'data-name="'         + (m.empName || '').toLowerCase() + '" ' +
            'data-code="'         + (m.empCode || '').toLowerCase() + '" ' +
            'data-filterstatus="' + filterCls                       + '" ' +
            'data-cycle="'        + esc(cycleNorm)                  + '" ' +
            'data-year="'         + esc(yearStr)                    + '" ' +
            'data-mappingid="'    + m.mappingId                     + '">' +
            '<td style="color:var(--ink4);font-family:var(--mono)">' + (i + 1) + '</td>' +
            '<td>' +
                '<div style="font-weight:600;font-size:.78rem">'    + esc(m.empName  || '') + '</div>' +
                '<div style="font-size:.67rem;color:var(--ink3)">'  + esc(m.email   || '') + '</div>' +
            '</td>' +
            '<td style="font-family:var(--mono);font-size:.72rem">' + esc(m.empCode     || '') + '</td>' +
            '<td class="plain-cell">'                               + esc(m.department  || '') + '</td>' +
            '<td><span class="badge badge-blue">'                   + esc(cycleNorm || '—') + '</span></td>' +
            '<td style="font-family:var(--mono);font-size:.72rem;color:var(--ink3)">' + (m.cycleFromDate || '—') + '</td>' +
            '<td style="font-family:var(--mono);font-size:.72rem;color:var(--ink3)">' + (m.cycleToDate   || '—') + '</td>' +
            '<td style="text-align:center;font-family:var(--mono)">' + m.appraisalYear + '</td>' +
            '<td style="text-align:center">' +
                '<div class="stage-progress-wrap">' +
                    buildStageProgressJS(m.status, _baStatusCache[m.mappingId] || null, m.mappingId, m) +
                '</div>' +
            '</td>' +
           '<td style="text-align:center">' +
    '<div style="display:flex;gap:5px;justify-content:center;align-items:center;">' +
        printBtn +
        (reviewersLocked
            ? '<span class="btn-edit-cycle" style="opacity:.45;cursor:not-allowed;pointer-events:none" ' +
              'title="' + (isAnnualCyc
                  ? 'Locked — JMD rating already given'
                  : 'Locked — Unit Head review already completed') + '">&#128274; Reviewers</span>'
            : '<button type="button" class="btn-edit-cycle" onclick="openRevModal(' + m.mappingId + ')">&#9999; Reviewers</button>') +
