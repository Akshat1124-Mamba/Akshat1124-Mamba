                if (overlay) overlay.classList.add('open');
            })
            .catch(function(){ showToast('Could not load reviewer data.', 'err'); });
        return;
    }

    _editCycleMappingId = mappingId;
    _revModalPrev = {
        rm:  m.rmName            || '',
        hod: m.hodName           || '',
        uh:  m.unitHeadName      || '',
        mod: m.modCommitteeNames || '',
