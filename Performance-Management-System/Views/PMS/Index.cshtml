/* ══ TARGET VALIDATION ══ */
function validateActualVsTarget(inputEl, target) {
    var actual = parseFloat(inputEl.value);
    var msgId  = inputEl.id + '_overtarget_msg';
    var existing = document.getElementById(msgId);
    if (!isNaN(actual) && actual > parseFloat(target)) {
        inputEl.classList.add('actual-over-target');
        if (!existing) {
            var msg = document.createElement('div');
            msg.id = msgId;
            msg.className = 'actual-over-target-msg';
            msg.innerHTML = '⚠ Actual (' + actual + ') exceeds target (' + target + ')';
            inputEl.parentNode.appendChild(msg);
        } else {
            existing.innerHTML = '⚠ Actual (' + actual + ') exceeds target (' + target + ')';
        }
        return false;
    } else {
        inputEl.classList.remove('actual-over-target');
        if (existing) existing.remove();
        return true;
    }
}

/* Call this when rendering actual-value inputs anywhere — pass target from KPI data */
function onActualInput(inputEl, target) {
    validateActualVsTarget(inputEl, target);
}

/* Block save if any actual exceeds target */
function validateAllActuals() {
    var allOk = true;
    document.querySelectorAll('[data-kpi-target]').forEach(function(el) {
        var target = parseFloat(el.getAttribute('data-kpi-target'));
        if (!validateActualVsTarget(el, target)) allOk = false;
    });
    return allOk;
}
/* ══ ANNUAL-ONLY INCREMENT CALC ══ */
function isAnnualCycle(cycleStr) {
    return (cycleStr || '').trim().toLowerCase() === 'annual';
}

/* Wrap wherever you compute final hike — returns 0 if not Annual */
function getFinalHikeForCycle(basePct, hikeOverBase, appraisalCycle) {
    if (!isAnnualCycle(appraisalCycle)) return 0;
    return Math.max(0, Math.round(basePct * (1 + hikeOverBase / 100) * 100) / 100);
}


/* ── Store for per-mapping detail data (PMS + BA scores) ── */
var _airDetailStore = {};
var _airPasData     = {
    baseMaster:   _pasBaseMaster   || [],
    ratingVersions: _rmvVersions   || [],
    yearlyPAT:    []   /* populated on demand */
};

/* ── Load annual report data on tab switch ── */
function loadAnnualReportData() {
    /* Pre-populate _airDetailStore with saved MC/JMD from server-rendered inputs */
    document.querySelectorAll('.air-mc-input').forEach(function(inp) {
        var mid = parseInt(inp.getAttribute('data-mid'));
        if (!mid) return;
        if (!_airDetailStore[mid]) _airDetailStore[mid] = {};
        if (inp.value && inp.value !== '') {
            _airDetailStore[mid]._mcRating = parseFloat(inp.value);
            inp.style.borderColor = '#059669';
        }
    });
    document.querySelectorAll('.air-jmd-input').forEach(function(inp) {
        var mid = parseInt(inp.getAttribute('data-mid'));
        if (!mid) return;
        if (!_airDetailStore[mid]) _airDetailStore[mid] = {};
        if (inp.value && inp.value !== '') {
            _airDetailStore[mid]._jmdRating = parseFloat(inp.value);
            inp.style.borderColor = '#059669';
        }
    });

    // Lock rows that already have saved values — MC and JMD independently
    document.querySelectorAll('.air-mc-input').forEach(function(inp) {
        var mid = parseInt(inp.getAttribute('data-mid'));
        if (inp.value && inp.value !== '') {
            _lockMcJmdRow(mid, 'mc');
        }
    });
    document.querySelectorAll('.air-jmd-input').forEach(function(inp) {
        var mid = parseInt(inp.getAttribute('data-mid'));
        if (inp.value && inp.value !== '') {
            _lockMcJmdRow(mid, 'jmd');
        }
    });

    /* Populate year filter dropdown from actual table rows — not ALL_MAPPED_EMPLOYEES */
    var years = [];
    document.querySelectorAll('#annualReportBody .annual-report-row').forEach(function(r) {
        var y = (r.getAttribute('data-year') || '').trim();
        if (y && years.indexOf(y) < 0) years.push(y);
    });
    /* Sort descending so newest FY appears first */
    years.sort(function(a, b) { return parseInt(b) - parseInt(a); });
    var sel = document.getElementById('annualYearFilter');
    if (sel) {
        /* Rebuild every time so stale options don't persist across tab switches */
        sel.innerHTML = '<option value="">All Years</option>';
        years.forEach(function(y) {
            var o = document.createElement('option');
            o.value = y;
            o.textContent = 'FY ' + y + '-' + String(parseInt(y) + 1).slice(-2);
            sel.appendChild(o);
        });
    }

    /* ── use document-level selector, NOT scoped to #s5-annual ── */
    var rows = document.querySelectorAll('.annual-report-row');
    console.log('[AIR] loadAnnualReportData: found', rows.length, 'rows');

    rows.forEach(function(row) {
        var mid = parseInt(row.getAttribute('data-mappingid'));
        if (!mid) return;

        fetch(GET_MAPPING_DETAIL + '?mappingId=' + mid)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                console.log('[AIR] mappingId=' + mid + ' kpiRows=' + (data.kpiRows ? data.kpiRows.length : 0) + ' status=' + data.status);
                if (data && !data.error) {
                    /* Restore saved MC/JMD from store into data */
                    var existing = _airDetailStore[mid] || {};
                    data._mcRating  = data._mcRating  || existing._mcRating;
                    data._jmdRating = data._jmdRating || existing._jmdRating;
                    _airDetailStore[mid] = Object.assign(existing, { mappingId: mid });
                    _airApplyDetailToRow(row, data);
                }
            })
            .catch(function(e) {
                console.error('[AIR] fetch failed for mappingId=' + mid, e);
            });
    });
    filterAnnualReport();
}
function _airApplyDetailToRow(row, data) {
    if (!data) return;
    var mid = parseInt(row.getAttribute('data-mappingid'));
    if (!mid) return;

    fetch('/Pms/GetPmsScoresForAnnualReport?mappingId=' + mid)
        .then(function(r) { return r.json(); })
        .then(function(scores) {
            if (scores.error) return;

            // Individual reviewer simple averages (for display cells)
            var empScore = scores.empScore != null ? Math.round(scores.empScore * 100) / 100 : null;
            var rmScore  = scores.rmScore  != null ? Math.round(scores.rmScore  * 100) / 100 : null;
            var hodScore = scores.hodScore != null ? Math.round(scores.hodScore * 100) / 100 : null;
            var uhScore  = scores.uhScore  != null ? Math.round(scores.uhScore  * 100) / 100 : null;

            // bscScore = SUM of (per-KPI avg × weightage) — the orange total from print view
            // This is what goes into the Weighted Rating formula as the PMS component
            var bscScore = Math.round((scores.bscScore || 0) * 100) / 100;

            // pmsSimpleAvg = simple avg of reviewer totals — shown in AVG ▣ cell only
            var filledScores = [empScore, rmScore, hodScore, uhScore]
                .filter(function(v) { return v != null; });
            var pmsSimpleAvg = filledScores.length > 0
                ? Math.round(
                    filledScores.reduce(function(a, b) { return a + b; }, 0)
                    / filledScores.length * 100
                  ) / 100
                : null;

            if (!_airDetailStore[mid]) _airDetailStore[mid] = {};
            _airDetailStore[mid].mappingId        = mid;
            _airDetailStore[mid].empId            = data.empId;
            _airDetailStore[mid].kpiRows          = data.kpiRows;
            _airDetailStore[mid]._pmsWeightedSelf = empScore;
            _airDetailStore[mid]._pmsWeightedRM   = rmScore;
            _airDetailStore[mid]._pmsWeightedHOD  = hodScore;
            _airDetailStore[mid]._pmsWeightedUH   = uhScore;
            _airDetailStore[mid]._pmsFinalScore   = bscScore;    // Wt.Rating SUM (4.1)
            _airDetailStore[mid]._pmsSimpleAvg    = pmsSimpleAvg; // AVG ▣ display (4.06)

            // Restore saved MC/JMD into the input fields (single row now, no siblings to loop)
            var savedMc  = _airDetailStore[mid]._mcRating;
            var savedJmd = _airDetailStore[mid]._jmdRating;
            var mcInp  = row.querySelector('.air-mc-input');
            var jmdInp = row.querySelector('.air-jmd-input');
            if (mcInp  && savedMc  != null && !mcInp.value)
                { mcInp.value  = savedMc;  mcInp.style.borderColor = '#059669'; }
            if (jmdInp && savedJmd != null && !jmdInp.value)
                { jmdInp.value = savedJmd; jmdInp.style.borderColor = '#059669'; }

            // Reviewer score display cells
            _airSetCell(mid, '.air-pms-self',
                empScore != null ? empScore.toFixed(2) : 'N/A', '#065f46');
            _airSetCell(mid, '.air-pms-rm',
                rmScore  != null ? rmScore.toFixed(2)  : 'N/A', '#065f46');
            _airSetCell(mid, '.air-pms-hod',
                hodScore != null ? hodScore.toFixed(2) : 'N/A', '#065f46');
            _airSetCell(mid, '.air-pms-uh',
                uhScore  != null ? uhScore.toFixed(2)  : 'N/A', '#065f46');

            // AVG ▣ = Wt.Rating SUM from PrintAppraisal (bscScore), not simple average
            _airSetCell(mid, '.air-pms-avg',
                bscScore > 0
                    ? bscScore.toFixed(2)
                    : (data.kpiRows && data.kpiRows.length ? 'Partial' : 'Pending'),
                '#065f46');

            // Fetch BA and compute Weighted Rating using bscScore (4.1) as PMS component
            _airFetchBAScores(mid, data.empId, mid, bscScore);
        })
        .catch(function(e) {
            console.error('[AIR] GetPmsScoresForAnnualReport failed for mid=' + mid, e);
        });
}
 
function _airFetchBAScores(mid, empId, mappingId, bscScore) {
    fetch('/Pms/GetBaScoresForAnnualReport?mappingId=' + mappingId + '&empId=' + empId)
        .then(function(r) { return r.json(); })
        .then(function(ba) {
            var baRmScore  = ba.rmScore  != null ? Math.round(ba.rmScore  * 100) / 100 : null;
            var baHodScore = ba.hodScore != null ? Math.round(ba.hodScore * 100) / 100 : null;
 
            var baAvg = null;
            if (baRmScore != null && baHodScore != null)
                baAvg = Math.round((baRmScore + baHodScore) / 2 * 100) / 100;
            else if (baRmScore  != null) baAvg = baRmScore;
            else if (baHodScore != null) baAvg = baHodScore;
 
            _airDetailStore[mid]._baRmScore  = baRmScore;
            _airDetailStore[mid]._baHodScore = baHodScore;
            _airDetailStore[mid]._baAvg      = baAvg;
 
            _airSetCell(mid, '.air-ba-rm',
                baRmScore  != null ? baRmScore.toFixed(2)  : '—', '#1e40af');
            _airSetCell(mid, '.air-ba-hod',
                baHodScore != null ? baHodScore.toFixed(2) : '—', '#1e40af');
            _airSetCell(mid, '.air-ba-avg',
                baAvg      != null ? baAvg.toFixed(2)      : '—', '#0d47a1');
 
            // Weighted Rating = bscScore (Wt.Rating SUM) × 0.8 + baAvg × 0.2
            // Example: 4.1 × 0.8 + 4.0 × 0.2 = 3.28 + 0.80 = 4.08 ✓
            _airComputeWeighted(mid, bscScore, baAvg);
        })
        .catch(function(e) {
            console.warn('[AIR] BA fetch failed for mid=' + mid, e);
            _airDetailStore[mid]._baRmScore  = null;
            _airDetailStore[mid]._baHodScore = null;
            _airDetailStore[mid]._baAvg      = null;
            _airComputeWeighted(mid, bscScore, null);
        });
}
 
 
function _airComputeWeighted(mid, bscScore, baAvg) {
    var wtRating;
 
    if (baAvg != null && baAvg > 0) {
        wtRating = Math.round((0.8 * bscScore + 0.2 * baAvg) * 100) / 100;
    } else {
        wtRating = bscScore;
    }
    wtRating = Math.round(wtRating * 100) / 100;
 
    _airDetailStore[mid]._wtRating = wtRating;

    // Orange box always shows the direct BSC Wt.Rating SUM (same as AVG ▣)
// Orange box = PMS×0.8 + BA×0.2 (or just PMS if no BA)
var _wtDisplay = (baAvg != null && baAvg > 0)
    ? (0.8 * bscScore + 0.2 * baAvg)
    : bscScore;
_wtDisplay = Math.round(_wtDisplay * 100) / 100;
_airSetCell(mid, '.air-wt-rating',
    bscScore > 0 ? _wtDisplay.toFixed(2) : '—', '#e65100');
 
    var mcRating  = _airDetailStore[mid]._mcRating;
    var jmdRating = _airDetailStore[mid]._jmdRating;
    _airUpdateFinal(mid, wtRating,
        mcRating  != null ? mcRating  : null,
        jmdRating != null ? jmdRating : null);
}
 
/* ── Update final rating and increment ── */
function _airUpdateFinal(mid, wtRating, mcRating, jmdRating) {
    _airDetailStore[mid]._mcRating  = mcRating;
    _airDetailStore[mid]._jmdRating = jmdRating;

    // JMD rating is mandatory — MC alone must never drive Final Rating / Incr %.
    if (jmdRating == null) {
        _airDetailStore[mid]._finalRating  = null;
        _airDetailStore[mid]._finalIncrPct = null;
        _airSetCell(mid, '.air-final-rating',
            mcRating != null ? '⏳ Awaiting JMD' : '—', '#c2410c');
        _airSetCell(mid, '.air-final-incr', '—', '#94a3b8');
        return;
    }

    var finalRating = Math.round(jmdRating * 100) / 100;
    _airDetailStore[mid]._finalRating = finalRating;

    var calcRating = Math.min(5, Math.max(1, Math.round(finalRating)));
    var incrPct = '—';
    var year = 0;
    var anyRow = document.querySelector('.annual-report-row[data-mappingid="' + mid + '"]');
    if (anyRow) year = parseInt(anyRow.getAttribute('data-year')) || 0;

    var basePercent  = 0;
    var hikeOverBase = 0;
    var ratingLabel  = 'Rating ' + calcRating;

    if (window._pasYearlyPATData) {
        var yearlyEntry = window._pasYearlyPATData.find(function(y) {
            var parts = (y.financialYear || '').split(/[-\/]/);
            if (parts.length && parseInt(parts[0]) === year) return true;
            return y.financialYear === String(year);
        });
        if (yearlyEntry) basePercent = parseFloat(yearlyEntry.basePercentage) || 0;
    }

    var activeVer = (_rmvVersions || []).find(function(v) { return v.isActive; })
                    || (_rmvVersions || [])[0];
    if (activeVer && activeVer.detailRows) {
        var dr = activeVer.detailRows.find(function(d) { return d.rating === calcRating; });
        if (dr) { hikeOverBase = parseFloat(dr.hikeOverBasePercent) || 0; ratingLabel = dr.ratingLabel || ratingLabel; }
    }

    if (basePercent > 0) {
        var finalIncrPct = Math.round(basePercent * (1 + hikeOverBase / 100) * 10000) / 10000;
        incrPct = finalIncrPct.toFixed(4) + '%';
        _airDetailStore[mid]._finalIncrPct = finalIncrPct;
    }

    _airSetCell(mid, '.air-final-rating', calcRating + ' (' + ratingLabel + ')', '#f59e0b');
    _airSetCell(mid, '.air-final-incr',   incrPct, '#34d399');
}
