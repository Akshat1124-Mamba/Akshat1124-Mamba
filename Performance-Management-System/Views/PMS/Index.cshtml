        years.forEach(function(y) {
            var o = document.createElement('option');
            o.value       = y;
            o.textContent = 'FY ' + y + '-' + String(parseInt(y) + 1).slice(-2);
            if (y === prevVal) o.selected = true;
            sel.appendChild(o);
        });
    }

    /* ── Pills (visual reference only) ── */
/* ── Pills removed ── */
var container = document.getElementById('sentYearPills');
if (container) container.innerHTML = '';

    /* ── Clear button ── */
    var clearBtn = document.getElementById('sentYearClearBtn');
    if (clearBtn) clearBtn.style.display = _sentYearFilter ? 'inline-flex' : 'none';
}
 
