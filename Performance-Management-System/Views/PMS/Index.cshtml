// Add this variable near other globals
var _revModalPrev = { rm:'', hod:'', uh:'', mod:'', jmd:'' };

function saveRevModal() {
    var mappingId = _editCycleMappingId;

    fetch('/Pms/UpdateReviewers', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            mappingId:         mappingId,
            rmName:            document.getElementById('rev-rmName').value,
            hodName:           document.getElementById('rev-hodName').value,
            unitHeadName:      document.getElementById('rev-unitHeadName').value,
            modCommitteeNames: document.getElementById('rev-modNames').value,
            jmdName:           document.getElementById('rev-jmdName').value,
            // Pass previous values for change detection on server
            prevRmName:        _revModalPrev.rm,
            prevHodName:       _revModalPrev.hod,
            prevUhName:        _revModalPrev.uh,
            prevModNames:      _revModalPrev.mod,
            prevJmdName:       _revModalPrev.jmd
        })
    })
    .then(function(r){ return r.json(); })
    .then(function(res){
        if (res.success) {
            // Update in-memory stores so UI reflects change immediately
            var inSent = (_sentAllData || []).find(function(e){ return e.mappingId === mappingId; });
            var inAll  = ALL_MAPPED_EMPLOYEES.find(function(e){ return e.mappingId === mappingId; });
            var newRm  = document.getElementById('rev-rmName').value;
            var newHod = document.getElementById('rev-hodName').value;
            var newUh  = document.getElementById('rev-unitHeadName').value;
            var newMod = document.getElementById('rev-modNames').value;
            var newJmd = document.getElementById('rev-jmdName').value;

            [inSent, inAll].forEach(function(rec) {
                if (!rec) return;
                rec.rmName            = newRm;
                rec.hodName           = newHod;
                rec.unitHeadName      = newUh;
                rec.modCommitteeNames = newMod;
                rec.jmdName           = newJmd;
            });

            showToast(res.message || 'Reviewers updated.', 'ok');
            closeRevModal();
            loadSentListFromServer(); // refresh table
        } else {
            showToast(res.message || 'Save failed.', 'err');
        }
    })
    .catch(function(){ showToast('Network error.', 'err'); });
}

function closeRevModal() {
    var overlay = document.getElementById('revModalOverlay');
    if (overlay) overlay.classList.remove('open');
    _editCycleMappingId = 0;
}

function setSentStatusFilter(filter, btn) {
    _sentStatusFilter = filter;
    document.querySelectorAll('#sentStatusFilterBar .sft-btn').forEach(function(b){ b.classList.remove('active','active-pending','active-done'); });
    if (filter === 'pending')        btn.classList.add('active-pending');
    else if (filter === 'completed') btn.classList.add('active-done');
    else                             btn.classList.add('active');
    applyCurrentSentFilter();
}

function applyCurrentSentFilter() {
    var q     = ((document.getElementById('sentListSearch') || {}).value || '').toLowerCase().trim();
    var rows  = document.querySelectorAll('.sent-emp-row');
    var visible = 0;

    rows.forEach(function(r) {
        var matchSearch = !q
            || (r.dataset.name || '').indexOf(q) >= 0
            || (r.dataset.code || '').indexOf(q) >= 0;
        var matchStatus = _sentStatusFilter === 'all'
            || r.dataset.filterstatus === _sentStatusFilter;
        var matchCycle = !_sentCycleFilter
            || (r.dataset.cycle || '').toLowerCase() === _sentCycleFilter.toLowerCase();
        var matchYear = !_sentYearFilter
            || (r.dataset.year || '') === _sentYearFilter;

        var show = matchSearch && matchStatus && matchCycle && matchYear;
        r.style.display = show ? '' : 'none';
        if (show) visible++;
    });

    var el = document.getElementById('sentListCount');
    if (el) el.textContent = visible + ' record(s)';

    // ← ADD THIS: recount badges based on what's now visible
    refreshSentListCounts();
}

function filterSentList() { applyCurrentSentFilter(); }
function refreshSentListCounts() {
    var rows = document.querySelectorAll('.sent-emp-row');
    var all = 0, pending = 0, completed = 0;

    rows.forEach(function(r) {
        // Only count rows that are actually visible after all filters applied
        if (r.style.display === 'none') return;

        all++;
        if (r.dataset.filterstatus === 'completed') completed++;
        else pending++;
    });

    var ca = document.getElementById('sent-count-all');       if (ca) ca.textContent = all;
    var cp = document.getElementById('sent-count-pending');   if (cp) cp.textContent = pending;
    var cd = document.getElementById('sent-count-completed'); if (cd) cd.textContent = completed;
}

