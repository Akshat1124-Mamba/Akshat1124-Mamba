    /* Step 1: Deduplicate → one row per employee */
    var empMap = {};
    _assignFiltered.forEach(function(m) {
        var key = (m.empCode || ('_mid_' + m.mappingId)).toLowerCase().trim();
        if (!empMap[key]) {
            empMap[key] = m;
        } else {
            var prev   = empMap[key];
            var prevYr = parseInt(prev.appraisalYear) || 0;
            var thisYr = parseInt(m.appraisalYear)    || 0;
            if ((thisYr === selYear && prevYr !== selYear) ||
                (thisYr === prevYr  && m.mappingId > prev.mappingId)) {
                empMap[key] = m;
            }
        }
    });
 
    /* Step 2: Sort */
    var deduped = Object.values(empMap);
    var col = _assignSortCol, asc = _assignSortAsc;
    deduped.sort(function(a, b) {
        var va = String(a[col] || '').toLowerCase();
        var vb = String(b[col] || '').toLowerCase();
        return asc ? va.localeCompare(vb) : vb.localeCompare(va);
    });
 
    /* Step 3: When a cycle IS selected, REMOVE employees who
       already have that cycle IN THE SELECTED YEAR */
    var hiddenCount = 0;
    if (selCycle) {
        var visible = [];
        deduped.forEach(function(m) {
            // Year-scoped check
            var assignedThisYear = _getAllCyclesForEmp(m.empCode, selYear);
            if (assignedThisYear.indexOf(selCycle) >= 0) {
                hiddenCount++;
                _assignSelected.delete(m.mappingId);
            } else {
                visible.push(m);
            }
        });
        deduped = visible;
    }
 
    /* Update counts */
    document.getElementById('assignTableRowCount').textContent   = deduped.length;
    document.getElementById('assignTableTotalCount').textContent = _assignAllMappings.length;
 
    /* Hidden note */
    var noteEl = document.getElementById('assignDisabledNote');
    if (noteEl) {
        if (selCycle && hiddenCount > 0) {
            noteEl.style.display = 'inline';
            noteEl.textContent   = hiddenCount + ' employee(s) already have ' +
                selCycle + ' assigned for ' + (selYear || 'this year') +
                ' — hidden from list';
        } else {
            noteEl.style.display = 'none';
        }
    }
 
    if (!deduped.length) {
        tbody.innerHTML =
            '<tr><td colspan="7" style="text-align:center;padding:28px;color:var(--ink4);">' +
            (selCycle
                ? 'All employees already have <strong>' + _aEsc(selCycle) +
                  '</strong> assigned for ' + (selYear || 'this year') + '.'
                : 'No employees match the current filters.') +
            '</td></tr>';
        syncAssignSelCount();
        return;
    }
 
    /* Render visible rows */
    var html = '';
 
    deduped.forEach(function(m, idx) {
        var empKey = (m.empCode || '').toLowerCase().trim();
 
        // Get ALL cycles across ALL years for display chips
       // Get cycles scoped to the selected year only
var allEmpHistory = _appraisalCycleData[empKey] || [];
var empHistoryAll = allEmpHistory.filter(function(h) {
    return !selYear || h.year === selYear;
});

// Merge freshly-assigned this session, year-scoped
Object.keys(_cycleStore).forEach(function(midStr) {
    var stored = _cycleStore[midStr];
    if (!stored || !stored.appraisalCycle || !stored.appraisalCycle.trim()) return;
    var rec = ALL_MAPPED_EMPLOYEES.find(function(x) {
        return x.mappingId === parseInt(midStr);
    });
    if (!rec) return;
    if ((rec.empCode || '').toLowerCase().trim() !== empKey) return;

    // Year-scope the _cycleStore entry
    var storedFY = 0;
    var fromRaw = (stored.cycleFromDate || '').trim();
    if (fromRaw) {
        var m1 = fromRaw.match(/^(\d{1,2})-([A-Za-z]{3})-(\d{2,4})$/);
        if (m1) {
            var months = {jan:1,feb:2,mar:3,apr:4,may:5,jun:6,
                          jul:7,aug:8,sep:9,oct:10,nov:11,dec:12};
            var mon = months[(m1[2]||'').toLowerCase()]||0;
            var yr  = parseInt(m1[3]); if (yr < 100) yr += 2000;
            storedFY = (mon >= 4) ? yr : yr - 1;
        } else {
            var m2 = fromRaw.match(/^(\d{4})-(\d{2})-(\d{2})$/);
            if (m2) {
                var cal2 = parseInt(m2[1]), mon2 = parseInt(m2[2]);
                storedFY = (mon2 >= 4) ? cal2 : cal2 - 1;
            }
        }
    }
    if (!storedFY) storedFY = parseInt(rec.appraisalYear) || 0;
    if (selYear && storedFY !== selYear) return;

    var alreadyIn = empHistoryAll.some(function(h) {
        return h.cycle === stored.appraisalCycle.trim() &&
               h.mappingId === parseInt(midStr);
    });
    if (!alreadyIn) {
        empHistoryAll = empHistoryAll.concat([{
            cycle:     stored.appraisalCycle.trim(),
            year:      storedFY || selYear,
            status:    stored.status || 'Draft',
            mappingId: parseInt(midStr),
            fromDate:  stored.cycleFromDate || '',
            toDate:    stored.cycleToDate   || ''
        }]);
    }
});

// Latest cycle for selected year (most recently assigned)
var latestCycle = empHistoryAll.length > 0 ? empHistoryAll[0].cycle : '';

// Unique cycle names for chip display — selected year only
var assignedCycles = [];
empHistoryAll.forEach(function(c) {
    if (assignedCycles.indexOf(c.cycle) < 0) assignedCycles.push(c.cycle);
});
 
        var checked = _assignSelected.has(m.mappingId);
        var rowBg   = checked
