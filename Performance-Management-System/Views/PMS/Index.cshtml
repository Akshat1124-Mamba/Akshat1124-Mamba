            '<td style="text-align:center">' + kpiCountCell + '</td>' +
          // BROKEN — missing + before the lastUpdated cell:
'<td style="font-family:var(--mono);font-size:.71rem;color:var(--ink3)">' +
    (m.createdAt || '—') + '</td>' +
'<td style="font-family:var(--mono);font-size:.71rem">' + lastUpdated + '</td>' +
