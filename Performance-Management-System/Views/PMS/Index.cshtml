/* Helper: find input in current row or sibling pms/ba row */
// REPLACE _airFindSiblingInput:
function _airFindSiblingInput(row, selector) {
    var el = row.querySelector(selector);
    if (el) return el;
    var mid = row.getAttribute('data-mappingid');
    if (!mid) return null;
    var siblings = document.querySelectorAll(
        '.annual-report-row[data-mappingid="' + mid + '"]');
    for (var i = 0; i < siblings.length; i++) {
        el = siblings[i].querySelector(selector);
        if (el) return el;
    }
    return null;
}
 

// REPLACE the existing _airSetCell function with this:
function _airSetCell(mid, selector, value, color) {
    /* Search ALL rows with this mappingId across the whole document */
    var allRows = document.querySelectorAll(
        '.annual-report-row[data-mappingid="' + mid + '"]');
    var cell = null;
    for (var i = 0; i < allRows.length; i++) {
        cell = allRows[i].querySelector(selector);
        if (cell) break;
    }
    if (!cell) {
        console.warn('[AIR] _airSetCell: cell not found', selector, 'for mid=', mid);
        return;
    }
    cell.textContent = value;
    if (color) cell.style.color = color;
}

/* ══ ANNUAL REPORT — MC/JMD STATUS FILTER ══ */
var _annualStatusFilter = 'all';

function setAnnualStatusFilter(filter, btn) {
    _annualStatusFilter = filter;
    document.querySelectorAll('#annualStatusFilterBar .sft-btn').forEach(function(b){
        b.classList.remove('active','active-pending','active-done');
    });
    if (filter === 'pending')        btn.classList.add('active-pending');
    else if (filter === 'completed') btn.classList.add('active-done');
    else                              btn.classList.add('active');
    filterAnnualReport();
}

function _annualRowIsCompleted(mid) {
    var d = _airDetailStore[mid] || {};
    var mc  = d._mcRating;
    var jmd = d._jmdRating;
    return (mc != null && mc > 0) && (jmd != null && jmd > 0);
}

function refreshAnnualStatusCounts() {
    var rows = document.querySelectorAll('#annualReportBody .annual-report-row');
    var all = 0, pending = 0, completed = 0;
    rows.forEach(function(r) {
        if (r.style.display === 'none') return;
        all++;
        var mid = parseInt(r.getAttribute('data-mappingid'));
        if (_annualRowIsCompleted(mid)) completed++; else pending++;
    });
    var ca = document.getElementById('annual-count-all');       if (ca) ca.textContent = all;
    var cp = document.getElementById('annual-count-pending');   if (cp) cp.textContent = pending;
    var cd = document.getElementById('annual-count-completed'); if (cd) cd.textContent = completed;
}

function filterAnnualReport() {
    var q    = ((document.getElementById('annualReportSearch') || {}).value || '').toLowerCase().trim();
    var year = ((document.getElementById('annualYearFilter') || {}).value || '');
    var rows = document.querySelectorAll('#annualReportBody .annual-report-row');
    var visible = 0;
    rows.forEach(function(r) {
        var matchName = !q || (r.dataset.name || '').indexOf(q) >= 0 || (r.dataset.code || '').indexOf(q) >= 0;
        var matchYear = !year || r.dataset.year === year;
        var mid = parseInt(r.getAttribute('data-mappingid'));
        var isCompleted = _annualRowIsCompleted(mid);
        var matchStatus = _annualStatusFilter === 'all'
            || (_annualStatusFilter === 'completed' && isCompleted)
            || (_annualStatusFilter === 'pending'   && !isCompleted);
        var show = matchName && matchYear && matchStatus;
        r.style.display = show ? '' : 'none';
        if (show) visible++;
    });
    var badge = document.getElementById('annualReportCount');
    if (badge) badge.textContent = visible + ' record(s)';
    refreshAnnualStatusCounts();
}
