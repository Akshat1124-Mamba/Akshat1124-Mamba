    total=Math.round(total*100)/100;
    document.getElementById('overallWtDisplay').textContent=total+'%';
    var pct=Math.min(total,100);var fill=document.getElementById('wtFill');
    fill.style.width=pct+'%';fill.style.background=total>100?'var(--rose)':total===100?'var(--emerald)':'var(--cobalt)';
}
