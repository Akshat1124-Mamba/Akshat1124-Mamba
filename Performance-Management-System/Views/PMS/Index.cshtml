var _sentYearFilter  = '';   // '', '2024', '2025', etc.
/* ── Move _loadMcJmdIntoAirStore to TOP LEVEL (outside loadSentListFromServer) ── */
function _loadMcJmdIntoAirStore(mappings) {
    var annualMappings = mappings.filter(function(m) {
        return (m.appraisalCycle || '').trim() === 'Annual'
            && m.mappingId
            && !(_airDetailStore[m.mappingId]
                && (_airDetailStore[m.mappingId]._mcRating != null
                    || _airDetailStore[m.mappingId]._jmdRating != null));
    });

    if (!annualMappings.length) return;

    var idx = 0;
    function fetchNext() {
        if (idx >= annualMappings.length) return;
        var m = annualMappings[idx++];

        fetch('/Pms/GetSavedMcJmdRatings?mappingId=' + m.mappingId)
            .then(function(r) { return r.json(); })
            .then(function(res) {
                if (res.error) return;
                if (!_airDetailStore[m.mappingId]) _airDetailStore[m.mappingId] = {};
                if (res.mcRating  != null) _airDetailStore[m.mappingId]._mcRating  = res.mcRating;
                if (res.jmdRating != null) _airDetailStore[m.mappingId]._jmdRating = res.jmdRating;

                var row = document.querySelector('.sent-emp-row[data-mappingid="' + m.mappingId + '"]');
                if (row) {
                    var sentM = (_sentAllData || []).find(function(x) { return x.mappingId === m.mappingId; });
                    var cell = row.querySelector('.stage-progress-wrap');
                    if (cell && sentM) {
                        cell.innerHTML = buildStageProgressJS(m.status, _baStatusCache[m.mappingId] || null, m.mappingId, sentM);
                    }
                    var actionsCell = row.querySelector('td:last-child');
                    if (actionsCell && sentM) {
                        var printUrl = PRINT_APPRAISAL_URL + '?mappingId=' + m.mappingId;
                        var unlocked = isPrintUnlocked(sentM);
                        var printBtn = actionsCell.querySelector('.btn-print-sheet, [class*="btn-print"]');
                        if (printBtn && unlocked) {
                            var a = document.createElement('a');
                            a.href = printUrl;
                            a.target = '_blank';
                            a.className = 'btn-print-sheet';
                            a.title = 'Print appraisal sheet';
                            a.innerHTML = '&#128424; Print';
                            printBtn.replaceWith(a);
                        }
                    }
                }
            })
            .catch(function() {})
            .finally(function() {
                setTimeout(fetchNext, 100);
            });
    }

    setTimeout(fetchNext, 200);
}

/* ── loadSentListFromServer — clean, self-contained ── */
function loadSentListFromServer() {
    fetch(GET_APPRAISAL_MAPS_URL)
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (!data || data.error) return;

            var merged = data.map(function(m) {
                var stored = _cycleStore[m.mappingId] || {};
                return {
                    mappingId:         m.mappingId,
                    userId:            m.userId,
                    empId:             m.empId,
                    empName:           m.empName,
                    empCode:           m.empCode,
                    designation:       m.designation,
                    department:        m.department,
                    email:             m.email,
                    appraisalYear:     m.appraisalYear,
                    rmName:            m.rmName            || stored.rmName            || '',
                    hodName:           m.hodName           || stored.hodName           || '',
                    unitHeadName:      m.unitHeadName      || stored.unitHeadName      || '',
                    modCommitteeNames: m.modCommitteeNames || stored.modCommitteeNames || '',
                    jmdName:           m.jmdName           || stored.jmdName           || '',
                    status:            m.status            || stored.status            || 'Draft',
                    kpiCount:          m.kpiCount,
                    appraisalCycle:    m.appraisalCycle    || stored.appraisalCycle    || '',
                    cycleFromDate:     m.cycleFromDate     || stored.cycleFromDate     || '',
                    cycleToDate:       m.cycleToDate       || stored.cycleToDate       || '',
                    createdAt:         m.createdAt || '—',
                    jmdRating:         m.jmdRating,
                    mcRating:          m.mcRating
                };
            });


            /* seed _airDetailStore from server JMD/MC ratings so print
               button reflects correct state on first render */
            merged.forEach(function(m) {
                if ((m.appraisalCycle || '').trim() === 'Annual') {
                    if (!_airDetailStore[m.mappingId]) _airDetailStore[m.mappingId] = {};
                    if (_airDetailStore[m.mappingId]._jmdRating == null && m.jmdRating != null)
                        _airDetailStore[m.mappingId]._jmdRating = m.jmdRating;
                    if (_airDetailStore[m.mappingId]._mcRating == null && m.mcRating != null)
                        _airDetailStore[m.mappingId]._mcRating = m.mcRating;
                }
            });

            _sentAllData = merged;
            renderSentListTable(merged);
            _loadMcJmdIntoAirStore(merged);  /* now callable — top-level function */
            _sentAllData = merged;
            renderSentListTable(merged);
            _loadMcJmdIntoAirStore(merged);  /* now callable — top-level function */
        })
        .catch(function(e) {
            console.error('[loadSentListFromServer] failed:', e);
        });
}

