function onPasYearInput() {
    var raw = (document.getElementById('pasFinancialYear').value || '').trim();
    var parsed = parseFYInput(raw);
    if (parsed) {
        document.getElementById('pasFYStart').value = parsed.startYear + '-04-01';
        document.getElementById('pasFYEnd').value   = (parsed.startYear + 1) + '-03-31';
    } else {
        document.getElementById('pasFYStart').value = '';
        document.getElementById('pasFYEnd').value   = '';
    }
}
function parseFYInput(raw) {
    if (!raw) return null;
    var m1 = raw.match(/^(\d{4})$/);
    if (m1) { var s = parseInt(m1[1]); return { startYear: s, endYear: s+1, label: s+'-'+String(s+1).slice(-2) }; }
    var m2 = raw.match(/^(\d{4})[-\/](\d{2})$/);
    if (m2) { var s2=parseInt(m2[1]); var e2=(s2-(s2%100))+parseInt(m2[2]); if(e2===s2+1) return {startYear:s2,endYear:e2,label:s2+'-'+m2[2]}; }
    var m3 = raw.match(/^(\d{4})[-\/](\d{4})$/);
    if (m3) { var s3=parseInt(m3[1]); var e3=parseInt(m3[2]); if(e3===s3+1) return {startYear:s3,endYear:e3,label:s3+'-'+String(e3).slice(-2)}; }
    return null;
}
function calcPATPercentDirect() {
    var pct    = parseFloat(document.getElementById('pasPATPercent').value);
    var baseEl = document.getElementById('pasYearlyBase');
    var preview = document.getElementById('pasYearlyPreview');
    if (isNaN(pct)) { baseEl.value = ''; if (preview) preview.style.display = 'none'; return; }
    var baseRow = lookupBasePercent(pct);
    if (baseRow) {
        baseEl.value = baseRow.basePercentage + '%';
        renderYearlyIncrementPreview(baseRow.basePercentage, pct);
        if (preview) preview.style.display = 'block';
    } else {
        baseEl.value = 'Out of range';
        if (preview) preview.style.display = 'none';
    }
}
function calcPATPercent() { calcPATPercentDirect(); }
function lookupBasePercent(patPct) {
    for (var i = 0; i < _pasBaseMaster.length; i++) {
        var r = _pasBaseMaster[i];
        if (r.pATRevenueMin === null || r.pATRevenueMin === undefined) { if (patPct <= r.pATRevenueMax) return r; }
        else { if (patPct > r.pATRevenueMin && patPct <= r.pATRevenueMax) return r; }
    }
    return null;
}
function renderYearlyIncrementPreview(basePct, patPct) {
    var fy = (document.getElementById('pasFinancialYear').value || '').trim();
    document.getElementById('previewFY').textContent    = fy || '—';
    document.getElementById('previewBaseLabel').textContent = 'Base: ' + basePct + '%';

    var sortedRatings = _pasRatingMaster.slice().sort(function(a,b){ return b.rating - a.rating; });

    var html = sortedRatings.map(function(r){
        var hike         = r.hikeOverBasePercent;
        var finalHikePct = Math.max(0, basePct * (1 + hike / 100));
        finalHikePct     = Math.round(finalHikePct * 100) / 100;
        var grossIncr    = Math.round(900000 * finalHikePct / 100);
        var chipCls      = finalHikePct > basePct ? 'hike-positive'
                         : finalHikePct === 0     ? 'hike-zero'
                                                  : 'hike-negative';
        return '<tr>' +
            '<td><strong style="font-family:var(--mono);font-size:.90rem">' + r.rating + '</strong></td>' +
            '<td>' + esc(r.ratingLabel) + '</td>' +
            '<td class="td-r" style="font-family:var(--mono)">' + (hike >= 0 ? '+' : '') + hike + '%</td>' +
            '<td class="td-r"><span class="pas-preview-hike-chip ' + chipCls + '">' + finalHikePct + '%</span></td>' +
            '<td class="td-r" style="font-family:var(--mono);color:rgba(255,255,255,.6)">₹' + grossIncr.toLocaleString('en-IN') + '</td>' +
        '</tr>';
    }).join('');

    document.getElementById('previewIncrementBody').innerHTML = html;
}
