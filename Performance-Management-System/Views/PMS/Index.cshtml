function deleteKpi(id) {
    if (!window.confirm('Delete this KPI? This cannot be undone.')) return;

    // Instantly fade the row so user gets immediate feedback
    var row = document.getElementById('kpi-row-' + id);
    if (row) {
        row.style.transition = 'opacity 0.15s';
        row.style.opacity = '0.3';
        row.style.pointerEvents = 'none';
    }

    fetch(DELETE_KPI_URL + '?id=' + id, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function(r) { return r.text(); })
    .then(function(text) {
        var res;
        try { res = JSON.parse(text); }
        catch(e) {
            if (row) { row.style.opacity = '1'; row.style.pointerEvents = ''; }
            showToast('Server error — check console.', 'err');
            return;
        }

        if (res.success) {
            showToast(res.message || 'KPI deleted.', 'ok');
            // Let refreshKpiTable rebuild correctly — no manual DOM rowspan touching
            refreshKpiTable();
        } else {
            // Restore row if delete failed
            if (row) { row.style.opacity = '1'; row.style.pointerEvents = ''; }
            showToast(res.message || 'Delete failed.', 'err');
        }
    })
    .catch(function(e) {
        if (row) { row.style.opacity = '1'; row.style.pointerEvents = ''; }
        showToast('Network error: ' + e.message, 'err');
    });
}
