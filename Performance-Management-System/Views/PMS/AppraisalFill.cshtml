                            @if (role != "Employee" && showEmp)
                            {
                                <th colspan="2" class="cg-emp">✏️ Employee</th>
                            }
                            @if (role != "RM" && showRm)
                            {
                                <th colspan="3" class="cg-rm">👔 Reporting Manager</th>
                            }
                            @if (role != "HOD" && showHod)
                            {
                                <th colspan="3" class="cg-hod">🏛 HOD</th>
                            }
                            @if (role != "UnitHead" && showUh)
                            {
                                <th colspan="3" class="cg-uh">🏢 Unit Head</th>
                            }

