                                </td>
                                <td class="tc" style="font-family:var(--mono);color:var(--c-slate);font-size:.72rem">@row.UnitOfMeasure</td>
                                <td class="tr" style="font-size:.72rem">@row.IndividualWeightage.ToString("0.##")%</td>
                                <td class="tc" style="font-family:var(--mono);font-weight:700;color:var(--c-navy)">@row.Target.ToString("0.##")%</td>

                                @* ── Employee (active / editable) ── *@
                                @if (role == "Employee" && showEmp)
                                {
                                    <td class="tc bg-active-emp">
                                        @if (canEdit)
                                        {
                                            <input type="number" class="num-inp ei emp-actual"
                                                   data-id="@row.EmpKpiRowId" data-target="@row.Target.ToString("0.##")"
                                                   value="@(row.EmpActual?.ToString("0.##") ?? "")"
                                                   placeholder="0" step="0.01" min="0" max="100" />
                                        }
                                        else
                                        {

                                            <span class="val ve">@(row.EmpActual.HasValue? row.EmpActual.Value.ToString("0.##") : "—")</span>
                                        }
                                    </td>
                                    <td class="tc bg-active-emp">
                                        @if (canEdit)
                                        {
                                            <div class="stars" data-id="@row.EmpKpiRowId" data-field="empRating">
                                                @for (int s = 1; s <= 5; s++)
                                                {
                                                    <button type="button" class="star @(row.EmpRating.HasValue && (int)row.EmpRating.Value >= s ? "on" : "")"
                                                            data-val="@s" onclick="setRating(this)">
                                                        @s
                                                    </button>
                                                }
                                            </div>
                                            <input type="hidden" class="emp-rating" data-id="@row.EmpKpiRowId"
                                                   value="@(row.EmpRating?.ToString("0") ?? "")" />
                                        }
                                        else
                                        {
                                            @if (row.EmpRating.HasValue)
                                            {
                                                var rv = (int)row.EmpRating.Value;
                                                <span class="rb rb@rv">@rv</span>
                                            }
                                            else
                                            {

                                                <span style="color:var(--c-muted)">—</span>
                                            }
                                        }
                                    </td>
                                }

                                @* ── RM (active / editable) ── *@
                                @if (role == "RM" && showRm)
                                {
                                    <td class="tc bg-active-rm">
                                        @if (canEdit)
                                        {
                                            <input type="number" class="num-inp ri rm-actual"
                                                   data-id="@row.EmpKpiRowId" data-target="@row.Target.ToString("0.##")"
                                                   value="@(row.RmActual?.ToString("0.##") ?? "")"
                                                   placeholder="0" step="0.01" min="0" max="100" />
                                        }
                                        else
                                        {

                                            <span class="val vr">@(row.RmActual.HasValue? row.RmActual.Value.ToString("0.##") : "—")</span>
                                        }
                                    </td>
                                    <td class="tc bg-active-rm">
                                        @if (canEdit)
                                        {
                                            <div class="stars" data-id="@row.EmpKpiRowId" data-field="rmRating">
                                                @for (int s = 1; s <= 5; s++)
                                                {
                                                    <button type="button" class="star @(row.RmRating.HasValue && (int)row.RmRating.Value >= s ? "on" : "")"
                                                            data-val="@s" onclick="setRating(this)">
                                                        @s
                                                    </button>
                                                }
                                            </div>
                                            <input type="hidden" class="rm-rating" data-id="@row.EmpKpiRowId"
                                                   value="@(row.RmRating?.ToString("0") ?? "")" />
                                        }
                                        else
                                        {
                                            @if (row.RmRating.HasValue)
                                            {
                                                var rv = (int)row.RmRating.Value;
                                                <span class="rb rb@rv">@rv</span>
                                            }
                                            else
                                            {

                                                <span style="color:var(--c-muted)">—</span>
                                            }
                                        }
                                    </td>
                                    <td class="bg-active-rm">
                                        @if (canEdit)
                                        {
                                            <input type="text" class="rem-inp rm-remarks" data-id="@row.EmpKpiRowId"
                                                   value="@(row.RmRemarks ?? "")" placeholder="Remarks…" />
                                        }
                                        else
                                        {

                                            <span style="font-size:.73rem;color:var(--c-slate)">@(string.IsNullOrEmpty(row.RmRemarks) ? "—" : row.RmRemarks)</span>
                                        }
                                    </td>
                                }

                                @* ── HOD (active / editable) ── *@
                                @if (role == "HOD" && showHod)
                                {
                                    <td class="tc bg-active-hod">
                                        @if (canEdit)
                                        {
                                            <input type="number" class="num-inp hi hod-actual"
                                                   data-id="@row.EmpKpiRowId" data-target="@row.Target.ToString("0.##")"
                                                   value="@(row.HodActual?.ToString("0.##") ?? "")"
                                                   placeholder="0" step="0.01" min="0" max="100" />
                                        }
                                        else
                                        {

                                            <span class="val vh">@(row.HodActual.HasValue? row.HodActual.Value.ToString("0.##") : "—")</span>
                                        }
                                    </td>
                                    <td class="tc bg-active-hod">
                                        @if (canEdit)
                                        {
                                            <div class="stars" data-id="@row.EmpKpiRowId" data-field="hodRating">
                                                @for (int s = 1; s <= 5; s++)
                                                {
                                                    <button type="button" class="star @(row.HodRating.HasValue && (int)row.HodRating.Value >= s ? "on" : "")"
                                                            data-val="@s" onclick="setRating(this)">
                                                        @s
                                                    </button>
                                                }
                                            </div>
                                            <input type="hidden" class="hod-rating" data-id="@row.EmpKpiRowId"
                                                   value="@(row.HodRating?.ToString("0") ?? "")" />
                                        }
                                        else
                                        {
                                            @if (row.HodRating.HasValue)
                                            {
                                                var rv = (int)row.HodRating.Value;
                                                <span class="rb rb@rv">@rv</span>
                                            }
                                            else
                                            {

                                                <span style="color:var(--c-muted)">—</span>
                                            }
                                        }
                                    </td>
                                    <td class="bg-active-hod">
                                        @if (canEdit)
                                        {
                                            <input type="text" class="rem-inp hod-remarks" data-id="@row.EmpKpiRowId"
                                                   value="@(row.HodRemarks ?? "")" placeholder="Remarks…" />
                                        }
                                        else
                                        {

                                            <span style="font-size:.73rem;color:var(--c-slate)">@(string.IsNullOrEmpty(row.HodRemarks) ? "—" : row.HodRemarks)</span>
                                        }
                                    </td>
                                }

                                @* ── UnitHead (active / editable) ── *@
                                @if (role == "UnitHead" && showUh)
                                {
                                    <td class="tc bg-active-uh">
                                        @if (canEdit)
                                        {
                                            <input type="number" class="num-inp ui uh-actual"
                                                   data-id="@row.EmpKpiRowId" data-target="@row.Target.ToString("0.##")"
                                                   value="@(row.UnitHeadActual?.ToString("0.##") ?? "")"
                                                   placeholder="0" step="0.01" min="0" max="100" />
                                        }
                                        else
                                        {

                                            <span class="val vu">@(row.UnitHeadActual.HasValue? row.UnitHeadActual.Value.ToString("0.##") : "—")</span>
                                        }
                                    </td>
                                    <td class="tc bg-active-uh">
                                        @if (canEdit)
                                        {
                                            <div class="stars" data-id="@row.EmpKpiRowId" data-field="uhRating">
                                                @for (int s = 1; s <= 5; s++)
                                                {
                                                    <button type="button" class="star @(row.UnitHeadRating.HasValue && (int)row.UnitHeadRating.Value >= s ? "on" : "")"
                                                            data-val="@s" onclick="setRating(this)">
                                                        @s
                                                    </button>
                                                }
                                            </div>
                                            <input type="hidden" class="uh-rating" data-id="@row.EmpKpiRowId"
                                                   value="@(row.UnitHeadRating?.ToString("0") ?? "")" />
                                        }
                                        else
                                        {
                                            @if (row.UnitHeadRating.HasValue)
                                            {
                                                var rv = (int)row.UnitHeadRating.Value;
                                                <span class="rb rb@rv">@rv</span>
                                            }
                                            else
                                            {

                                                <span style="color:var(--c-muted)">—</span>
                                            }
                                        }
                                    </td>
                                    <td class="bg-active-uh">
                                        @if (canEdit)
                                        {
                                            <input type="text" class="rem-inp uh-remarks" data-id="@row.EmpKpiRowId"
                                                   value="@(row.UnitHeadRemarks ?? "")" placeholder="Remarks…" />
                                        }
                                        else
                                        {

                                            <span style="font-size:.73rem;color:var(--c-slate)">@(string.IsNullOrEmpty(row.UnitHeadRemarks) ? "—" : row.UnitHeadRemarks)</span>
                                        }
                                    </td>
                                }

                                @* ── Employee read-only (shown to RM / HOD / UH / MC / JMD / HR) ── *@
                                @if (role != "Employee" && showEmp)
                                {
                                    <td class="tc bg-emp"><span class="val ve">@(row.EmpActual.HasValue? row.EmpActual.Value.ToString("0.##") : "—")</span></td>
                                    <td class="tc bg-emp">
                                        @if (row.EmpRating.HasValue)
                                        {
                                            var rv = (int)row.EmpRating.Value;
                                            <span class="rb rb@rv">@rv</span>
                                        }
                                        else
                                        {

                                            <span style="color:var(--c-muted)">—</span>
                                        }
                                    </td>
                                }

                                @* ── RM read-only ── *@
                                @if (role != "RM" && showRm)
                                {
                                    <td class="tc bg-rm"><span class="val vr">@(row.RmActual.HasValue? row.RmActual.Value.ToString("0.##") : "—")</span></td>
                                    <td class="tc bg-rm">
                                        @if (row.RmRating.HasValue)
                                        {
                                            var rv = (int)row.RmRating.Value;
                                            <span class="rb rb@rv">@rv</span>
                                        }
                                        else
                                        {

                                            <span style="color:var(--c-muted)">—</span>
                                        }
                                    </td>
                                    <td class="bg-rm"><span style="font-size:.73rem;color:var(--c-slate)">@(string.IsNullOrEmpty(row.RmRemarks) ? "—" : row.RmRemarks)</span></td>
                                }

                                @* ── HOD read-only ── *@
                                @if (role != "HOD" && showHod)
                                {
                                    <td class="tc bg-hod"><span class="val vh">@(row.HodActual.HasValue? row.HodActual.Value.ToString("0.##") : "—")</span></td>
                                    <td class="tc bg-hod">
                                        @if (row.HodRating.HasValue)
                                        {
                                            var rv = (int)row.HodRating.Value;
                                            <span class="rb rb@rv">@rv</span>
                                        }
                                        else
                                        {

                                            <span style="color:var(--c-muted)">—</span>
                                        }
                                    </td>
                                    <td class="bg-hod"><span style="font-size:.73rem;color:var(--c-slate)">@(string.IsNullOrEmpty(row.HodRemarks) ? "—" : row.HodRemarks)</span></td>
                                }

                                @* ── UnitHead read-only ── *@
                                @if (role != "UnitHead" && showUh)
                                {
                                    <td class="tc bg-uh"><span class="val vu">@(row.UnitHeadActual.HasValue? row.UnitHeadActual.Value.ToString("0.##") : "—")</span></td>
                                    <td class="tc bg-uh">
                                        @if (row.UnitHeadRating.HasValue)
                                        {
                                            var rv = (int)row.UnitHeadRating.Value;
                                            <span class="rb rb@rv">@rv</span>
                                        }
                                        else
                                        {

                                            <span style="color:var(--c-muted)">—</span>
                                        }
                                    </td>
                                    <td class="bg-uh"><span style="font-size:.73rem;color:var(--c-slate)">@(string.IsNullOrEmpty(row.UnitHeadRemarks) ? "—" : row.UnitHeadRemarks)</span></td>
                                }

                                @* ── DOCUMENTS ── *@
                                <td style="vertical-align:top;padding:10px 12px">
                                    <div class="doc-zone" id="doczone-@row.EmpKpiRowId">
                                        <div class="doc-zone-inner">
                                            @if (canEdit)
                                            {
                                                <label class="doc-upload-btn" title="Attach JPEG, PDF or DOC">
                                                    📎 @(role == "Employee" ? "Attach" : "Add Doc")
                                                    <input type="file"
                                                           accept=".jpg,.jpeg,.pdf,.doc,.docx,image/jpeg,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                                                           onchange="handleDocUpload(event, @row.EmpKpiRowId)" multiple />
                                                </label>
                                            }
                                        </div>
                                        <div class="doc-pills" id="docpills-@row.EmpKpiRowId">
                                            @if (row.Documents != null && row.Documents.Any())
                                            {
                                                foreach (var doc in row.Documents)
                                                {
                                                    var roleLabel = doc.UploaderRole switch
                                                    {
                                                        "Employee" => ("EMP", "#92400e", "#fef9ee"),
                                                        "RM" => ("RM", "#1e40af", "#eff6ff"),
                                                        "HOD" => ("HOD", "#5b21b6", "#f5f3ff"),
                                                        "UnitHead" => ("UH", "#0f766e", "#f0fdfa"),
                                                        "ModCommittee" => ("MC", "#c2410c", "#fff7ed"),
                                                        "JMD" => ("JMD", "#9d174d", "#fdf2f8"),
                                                        _ => ("HR", "#047857", "#ecfdf5")
                                                    };
                                                    var ext = System.IO.Path.GetExtension(doc.FileName).ToLower();
                                                    var icon = ext is ".pdf" ? "📄" : ext is ".jpg" or ".jpeg" ? "🖼" : "📝";
                                                    <div class="doc-pill" id="docpill-@doc.Id">
                                                        <span class="doc-pill-icon">@icon</span>
                                                        <span class="doc-pill-name" title="@doc.OriginalFileName">@doc.OriginalFileName</span>
                                                        <span class="doc-pill-role" style="color:@roleLabel.Item2;background:@roleLabel.Item3">@roleLabel.Item1</span>
                                                        <a href="/Pms/DownloadKpiDoc?id=@doc.Id" target="_blank" class="doc-pill-view">View</a>
                                                        @if (canEdit && doc.UploaderRole == role)
                                                        {
                                                            <button type="button" class="doc-pill-del"
                                                                    onclick="deleteKpiDoc(@doc.Id, @row.EmpKpiRowId)" title="Remove">
                                                                ✕
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>
                                       
                                    </div>
                                </td>

                                @* ════════════════════════════════════════════
                               JUSTIFICATION COLUMN
                            ════════════════════════════════════════════ *@
                                <td class="bg-just" style="vertical-align:top;padding:10px 12px">
                                    @if (role == "Employee" && canEdit)
                                    {
                                        <textarea class="justification-inp emp-justification"
                                          id="just-@row.EmpKpiRowId"
                                          data-id="@row.EmpKpiRowId"
                                          maxlength="500"
                                          placeholder="Explain your performance for this KPI — what you achieved, how you measured it, and any challenges faced…"
                                          oninput="onJustificationInput(this)">@(row.EmpJustification ?? "")</textarea>
                                        <div class="just-char-count" id="justcount-@row.EmpKpiRowId">
                                            <span id="justcountval-@row.EmpKpiRowId">@((row.EmpJustification ?? "").Length)</span> / 500
                                        </div>
                                        <div class="just-missing-warn" id="justwarn-@row.EmpKpiRowId">⚠ Justification required</div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(row.EmpJustification))
                                    {
                                        <div style="display:flex;flex-direction:column;gap:4px">
                                            <span style="font-size:.60rem;font-weight:700;color:var(--just-tx);text-transform:uppercase;letter-spacing:.06em;margin-bottom:2px">Employee Justification</span>
                                            <span class="just-display">@row.EmpJustification</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span style="color:var(--c-muted);font-size:.72rem;font-style:italic">No justification provided</span>
                                    }
                                </td>

                                @* ── WEIGHTED RATING ── *@
                                <td class="tc">
                                    <span style="font-family:var(--mono);font-weight:700;color:var(--c-navy);font-size:.82rem">
                                        @(row.WeightedRating.HasValue? row.WeightedRating.Value.ToString("0.00") : "—")
                                    </span>
                                </td>

                            </tr>
                        }

                        <!-- Total row -->
                        <tr class="total-row">
                            <td colspan="@(fixedCols + dynCols)" style="text-align:right;font-size:.70rem;letter-spacing:.08em;opacity:.6">
                                TOTAL WEIGHTED RATING
                            </td>
                            <td class="tc" colspan="2"><span class="total-score">@totalWR.ToString("0.00")</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ACTION BAR -->
        @if (canEdit)
        {
            <div class="action-bar">
                <div class="action-msg" style="display:flex;flex-direction:column;gap:8px;flex:1">
                    @if (role is not "ModCommittee" and not "JMD")
                    {
                        <div style="display:flex;align-items:center;gap:12px">
                            <span class="kpi-counter" id="progressCounter" style="color:var(--c-slate)">0 / @m.KpiRows.Count filled</span>
                            <div class="kpi-progress-bar">
                                <div class="kpi-progress-fill" id="progressFill" style="width:0%"></div>
                            </div>
                        </div>
                    }
                    <span id="valMsg" style="color:#dc2626;font-weight:600;display:none">
                        ⚠️ <span id="valMsgText">Please fill Actual, Rating and Justification for every KPI before submitting.</span>
                    </span>
                    <span id="okMsg" style="display:none;color:#15803d;font-weight:600">
                        @if (role is "ModCommittee" or "JMD")
                        {
                            <text>✔ Ready to submit — Overall rating provided.</text>
                        }
                        else
                        {

                            <text>✔ All @m.KpiRows.Count KPI(s) filled — ready to submit.</text>
                        }
                    </span>
                </div>
                <div class="btn-row">
                    <button type="button" class="btn btn-sec" onclick="history.back()">Cancel</button>
                    <button type="button" class="btn btn-pri" id="btnSubmit" onclick="doSubmit()">
                        <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                            <path d="M1.5 7l4 4 6-6.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        @submitLabel
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="action-bar">
                <div class="action-msg">
                    @(m.Status == "EmployeeFilled" && role == "Employee" ? "Your appraisal has been submitted and is awaiting Reporting Manager review." :
                                    m.Status == "RMReview" && role == "RM" ? "RM review submitted. Awaiting HOD review." :
                                    m.Status == "HODReview" && role == "HOD" ? "HOD review submitted. Awaiting Unit Head review." :
                                    m.Status == "UnitHeadReview" && role == "UnitHead" ? "Unit Head review submitted. Awaiting Moderation Committee review." :
                                    m.Status == "ModCommitteeReview" && role == "ModCommittee" ? "Moderation Committee review submitted. Awaiting JMD review." :
                                    m.Status == "JMDReview" && role == "JMD" ? "JMD review submitted. Awaiting HR finalization." :
                                    m.Status == "HRFinalized" ? "This appraisal has been finalized by HR." :
                                    "This appraisal sheet is currently in read-only mode.")
            </div>
            <button type="button" class="btn btn-sec" onclick="history.back()">← Back</button>
        </div>
                }

    </div><!-- /.body -->

    <div class="overlay" id="overlay">
        <div class="overlay-box">
            <div class="spin"></div>
            <div class="overlay-txt" id="overlayTxt">Submitting…</div>
        </div>
    </div>
    <div class="toasts" id="toasts"></div>

    <script>
        var MAPPING_ID  = @m.MappingId;
        var FILLER_ROLE = '@role';
        var SUBMIT_URL  = '@Url.Action("SubmitAppraisalFill", "Pms")';
        var TOTAL_ROWS  = @m.KpiRows.Count;
        var IS_MC_JMD   = (FILLER_ROLE === 'ModCommittee' || FILLER_ROLE === 'JMD');

        /* ── JUSTIFICATION CHARACTER COUNTER ── */
        function onJustificationInput(ta) {
            var rowId = ta.dataset.id;
            var len   = ta.value.length;
            var cntEl = document.getElementById('justcountval-' + rowId);
            var boxEl = document.getElementById('justcount-'    + rowId);
            if (cntEl) cntEl.textContent = len;
            if (boxEl) {
                boxEl.className = 'just-char-count' + (len > 450 && len < 500 ? ' warn' : len >= 500 ? ' over' : '');
            }
            /* clear warning once filled */
            var warnEl = document.getElementById('justwarn-' + rowId);
            if (warnEl && ta.value.trim().length > 0) {
                warnEl.style.display = 'none';
                ta.classList.remove('inp-error');
            }
            onAnyInput();
        }

        /* ── CLAMP OVERALL RATING ── */
        function clampOverallRating(inp) {
            var v = parseFloat(inp.value);
            if (!isNaN(v) && v > 5) inp.value = 5;
            if (!isNaN(v) && v < 0) inp.value = '';
            inp.classList.remove('inp-error');
        }

        /* ── STAR RATING ── */
        function setRating(btn) {
            var grp   = btn.closest('.stars');
            var val   = +btn.dataset.val;
            var field = grp.dataset.field;
            grp.querySelectorAll('.star').forEach(function (b) {
                b.classList.toggle('on', +b.dataset.val <= val);
            });
            var classMap = { empRating:'emp-rating', rmRating:'rm-rating', hodRating:'hod-rating', uhRating:'uh-rating' };
            var tr = grp.closest('tr');
            var hidden = tr && tr.querySelector('.' + (classMap[field] || 'emp-rating'));
            if (hidden) { hidden.value = val; onAnyInput(); }
        }

        /* ── FIELD ACCESSORS ── */
        function getFields(tr) {
            function q(cls)  { return tr.querySelector('.' + cls); }
            function fv(cls) { var e = q(cls); return e ? e.value.trim() : ''; }
            var roleMap = {
                Employee: { actual:'emp-actual', rating:'emp-rating', remarks:null, justification:'emp-justification' },
                RM:       { actual:'rm-actual',  rating:'rm-rating',  remarks:'rm-remarks',  justification:null },
                HOD:      { actual:'hod-actual', rating:'hod-rating', remarks:'hod-remarks', justification:null },
                UnitHead: { actual:'uh-actual',  rating:'uh-rating',  remarks:'uh-remarks',  justification:null }
            };
            var map = roleMap[FILLER_ROLE];
            if (!map) return null;
            return {
                actualEl:         map.actual        ? q(map.actual)        : null,
                ratingEl:         map.rating        ? q(map.rating)        : null,
                remarksEl:        map.remarks       ? q(map.remarks)       : null,
                justificationEl:  map.justification ? q(map.justification) : null,
                actualVal:        fv(map.actual),
                ratingVal:        fv(map.rating),
                remarksVal:       map.remarks       ? fv(map.remarks)       : '',
                justificationVal: map.justification ? fv(map.justification) : ''
            };
        }

        /* ── COLLECT PER-KPI ROWS ── */
        function collectRows() {
            var rows = [];
            document.querySelectorAll('#kpiBody tr[data-row-id]').forEach(function (tr) {
                var rowId = +tr.dataset.rowId;
                if (!rowId) return;
                var f = getFields(tr);
                if (!f) return;
                rows.push({
                    empKpiRowId:   rowId,
                    actual:        f.actualVal !== '' ? parseFloat(f.actualVal) : null,
                    rating:        f.ratingVal ? +f.ratingVal : 0,
                    remarks:       f.remarksVal,
                    justification: f.justificationVal
                });
            });
            return rows;
        }

        /* ── COLLECT MC/JMD ROW REMARKS ── */
        function collectRowRemarks(cls) {
            var remarks = [];
            document.querySelectorAll('#kpiBody tr[data-row-id]').forEach(function (tr) {
                var rowId = +tr.dataset.rowId;
                if (!rowId) return;
                var inp = tr.querySelector('.' + cls);
                remarks.push({ empKpiRowId: rowId, remarks: inp ? inp.value.trim() : '' });
            });
            return remarks;
        }

        /* ── VALIDATE ALL ROWS ── */
        function validateAll() {
            var errors = [];
            document.querySelectorAll('#kpiBody tr[data-row-id]').forEach(function (tr, idx) {
                var rowId = +tr.dataset.rowId;
                if (!rowId) return;
                var f = getFields(tr);
                if (!f) return;

                var rowErrors = [];
        if (f.actualVal === '') {
                            rowErrors.push('Actual missing');
                        } else {
                            var actualNum = parseFloat(f.actualVal);
                            if (!isNaN(actualNum) && actualNum > 100) {
                                rowErrors.push('Actual cannot exceed 100%');
                                if (f.actualEl) f.actualEl.classList.add('inp-error');
                            }
                        }

                        if (!f.ratingVal || f.ratingVal === '0')        rowErrors.push('Rating missing');
                        else if (+f.ratingVal < 1 || +f.ratingVal > 5) rowErrors.push('Rating must be 1–5');

                        /* Justification required for Employee role */
                        if (FILLER_ROLE === 'Employee' && f.justificationVal.trim().length === 0) {
                            rowErrors.push('Justification required');
                            var justEl   = document.getElementById('just-'     + rowId);
                            var warnEl   = document.getElementById('justwarn-' + rowId);
                            if (justEl)  justEl.classList.add('inp-error');
                            if (warnEl)  warnEl.style.display = 'block';
                        }

                if (rowErrors.length) {
                    errors.push({ tr, rowId, srNo: idx + 1, messages: rowErrors,
                                  actualEl: f.actualEl, ratingEl: f.ratingEl });
                }
            });
            return errors;
        }

        /* ── VALIDATE MC/JMD OVERALL RATING ── */
        function validateOverallRating() {
            var inputId = FILLER_ROLE === 'ModCommittee' ? 'mcOverallRatingInput' : 'jmdOverallRatingInput';
            var inp = document.getElementById(inputId);
            if (!inp) return true;
            var v = parseFloat(inp.value);
            if (isNaN(v) || v <= 0 || v > 5) { inp.classList.add('inp-error'); inp.focus(); return false; }
            inp.classList.remove('inp-error');
            return true;
        }

        /* ── COUNT COMPLETE ROWS ── */
        function countComplete() {
            var complete = 0;
            document.querySelectorAll('#kpiBody tr[data-row-id]').forEach(function (tr) {
                if (!+tr.dataset.rowId) return;
                var f = getFields(tr);
                if (!f) return;
                var hasActual  = f.actualVal !== '';
                var hasRating  = f.ratingVal && f.ratingVal !== '0' && +f.ratingVal >= 1 && +f.ratingVal <= 5;
                var hasJust    = FILLER_ROLE !== 'Employee' || f.justificationVal.trim().length > 0;
                if (hasActual && hasRating && hasJust) complete++;
            });
            return complete;
        }

        /* ── HIGHLIGHT / CLEAR ── */
        function applyHighlights(errors) {
            document.querySelectorAll('#kpiBody tr[data-row-id]').forEach(function (tr) {
                tr.classList.remove('row-incomplete');
                tr.querySelectorAll('.inp-error').forEach(function (el) { el.classList.remove('inp-error'); });
            });
            errors.forEach(function (e) {
                e.tr.classList.add('row-incomplete');
                if (e.actualEl && e.messages.indexOf('Actual missing') >= 0) e.actualEl.classList.add('inp-error');
                if (e.ratingEl && e.messages.some(function(m){ return m.indexOf('Rating') >= 0; })) e.ratingEl.classList.add('inp-error');
            });
        }

        function clearHighlights() {
            document.querySelectorAll('#kpiBody tr[data-row-id]').forEach(function (tr) {
                tr.classList.remove('row-incomplete');
                tr.querySelectorAll('.inp-error').forEach(function (el) { el.classList.remove('inp-error'); });
                var rowId = +tr.dataset.rowId;
                if (rowId) {
                    var zoneEl = document.getElementById('doczone-'  + rowId);
                    var warnEl = document.getElementById('docwarn-'  + rowId);
                    var justEl = document.getElementById('just-'     + rowId);
                    var jwEl   = document.getElementById('justwarn-' + rowId);
                    if (zoneEl) zoneEl.classList.remove('doc-required-err');
                    if (warnEl) warnEl.style.display = 'none';
                    if (justEl) justEl.classList.remove('inp-error');
                    if (jwEl)   jwEl.style.display   = 'none';
                }
            });
        }

        /* ── PROGRESS BAR ── */
        function updateProgress() {
            if (IS_MC_JMD) return;
            var complete = countComplete();
            var pct      = TOTAL_ROWS > 0 ? Math.round(complete / TOTAL_ROWS * 100) : 0;
            var counter  = document.getElementById('progressCounter');
            var fill     = document.getElementById('progressFill');
            var valMsg   = document.getElementById('valMsg');
            var okMsg    = document.getElementById('okMsg');
            if (counter) counter.textContent = complete + ' / ' + TOTAL_ROWS + ' filled';
            if (fill) {
                fill.style.width      = pct + '%';
                fill.style.background = pct === 100 ? '#22c55e' : pct >= 60 ? '#f59e0b' : '#f43f5e';
            }
            if (complete === TOTAL_ROWS) {
                if (valMsg) valMsg.style.display = 'none';
                if (okMsg)  okMsg.style.display  = 'inline';
                clearHighlights();
            } else {
                if (okMsg) okMsg.style.display = 'none';
            }
        }

        /* ── LIVE ACTUAL vs TARGET VALIDATION ── */
        /* ── LIVE ACTUAL VALIDATION (capped at 100%) ── */
               function validateActualInput(inp) {
                   var val = parseFloat(inp.value);
                   if (!isNaN(val) && val > 100) {
                       inp.classList.add('inp-error');
                       inp.title = 'Actual cannot exceed 100%';
                       clearTimeout(inp._clampTimer);
                       inp._clampTimer = setTimeout(function () {
                           inp.value = 100;
                           inp.classList.remove('inp-error');
                           inp.title = '';
                           onAnyInput();
                       }, 1200);
                   } else {
                       inp.classList.remove('inp-error');
                       inp.title = '';
                   }
               }
        function onAnyInput() { updateProgress(); }

        document.addEventListener('DOMContentLoaded', function () {
            if (!IS_MC_JMD) {
                document.querySelectorAll('#kpiBody .num-inp, #kpiBody .rem-inp').forEach(function (inp) {
                    inp.addEventListener('input', function () {
                        var cls = inp.className;
                        if (cls.indexOf('emp-actual') >= 0 || cls.indexOf('rm-actual') >= 0 ||
                            cls.indexOf('hod-actual') >= 0 || cls.indexOf('uh-actual') >= 0) {
                            validateActualInput(inp);
                        }
                        onAnyInput();
                    });
                });
                /* Justification textareas trigger progress too */
                document.querySelectorAll('#kpiBody .justification-inp').forEach(function (ta) {
                    ta.addEventListener('input', function () { onAnyInput(); });
                });
                updateProgress();
            }
        });

        /* ── SUBMIT ── */
        function doSubmit() {
            var valMsg     = document.getElementById('valMsg');
            var valMsgText = document.getElementById('valMsgText');
            var okMsg      = document.getElementById('okMsg');

            if (IS_MC_JMD) {
                if (!validateOverallRating()) {
                    var labelRole = FILLER_ROLE === 'ModCommittee' ? 'MC' : 'JMD';
                    if (valMsgText) valMsgText.textContent = 'Please enter a valid ' + labelRole + ' Overall Rating (0.01 – 5.00) before submitting.';
                    if (valMsg) valMsg.style.display = 'inline';
                    if (okMsg)  okMsg.style.display  = 'none';
                    toast('Please provide a valid overall rating (0.01 – 5.00).', 'err');
                    return;
                }
                if (valMsg) valMsg.style.display = 'none';
                if (okMsg)  okMsg.style.display  = 'inline';
            } else {
                var errors = validateAll();
                if (errors.length > 0) {
                    applyHighlights(errors);
                    if (valMsgText) valMsgText.textContent =
                        errors.length + ' of ' + TOTAL_ROWS + ' KPI(s) incomplete — ' +
                        errors.map(function (e) { return 'KPI ' + e.srNo; }).join(', ') +
                        '. Please fill Actual, Rating and Justification for each.';
                    if (valMsg) valMsg.style.display = 'inline';
                    if (okMsg)  okMsg.style.display  = 'none';
                    errors[0].tr.scrollIntoView({ behavior:'smooth', block:'center' });
                    toast(errors.length + ' KPI(s) still need Actual, Rating and/or Justification.', 'err');
                    return;
                }
            }

            var confirmMessages = {
                Employee:     'Submit your self-appraisal? This will send it to your Reporting Manager for review.',
                RM:           'Submit your RM review? This will forward the appraisal to the Head of Department.',
                HOD:          'Submit your HOD review? This will forward the appraisal to the Unit Head.',
                UnitHead:     'Submit your Unit Head review? This will forward the appraisal to the Moderation Committee.',
                ModCommittee: 'Submit the Moderation Committee overall rating? This will forward the appraisal to the JMD.',
                JMD:          'Submit your JMD overall rating? This will send the appraisal to HR for final processing.'
            };
            if (!confirm(confirmMessages[FILLER_ROLE] || 'Submit and advance the workflow?')) return;

            clearHighlights();

            var spinLabels = {
                Employee:     'Submitting self appraisal…',
                RM:           'Submitting RM review…',
                HOD:          'Submitting HOD review…',
                UnitHead:     'Submitting Unit Head review…',
                ModCommittee: 'Submitting Moderation Committee review…',
                JMD:          'Submitting JMD review…'
            };
            document.getElementById('overlayTxt').textContent = spinLabels[FILLER_ROLE] || 'Submitting…';
            document.getElementById('overlay').classList.add('on');

            var btn = document.getElementById('btnSubmit');
            if (btn) btn.disabled = true;

            var payload;

            if (FILLER_ROLE === 'ModCommittee') {
                var mcInp = document.getElementById('mcOverallRatingInput');
                var mcRem = document.getElementById('mcOverallRemarksInput');
                var mcRowRemarks = collectRowRemarks('mc-row-remarks');
                payload = {
                    mappingId:        MAPPING_ID,
                    fillerRole:       FILLER_ROLE,
                    rows:             mcRowRemarks.map(function(r){ return { empKpiRowId:r.empKpiRowId, actual:null, rating:0, remarks:r.remarks }; }),
                    mcOverallRating:  mcInp ? parseFloat(mcInp.value) : null,
                    mcOverallRemarks: mcRem ? mcRem.value.trim() : ''
                };
            } else if (FILLER_ROLE === 'JMD') {
                var jmdInp = document.getElementById('jmdOverallRatingInput');
                var jmdRem = document.getElementById('jmdOverallRemarksInput');
                var jmdRowRemarks = collectRowRemarks('jmd-row-remarks');
                payload = {
                    mappingId:         MAPPING_ID,
                    fillerRole:        FILLER_ROLE,
                    rows:              jmdRowRemarks.map(function(r){ return { empKpiRowId:r.empKpiRowId, actual:null, rating:0, remarks:r.remarks }; }),
                    jmdOverallRating:  jmdInp ? parseFloat(jmdInp.value) : null,
                    jmdOverallRemarks: jmdRem ? jmdRem.value.trim() : ''
                };
            } else {
                var rows = collectRows();
                if (!rows.length) {
                    document.getElementById('overlay').classList.remove('on');
                    if (btn) btn.disabled = false;
                    toast('No KPI rows found.', 'err');
                    return;
                }
                payload = { mappingId: MAPPING_ID, fillerRole: FILLER_ROLE, rows: rows };
            }

            fetch(SUBMIT_URL, {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify(payload)
            })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                document.getElementById('overlay').classList.remove('on');
                if (btn) btn.disabled = false;
                if (res.success) {
                    toast(res.message || 'Submitted successfully.', 'ok');
                    setTimeout(function () { window.location.href = res.redirectUrl || '/Pms/Index'; }, 2400);
                } else {
                    toast(res.message || 'Submission failed. Please try again.', 'err');
                }
            })
            .catch(function (err) {
                document.getElementById('overlay').classList.remove('on');
                if (btn) btn.disabled = false;
                toast('Network error: ' + err.message, 'err');
            });
        }

        /* ── TOAST ── */
        function toast(msg, type) {
            var wrap = document.getElementById('toasts');
            var el   = document.createElement('div');
            el.className = 'toast ' + (type || 'ok');
            el.innerHTML = (type === 'err' ? '✖ ' : '✔ ') + esc(msg);
            wrap.appendChild(el);
            setTimeout(function () {
                el.style.transition = 'opacity .35s';
                el.style.opacity    = '0';
                setTimeout(function () { el.remove(); }, 380);
            }, 4500);
        }

        function esc(s) {
            return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        }

        /* ══ DOCUMENT UPLOAD ══ */
        var UPLOAD_KPI_DOC_URL = '@Url.Action("UploadKpiDoc", "Pms")';
        var DELETE_KPI_DOC_URL = '@Url.Action("DeleteKpiDoc", "Pms")';
        var ALLOWED_EXTS       = ['jpg','jpeg','pdf','doc','docx'];
        var MAX_FILE_BYTES     = 10 * 1024 * 1024;

        var ROLE_BADGE = {
            Employee:     { label:'EMP', color:'#92400e', bg:'#fef9ee' },
            RM:           { label:'RM',  color:'#1e40af', bg:'#eff6ff' },
            HOD:          { label:'HOD', color:'#5b21b6', bg:'#f5f3ff' },
            UnitHead:     { label:'UH',  color:'#0f766e', bg:'#f0fdfa' },
            ModCommittee: { label:'MC',  color:'#c2410c', bg:'#fff7ed' },
            JMD:          { label:'JMD', color:'#9d174d', bg:'#fdf2f8' },
            HR:           { label:'HR',  color:'#047857', bg:'#ecfdf5' }
        };

        function fileIcon(name) {
            var ext = (name || '').split('.').pop().toLowerCase();
            return ext === 'pdf' ? '📄' : (ext === 'jpg' || ext === 'jpeg') ? '🖼' : '📝';
        }

        function handleDocUpload(evt, rowId) {
            var files = Array.from(evt.target.files || []);
            evt.target.value = '';
            if (!files.length) return;
            var invalid = files.filter(function(f){ var ext=f.name.split('.').pop().toLowerCase(); return ALLOWED_EXTS.indexOf(ext)<0; });
            if (invalid.length) { toast('Only JPEG, PDF, DOC/DOCX files allowed.', 'err'); return; }
            var tooBig = files.filter(function(f){ return f.size > MAX_FILE_BYTES; });
            if (tooBig.length) { toast('File must be under 10 MB.', 'err'); return; }
            files.forEach(function(file){ uploadOneDoc(file, rowId); });
        }

        function uploadOneDoc(file, rowId) {
            var pillsEl = document.getElementById('docpills-' + rowId);
            var warnEl  = document.getElementById('docwarn-'  + rowId);
            var zoneEl  = document.getElementById('doczone-'  + rowId);

            var spinnerId = 'spin-' + rowId + '-' + Date.now();
            var spinPill  = document.createElement('div');
            spinPill.id   = spinnerId;
            spinPill.className = 'doc-uploading';
            spinPill.innerHTML = '<div class="doc-spin"></div> Uploading ' + esc(file.name) + '…';
            pillsEl.appendChild(spinPill);

            var fd = new FormData();
            fd.append('file',         file);
            fd.append('empKpiRowId',  rowId);
            fd.append('mappingId',    MAPPING_ID);
            fd.append('uploaderRole', FILLER_ROLE);

            fetch(UPLOAD_KPI_DOC_URL, { method:'POST', body:fd })
                .then(function(r){ return r.json(); })
                .then(function(res){
                    var sp = document.getElementById(spinnerId);
                    if (sp) sp.remove();
                    if (!res.success) { toast(res.message || 'Upload failed.', 'err'); return; }
                    var badge = ROLE_BADGE[FILLER_ROLE] || ROLE_BADGE.HR;
                    var pill  = document.createElement('div');
                    pill.className = 'doc-pill';
                    pill.id        = 'docpill-' + res.docId;
                    pill.innerHTML =
                        '<span class="doc-pill-icon">' + fileIcon(res.fileName) + '</span>' +
                        '<span class="doc-pill-name" title="' + esc(res.fileName) + '">' + esc(res.fileName) + '</span>' +
                        '<span class="doc-pill-role" style="color:' + badge.color + ';background:' + badge.bg + '">' + badge.label + '</span>' +
                        '<a href="/Pms/DownloadKpiDoc?id=' + res.docId + '" target="_blank" class="doc-pill-view">View</a>' +
                        '<button type="button" class="doc-pill-del" onclick="deleteKpiDoc(' + res.docId + ',' + rowId + ')" title="Remove">✕</button>';
                    pillsEl.appendChild(pill);
                    if (zoneEl) zoneEl.classList.remove('doc-required-err');
                    if (warnEl) warnEl.style.display = 'none';
                    toast('Document attached.', 'ok');
                    onAnyInput();
                })
                .catch(function(e){
                    var sp = document.getElementById(spinnerId);
                    if (sp) sp.remove();
                    toast('Upload error: ' + e.message, 'err');
                });
        }

        function deleteKpiDoc(docId, rowId) {
            if (!confirm('Remove this attachment?')) return;
            fetch(DELETE_KPI_DOC_URL + '?id=' + docId, { method:'POST' })
                .then(function(r){ return r.json(); })
                .then(function(res){
                    if (res.success) {
                        var pill = document.getElementById('docpill-' + docId);
                        if (pill) pill.remove();
                        toast('Attachment removed.', 'ok');
                        onAnyInput();
                    } else { toast(res.message || 'Delete failed.', 'err'); }
                }).catch(function(e){ toast('Error: ' + e.message, 'err'); });
        }

        function countDocsForRow(rowId) {
            return document.querySelectorAll('#docpills-' + rowId + ' .doc-pill').length;
        }

        let justificationTimers = {};

        function onJustificationInput(el) {
            const id = el.dataset.id;
            const val = el.value;

            document.getElementById('justcountval-' + id).textContent = val.length;

            const warn = document.getElementById('justwarn-' + id);
            if (warn) warn.style.display = val.trim().length === 0 ? 'block' : 'none';

            clearTimeout(justificationTimers[id]);
            justificationTimers[id] = setTimeout(() => {
                saveJustification(id, val);
            }, 800);
        }

        function saveJustification(id, val) {
            fetch('/PMS/SaveJustification', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `empKpiRowId=${encodeURIComponent(id)}&justification=${encodeURIComponent(val)}`
            })
            .then(res => res.json())
            .then(data => {
                if (!data.success) console.error('Save failed:', data.message);
            })
            .catch(err => console.error('Save error:', err));
        }
    </script>
</body>
</html>
