@model vgl.Models.AppraisalFillVM
@using vgl.Models
@{
    Layout = null;
    var m = Model.Mapping;
    var role = Model.Role;
    var canEdit = Model.CanEdit;

    bool showEmp = true;
    bool showRm = role is "RM" or "HOD" or "UnitHead" or "HR";
    bool showHod = role is "HOD" or "UnitHead" or "HR";
    bool showUh = role is "UnitHead" or "HR";
    if (role == "Employee") { showRm = false; showHod = false; showUh = false; }

    string roleColor = role switch
    {
        "Employee" => "#b45309",
        "RM" => "#1d4ed8",
        "HOD" => "#6d28d9",
        "UnitHead" => "#0f766e",
        "ModCommittee" => "#c2410c",
        "JMD" => "#9d174d",
        _ => "#047857"
    };
    string roleBg = role switch
    {
        "Employee" => "#fef9ee",
        "RM" => "#eff6ff",
        "HOD" => "#f5f3ff",
        "UnitHead" => "#f0fdfa",
        "ModCommittee" => "#fff7ed",
        "JMD" => "#fdf2f8",
        _ => "#ecfdf5"
    };
    string roleName = role switch
    {
        "Employee" => "Self Appraisal",
        "RM" => "Reporting Manager Review",
        "HOD" => "HOD Review",
        "UnitHead" => "Unit Head Review",
        "ModCommittee" => "Moderation Committee Review",
        "JMD" => "JMD Review",
        _ => "HR View"
    };
    string roleIcon = role switch
    {
        "Employee" => "✏️",
        "RM" => "👔",
        "HOD" => "🏛",
        "UnitHead" => "🏢",
        "ModCommittee" => "⚖️",
        "JMD" => "👑",
        _ => "👁"
    };

    var pmpSpan = new Dictionary<string, int>();
    var kraSpan = new Dictionary<string, int>();
    foreach (var r in m.KpiRows)
    {
        var pk = r.PmpName;
        var kk = pk + "||" + r.KraName;
        pmpSpan[pk] = (pmpSpan.ContainsKey(pk) ? pmpSpan[pk] : 0) + 1;
        kraSpan[kk] = (kraSpan.ContainsKey(kk) ? kraSpan[kk] : 0) + 1;
    }
    var seenPmp = new HashSet<string>();
    var seenKra = new HashSet<string>();

    // Fixed cols: #, PMP, KRA, KPI, Unit, Wt%, Target, Justification = 8
    int fixedCols = 8;
    int dynCols = 0;
    if (showEmp) dynCols += 2;
    if (showRm) dynCols += 3;
    if (showHod) dynCols += 3;
    if (showUh) dynCols += 3;

    var totalWR = m.KpiRows.Where(r => r.WeightedRating.HasValue).Sum(r => (decimal)r.WeightedRating!.Value);

    decimal? mcOverallRating = ViewBag.McOverallRating as decimal?;
    decimal? jmdOverallRating = ViewBag.JmdOverallRating as decimal?;

    decimal? ComputeAvgRmHodUh(EmpKpiRow r)
    {
        var vals = new List<decimal>();
        if (r.RmRating.HasValue) vals.Add(r.RmRating.Value);
        if (r.HodRating.HasValue) vals.Add(r.HodRating.Value);
        if (r.UnitHeadRating.HasValue) vals.Add(r.UnitHeadRating.Value);
        return vals.Any() ? Math.Round(vals.Average(), 2) : (decimal?)null;
    }

    string submitLabel = role switch
    {
        "Employee" => "Submit Self Appraisal",
        "RM" => "Submit RM Review",
        "HOD" => "Submit HOD Review",
        "UnitHead" => "Submit Unit Head Review",
        "ModCommittee" => "Submit Moderation Committee Review",
        _ => "Submit JMD Review"
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@roleName — @m.EmpName</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0
        }

        :root {
            --c-navy: #0b1731;
            --c-navy2: #152447;
            --c-navy3: #1e3460;
            --c-slate: #64748b;
            --c-muted: #94a3b8;
            --c-border: #e2e8f0;
            --c-bg: #f8fafc;
            --c-bg2: #f1f5f9;
            --c-white: #ffffff;
            --c-ink: #0f172a;
            --c-ink2: #1e293b;
            --c-ink3: #475569;
            --rc: @roleColor;
            --rb: @roleBg;
            --emp-bg: #fffbeb;
            --emp-bd: #fcd34d;
            --emp-tx: #92400e;
            --rm-bg: #eff6ff;
            --rm-bd: #93c5fd;
            --rm-tx: #1e40af;
            --hod-bg: #f5f3ff;
            --hod-bd: #c4b5fd;
            --hod-tx: #5b21b6;
            --uh-bg: #f0fdfa;
            --uh-bd: #5eead4;
            --uh-tx: #0f766e;
            --mc-bg: #fff7ed;
            --mc-bd: #fdba74;
            --mc-tx: #c2410c;
            --jmd-bg: #fdf2f8;
            --jmd-bd: #f9a8d4;
            --jmd-tx: #9d174d;
            --avg-bg: #f0f9ff;
            --avg-bd: #7dd3fc;
            --avg-tx: #0369a1;
            --just-bg: #f0fdf4;
            --just-bd: #86efac;
            --just-tx: #166534;
            --font: 'Plus Jakarta Sans',system-ui,sans-serif;
            --mono: 'IBM Plex Mono',monospace;
            --rad: 12px;
            --rad-lg: 20px;
            --sh: 0 1px 3px rgba(0,0,0,.08),0 4px 16px rgba(0,0,0,.06);
            --tr: .15s ease;
        }

        html, body {
            font-family: var(--font);
            background: var(--c-bg);
            color: var(--c-ink);
            font-size: 13px;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
            min-height: 100vh
        }

        .nav {
            height: 60px;
            background: var(--c-navy);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 28px;
            gap: 16px
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 12px
        }

        .nav-logo {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg,#3b82f6,#6366f1);
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
            font-weight: 800;
            color: #fff;
            font-family: var(--mono);
            flex-shrink: 0;
            box-shadow: 0 4px 12px rgba(99,102,241,.4)
        }

        .nav-title strong {
            display: block;
            font-size: .84rem;
            font-weight: 700;
            color: #fff;
            letter-spacing: .02em
        }

        .nav-title span {
            font-size: .6rem;
            color: rgba(255,255,255,.35);
            text-transform: uppercase;
            letter-spacing: .12em;
            font-family: var(--mono)
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 10px
        }

        .role-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 14px;
            border-radius: 20px;
            font-size: .72rem;
            font-weight: 700;
            font-family: var(--mono);
            letter-spacing: .04em;
            background: var(--rb);
            color: var(--rc);
            border: 1.5px solid var(--rc)
        }

        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            height: 32px;
            padding: 0 14px;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,.15);
            background: rgba(255,255,255,.08);
            color: rgba(255,255,255,.75);
            font-size: .74rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: var(--tr)
        }

            .btn-back:hover {
                background: rgba(255,255,255,.15);
                color: #fff
            }

        .hero {
            background: linear-gradient(120deg,var(--c-navy) 0%,var(--c-navy3) 100%);
            padding: 26px 32px 22px;
            position: relative;
            overflow: hidden
        }

            .hero::after {
                content: '';
                position: absolute;
                right: -80px;
                top: -80px;
                width: 320px;
                height: 320px;
                border-radius: 50%;
                background: rgba(255,255,255,.03);
                pointer-events: none
            }

        .hero-name {
            font-size: 1.55rem;
            font-weight: 800;
            color: #fff;
            letter-spacing: -.01em;
            line-height: 1.2
        }

        .hero-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 6px 18px;
            margin-top: 10px
        }

        .hero-tag {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: .69rem;
            color: rgba(255,255,255,.5);
            font-family: var(--mono)
        }

            .hero-tag strong {
                color: rgba(255,255,255,.82);
                font-weight: 600
            }

        .hero-badge {
            background: rgba(255,255,255,.12);
            border: 1px solid rgba(255,255,255,.2);
            border-radius: 30px;
            padding: 2px 12px;
            font-size: .66rem;
            font-weight: 700;
            color: rgba(255,255,255,.9);
            font-family: var(--mono)
        }

        .body {
            max-width: 1480px;
            margin: 0 auto;
            padding: 24px 28px 80px
        }

        .alert {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 14px 18px;
            border-radius: var(--rad);
            margin-bottom: 16px;
            font-size: .82rem;
            line-height: 1.6
        }

        .alert-icon {
            font-size: 1.25rem;
            flex-shrink: 0;
            margin-top: 1px
        }

        .alert-role {
            background: var(--rb);
            border: 1.5px solid var(--rc)
        }

            .alert-role .alert-text strong {
                color: var(--rc)
            }

        .alert-ro {
            background: #fefce8;
            border: 1.5px solid #fde047;
            border-left: 4px solid #eab308;
            color: #713f12;
            font-weight: 600
        }

        .card {
            background: var(--c-white);
            border: 1px solid var(--c-border);
            border-radius: var(--rad-lg);
            box-shadow: var(--sh);
            margin-bottom: 20px
        }

        .card-hd {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 20px;
            background: linear-gradient(135deg,var(--c-navy) 0%,var(--c-navy3) 100%);
            border-radius: var(--rad-lg) var(--rad-lg) 0 0
        }

        .card-hd-title {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: .72rem;
            font-weight: 700;
            color: rgba(255,255,255,.9);
            font-family: var(--mono);
            text-transform: uppercase;
            letter-spacing: .08em
        }

        .card-hd-badge {
            font-size: .62rem;
            font-weight: 600;
            background: rgba(255,255,255,.12);
            color: rgba(255,255,255,.65);
            padding: 3px 12px;
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,.15);
            font-family: var(--mono)
        }

        .tbl-wrap {
            overflow-x: auto;
            overflow-y: auto;
            max-height: 62vh;
            border-radius: 0 0 var(--rad-lg) var(--rad-lg)
        }

        table.ap {
            width: 100%;
            border-collapse: collapse;
            font-size: .78rem;
            table-layout: auto
        }

            table.ap thead th {
                padding: 9px 12px;
                border: 1px solid var(--c-border);
                font-weight: 700;
                letter-spacing: .07em;
                text-transform: uppercase;
                white-space: nowrap;
                text-align: center
            }

            table.ap thead tr:first-child th {
                background: var(--c-bg2);
                color: var(--c-slate);
                font-size: .57rem
            }

            table.ap thead tr:last-child th {
                font-size: .58rem;
                color: var(--c-slate)
            }

            table.ap thead th[rowspan] {
                background: var(--c-bg2);
                color: var(--c-slate);
                font-size: .57rem;
                vertical-align: middle
            }

                table.ap thead th[rowspan].tl {
                    text-align: left
                }

        .cg-emp {
            background: var(--emp-bg) !important;
            color: var(--emp-tx) !important;
            border-bottom: 2px solid var(--emp-bd) !important
        }

        .cg-rm {
            background: var(--rm-bg) !important;
            color: var(--rm-tx) !important;
            border-bottom: 2px solid var(--rm-bd) !important
        }

        .cg-hod {
            background: var(--hod-bg) !important;
            color: var(--hod-tx) !important;
            border-bottom: 2px solid var(--hod-bd) !important
        }

        .cg-uh {
            background: var(--uh-bg) !important;
            color: var(--uh-tx) !important;
            border-bottom: 2px solid var(--uh-bd) !important
        }

        .sl-emp {
            background: var(--emp-bg) !important;
            color: var(--emp-tx) !important
        }

        .sl-rm {
            background: var(--rm-bg) !important;
            color: var(--rm-tx) !important
        }

        .sl-hod {
            background: var(--hod-bg) !important;
            color: var(--hod-tx) !important
        }

        .sl-uh {
            background: var(--uh-bg) !important;
            color: var(--uh-tx) !important
        }

        .cg-you {
            outline: 2.5px solid var(--rc);
            outline-offset: -2px
        }

        table.ap tbody tr:hover td {
            background: #f8fafc
        }

        table.ap tbody td {
            padding: 10px 12px;
            border: 1px solid #e8edf5;
            vertical-align: middle
        }

            table.ap tbody td.tc {
                text-align: center
            }

            table.ap tbody td.tr {
                text-align: right;
                font-family: var(--mono)
            }

        .pmp-cell {
            background: linear-gradient(160deg,var(--c-navy) 0%,var(--c-navy3) 100%) !important;
            color: #fff !important;
            font-weight: 700;
            font-size: .69rem;
            text-align: center !important;
            text-transform: uppercase;
            letter-spacing: .06em;
            padding: 12px 10px !important;
            vertical-align: middle !important
        }

        .kra-cell {
            background: var(--c-bg2) !important;
            font-weight: 600;
            font-size: .73rem;
            color: var(--c-ink2);
            border-left: 3px solid #93c5fd !important;
            vertical-align: middle !important
        }

        .kpi-wrap {
            display: flex;
            align-items: center;
            gap: 8px
        }

        .kpi-sr {
            flex-shrink: 0;
            width: 22px;
            height: 22px;
            border-radius: 6px;
            background: var(--c-navy);
            color: #fff;
            font-size: .58rem;
            font-weight: 700;
            font-family: var(--mono);
            display: inline-flex;
            align-items: center;
            justify-content: center
        }

        .kpi-name {
            font-weight: 600;
            font-size: .79rem;
            color: var(--c-ink)
        }

        .bg-emp {
            background: var(--emp-bg)
        }

        .bg-rm {
            background: var(--rm-bg)
        }

        .bg-hod {
            background: var(--hod-bg)
        }

        .bg-uh {
            background: var(--uh-bg)
        }

        .bg-mc {
            background: var(--mc-bg)
        }

        .bg-jmd {
            background: var(--jmd-bg)
        }

        .bg-avg {
            background: var(--avg-bg)
        }

        .bg-active-emp {
            background: #fef3c7
        }

        .bg-active-rm {
            background: #dbeafe
        }

        .bg-active-hod {
            background: #ede9fe
        }

        .bg-active-uh {
            background: #ccfbf1
        }

        /* ── JUSTIFICATION COLUMN ── */
        .cg-just {
            background: var(--just-bg) !important;
            color: var(--just-tx) !important;
            border-bottom: 2px solid var(--just-bd) !important
        }

        .bg-just {
            background: var(--just-bg)
        }

        .justification-inp {
            width: 100%;
            min-width: 200px;
            min-height: 72px;
            max-height: 140px;
            border: 1.5px solid var(--just-bd);
            border-radius: 8px;
            background: #fff;
            font-family: var(--font);
            font-size: .75rem;
            color: var(--c-ink);
            padding: 8px 10px;
            resize: vertical;
            outline: none;
            line-height: 1.5;
            transition: var(--tr);
        }

            .justification-inp:focus {
                border-color: var(--just-tx);
                box-shadow: 0 0 0 3px rgba(22,101,52,.12);
            }

            .justification-inp.inp-error {
                border-color: #f43f5e !important;
                box-shadow: 0 0 0 3px rgba(244,63,94,.18) !important;
                background: #fff1f2 !important;
            }

            .justification-inp::placeholder {
                color: var(--c-muted);
                font-style: italic
            }

        .just-display {
            font-size: .74rem;
            color: var(--c-ink3);
            line-height: 1.6;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .just-missing-warn {
            font-size: .68rem;
            color: #dc2626;
            font-weight: 600;
            margin-top: 4px;
            display: none;
        }

        .just-char-count {
            font-size: .62rem;
            color: var(--c-muted);
            text-align: right;
            margin-top: 2px;
            font-family: var(--mono);
        }

            .just-char-count.warn {
                color: #f59e0b;
                font-weight: 600
            }

            .just-char-count.over {
                color: #f43f5e;
                font-weight: 700
            }

        .overall-rating-card {
            background: #fff;
            border: 1.5px solid var(--c-border);
            border-radius: 14px;
            padding: 20px 26px;
            margin-bottom: 20px;
            box-shadow: var(--sh)
        }

        .orc-title {
            font-size: .80rem;
            font-weight: 700;
            color: var(--c-navy);
            margin-bottom: 14px;
            display: flex;
