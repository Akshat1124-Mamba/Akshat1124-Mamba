                                    <td class="pmp-cell" rowspan="@pmpSpan[pk]">@row.PmpName</td>
                                }
                                @if (nk)
                                {
                                    <td class="kra-cell" rowspan="@kraSpan[kk]">@row.KraName</td>
                                }

