        }

        .orc-input-wrap {
            display: flex;
            align-items: center;
            gap: 12px
        }

        .orc-input {
            width: 100px;
            height: 42px;
            border: 2px solid var(--rc);
            border-radius: 10px;
            text-align: center;
            font-family: var(--mono);
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--c-ink);
            background: var(--rb);
            outline: none;
            padding: 0 8px;
            transition: var(--tr)
        }

            .orc-input:focus {
                box-shadow: 0 0 0 3px color-mix(in srgb,var(--rc) 20%,transparent)
            }

            .orc-input.inp-error {
                border-color: #f43f5e !important;
                background: #fff1f2 !important;
                box-shadow: 0 0 0 3px rgba(244,63,94,.18) !important
            }

        .orc-label {
            font-size: .72rem;
            color: var(--c-slate);
            font-weight: 600
        }

        .orc-display {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 70px;
            height: 42px;
            padding: 0 14px;
            border-radius: 10px;
            background: var(--rb);
            border: 2px solid var(--rc);
            color: var(--rc);
            font-family: var(--mono);
            font-size: 1.15rem;
            font-weight: 700
        }

        .mc-info-panel {
            background: var(--mc-bg);
            border: 1.5px solid var(--mc-bd);
            border-radius: 10px;
            padding: 12px 18px;
            display: flex;
            align-items: center;
            gap: 14px
        }

        .mc-info-label {
            font-size: .72rem;
            font-weight: 700;
            color: var(--mc-tx);
            text-transform: uppercase;
            letter-spacing: .06em
        }

        .mc-info-val {
            font-family: var(--mono);
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--mc-tx)
        }

        .avg-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 48px;
            height: 28px;
            padding: 0 8px;
            border-radius: 7px;
            background: var(--avg-bg);
            border: 1.5px solid var(--avg-bd);
            color: var(--avg-tx);
            font-family: var(--mono);
            font-size: .80rem;
            font-weight: 700
        }

        .avg-badge-null {
            background: var(--c-bg2);
            border-color: var(--c-border);
            color: var(--c-muted)
        }

        .num-inp {
            width: 80px;
            height: 34px;
            border: 1.5px solid var(--c-border);
            border-radius: 7px;
            text-align: center;
            font-family: var(--mono);
            font-size: .80rem;
            color: var(--c-ink);
            background: #fff;
            outline: none;
            padding: 0 6px;
            transition: var(--tr)
        }

            .num-inp:focus {
                border-color: var(--rc);
                box-shadow: 0 0 0 3px color-mix(in srgb,var(--rc) 15%,transparent)
            }

            .num-inp.ei {
                border-color: var(--emp-bd);
                background: var(--emp-bg)
            }

            .num-inp.ri {
                border-color: var(--rm-bd);
                background: var(--rm-bg)
            }

            .num-inp.hi {
                border-color: var(--hod-bd);
                background: var(--hod-bg)
            }

            .num-inp.ui {
                border-color: var(--uh-bd);
                background: var(--uh-bg)
            }

        .rem-inp {
            width: 160px;
            height: 34px;
            border: 1.5px solid var(--c-border);
            border-radius: 7px;
            font-family: var(--font);
            font-size: .73rem;
            color: var(--c-ink);
            padding: 0 10px;
            outline: none;
            transition: var(--tr);
            background: #fff
        }

            .rem-inp:focus {
                border-color: var(--rc);
                box-shadow: 0 0 0 2px color-mix(in srgb,var(--rc) 12%,transparent)
            }

        .inp-error {
            border-color: #f43f5e !important;
            box-shadow: 0 0 0 3px rgba(244,63,94,.18) !important;
            background: #fff1f2 !important
        }

        .row-incomplete td {
            background: rgba(244,63,94,.045) !important
        }

        .kpi-progress-bar {
            height: 5px;
            border-radius: 3px;
            background: #e2e8f0;
            overflow: hidden;
            flex: 1;
            min-width: 80px
        }

        .kpi-progress-fill {
            height: 100%;
            border-radius: 3px;
            background: #22c55e;
            transition: width .25s ease, background .25s ease
        }

        .kpi-counter {
            font-family: var(--mono);
            font-size: .74rem;
            font-weight: 700;
            white-space: nowrap
        }

        .stars {
            display: flex;
            gap: 2px;
            justify-content: center
        }

        .star {
            width: 30px;
            height: 30px;
            border-radius: 6px;
            border: 1.5px solid var(--c-border);
            background: #fff;
            font-family: var(--mono);
            font-size: .74rem;
            font-weight: 700;
            color: var(--c-slate);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--tr)
        }

            .star:hover {
                border-color: var(--rc);
                color: var(--rc);
                background: var(--rb)
            }

            .star.on {
                background: var(--rc);
                border-color: var(--rc);
                color: #fff;
                box-shadow: 0 2px 6px rgba(0,0,0,.2)
            }

        .val {
            font-family: var(--mono);
            font-size: .80rem;
            font-weight: 700
        }

        .ve {
            color: var(--emp-tx)
        }

        .vr {
            color: var(--rm-tx)
        }

        .vh {
            color: var(--hod-tx)
        }

        .vu {
            color: var(--uh-tx)
        }

        .rb {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            font-size: .73rem;
            font-weight: 700;
            font-family: var(--mono)
        }

        .rb1 {
            background: #fff1f2;
            color: #e11d48;
            border: 2px solid #fecdd3
        }

        .rb2 {
            background: #fef9c3;
            color: #a16207;
            border: 2px solid #fde047
        }

        .rb3 {
            background: #eff6ff;
            color: #1d4ed8;
            border: 2px solid #93c5fd
        }

        .rb4 {
            background: #f0fdf4;
            color: #15803d;
            border: 2px solid #86efac
        }

        .rb5 {
            background: #f0fdf4;
            color: #14532d;
            border: 2px solid #4ade80
        }

        .total-row td {
            background: linear-gradient(120deg,var(--c-navy) 0%,var(--c-navy3) 100%);
            color: #fff;
            font-family: var(--mono);
            font-weight: 700;
            font-size: .82rem;
            padding: 13px 12px !important
        }

        .total-score {
            color: #34d399;
            font-size: 1.05rem
        }

        .action-bar {
            background: var(--c-white);
            border: 1px solid var(--c-border);
            border-radius: var(--rad);
            padding: 16px 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            box-shadow: var(--sh)
        }

        .action-msg {
            font-size: .81rem;
            color: var(--c-ink3);
            line-height: 1.5
        }

        .btn-row {
            display: flex;
            gap: 8px;
            align-items: center
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            height: 40px;
            padding: 0 20px;
            border-radius: 9px;
            font-family: var(--font);
            font-size: .80rem;
            font-weight: 700;
            cursor: pointer;
            border: none;
            transition: var(--tr);
            text-decoration: none;
            white-space: nowrap
        }

            .btn:active {
                transform: scale(.97)
            }

        .btn-pri {
            background: var(--rc);
            color: #fff;
            box-shadow: 0 2px 10px rgba(0,0,0,.18)
        }

            .btn-pri:hover {
                filter: brightness(1.08);
                box-shadow: 0 4px 16px rgba(0,0,0,.22)
            }

        .btn-sec {
            background: #fff;
            color: var(--c-ink2);
            border: 1.5px solid var(--c-border)
        }

            .btn-sec:hover {
                border-color: var(--c-slate);
                color: var(--c-ink)
            }

        .overlay {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 9000;
            background: rgba(11,23,49,.6);
            backdrop-filter: blur(5px);
            align-items: center;
            justify-content: center
        }

            .overlay.on {
                display: flex
            }

        .overlay-box {
            background: #fff;
            border-radius: 18px;
            padding: 40px 52px;
            text-align: center;
            box-shadow: 0 20px 60px rgba(0,0,0,.25)
        }

        .spin {
            width: 44px;
            height: 44px;
            border: 4px solid #e2e8f0;
            border-top-color: var(--rc);
            border-radius: 50%;
            animation: spin .7s linear infinite;
            margin: 0 auto 16px
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg)
            }
        }

        .overlay-txt {
            font-size: .84rem;
            color: var(--c-slate);
            font-weight: 500
        }

        .toasts {
            position: fixed;
            bottom: 22px;
            right: 22px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 8px
        }

        .toast {
            background: var(--c-navy);
            color: rgba(255,255,255,.9);
            border-radius: 10px;
            padding: 11px 16px;
            font-size: .80rem;
            font-weight: 500;
            min-width: 280px;
            display: flex;
            align-items: center;
            gap: 9px;
            box-shadow: 0 8px 32px rgba(0,0,0,.2);
            animation: tin .2s ease
        }

            .toast.ok {
                border-left: 4px solid #34d399
            }

            .toast.err {
                border-left: 4px solid #f43f5e
            }

        @@keyframes tin {
            from {
                opacity: 0;
                transform: translateX(16px)
            }

            to {
                opacity: 1;
                transform: none
            }
        }

        @@media(max-width:768px) {
            .body, .hero, .nav {
                padding-left: 14px;
                padding-right: 14px
            }

            .hero-meta {
                flex-direction: column;
                gap: 6px
            }
        }

        .doc-zone {
            border: 1.5px dashed var(--c-border);
            border-radius: 9px;
            padding: 10px 12px;
            background: var(--c-bg);
            min-width: 220px;
            transition: border-color .15s, background .15s
        }

            .doc-zone:hover {
                border-color: var(--rc);
                background: var(--rb)
            }

        .doc-zone-inner {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap
        }

        .doc-upload-btn {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            height: 30px;
            padding: 0 12px;
            border-radius: 7px;
            border: 1.5px solid var(--rc);
            background: var(--rb);
            color: var(--rc);
            font-family: var(--font);
            font-size: .72rem;
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
            transition: .15s
        }

            .doc-upload-btn:hover {
                filter: brightness(.93)
            }

            .doc-upload-btn input[type=file] {
                display: none
            }

        .doc-pills {
            display: flex;
            flex-direction: column;
            gap: 5px;
            margin-top: 6px;
            width: 100%
        }

        .doc-pill {
            display: flex;
            align-items: center;
            gap: 6px;
            background: #fff;
            border: 1px solid var(--c-border);
            border-radius: 6px;
            padding: 4px 8px;
            font-size: .70rem;
            color: var(--c-ink2);
            min-width: 0
        }

        .doc-pill-icon {
            font-size: .85rem;
            flex-shrink: 0
        }

        .doc-pill-name {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-weight: 500
        }

        .doc-pill-role {
            font-size: .60rem;
            font-weight: 700;
            padding: 1px 6px;
            border-radius: 4px;
            white-space: nowrap;
            flex-shrink: 0
        }

        .doc-pill-view {
            font-size: .68rem;
            font-weight: 700;
            color: var(--rc);
            text-decoration: none;
            flex-shrink: 0;
            padding: 2px 6px;
            border-radius: 4px;
            border: 1px solid var(--rc);
            background: var(--rb);
            white-space: nowrap
        }

            .doc-pill-view:hover {
                filter: brightness(.93)
            }

        .doc-pill-del {
            background: none;
            border: none;
            cursor: pointer;
            color: #e11d48;
            font-size: .75rem;
            padding: 0 2px;
            flex-shrink: 0;
            line-height: 1
        }

        .doc-uploading {
            font-size: .70rem;
            color: var(--c-slate);
            display: flex;
            align-items: center;
            gap: 5px;
            font-style: italic
        }

        .doc-spin {
            width: 12px;
            height: 12px;
            border: 2px solid var(--c-border);
            border-top-color: var(--rc);
            border-radius: 50%;
            animation: spin .6s linear infinite;
            flex-shrink: 0
        }

        .doc-missing-warn {
            font-size: .68rem;
            color: #dc2626;
            font-weight: 600;
            margin-top: 4px;
            display: none
        }

        .doc-zone.doc-required-err {
            border-color: #f43f5e;
            background: #fff1f2
        }

        /* ── Compact column widths — friendlier scrolling ── */
        table.ap th[style*="min-width:210px"] {
            min-width: 180px !important;
        }

        table.ap th[style*="min-width:168px"] {
            min-width: 150px !important;
        }

        table.ap th[style*="min-width:88px"] {
            min-width: 64px !important;
        }

        table.ap th[style*="min-width:240px"] {
            min-width: 170px !important;
        }

        table.ap th[style*="min-width:260px"] {
            min-width: 220px !important;
        }

        .star {
            width: 24px;
            height: 24px;
            font-size: .66rem;
        }

        .num-inp {
            width: 58px;
        }

        .rem-inp {
            width: 130px;
        }

        .justification-inp {
            min-width: 180px;
        }

        .doc-zone {
            min-width: 150px;
        }
    </style>
</head>
<body>

    <nav class="nav">
        <div class="nav-brand">
            <div class="nav-logo">V</div>
            <div class="nav-title">
                <strong>VANDANA GLOBAL LIMITED</strong>
                <span>Performance Management System</span>
            </div>
        </div>
        <div class="nav-right">
            <div class="role-chip">@roleIcon &nbsp;@roleName</div>
            <a href="javascript:history.back()" class="btn-back">← Back</a>
        </div>
    </nav>

    <div class="hero">
        <div class="hero-name">@m.EmpName</div>
        <div class="hero-meta">
            <span class="hero-tag">🔑 <strong>@m.EmpCode</strong></span>
            <span class="hero-tag">💼 <strong>@m.Designation</strong></span>
            <span class="hero-tag">🏢 <strong>@m.Department</strong></span>
            <span class="hero-tag">📅 <strong>@m.AppraisalYear</strong></span>
            <span class="hero-tag"><span class="hero-badge">@m.AppraisalCycle</span></span>
            @if (m.CycleFromDate.HasValue && m.CycleToDate.HasValue)
            {
                <span class="hero-tag">📆 <strong>@m.CycleFromDate.Value.ToString("dd MMM yyyy") → @m.CycleToDate.Value.ToString("dd MMM yyyy")</strong></span>
            }
            @if (!string.IsNullOrEmpty(m.RmName))
            {
                <span class="hero-tag">👔 RM: <strong>@m.RmName</strong></span>
            }
            @if (!string.IsNullOrEmpty(m.HodName))
            {
                <span class="hero-tag">🏛 HOD: <strong>@m.HodName</strong></span>
            }
            @if (!string.IsNullOrEmpty(m.UnitHeadName))
            {
                <span class="hero-tag">🏢 UH: <strong>@m.UnitHeadName</strong></span>
            }
        </div>
    </div>

    <div class="body">

        <!-- Role / instruction banner -->
        <div class="alert alert-role">
            <div class="alert-icon">@roleIcon</div>
            <div class="alert-text">
                @if (role == "Employee" && canEdit)
                {
                    <text><strong>Self Appraisal</strong> — Enter your <strong>Actual</strong> value and <strong>Rating (1–5)</strong> for each KPI. Provide a <strong>Justification</strong> explaining your performance. Supporting documents are optional. Once you submit, your appraisal is forwarded to your Reporting Manager.</text>
                }
                else if (role == "Employee")
                {
                    <text><strong>Self Appraisal (Read Only)</strong> — Your appraisal has been submitted and is now under review.</text>
                }
                else if (role == "RM" && canEdit)
                {
                    <text><strong>Reporting Manager Review</strong> — Your input columns appear first. Enter <strong>RM Actual</strong>, <strong>RM Rating (1–5)</strong> and optional <strong>Remarks</strong>. Employee's scores and justifications are shown for reference. Submitting forwards to HOD.</text>
                }
                else if (role == "RM")
                {

                    <text><strong>RM Review (Read Only)</strong> — This appraisal is not in the RM review stage or has already been reviewed.</text>
                }
                else if (role == "HOD" && canEdit)
                {
                    <text><strong>HOD Review</strong> — Your input columns appear first. Enter <strong>HOD Actual</strong>, <strong>HOD Rating (1–5)</strong> and optional <strong>Remarks</strong>. Previous scores and employee justifications shown for reference. Submitting forwards to Unit Head.</text>
                }
                else if (role == "HOD")
                {

                    <text><strong>HOD Review (Read Only)</strong> — This appraisal is not currently in the HOD review stage.</text>
                }
                else if (role == "UnitHead" && canEdit)
                {
                    <text><strong>Unit Head Review</strong> — Your input columns appear first. Enter <strong>UH Actual</strong>, <strong>UH Rating (1–5)</strong> and optional <strong>Remarks</strong>. Previous scores and employee justifications shown for reference. Submitting forwards to Moderation Committee.</text>
                }
                else if (role == "UnitHead")
                {

                    <text><strong>Unit Head Review (Read Only)</strong> — This appraisal is not currently in the Unit Head review stage.</text>
                }
                else if (role == "ModCommittee" && canEdit)
                {
                    <text><strong>Moderation Committee Review</strong> — Review per-KPI scores and employee justifications, then provide a single <strong>Overall MC Rating (0.01–5.00)</strong> with optional remarks. Submitting forwards to JMD.</text>
                }
                else if (role == "ModCommittee")
                {

                    <text><strong>Moderation Committee Review (Read Only)</strong> — Not currently in Moderation Committee stage.</text>
                }
                else if (role == "JMD" && canEdit)
                {
                    <text><strong>JMD Review</strong> — Review all reviewer scores, employee justifications and the MC Overall Rating, then provide a single <strong>Overall JMD Rating (0.01–5.00)</strong>. Submitting forwards to HR.</text>
                }
                else if (role == "JMD")
                {

                    <text><strong>JMD Review (Read Only)</strong> — Not currently in JMD review stage.</text>
                }
                else
                {

                    <text><strong>HR View</strong> — Complete read-only view of all appraisal stages including employee justifications.</text>
                }
            </div>
        </div>

        @if (!canEdit)
        {
            <div class="alert alert-ro">⚠️ Read-only mode — Current status: <strong>@m.Status</strong></div>
        }

        <!-- MC OVERALL RATING PANEL -->
        @if (role is "ModCommittee" or "JMD" or "HR")
        {
            var allVals = new List<decimal>();
            foreach (var kRow in m.KpiRows)
            {
                if (kRow.RmRating.HasValue) allVals.Add(kRow.RmRating.Value);
                if (kRow.HodRating.HasValue) allVals.Add(kRow.HodRating.Value);
                if (kRow.UnitHeadRating.HasValue) allVals.Add(kRow.UnitHeadRating.Value);
            }
            decimal? overallAvg = allVals.Any() ? (decimal?)Math.Round(allVals.Average(), 2) : null;

            <div class="overall-rating-card">
                <div class="orc-title"><span>⚖️</span>@(role == "ModCommittee" ? "Moderation Committee — Overall Rating" : "Moderation Committee — Overall Rating (Reference)")</div>
                <div class="orc-body">
                    <div class="orc-info">
                        <strong>Overall Average (RM + HOD + Unit Head)</strong> across all @m.KpiRows.Count KPI(s):<br />
                        <span style="font-family:var(--mono);font-size:1.05rem;font-weight:700;color:var(--avg-tx)">@(overallAvg.HasValue? overallAvg.Value.ToString("0.00") : "—")</span>
                        <span style="font-size:.70rem;color:var(--c-slate);margin-left:6px">(avg of all RM, HOD &amp; UH ratings)</span><br />
                        <span style="font-size:.74rem;color:var(--c-ink3);margin-top:4px;display:block">MC gives a single overall rating for the entire appraisal (decimal allowed, max 5.00).</span>
                    </div>
                    <div class="orc-input-wrap">
                        @if (role == "ModCommittee" && canEdit)
                        {
                            <div style="display:flex;flex-direction:column;align-items:center;gap:5px">
                                <input type="number" id="mcOverallRatingInput" class="orc-input"
                                       placeholder="e.g. 3.75" step="0.01" min="0.01" max="5"
                                       value="@(mcOverallRating.HasValue? mcOverallRating.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "")"
                                       oninput="clampOverallRating(this)" />
                                <span class="orc-label">MC Rating (max 5.00)</span>
                            </div>
                            <div style="display:flex;flex-direction:column;gap:4px">
                                <label style="font-size:.70rem;font-weight:600;color:var(--c-slate)">MC Remarks (optional)</label>
                                <input type="text" id="mcOverallRemarksInput" class="rem-inp"
                                       placeholder="Overall remarks…" style="width:220px"
                                       value="@(ViewBag.McOverallRemarks as string ?? "")" />
                            </div>
                        }
                        else
                        {
                            <div style="display:flex;flex-direction:column;align-items:center;gap:5px">
                                <span class="orc-display">@(mcOverallRating.HasValue? mcOverallRating.Value.ToString("0.##") : "—")</span>
                                <span class="orc-label" style="color:var(--mc-tx)">MC Overall Rating</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(ViewBag.McOverallRemarks as string))
                            {
                                <div style="font-size:.74rem;color:var(--c-slate);max-width:260px">
                                    <span style="font-weight:600;color:var(--mc-tx)">MC Remarks:</span><br />@(ViewBag.McOverallRemarks as string)
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }

        <!-- JMD OVERALL RATING PANEL -->
        @if (role is "JMD" or "HR")
        {
            <div class="overall-rating-card" style="--rc:var(--jmd-tx);--rb:var(--jmd-bg)">
                <div class="orc-title"><span>👑</span>@(role == "JMD" ? "JMD — Overall Rating" : "JMD — Overall Rating (Reference)")</div>
                <div class="orc-body">
                    <div class="orc-info">
                        @if (mcOverallRating.HasValue)
                        {
                            <div class="mc-info-panel" style="margin-bottom:10px">
                                <span class="mc-info-label">⚖️ MC Overall Rating:</span>
                                <span class="mc-info-val">@mcOverallRating.Value.ToString("0.##")</span>
                                @if (!string.IsNullOrWhiteSpace(ViewBag.McOverallRemarks as string))
                                {
                                    <span style="font-size:.72rem;color:var(--mc-tx);margin-left:8px">"@(ViewBag.McOverallRemarks as string)"</span>
                                }
                            </div>
                        }
                        <span style="font-size:.74rem;color:var(--c-ink3)">JMD gives a single overall rating for the entire appraisal (decimal allowed, max 5.00).</span>
                    </div>
                    <div class="orc-input-wrap">
                        @if (role == "JMD" && canEdit)
                        {
                            <div style="display:flex;flex-direction:column;align-items:center;gap:5px">
                                <input type="number" id="jmdOverallRatingInput" class="orc-input"
                                       style="border-color:var(--jmd-bd);background:var(--jmd-bg)"
                                       placeholder="e.g. 4.25" step="0.01" min="0.01" max="5"
                                       value="@(jmdOverallRating.HasValue? jmdOverallRating.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "")"
                                       oninput="clampOverallRating(this)" />
                                <span class="orc-label">JMD Rating (max 5.00)</span>
                            </div>
                            <div style="display:flex;flex-direction:column;gap:4px">
                                <label style="font-size:.70rem;font-weight:600;color:var(--c-slate)">JMD Remarks (optional)</label>
                                <input type="text" id="jmdOverallRemarksInput" class="rem-inp"
                                       placeholder="Overall remarks…" style="width:220px"
                                       value="@(ViewBag.JmdOverallRemarks as string ?? "")" />
                            </div>
                        }
                        else
                        {
                            <div style="display:flex;flex-direction:column;align-items:center;gap:5px">
                                <span class="orc-display" style="border-color:var(--jmd-bd);background:var(--jmd-bg);color:var(--jmd-tx)">
                                    @(jmdOverallRating.HasValue? jmdOverallRating.Value.ToString("0.##") : "—")
                                </span>
                                <span class="orc-label" style="color:var(--jmd-tx)">JMD Overall Rating</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(ViewBag.JmdOverallRemarks as string))
                            {
                                <div style="font-size:.74rem;color:var(--c-slate);max-width:260px">
                                    <span style="font-weight:600;color:var(--jmd-tx)">JMD Remarks:</span><br />@(ViewBag.JmdOverallRemarks as string)
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }

        <!-- APPRAISAL TABLE -->
        <div class="card">
            <div class="card-hd">
                <div class="card-hd-title">📊 Appraisal Sheet — @m.EmpName</div>
                <span class="card-hd-badge">@m.KpiRows.Count KPI(s)</span>
            </div>

            <div class="tbl-wrap">
                <table class="ap">
                    <thead>
                        <tr>
                            <th rowspan="2" class="tl" style="min-width:40px;width:40px">#</th>
                            <th rowspan="2" class="tl" style="min-width:100px">PMP</th>
                            <th rowspan="2" class="tl" style="min-width:120px">KRA</th>
                            <th rowspan="2" class="tl" style="min-width:210px">KPI</th>
                            <th rowspan="2" style="min-width:58px">Unit</th>
                            <th rowspan="2" style="min-width:58px">Wt%</th>
