                                <th class="sl-rm" style="min-width:168px">Rating (1–5)</th>
                                <th class="sl-rm" style="min-width:168px">Remarks</th>
                            }
                            @if (role == "HOD" && showHod)
                            {
                                <th class="sl-hod" style="min-width:88px">Actual</th>
                                <th class="sl-hod" style="min-width:168px">Rating (1–5)</th>
                                <th class="sl-hod" style="min-width:168px">Remarks</th>
                            }
                            @if (role == "UnitHead" && showUh)
                            {
                                <th class="sl-uh" style="min-width:88px">Actual</th>
                                <th class="sl-uh" style="min-width:168px">Rating (1–5)</th>
                                <th class="sl-uh" style="min-width:168px">Remarks</th>
                            }
                            @* Other roles sub-headers *@
                            @if (role != "Employee" && showEmp)
                            {
                                <th class="sl-emp" style="min-width:88px">Actual</th>
                                <th class="sl-emp" style="min-width:168px">Rating</th>
                            }
                            @if (role != "RM" && showRm)
                            {
                                <th class="sl-rm" style="min-width:88px">Actual</th>
                                <th class="sl-rm" style="min-width:168px">Rating</th>
                                <th class="sl-rm" style="min-width:168px">Remarks</th>
                            }
                            @if (role != "HOD" && showHod)
                            {
                                <th class="sl-hod" style="min-width:88px">Actual</th>
                                <th class="sl-hod" style="min-width:168px">Rating</th>
                                <th class="sl-hod" style="min-width:168px">Remarks</th>
                            }
                            @if (role != "UnitHead" && showUh)
                            {
                                <th class="sl-uh" style="min-width:88px">Actual</th>
                                <th class="sl-uh" style="min-width:168px">Rating</th>
                                <th class="sl-uh" style="min-width:168px">Remarks</th>
                            }
                        </tr>
                    </thead>

                    <tbody id="kpiBody">
                        @{
                            int sr = 0;
                        }
                        @foreach (var row in m.KpiRows)
                        {
                            sr++;
                            var pk = row.PmpName;
                            var kk = pk + "||" + row.KraName;
                            bool np = seenPmp.Add(pk);
                            bool nk = seenKra.Add(kk);

                            <tr data-row-id="@row.EmpKpiRowId">

                                <td class="tc" style="font-family:var(--mono);color:var(--c-muted);font-size:.72rem">@sr</td>

